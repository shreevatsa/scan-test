{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "नारीणामप्यवज्ञा विलसति नियतं वृद्धभावोप्यसाधुः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "संसारे रे मनुष्या वदत यदि सुखं स्वल्पमप्यस्ति किंचित् ॥१०६॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "",
     "end": "space"
    },
    {
     "n": 2,
     "text": "आयुर्वर्षशतं नृणां परिमितं रात्रौ तदर्धं गतं",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "space"
    },
    {
     "n": 4,
     "text": "तस्यार्धस्य परस्य चार्धमपरं बालत्ववृद्धत्वयोः ।",
     "end": "line"
    },
    {
     "n": 5,
     "text": "शेषं व्याधिवियोगदुःखसहितं सेवादिभिर्नीयते",
     "end": "line"
    },
    {
     "n": 6,
     "text": "",
     "end": "space"
    },
    {
     "n": 7,
     "text": "जीवे वारितरङ्गचञ्चलतरे सौख्यं कुतः प्राणिनाम् ॥ १०७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "ब्रह्मज्ञानविवेकिनोमलधियः कुर्वन्त्यहो दुष्करं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "यन्मुञ्चन्त्युपभोगकाञ्चनधनान्येकान्ततो निस्पृहाः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "न प्राप्तानि पुरा न सम्प्रति न च प्राप्तौ दृढप्रत्ययो",
     "end": "line"
    },
    {
     "n": 4,
     "text": "वाञ्छामात्रपरिग्रहाण्यपि परं त्यक्तुं न शक्ता वयम् ॥ १०८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "व्याघ्रीव तिष्ठति जरा परितर्जयन्ती",
     "end": "line"
    },
    {
     "n": 2,
     "text": "रोगाश्च शत्रव इव प्रहरन्ति देहम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "आयुः परिस्रवति भिन्नघटादिवाम्भो",
     "end": "line"
    },
    {
     "n": 4,
     "text": "लोकस्तथाप्यहितमाचरतीति चित्रम् ॥ १०९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
