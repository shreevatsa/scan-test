          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"rshi; marked or settled as one\u2019s measure i. e. portion destined\",\"end\":\"space\"},{\"n\":2,\"text\":\"to fall to one\u2019s share. \u0909\u092a\u0928\u092e\u0947\u0924\u094d\u2014Lit. go to, fall to one\u2019s lot.\",\"end\":\"space\"},{\"n\":3,\"text\":\"Comp. for this sense of \u0928\u092e\u094d with \u0909\u092a, \u0907\u0926\u092e\u0941\u092a\u0928\u0924\u092e\u0947\u0935\u0902 \u0930\u0942\u092a\u092e\u0915\u094d\u0932\u093f\u0937\u094d\u091f\u0915\u093e\u0928\u094d\u0924\u093f\",\"end\":\"space\"},{\"n\":4,\"text\":\"S'ak V. 19. \u0915\u0938\u094d\u092f\u093e\u0924\u094d\u092f\u0928\u094d\u0924\u0902 \u0938\u0941\u0916\u092e\u0941\u092a\u0928\u0924\u0902 &c. Meg. Some read\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0909\u092a\u0928\u092f\u0947\u0924\u094d supplying \u0926\u0948\u0935\u0902 as the subject, but then the construction\",\"end\":\"space\"},{\"n\":6,\"text\":\"becomes clumsy. \u0915\u093e\u0930\u0923\u092e\u094d\u2014i. e. to obtain more. \u0906\u0936\u093e\u2014direc-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"tions; there is also an indirect reference to the other meaning\u2014\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u2018hopes, expectations\u2019. \u0935\u0930\u094d\u0937\u0924\u093f\u2014Loc. of the pres. p. of \u0935\u0943\u0937\u094d, which,\",\"end\":\"space\"},{\"n\":9,\"text\":\"though trans., is here used intransitively as its object \u091c\u0932 is\",\"end\":\"space\"},{\"n\":10,\"text\":\"well-known. Cf. \u0927\u093e\u0924\u094b\u0930\u0930\u094d\u0925\u093e\u0928\u094d\u0924\u0930\u0947 \u0935\u0943\u0924\u094d\u0924\u0947\u0930\u094d\u0927\u093e\u0924\u094d\u0935\u0930\u094d\u0925\u0947\u0928\u094b\u092a\u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0924\u094d \u0964 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927\u0947\u0930\u0935\u093f\u0935\u0915\u094d\u0937\u093e\u0924\u0903\",\"end\":\"space\"},{\"n\":11,\"text\":\"\u0915\u0930\u094d\u092e\u0923\u094b\u093d\u0915\u0930\u094d\u092e\u093f\u0915\u093e \u0915\u094d\u0930\u093f\u092f\u093e \u0965 Sid. Kau. \u0926\u094d\u0935\u093f\u0924\u094d\u0930\u093e\u0903\u2014A Bah. Comp.; \u0938\u0902\u0916\u094d\u092f\u0947\u092f\u0947\",\"end\":\"space\"},{\"n\":12,\"text\":\"\u092f\u094b \u092c\u0939\u0941\u0935\u094d\u0930\u0940\u0939\u093f\u0938\u094d\u0924\u0938\u094d\u092e\u093e\u0926\u094d \u0921\u091a\u094d ( \u0905 substituted for the final vowel ) \u0938\u094d\u092f\u093e\u0924\u094d \u0964\",\"end\":\"space\"},{\"n\":13,\"text\":\"\",\"end\":\"space\"},{\"n\":14,\"text\":\"Sid. Kau. on P\u00e0n. V. 4. 73. See com. \u092c\u0939\u0941\u0935\u094d\u0930\u0940\u0939\u094c &c\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit passages are difficult to read, especially the quotations and grammatical forms.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 98. \u092f\u0926\u093e\u2014is equivalent here to \u092f\u0926\u093f. \u0926\u094b\u0937\u094b &c\u2014The spring is\",\"end\":\"space\"},{\"n\":2,\"text\":\"the season for the trees to put forth new leaves. \u0915\u0930\u0940\u0930 a thorny\",\"end\":\"space\"},{\"n\":3,\"text\":\"shrub growing in a desert; it is eaten by sheep and camels.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0909\u0932\u0942\u0915\u2014an owl. \u0905\u092a\u093f stands for \u091a. \u0938\u0942\u0930\u094d\u092f\u0938\u094d\u092f\u2014\u0938\u0930\u0924\u093f \u0906\u0915\u093e\u0936\u0947 \u0938\u0942\u0930\u094d\u092f\u0903 \u0964 \u092f\u0926\u094d\u0935\u093e\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0938\u0941\u0935\u0924\u093f \u0915\u0930\u094d\u092e\u0923\u093f \u0932\u094b\u0915\u0902 \u092a\u094d\u0930\u0947\u0930\u092f\u0924\u093f ( urges men to action ); from \u0938\u0942 + \u092f\u0902 (\u0915\u094d\u092f\u092a\u094d\",\"end\":\"space\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0915\u0930\u094d\u0924\u0930\u093f; \u0915\u094d\u092f\u092a\u094b \u0939\u094d\u0930\u0938\u094d\u0935\u0903); it is irregularly derived by \u2018\u0930\u093e\u091c\u0938\u0942\u092f\u0938\u0942\u0930\u094d\u092f &c.\u2019 Pan.\",\"end\":\"space\"},{\"n\":8,\"text\":\"III. 1. 114. \u091a\u093e\u0924\u0915\u092e\u0941\u0916\u0947\u2014The bird \u091a\u093e\u0924\u0915 is supposed to drink\",\"end\":\"space\"},{\"n\":9,\"text\":\"only a few drops of rain water when the sun is in Sv\u00e1ti.\",\"end\":\"space\"},{\"n\":10,\"text\":\"Various discrepant stories are current about this bird with\",\"end\":\"space\"},{\"n\":11,\"text\":\"which every one is familiar. \u092e\u0947\u0918\u0903\u2014\u092e\u0947\u0939\u0924\u093f \u0938\u093f\u091e\u094d\u091a\u0924\u0940\u0924\u093f.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit grammatical forms and the cited rule are not entirely clear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 99. \u0928\u092e\u0938\u094d\u092f\u093e\u092e\u0903\u2014A denominative, \u092f ( \u0915\u094d\u092f\u091a\u094d ) is added to \u0928\u092e\u0903\",\"end\":\"space\"},{\"n\":2,\"text\":\"in the sense of \u2018 paying homage to \u2019; \u0928\u092e\u0938\u094d\u092f\u0924\u093f \u0926\u0947\u0935\u093e\u0928\u094d \u0964 \u092a\u0942\u091c\u092f\u0924\u0940\u0924\u094d\u092f\u0930\u094d\u0925\u0903 \u0964\",\"end\":\"space\"},{\"n\":3,\"text\":\"Sid. Kau. on P\u00e1n III. 1. 19. \u0928\u0928\u0941\u2014here used to introduce an\",\"end\":\"space\"},{\"n\":4,\"text\":\"objection\u2014but, are they not &c. \u0939\u0924\u0935\u093f\u0927\u093f\u2014accursed fate. Cf.\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0939\u0924\u0939\u0943\u0926\u092f\u0902 S'ak. VI. 6. \u0939\u0924\u0935\u093f\u0927\u093f\u0932\u0938\u093f\u0924\u093e\u0928\u093e\u0902 \u0939\u0940 \u0935\u093f\u091a\u093f\u0924\u094d\u0930\u094b \u0935\u093f\u092a\u093e\u0915\u0903 \u0964 Sis XI, 64.\",\"end\":\"space\"},{\"n\":6,\"text\":\"The word \u0926\u0917\u094d\u0927 is also similarly used. See Vais. S'a. sl. 22. The\",\"end\":\"space\"},{\"n\":7,\"text\":\"words \u0939\u0924\u0915 is more commonly used in this sense but at the end\",\"end\":\"space\"},{\"n\":8,\"text\":\"of a comp.; \u0928 \u0916\u0932\u0941 \u0935\u093f\u0926\u093f\u0924\u0938\u094d\u0924\u0947 \u091a\u093e\u0923\u0915\u094d\u092f\u0939\u0924\u0915\u0947\u0928 \u0964 Mud. II. \u092a\u0930\u093f\u092d\u0942\u0924\u093e\u0903 \u0938\u094d\u092e\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u0930\u093e\u092e\u0939\u0924\u0915\u0947\u0928 \u0964 Utt. I. \u0935\u0936\u0917\u093e\u0903\u2014\u0935\u0936\u0902 \u0917\u091a\u094d\u091b\u0928\u094d\u0924\u0940\u0924\u093f \u0935\u0936\u0917\u093e\u0903 \u0964 under the power\",\"end\":\"space\"},{\"n\":10,\"text\":\"of fate. The gods, Indra included, are finite beings, whose\",\"end\":\"space\"},{\"n\":11,\"text\":\"existence as separate deities terminates at the end of a Kalpa\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some quoted Sanskrit forms and punctuation are unclear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 36 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"97\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"98\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"99\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
