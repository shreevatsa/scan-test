{
 "regions": {
  "r3": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "कान्तिरपीत्यर्थः । इभेषु इन्द्र इव इभेन्द्रः । मत्तश्चासौ इभेन्द्रश्च मत्ते० । विभिन्नौ",
     "end": "space"
    },
    {
     "n": 2,
     "text": "च तौ कुम्भौ च विभि० । मत्तेभेन्द्रस्य विभिन्नकुम्भौ तयोः कवलः । पिशितेति",
     "end": "space"
    },
    {
     "n": 3,
     "text": "पाठे तत्र यत्पिशितं मांसं । तस्य ग्रासः मत्ते०ग्रासः । स एव एकस्तस्मिन्बद्धा",
     "end": "space"
    },
    {
     "n": 4,
     "text": "स्पृहा येन सः । तथा च मानेन महान्त उन्नतास्तेषाम् । अग्रे सरतीत्यग्रेसरः ।",
     "end": "space"
    },
    {
     "n": 5,
     "text": "पुरोऽग्रेषु सर्तेः ३. २. १८ ) इति टप्रत्ययः । स केसरी शुष्कं तृणमत्ति",
     "end": "space"
    },
    {
     "n": 6,
     "text": "किम् । नैवात्तीत्यर्थं । अप्रस्तुतप्रशंसालङ्कारः । शार्दूलविक्रीडितं वृत्तम् ।",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some readings and punctuation are indistinct, especially in lines 1 and 5."
  },
  "r4": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अथ सर्वेषां सत्त्वानुरूपैव प्रवृत्तिरित्याह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "स्वल्पस्नायुवसावशेषमलिनं निर्मांसमप्यस्थिकं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "श्वा लब्ध्वा परितोषमेति न तु तत्तस्य क्षुधाशान्तये ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "सिंहो जम्बुकमङ्कमागतमपि त्यक्त्वा निहन्ति द्विपं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सर्वः कृच्छ्रगतोऽपि वाञ्छति जनः सत्त्वानुरूपं फलम् ॥३०॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The small footnote markers in the verse are not legible enough to identify reliably."
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "स्वल्पः स्नायुश्च वसा मेदश्च स्नायुवसं तस्य अवशेषस्तेन मलिनम् । अल्पं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "कुत्सितं वास्थि अस्थिकम् । हिनस्तीति सिंहः । पृषोदरादिः । तदुक्तं सिंहो वर्ण-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "विपर्ययात् । कृच्छ्रं गतः कृच्छ्रगतः सङ्कटावस्थां प्राप्तः । सत्त्वानुरूपं स्वशक्त्य-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "नुगुणं स्वमनोऽनुरूपं वा फलं वाञ्छति । वृत्तं पूर्वोक्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some compound readings are indistinct."
  },
  "r7": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "सम्प्रति नीचान्नीजजनयोश्चेष्टाप्रकारमाह—",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The middle compound is unclear."
  },
  "r8": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "लाङ्गूलचालनमधश्चरणावपातं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "भूमौ निपत्य वदनोदरदर्शनं च ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "श्वा पिण्डदस्य कुरुते गजपुङ्गवस्तु",
     "end": "line"
    },
    {
     "n": 4,
     "text": "धीरं विलोकयति चाटुशतैश्च भुङ्क्ते ॥ ३१ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "चरणयोरवपातः चरणावपातः । पुमान्गौः पुङ्गवः । विशेषणसमासः । गोरत-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "द्धितलुकि ( ५. ४. ९२ ) इति समासान्तष्टच् । गजपुङ्गवः गजश्रेष्ठः । स्युरुत्तरपदे-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "व्याघ्रपुङ्गवपर्षभकुञ्जराः । सिंहशार्दूलनागाद्याः पुंसि श्रेष्ठार्थगोचराः ॥ इत्यमरः ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "",
     "end": "space"
    },
    {
     "n": 5,
     "text": "चाटुशतैः अनेकप्रियवाक्यैः । अनुनयवाक्यैरित्यर्थः । वसन्ततिलका वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The grammatical citation and some letters are indistinct; line 4 contains only a stray mark."
  },
  "r10": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "परिवर्तिनि संसारे मृतः को वा न जायते ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स जातो येन जातेन याति वंशः समुन्नतिम् ॥ ३२ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r11": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "परिवर्तिनि धर्माधर्मवशात्परिवर्तमाने । को वा मृतः सन् न जायते उत्पन्नो",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
