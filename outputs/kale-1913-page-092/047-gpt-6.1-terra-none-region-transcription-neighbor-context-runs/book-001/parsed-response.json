{
 "regions": {
  "r3": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अथ शिव उपासनारतेः शमस्योदयवशादाविर्भवतः निर्वेदस्थायिनः शान्तर-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "सस्य व्यञ्जकानि वाक्यान्याह पञ्चभिः—",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some characters in the first line are indistinct."
  },
  "r4": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "स्फुरत्स्फारज्योत्स्नाधवलिततले क्वापि पुलिने",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सुखासीनाः शान्तध्वनिषु रजनीषु द्युसरितः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "भवाभोगोद्विग्नाः शिव शिव शिवेत्युच्चवचसः",
     "end": "line"
    },
    {
     "n": 4,
     "text": "कदा स्यामानन्दोद्गतबहुलबाष्पाकुलदृशः ॥ ८६ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Footnote markers are not legible in the scan."
  },
  "r5": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "शान्ता ध्वनयः पक्षिमृगादिशब्दा यासु तासु रजनीषु रात्रिषु । एतेनान्तः-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "करणविक्षेपहेतुराहित्यं सूचितम् । स्फुरन्ती या स्फारा बहुला ज्योत्स्ना कौमुदी",
     "end": "space"
    },
    {
     "n": 3,
     "text": "तया धवलितं तलं यस्य तस्मिन् । द्युसरितः स्वर्धुन्याः क्वापि पुलिने सैकते ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "सुखेनासीनाः उपविष्टाः । भवस्य संसारस्य भवानां जन्मनां वा आभोगः वि-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "स्तारस्तेन उद्विग्ना उद्वेगं प्राप्ताः । शिव शिव शिवेति उच्चं वचो येषां ते । आ-",
     "end": "hyphen"
    },
    {
     "n": 6,
     "text": "नन्देन उद्गता ये बहुला बाष्पाः तैः आकुला दृशः येषां ते । कदा कस्मिन्काले",
     "end": "space"
    },
    {
     "n": 7,
     "text": "स्याम भवेम । येन कृतकृत्याः स्म इति भावः । शिखरिणी ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "A few characters are unclear."
  },
  "r6": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "वितीर्णे सर्वस्वे तरुणकरुणापूर्णहृदयाः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स्मरन्तः संसारे विगुणपरिणामां विधिगतिम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "वयं पुण्यारण्ये परिणतशरच्चन्द्रकिरणा-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "स्त्रियामा नेष्यामो हरचरणचिन्तैकशरणाः ॥ ८७ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Footnote markers are not legible; part of line 3 is heavily inked."
  },
  "r7": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "सर्वं च तत्स्वं धनं च तस्मिन् । वितीर्णे धर्मबुद्ध्या दत्ते । तरुणा प्रत्यग्रा या",
     "end": "space"
    },
    {
     "n": 2,
     "text": "करुणा तया पूर्णं हृदयं येषाम् । विगुणः निर्गुणः । अनिष्ट इति यावत् । परिणामः",
     "end": "space"
    },
    {
     "n": 3,
     "text": "परिपाको यासां तां विधिगतिं दैवविलसितानि । परिणता उपचिताः शरत्सं-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "बन्धिचन्द्रस्य परिणतस्य शरच्चन्द्रस्य वा किरणा अंशवः यासु ताः त्रियामाः",
     "end": "space"
    },
    {
     "n": 5,
     "text": "क्षपाः । हरस्य चरणयोः या चिन्ता ध्यानं सैव एकं शरणं आश्रयः येषां ते ।",
     "end": "space"
    },
    {
     "n": 6,
     "text": "‘शरणं गृहरक्षित्रोः’ इत्यमरः । शिख० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several characters, especially at the ends of lines, are indistinct."
  },
  "r8": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "कदा वाराणस्याममरतटिनीरोधसि वस-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "न्नसानेः कौपीनं शिरसि निदधानोऽञ्जलिपुटम् ।",
     "end": "line"
    }
   ],
   "uncertain": true,
   "note": "The first word on line 2 is unclear."
  },
