          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u092d\u0940\u0924\u093f\u091a\u094d\u091b\u0926\u094d-v. l. shielding ( lit covering ) from fear. \u0905\u092d\u093f\u092e\u093e\u0928\u2014\",\"end\":\"space\"},{\"n\":2,\"text\":\"may also mean \u2018egotism\u2019 \u0905\u0928\u094d\u0935\u0939\u0902\u2014day after day, always \u0938\u093e\u0927\u0941\u092a\u094d\u0930\u093f\u092f\u0902\u2014\",\"end\":\"space\"},{\"n\":3,\"text\":\"may also be taken as \u0938\u093e\u0927\u0941 \u091a \u0924\u0924\u094d \u092a\u094d\u0930\u093f\u092f\u0902 \u091a \u0964 \u0938\u0924\u094d\u0938\u0941-\u0938\u0940\u0926\u0928\u094d\u0924\u094d\u092f\u0924\u094d\u0930 fr \u0938\u0926\u094d + \u0915\u094d\u0924\u094d\u0930\u0928\u094d\",\"end\":\"space\"},{\"n\":4,\"text\":\"(\u0924\u094d\u0930) Un. IV 159. That in which people sit down to worship\",\"end\":\"space\"},{\"n\":5,\"text\":\"or contemplate; hence here worship or the system of worship;\",\"end\":\"space\"},{\"n\":6,\"text\":\"it may have here the same meaning as that of \u0938\u0902\u092a\u094d\u0930\u0926\u093e\u092f or\",\"end\":\"space\"},{\"n\":7,\"text\":\"the course of life adopted by the devotees of S'iva. \u0905\u0935\u093e\u0930\u094d\u092f\u0902 If the\",\"end\":\"space\"},{\"n\":8,\"text\":\"reading \u0905\u092a\u094d\u0930\u0924\u093f\u0939\u0924 be adopted in the first line this should be taken\",\"end\":\"space\"},{\"n\":9,\"text\":\"to mean that cannot be opposed, i. e. made to give way by\",\"end\":\"space\"},{\"n\":10,\"text\":\"being proved inferior. Mr. Telang who does not understand the\",\"end\":\"space\"},{\"n\":11,\"text\":\"word \u0905\u0935\u093e\u0930\u094d\u092f\u0902 in this sense suggests that \u0905\u092a\u094d\u0930\u0924\u093f\u0938\u0941\u0916\u0902 should be\",\"end\":\"space\"},{\"n\":12,\"text\":\"\",\"end\":\"space\"},{\"n\":13,\"text\":\"preferred to \u0905\u092a\u094d\u0930\u0924\u093f\u0939\u0924\u092e\u094d \u0905\u0935\u093e\u0930\u094d\u092f\u0902 may also be taken with \u0905\u0915\u094d\u0937\u092f\u0928\u093f\u0927\u093f\u092e\u094d\",\"end\":\"space\"},{\"n\":14,\"text\":\"\",\"end\":\"space\"},{\"n\":15,\"text\":\"as we have done in translating.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words, especially in the first three lines and the variant reading in line 11, are indistinct.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 32. \u0915\u0941\u0932\u0947\u2014\u0915\u0941\u0932 is here used in the same way as \u2018birth\u2019 in\",\"end\":\"space\"},{\"n\":2,\"text\":\"English, in the sense of \u2018noble birth\u2019. The reading \u092e\u094c\u0928\u0947 for \u092e\u093e\u0928\u0947\",\"end\":\"space\"},{\"n\":3,\"text\":\"in l. 2 is not to be preferred; because \u092e\u094c\u0928 by itself is a blemish\",\"end\":\"space\"},{\"n\":4,\"text\":\"and cannot be linked with other good things mentioned in the\",\"end\":\"space\"},{\"n\":5,\"text\":\"verse; secondly, all the expressions indicating danger are predi-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"cated as directly producing evil effects on the objects named\",\"end\":\"space\"},{\"n\":7,\"text\":\"while no direct effect can be produced on \u092e\u094c\u0928 by the fear of\",\"end\":\"space\"},{\"n\":8,\"text\":\"being considered spiritless. There is therefore a want of symme-\",\"end\":\"hyphen\"},{\"n\":9,\"text\":\"\",\"end\":\"space\"},{\"n\":10,\"text\":\"try if we accept the reading \u092e\u094c\u0928\u0947 instead of \u092e\u093e\u0928\u0947 If we take \u092e\u094c\u0928\",\"end\":\"space\"},{\"n\":11,\"text\":\"in its Vedantic sense of \u2018reticence\u2019 it will be inappropriate, as\",\"end\":\"space\"},{\"n\":12,\"text\":\"\",\"end\":\"space\"},{\"n\":13,\"text\":\"Mr Joglekar remarks, to link it with other material things so\",\"end\":\"space\"},{\"n\":14,\"text\":\"opposed to asceticism \u0917\u0941\u0923\u0947-comp -\u0928 \u0926\u0941\u0930\u094d\u091c\u0928\u093e\u0928\u093e\u092e\u093f\u0939 \u0915\u094b\u093d\u092a\u093f \u0926\u094b\u0937\u0938\u094d\u0924\u0947\u0937\u093e\u0902\",\"end\":\"space\"},{\"n\":15,\"text\":\"\u0938\u094d\u0935\u092d\u093e\u0935\u094b \u0939\u093f \u0917\u0941\u0923\u093e\u0938\u0939\u093f\u0937\u094d\u0923\u0941\u0903 \u0964 Vikramanga I. 20.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation and its introductory abbreviation are somewhat unclear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 33 \u0906\u0915\u094d\u0930\u093e\u0928\u094d\u0924\u0902\u2014is more forcible than \u0906\u0917\u0924\u0902. It must be\",\"end\":\"space\"},{\"n\":2,\"text\":\"taken with the following expressions also. \u0905\u0924\u094d\u092f\u0941\u091c\u094d\u091c\u094d\u0935\u0932\u0902\u2014this\",\"end\":\"space\"},{\"n\":3,\"text\":\"breaks the symmetry as it is the only adj. used to qualify one\",\"end\":\"space\"},{\"n\":4,\"text\":\"of the several things stated in the sl. \u0935\u093f\u092d\u094d\u0930\u092e\u2014Sportive move-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"ments, amorous actions \u0905\u0938\u094d\u0925\u0948\u0930\u094d\u092f\u0947\u0923 \u0935\u093f\u092d\u0942\u0924\u092f\u0903\u2014affluence ( marred )\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"},{\"n\":8,\"text\":\"by inconstancy. \u0909\u092a\u0939\u0924\u093e\u0903\u2014\u0909\u092a\u0939\u0924\u093e v. l. does not make good sense.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit readings are indistinct.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl 34. \u0906\u0927\u093f\u2014mental torment, anxiety; \u0935\u094d\u092f\u093e\u0927\u093f\u2014bodily\",\"end\":\"space\"},{\"n\":2,\"text\":\"ailment, disease. \u0935\u093f\u0935\u0943\u0924\u0926\u094d\u0935\u093e\u0930\u093e\u0903\u2014may also be taken as \u0935\u093f\u0935\u0943\u0924\u0902 \u0926\u094d\u0935\u093e\u0930\u092e\u093e\u0938\u093e\u0902;\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 60 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"32\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"33\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"34\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
