{
 "regions": {
  "r3": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "मानय पूजय । अन्यथा महती हानिः स्यात् । उक्तं च । अपूज्या यत्र पूज्यन्ते",
     "end": "space"
    },
    {
     "n": 2,
     "text": "पूज्याश्चैवावमानिताः । अयशो महदाप्नोति धनाद्धर्माच्च हीयते ॥ प्रख्यापय प्रश्रय-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "मितिपाठे गुर्वादिषु नम्रत्वं प्रकटयेत्यर्थः । दुःखमस्य संजातमसौ दुःखितस्त-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "स्मिन् । तारकादित्वादितच् । शार्दूल० वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some readings in the first three lines are indistinct."
  },
  "r4": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "एवंविधाः सन्तो विरला इति निगमयति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "मनसि वचसि काये पुण्यपीयूषपूर्णा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "स्त्रिभुवनमुपकारश्रेणिभिः प्रीणयन्तः[१] ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "परगुणपरमाणून्पर्वतीकृत्य नित्यं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "निजहृदि विकसन्तः सन्ति सन्तः कियन्तः ॥ ७८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "पुण्यमेव पीयूषममृतं तेन पूर्णाः । पुण्यकर्माचरणनिरता इत्यर्थः । पीयूषम-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "मृतं सुधा । इत्यमरः । त्रयाणां भुवनानां समाहारः त्रिभुवनं लक्षणया तन्निवा-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "सिजनस्तम् । उपकारपरम्पराभिः सन्तोषयन्तः । परेषां गुणपरमाणूनल्पगुणा-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "नित्यर्थः । न पर्वताः अपर्वताः । अपर्वताः पर्वताः सम्पद्यन्ते तथा कृत्वा",
     "end": "space"
    },
    {
     "n": 5,
     "text": "पर्वतीकृत्य । अभूततद्भावे च्विः । उर्यादिच्विडाचश्च ( १-४-६१ ) इति",
     "end": "space"
    },
    {
     "n": 6,
     "text": "गतिसंज्ञायां कुगतिप्रादयः इति समासः । विकसन्तः सन्तुष्यन्तः । कियन्तः",
     "end": "space"
    },
    {
     "n": 7,
     "text": "कतिपये । विरला एवेत्यर्थः । मालिनी वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r7": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अथ मलयवर्णनेन महान्तः प्राकृतमप्युन्नतं पदं प्रापयन्तीत्याह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "किं तेन हेमगिरिणा रजताद्रिणा वा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "यत्राश्रिताश्च तरवस्तरवस्त एव ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "मन्यामहे मलयमेव यदाश्रयेण ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "कङ्कोलनिम्बकुटजा[२] अपि चन्दनानि ॥ ७९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "हेमगिरिर्मेरुस्तेन । रजताद्रिणा कैलासेन । वसन्ततिलका वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r10": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "रत्नैर्महार्है[३]स्तुतुषुर्न देवाः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "न भेजिरे भीमविषेण भीतिम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "सुधां विना न प्रययुर्विरामं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "न निश्चितार्थाद्विरमन्ति धीराः ॥ ८० ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r11": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ पूरयन्तः.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r12": {
