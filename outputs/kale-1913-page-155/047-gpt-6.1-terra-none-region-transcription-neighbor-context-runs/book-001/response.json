          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"existence, when shall we, loudly uttering the words \u201cS'iva,\",\"end\":\"space\"},{\"n\":2,\"text\":\"S'iva\u201d have our eyes flooded with copious tears proceeding\",\"end\":\"space\"},{\"n\":3,\"text\":\"from supreme bliss !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"87. Having given away every thing with a heart full of\",\"end\":\"space\"},{\"n\":2,\"text\":\"tender compassion, and remembering the courses of destiny\",\"end\":\"space\"},{\"n\":3,\"text\":\"having adverse ends in this wordly existence, (when) shall\",\"end\":\"space\"},{\"n\":4,\"text\":\"we pass, in a sacred forest, the nights lit with the rays of the\",\"end\":\"space\"},{\"n\":5,\"text\":\"full autumnal moon, the feet of Hara being the sole refuge\",\"end\":\"space\"},{\"n\":6,\"text\":\"of our mind !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"88. When shall I, wearing a small strip of cloth, and\",\"end\":\"space\"},{\"n\":2,\"text\":\"residing in V\u00e2r\u00e2nas\u00ee ( Benares ) on the bank of the river\",\"end\":\"space\"},{\"n\":3,\"text\":\"of gods pass my days like a moment crying out \u201c Have\",\"end\":\"space\"},{\"n\":4,\"text\":\"mercy, oh Lord of Gaur\u00ee, Destroyer of the Three Cities,\",\"end\":\"space\"},{\"n\":5,\"text\":\"oh S'ambhu, oh Three-eyed God,\u201d having placed on my\",\"end\":\"space\"},{\"n\":6,\"text\":\"head my folded palms !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"89. Having bathed in the waters of the Ganges, and\",\"end\":\"space\"},{\"n\":2,\"text\":\"worshipped Thee, O Lord, with fruits and flowers undefiled,\",\"end\":\"space\"},{\"n\":3,\"text\":\"and having fixed my attention, sitting on a stony couch in\",\"end\":\"space\"},{\"n\":4,\"text\":\"the gorge of a mountain, on thee, the object of contemplation,\",\"end\":\"space\"},{\"n\":5,\"text\":\"when shall I, O Enemy of Smara, be free by Thy grace,\",\"end\":\"space\"},{\"n\":6,\"text\":\"from the pain of serving a master having hands and feet\",\"end\":\"space\"},{\"n\":7,\"text\":\"just like myself, delightfully carrying out the words of the\",\"end\":\"space\"},{\"n\":8,\"text\":\"preceptor, living on fruits ( only ) and self-complacent.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"90. O S'ambhu, when shall I, living all alone, free from\",\"end\":\"space\"},{\"n\":2,\"text\":\"desire and peaceful, and having for my pot my hand ( only )\",\"end\":\"space\"},{\"n\":3,\"text\":\"and for my garments the quarters, be able to root out Karma?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"91. A certain path ( i. e. of Moksha ), easily attainable\",\"end\":\"space\"},{\"n\":2,\"text\":\"by the favour of Shiva, opens up for the yogins, who use the\",\"end\":\"space\"},{\"n\":3,\"text\":\"hand as a pot, who are contented with alms which are intrin-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"sically pure, who sit any where, who ever look upon the\",\"end\":\"space\"},{\"n\":5,\"text\":\"world as almost like grass and who have all acquired, even\",\"end\":\"space\"},{\"n\":6,\"text\":\"without casting off the body, the knowledge of the uninter-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"rupted and supreme delight ( of Brahman ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 42 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"