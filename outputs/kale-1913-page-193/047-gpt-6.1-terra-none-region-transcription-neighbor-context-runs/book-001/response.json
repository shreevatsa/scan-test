          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 66. \u092e\u0939\u093e\u0936\u0948\u0932 &c.\u2014\u0936\u093f\u0932\u093e\u0928\u093e\u0902 \u0938\u0902\u0918\u093e\u0924\u0903 \u0936\u093f\u0932\u093e\u0938\u0902\u0918\u093e\u0924\u0903 \u0964 \u092e\u0939\u093e\u0902\u0936\u094d\u091a\u093e\u0938\u094c \u0936\u0948\u0932\u0936\u094d\u091a\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u092e\u0939\u093e\u0936\u0948\u0932\u0903 \u0924\u0938\u094d\u092f \u0936\u093f\u0932\u093e\u0938\u0902\u0918\u093e\u0924\u0903 like a dense ( \u0938\u0902 ) line ( \u0918\u093e\u0924 ) of rocks\",\"end\":\"space\"},{\"n\":3,\"text\":\"&c. The fig. here is \u0909\u092a\u092e\u093e, \u0935\u0924\u094d the simile-expressing aff.\",\"end\":\"space\"},{\"n\":4,\"text\":\"being omitted in the compound \u0909\u0924\u094d\u092a\u0932\u0915\u094b\u092e\u0932\u092e\u094d. For a similar\",\"end\":\"space\"},{\"n\":5,\"text\":\"idea, see sl. 63.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit characters are blurred.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 67. \u0928\u093e\u092e\u093e\u092a\u093f \u0928 \u0936\u094d\u0930\u0942\u092f\u0924\u0947\u2014even its name is not heard i. e. no\",\"end\":\"space\"},{\"n\":2,\"text\":\"trace of it is left. \u091c\u094d\u091e\u093e\u092f\u0924\u0947 V. l. known i. e. through the medium\",\"end\":\"space\"},{\"n\":3,\"text\":\"of the ears. \u092e\u0941\u0915\u094d\u0924\u093e\u0915\u093e\u0930\u0924\u092f\u093e\u2014by reason of its assuming the form of\",\"end\":\"space\"},{\"n\":4,\"text\":\"a pearl. \u0938\u094d\u0935\u093e\u0924\u094d\u092f\u093e\u092e\u094d\u2013In Sw\u00e2ti i e. while the sun is in conjunction with\",\"end\":\"space\"},{\"n\":5,\"text\":\"the constellation Sv\u00e2ti. It is supposed that at the time of the sun\",\"end\":\"space\"},{\"n\":6,\"text\":\"coming in conjunction with this constellation the pearl-shells\",\"end\":\"space\"},{\"n\":7,\"text\":\"burst open and the rain-drops that they receive into their cavity\",\"end\":\"space\"},{\"n\":8,\"text\":\"form pearls; see B\u1e5bhatsanhit\u00e2 of Var\u00e2hamihira XV. 13. Cf.\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u092a\u093e\u0924\u094d\u0930\u0935\u093f\u0936\u0947\u0937\u0947 \u0928\u094d\u092f\u0938\u094d\u0924\u0902 \u0917\u0941\u0923\u093e\u0928\u094d\u0924\u0930\u0902 \u0935\u094d\u0930\u091c\u0924\u093f \u0936\u093f\u0932\u094d\u092a\u092e\u093e\u0927\u093e\u0924\u0941\u0903 \u0964 \u091c\u0932\u092e\u093f\u0935 \u0938\u092e\u0941\u0926\u094d\u0930\u0936\u0941\u0915\u094d\u0924\u094c \u092e\u0941\u0915\u094d\u0924\u093e\u092b\u0932\u0924\u093e\u0902\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u092a\u092f\u094b\u0926\u0938\u094d\u092f \u0965 M\u00e2l. I. 6. \u0938\u0928\u094d\u092e\u094c\u0915\u094d\u0924\u093f\u0915\u092e\u094d\u2014A good or faultless pearl. \u0938\u0924\u094d is\",\"end\":\"space\"},{\"n\":11,\"text\":\"evidently preferable to \u0924\u0924\u094d. \u091c\u093e\u092f\u0924\u0947\u2013Since this verb is repeated a\",\"end\":\"space\"},{\"n\":12,\"text\":\"strict rhetorician would detect in this \u0915\u0925\u093f\u0924\u092a\u0926\u0926\u094b\u0937 ( the fault of\",\"end\":\"space\"},{\"n\":13,\"text\":\"repeating a word with the same meaning ). The reading\u2014\u091c\u0941\u0937\u093e\u0902\",\"end\":\"space\"},{\"n\":14,\"text\":\"&c. is free from this fault. The fig. is \u0905\u0930\u094d\u0925\u093e\u0928\u094d\u0924\u0930\u0928\u094d\u092f\u093e\u0938.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Devanagari readings and the transliterated title are blurred.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 68. Some take \u090f\u0935 with \u092d\u0930\u094d\u0924\u0941\u0903, but that is not good; the\",\"end\":\"space\"},{\"n\":2,\"text\":\"construction should be \u092f\u0926\u094d\u092d\u0930\u094d\u0924\u0941\u0930\u094d\u0939\u093f\u0924\u092e\u0947\u0935\u0947\u091a\u094d\u091b\u0924\u093f \u0924\u0924\u094d\u0915\u0932\u0924\u094d\u0930\u092e\u094d\u2013meaning \u2018she\",\"end\":\"space\"},{\"n\":3,\"text\":\"that desires the good only of her husband deserves to be\",\"end\":\"space\"},{\"n\":4,\"text\":\"called \u2018wife.\u2019 \u0915\u0932\u0924\u094d\u0930\u092e\u094d Mark the gender of this word which is\",\"end\":\"space\"},{\"n\":5,\"text\":\"neu.; the gender of Sanskrit words in some cases is quite\",\"end\":\"space\"},{\"n\":6,\"text\":\"arbitrary as remarked by P\u00e2n.\u2013 \u0932\u093f\u0919\u094d\u0917\u092e\u0936\u093f\u0937\u094d\u092f\u0902 \u0932\u094b\u0915\u093e\u0936\u094d\u0930\u092f\u0924\u094d\u0935\u093e\u0932\u094d\u0932\u093f\u0919\u094d\u0917\u0938\u094d\u092f \u0964 Cf.\",\"end\":\"space\"},{\"n\":7,\"text\":\"the word \u0926\u093e\u0930 which is masc., and is always used in\",\"end\":\"space\"},{\"n\":8,\"text\":\"the plural. \u092a\u0941\u0923\u094d\u092f\u0915\u0943\u0924\u0903\u2014\u092a\u0941\u0923\u094d\u092f\u0902 \u0915\u0943\u0924\u0935\u093e\u0928\u094d \u092a\u0941\u0923\u094d\u092f\u0915\u0943\u0924\u094d. The aff. \u0915\u094d\u0935\u093f\u092a\u094d ( \u0966\u2013\u0924\u094d )\",\"end\":\"space\"},{\"n\":9,\"text\":\"is added to \u0915\u0943 after the words mentioned in the S\u00fbtra \u0938\u0941\u0915\u0930\u094d\u092e-\",\"end\":\"hyphen\"},{\"n\":10,\"text\":\"\u092a\u093e\u092a\u092e\u0928\u094d\u0924\u094d\u0930\u092a\u0941\u0923\u094d\u092f\u0947\u0937\u0941 \u0915\u0943\u091e\u0903 \u0964 P\u00e2n. III. 2. 89.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some of the small Sanskrit text is blurred.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 69. \u0928\u092e\u094d\u0930\u0924\u094d\u0935\u0947\u0928\u094b\u0928\u094d\u0928\u092e\u0928\u094d\u0924\u0903\u2014rising to greatness by humility. \u0916\u094d\u092f\u093e-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u092a\u092f\u0928\u094d\u0924\u0903\u2014pres. p. of the causal of \u0916\u094d\u092f\u093e. Their appreciation of other\",\"end\":\"space\"},{\"n\":3,\"text\":\"people\u2019s merits is in itself a sign of their possessing merits.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0935\u093f\u0924\u0924\u0966\u2014\u0926\u0942\u0937\u092f\u0928\u094d\u0924\u0903\u2014rebuking. Contemptuous silence is the best\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit words are somewhat blurred.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 28 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"66\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"67\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"68\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"69\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
