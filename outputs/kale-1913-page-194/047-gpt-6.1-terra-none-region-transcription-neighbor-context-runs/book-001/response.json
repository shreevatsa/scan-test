          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"treatment of a calumniator. \u0938\u093e\u0936\u094d\u091a\u0930\u094d\u092f\u091a\u0930\u094d\u092f\u093e\u0903\u2014\u0906\u0936\u094d\u091a\u0930\u094d\u092f\u0938\u0939\u093f\u0924\u093e admirable,\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u091a\u0930\u094d\u092f\u093e ( \u091a\u0930\u093f\u0924\u092e\u094d ) \u092f\u0947\u0937\u093e\u0902 \u0924\u0947. The fig. here is \u0935\u093f\u0930\u094b\u0927\u093e\u092d\u093e\u0938.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 70. \u092d\u0942\u0930\u093f\u0935\u093f\u0932\u092e\u094d\u092c\u093f\u0928\u0903\u2014hanging very low. This reading is\",\"end\":\"space\"},{\"n\":2,\"text\":\"preferable to \u092d\u0942\u092e\u093f\u0966 as the point here is \u0928\u092e\u094d\u0930\u0924\u094d\u0935. \u0905\u0928\u0941\u0926\u094d\u0927\u0924\u093e\u0903\u2014Not\",\"end\":\"space\"},{\"n\":3,\"text\":\"haughty. \u0938\u092e\u0943\u0926\u094d\u0927\u093f\u092d\u093f\u0903\u2014with the acquisition of wealth. This sl.\",\"end\":\"space\"},{\"n\":4,\"text\":\"occurs in the S'\u00e2k. Act. V. The figures in this sl. according\",\"end\":\"space\"},{\"n\":5,\"text\":\"to R\u00e2ghavabhatta are \u0915\u094d\u0930\u093f\u092f\u093e\u0926\u0940\u092a\u0915. \u092e\u093e\u0932\u093e\u092a\u094d\u0930\u0924\u093f\u0935\u0938\u094d\u0924\u0942\u092a\u092e\u093e ( \u0935\u093f\u0928\u092f\u0938\u094d\u092f \u0938\u093e\u0927\u093e-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\u0930\u0923\u0927\u0930\u094d\u092e\u0938\u094d\u092f \u0928\u092e\u094d\u0930\u0926\u094d\u0930\u0941\u092e\u0935\u093f\u0932\u092e\u094d\u092c\u094d\u092f\u0928\u0941\u0926\u094d\u0927\u0924\u0936\u092c\u094d\u0926\u0947\u0928\u094b\u0915\u094d\u0924\u0947\u0903 ), \u0905\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924\u092a\u094d\u0930\u0936\u0902\u0938\u093e and \u0905\u0930\u094d\u0925\u093e\u0928\u094d\u0924\u0930\u0928\u094d\u092f\u093e\u0938\",\"end\":\"space\"},{\"n\":7,\"text\":\"( \u0938\u094d\u0935\u092d\u093e\u0935 \u0907\u0924\u094d\u092f\u093e\u0926\u093f\u0938\u094d\u0924\u0941 \u0939\u093f \u0936\u092c\u094d\u0926\u093e\u0926\u0941\u092a\u093e\u0926\u093e\u0928\u093e\u0926\u0930\u094d\u0925\u093e\u0928\u094d\u0924\u0930\u0928\u094d\u092f\u093e\u0938\u0903 ).\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit compounds in the final three lines are difficult to read.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 71. Cf. sl, 65. supra. The fig. here is \u092a\u0930\u093f\u0938\u0902\u0916\u094d\u092f\u093e as the\",\"end\":\"space\"},{\"n\":2,\"text\":\"S'\u00e2stras &c. are specially mentioned as imparting beauty to\",\"end\":\"space\"},{\"n\":3,\"text\":\"the ear &c. to the exclusion of the ear-ornaments &c. It is\",\"end\":\"space\"},{\"n\":4,\"text\":\"thus defined\u2013\u0915\u093f\u0902\u091a\u093f\u0924\u094d\u092a\u0943\u0937\u094d\u091f\u092e\u092a\u0943\u0937\u094d\u091f\u0902 \u0935\u093e \u0915\u0925\u093f\u0924\u0902 \u092f\u0924\u094d\u0930 \u0915\u0932\u094d\u092a\u0924\u0947 \u0964 \u0924\u093e\u0926\u0943\u0917\u0928\u094d\u092f\u0935\u094d\u092f\u092a\u094b\u0939\u093e\u092f\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u092a\u0930\u093f\u0938\u0902\u0916\u094d\u092f\u093e \u0924\u0941 \u0938\u093e \u0938\u094d\u092e\u0943\u0924\u093e \u0965 K. P. X.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit definition is not entirely clear.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 72. \u092a\u093e\u092a\u093e\u0924\u094d\u2014That from which a person is warded off is put\",\"end\":\"space\"},{\"n\":2,\"text\":\"in the abl. case; see. com. \u0939\u093f\u0924\u093e\u092f \u092f\u094b\u091c\u092f\u0924\u0947\u2014may mean ( 1 ) \u0939\u093f\u0924\u0902\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0938\u093e\u0927\u092f\u093f\u0924\u0941\u0902 ( \u0939\u093f\u0924\u0915\u0930\u0947 \u0915\u0930\u094d\u092e\u0923\u093f ) \u092e\u093f\u0924\u094d\u0930\u0902 \u092a\u094d\u0930\u0935\u0930\u094d\u0924\u092f\u0924\u093f urges ( his friend ) to apply\",\"end\":\"space\"},{\"n\":4,\"text\":\"himself to a work beneficial to him; or ( 2 ) \u0906\u0924\u094d\u092e\u093e\u0928\u0902 \u092f\u094b\u091c\u092f\u0924\u0947\u2014sets\",\"end\":\"space\"},{\"n\":5,\"text\":\"himself about the accomplishment of his friend's good. The dat.\",\"end\":\"space\"},{\"n\":6,\"text\":\"is to be explained by \u2018 \u0915\u094d\u0930\u093f\u092f\u093e\u0930\u094d\u0925\u094b\u092a\u092a\u0926\u0938\u094d\u092f \u091a \u0915\u0930\u094d\u092e\u0923\u093f \u0938\u094d\u0925\u093e\u0928\u093f\u0928\u0903\u2019 P\u00e2n. II.\",\"end\":\"space\"},{\"n\":7,\"text\":\"3. 14. When an infinitive of purpose is not actually used in a\",\"end\":\"space\"},{\"n\":8,\"text\":\"sentence its object is put in the dat. case; \u092b\u0932\u0947\u092d\u094d\u092f\u094b \u092f\u093e\u0924\u093f, \u092b\u0932\u093e\u0928\u094d\u092f\u093e\u0939\u0930\u094d\u0924\u0941\u0902\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u092f\u093e\u0924\u0940\u0924\u094d\u092f\u0930\u094d\u0925\u0903 Sid. Kau.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 73 \u0935\u093f\u0915\u091a\u0940\u0915\u0930\u094b\u0924\u093f\u2014causes to bloom, opens. A denom. verb\",\"end\":\"space\"},{\"n\":2,\"text\":\"derived from \u0935\u093f\u0915\u091a with the aff \u091a\u094d\u0935\u093f ( \u0966 ). \u0935\u093f\u0915\u091a\u2013\u0935\u093f\u0917\u0924\u0903 \u0915\u091a\u0903\",\"end\":\"space\"},{\"n\":3,\"text\":\"( fold ) \u0905\u0938\u094d\u092e\u093e\u0924\u094d; full blown or expanded. \u0915\u0948\u0930\u0935\u2013a white lotus. Like\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0915\u0941\u092e\u0941\u0926 it is a lotus blooming at moon-rise. \u091a\u0915\u094d\u0930\u0935\u093e\u0932\u2014a collection of;\",\"end\":\"space\"},{\"n\":5,\"text\":\"properly a circle of; \u091a\u0915\u094d\u0930\u0935\u093e\u0932\u0902 \u0924\u0941 \u092e\u0923\u094d\u0921\u0932\u092e\u094d \u0964 Amara. \u0928\u093e\u092d\u094d\u092f\u0930\u094d\u0925\u093f\u0924\u0903 to be\",\"end\":\"space\"},{\"n\":6,\"text\":\"taken with all the three\u2014\u0926\u093f\u0928\u0915\u0930, \u091a\u0928\u094d\u0926\u094d\u0930 and \u091c\u0932\u0927\u0930. \u0905\u092d\u093f\u092f\u094b\u0917\u2014\",\"end\":\"space\"},{\"n\":7,\"text\":\"application, resolutely setting oneself about. Fig Arth\u00e2ntarany\u00e2sa.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 74. \u090f\u0924\u0947\u2014Mr. Telang reads \u090f\u0915\u0947 \u2018some\u2019. \u0924\u0947 \u090f\u0924\u0947, however,\",\"end\":\"space\"},{\"n\":2,\"text\":\"serves as a better correlative of \u092f\u0947 and gives proper force to the\",\"end\":\"space\"},{\"n\":3,\"text\":\"main assertion. \u0918\u091f\u0915\u093e\u0903\u2014who bring about, accomplish. \u0909\u0926\u094d\u092f\u092e\u092d\u0943\u0924\u0903\u2014\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 29 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"70\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"71\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"72\",\"label\":null,\"open_start\":false,\"open_end\":f