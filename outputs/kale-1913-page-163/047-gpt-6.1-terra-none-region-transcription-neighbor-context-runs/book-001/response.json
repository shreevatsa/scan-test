          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"earth. Oh heart, you suffer torment day and night by the\",\"end\":\"space\"},{\"n\":2,\"text\":\"false pride of being good.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"28. My mind desires to go to S'ankara, its scruples in\",\"end\":\"space\"},{\"n\":2,\"text\":\"the investigation of Scriptural meaning being completely\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"set at rest, its delight in poetry full of various sentiments\",\"end\":\"space\"},{\"n\":5,\"text\":\"being turned away, and all the different wild doubts ( lit.\",\"end\":\"space\"},{\"n\":6,\"text\":\"expanse of doubts ) being totally dispelled.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"29. What if ( you have ) excellent rice, or a coarse meal\",\"end\":\"space\"},{\"n\":2,\"text\":\"at the close of the day? What if ( you have ) a strip of\",\"end\":\"space\"},{\"n\":3,\"text\":\"cloth or a long white garment? What if ( you have ) one\",\"end\":\"space\"},{\"n\":4,\"text\":\"wife, or a number of them endowed with hundred qualities ?\",\"end\":\"space\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"And what if you wander all alone, or are surrounded by\",\"end\":\"space\"},{\"n\":7,\"text\":\"hundreds of elephants and horses ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"30. Charity is a cow that yields all desires; a wallet\",\"end\":\"space\"},{\"n\":2,\"text\":\"protects from cold: (my) devotion to S'iva is firm; what then\",\"end\":\"space\"},{\"n\":3,\"text\":\"is the use of riches ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"31. An ascetic, though he has abandoned all desires, lies\",\"end\":\"space\"},{\"n\":2,\"text\":\"down on the ground like a king, having the earth for his\",\"end\":\"space\"},{\"n\":3,\"text\":\"couch, his creeper-like arm for a pillow, the sky for a canopy\",\"end\":\"space\"},{\"n\":4,\"text\":\"and the moon for his lamp, experiencing pleasure in his\",\"end\":\"space\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"union with the woman called Renunciation, and fanned from\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"},{\"n\":8,\"text\":\"all sides by the attendant maids\u2014the quarters, with their\",\"end\":\"space\"},{\"n\":9,\"text\":\"chauries\u2014the winds.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"32. Tell me, oh deer, where you performed penance\",\"end\":\"space\"},{\"n\":2,\"text\":\"and of what name, that ( by virtue of it ) you have never to\",\"end\":\"space\"},{\"n\":3,\"text\":\"see the face of the rich or to tell lying flatteries, you do not\",\"end\":\"space\"},{\"n\":4,\"text\":\"hear their haughty words, nor run to them with some expec-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"tation, but you eat tender grass when it is time (to eat)\",\"end\":\"space\"},{\"n\":6,\"text\":\"and lie down at ease when sleep comes ( to your eyes).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"33. Oh brute, how many times and what preparations of\",\"end\":\"space\"},{\"n\":2,\"text\":\"yours, desirous of drinking of the water of the ocean of\",\"end\":\"space\"},{\"n\":3,\"text\":\"mirage in the form of wealth, have not been baffled ? (Very\",\"end\":\"space\"},{\"n\":4,\"text\":\"often they have). Yet your hope is not dispelled; your\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 50 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"27\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"28\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"29\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"30\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"31\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"32\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"33\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
