      "content": [
        {
          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 86. \u0938\u093e\u0927\u0941 &c.\u2014The word \u0935\u0943\u0924\u094d\u0924 has a double application\",\"end\":\"space\"},{\"n\":2,\"text\":\"here; as applied to the ball \u0938\u093e\u0927\u0941\u0935\u0943\u0924\u094d\u0924 means ( \u0938\u093e\u0927\u0941 \u092f\u0925\u093e \u0924\u0925\u093e \u0935\u0943\u0924\u094d\u0924\u0903 )\",\"end\":\"space\"},{\"n\":3,\"text\":\"well-rounded, perfectly spherical; in the other case it means \u2018of\",\"end\":\"space\"},{\"n\":4,\"text\":\"virtuous conduct, whose course of actions is well-regulated.\u2019 Cf.\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u2018\u0935\u0943\u0924\u094d\u0924\u0947 \u0938\u094d\u0925\u093f\u0924\u0938\u094d\u092f\u093e\u0927\u093f\u092a\u0924\u0947\u0903 \u092a\u094d\u0930\u091c\u093e\u0928\u093e\u092e\u094d Rag. V. 33.\u2019 \u0905\u0938\u094d\u0925\u093e\u092f\u093f\u0928\u094d\u092f\u0903\u2014not abiding,\",\"end\":\"space\"},{\"n\":6,\"text\":\"short-lived. The Fig.s are \u0905\u0930\u094d\u0925\u093e\u0928\u094d\u0924\u0930\u0928\u094d\u092f\u093e\u0938 and \u0936\u094d\u0932\u0947\u0937.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit characters and punctuation are indistinct.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 87. \u0936\u0943\u0919\u094d\u0917.\u2014The top or peak of a mountain. \u0917\u0941\u0930\u0941\u2014great,\",\"end\":\"space\"},{\"n\":2,\"text\":\"stupendous. \u0935\u093f\u0937\u092e\u2014\u0935\u093f\u0917\u0924\u0902 \u0935\u093f\u0930\u0941\u0926\u094d\u0927\u0902 \u0935\u093e \u0938\u092e\u092e\u094d; lit. uneven surface; \u0928 \u0915\u0943\u0924\u0903\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0936\u0940\u0932\u0935\u093f\u0932\u092f\u0903\u2014i. e. one should value character above every thing\",\"end\":\"space\"},{\"n\":4,\"text\":\"else. Cf. \u092e\u0928\u0938\u094d\u0935\u0940 \u092e\u094d\u0930\u093f\u092f\u0924\u0947 \u0915\u093e\u092e\u0902 \u0915\u093e\u0930\u094d\u092a\u0923\u094d\u092f\u0902 \u0928 \u0924\u0941 \u0917\u091a\u094d\u091b\u0924\u093f.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit characters are indistinct, particularly at the line break.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 88. \u0924\u0938\u094d\u092f \u091c\u0932\u093e\u092f\u0924\u0947\u2014\u0924\u0938\u094d\u092f towards him; in his case. \u091c\u0932\u093e\u092f\u0924\u0947\",\"end\":\"space\"},{\"n\":2,\"text\":\"&c. are denominative verbs, formed by adding \u092f in the sense of\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u2018acts like that;\u2019 see com; and are conjugated in the \u0100tmane-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"pada. \u0915\u0941\u0932\u094d\u092f\u093e\u092f\u0924\u0947\u2014acts like a canal. i. e. assumes the narrowness of\",\"end\":\"space\"},{\"n\":5,\"text\":\"a canal. \u0915\u0941\u0930\u0919\u094d\u0917\u093e\u092f\u0924\u0947\u2014becomes tame like a deer. \u092e\u093e\u0932\u094d\u092f\u0917\u0941\u0923\u2014a wreath\",\"end\":\"space\"},{\"n\":6,\"text\":\"of flowers, a garland. \u092a\u0940\u092f\u0942\u0937\u0935\u0930\u094d\u0937\u093e\u092f\u0924\u0947\u2014produces the effects of a\",\"end\":\"space\"},{\"n\":7,\"text\":\"shower of nectar.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit terms and the diacritic on \u0100tmane- are somewhat indistinct.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 89. \u0909\u092a\u091a\u0940\u092f\u0924\u0947\u2014increases, waxes. The root \u091a\u093f with \u0909\u092a,\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"pass. means to grow in bulk, to thrive, as \u0905\u092a\u093e\u091a means to\",\"end\":\"space\"},{\"n\":4,\"text\":\"decrease in bulk. \u0938\u0928\u094d\u0924\u092a\u094d\u092f\u0928\u094d\u0924\u0947\u2014are not grieved. \u0935\u093f\u0927\u0941\u0924\u093e\u0903\u2014over-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"powered by difficulties. \u0928 \u0924\u0947 \u0935\u093f\u092a\u0926\u093e\u2014is a better reading being\",\"end\":\"space\"},{\"n\":6,\"text\":\"easier.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit readings are indistinct.\"},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 90. \u0928\u0947\u0924\u093e\u2014guide, adviser. Cf. \u0905\u092e\u093e\u0924\u094d\u092f\u0947 \u0928\u0947\u0924\u0930\u093f \u0938\u0941\u0932\u092d\u092e\u0947\u0924\u0924\u094d\u0915\u0941\u092e\u093e\u0930\u0938\u094d\u092f\",\"end\":\"space\"},{\"n\":2,\"text\":\"Mud. II. \u092c\u0943\u0939\u0938\u094d\u092a\u0924\u093f\u2014The spiritual adviser and counsellor of Indra.\",\"end\":\"space\"},{\"n\":3,\"text\":\"For derivation see sl. 34. \u0905\u0928\u0941\u0917\u094d\u0930\u0939\u0903 \u0915\u093f\u0932 \u0939\u0930\u0947\u0903\u2014who, as is well known,\",\"end\":\"space\"},{\"n\":4,\"text\":\"( \u0915\u093f\u0932 ) enjoys the favour of Hari. \u0910\u0930\u093e\u0935\u0924\u0903\u2014\u0907\u0930\u094d \u0906\u092a\u0903 \u0938\u0928\u094d\u0924\u094d\u092f\u0938\u094d\u092e\u093f\u0928\u094d\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0907\u0930\u093e\u0935\u093e\u0928\u094d \u0924\u0924\u094d\u0930 \u092d\u0935\u0903 (\u0905\u0923\u094d ); lit. sprung from water. The name of\",\"end\":\"space\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"Indra\u2019s elephant obtained at the churning of the milky ocean.\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0910\u0936\u094d\u0935\u0930\u094d\u092f\u092c\u0932\u0902\u2014may be taken as a Tat. or a Dwandwa. The latter\",\"end\":\"space\"},{\"n\":9,\"text\":\"is preferable. \u0910\u0936\u094d\u0935\u0930\u094d\u092f\u0902\u2014means here the accompaniments of royalty.\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u092d\u0917\u094d\u0928\u0903 had to yield, was routed. \u0926\u0948\u0935\u0936\u0930\u0923\u092e\u094d v. l.\u2014A poetical license.\",\"end\":\"space\"},{\"n\":11,\"text\":\"The poet\u2019s meaning is \u0926\u0948\u0935\u0902 \u0936\u0930\u0923\u0902 ( \u0930\u0915\u094d\u0937\u093f\u0924\u093e ) \u092f\u0924\u094d, and so the two\",\"end\":\"space\"},{\"n\":12,\"text\":\"words can not be compounded. As it stands we may explain\",\"end\":\"space\"},{\"n\":13,\"text\":\"\u0926\u0948\u0935\u0902 \u0936\u0930\u0923\u0902 \u0926\u0948\u0935\u0936\u0930\u0923\u092e\u094d \u0964 \u0927\u093f\u0915\u094d \u0927\u093f\u0915\u094d &c.\u2014This may be taken in two\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words and the grammatical explanation are difficult to read.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"(33.)\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"other\",\"lines\":[{\"n\":1,\"text\":\"3\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"86\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"87\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"88\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"89\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"90\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]},{\"flow\":\"notes\",\"units\":[]}],\"relations\":[]}"
        }
