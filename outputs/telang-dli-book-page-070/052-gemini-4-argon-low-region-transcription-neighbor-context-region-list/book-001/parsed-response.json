{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अनुद्धताः सत्पुरुषाः समृद्धिभिः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "",
     "end": "join"
    },
    {
     "n": 3,
     "text": "",
     "end": "join"
    },
    {
     "n": 4,
     "text": "स्वभाव एवैष परोपकारिणाम् ॥ ७० ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "श्रोत्रं श्रुतेनैव न कुण्डलेन",
     "end": "line"
    },
    {
     "n": 2,
     "text": "दानेन पाणिर्न तु कङ्कणेन ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "विभाति कायः करुणापराणां",
     "end": "line"
    },
    {
     "n": 4,
     "text": "परोपकारैर्न तु चन्देनन ॥ ७१ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "पापान्निवारयति योजयते हिताय",
     "end": "line"
    },
    {
     "n": 2,
     "text": "गुह्यं च गूहति गुणान्प्रकटीकरोति ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "आपद्गतं च न जहाति ददाति काले",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सन्मित्रलक्षणमिदं प्रवदन्ति सन्तः ॥ ७२ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "पद्माकरं दिनकरो विकचीकरोति",
     "end": "line"
    },
    {
     "n": 2,
     "text": "चन्द्रो विकाशयति कैरवचक्रवालम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "नाभ्यर्थितो जलधरोपि जलं ददाति",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सन्तः स्वयं परहितेषु कृताभियोगाः ॥ ७३ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
