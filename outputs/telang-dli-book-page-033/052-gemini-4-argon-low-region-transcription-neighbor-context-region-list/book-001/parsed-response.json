   "type": "corrigendum",
   "lines": [
    {
     "n": 1,
     "text": "P. 31. ( „ ) St. 2. for °खस्यै etc. read °खोसौ बतात्यर्थम् ; in note",
     "end": "space"
    },
    {
     "n": 2,
     "text": "delete श्रवण etc. to ला, substitute श्रवणसुखस्यैवतात्पर्यम्",
     "end": "space"
    },
    {
     "n": 3,
     "text": "K.—and after D. add °तात्य° ; °लात्य.° M.",
     "end": "space"
    }
