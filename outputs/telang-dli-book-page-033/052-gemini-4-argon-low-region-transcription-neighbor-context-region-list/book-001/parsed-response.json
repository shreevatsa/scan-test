     "text": "°न्समना noted in R. ; line 6 from bottom after (b)",
     "end": "space"
    },
    {
     "n": 3,
     "text": "add त्यक्त्वा ; कृत्वा M. ; line 3 from bottom at the",
     "end": "space"
    },
    {
     "n": 4,
     "text": "end add °हा° ; °दा° M.",
