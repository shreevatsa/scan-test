          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"like \u0935\u093e in \u092e\u0943\u0924\u0903 \u0915\u094b N\u2019i. S\u2019a. 32. Cf. \u092a\u0930\u0948\u0938\u094d\u0924\u0926\u0928\u094d\u092f\u0903 \u0915 \u0907\u0935\u093e\u092a\u0939\u093e\u0930\u092f\u0947\u0924\u094d &c. Kir.\",\"end\":\"space\"},{\"n\":2,\"text\":\"I. 31. or \u0915\u0907\u0935\u2014what sort of. ( what reason have they for )\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0915\u094d\u0937\u094b\u0923\u093f \u092a\u0924\u092f\u0903\u2014the loc. is noteworthy; see P\u00e0n. II. 3. 30. \u0935\u093f\u0937\u093e\u0926\u0947\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0915\u0930\u094d\u0924\u0935\u094d\u092f\u0947-Mr. Telang here remarks\u2014\u2018for having so little\u2019 they\",\"end\":\"space\"},{\"n\":5,\"text\":\"should have grieved; but it would be better to suppose that\",\"end\":\"space\"},{\"n\":6,\"text\":\"they should have chiefly grieved for being the lords of \u092d\u0941\u0915\u094d\u0924\u094b-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"\u091c\u094d\u091d\u093f\u0924\u093e \u092a\u0943\u0925\u094d\u0935\u0940.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words are difficult to distinguish in the scan.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 60. \u092e\u0943\u0926\u094d\u092a\u093f\u0923\u094d\u0921\u0903 &c.\u2014The whole earth is a ball of clay\",\"end\":\"space\"},{\"n\":2,\"text\":\"encircled by the line of water (sea); it is indeed, very small, and\",\"end\":\"space\"},{\"n\":3,\"text\":\"is parcelled out among themselves by a number of kings after\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"hundreds of fights. These petty chiefs are poor and mean-minded.\",\"end\":\"space\"},{\"n\":6,\"text\":\"The poet, therefore, despises those that wish to get something\",\"end\":\"space\"},{\"n\":7,\"text\":\"out of them. \u0938\u094d\u0935\u093e\u0902\u0936\u0940\u0915\u0943\u0924\u094d\u092f is preferable to \u092d\u093e\u0917\u0940\u0915\u0943\u0924\u094d\u092f-which simply\",\"end\":\"space\"},{\"n\":8,\"text\":\"means \u2018having divided.\u2019\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit readings are not entirely clear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 61. \u0915\u094b\u093d\u092a\u093f\u2014indescribable, unnamable. \u0938 \u091c\u093e\u0924\u0903 \u0906\u0938\u0940\u0924\u094d\u2014\",\"end\":\"space\"},{\"n\":2,\"text\":\"he alone was born; he alone deserves to be counted as having\",\"end\":\"space\"},{\"n\":3,\"text\":\"been born, the birth of others is as good as nothing. \u0909\u091a\u094d\u091a\u0948\u0903\u2014on\",\"end\":\"space\"},{\"n\":4,\"text\":\"high; or so as to give it high honour. \u0905\u0932\u0902\u0915\u093e\u0930\u0935\u093f\u0927\u092f\u0947\u2014for the\",\"end\":\"space\"},{\"n\":5,\"text\":\"purpose of decoration, as a decoration or ornament. It is well-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"known that S\u2019iva decorates himself with a string of the skulls\",\"end\":\"space\"},{\"n\":7,\"text\":\"of those who fall on the battle-field &c; comp. \u0915\u092a\u093e\u0932\u0940 \u0935\u093e \u0938\u094d\u092f\u093e\u0926\u0925\u0935\u0947-\",\"end\":\"hyphen\"},{\"n\":8,\"text\":\"\u0928\u094d\u0926\u0941\u0936\u0947\u0916\u0930\u092e\u094d \u0964 Kum. V. 78. That deity does not, however, give\",\"end\":\"space\"},{\"n\":9,\"text\":\"preference to one skull in particular, nor does he wear it on his\",\"end\":\"space\"},{\"n\":10,\"text\":\"head, as the poet seems to imply. \u092a\u094d\u0930\u0935\u0923 derived from \u092a\u094d\u0930\u0941 1 A. to go\",\"end\":\"space\"},{\"n\":11,\"text\":\"+\u0932\u094d\u092f\u0941\u091f\u094d ( \u0905\u0928 ) \u092a\u094d\u0930\u0935\u0928\u094d\u0924\u0947 \u0905\u0928\u0947\u0928 \u0905\u0924\u094d\u0930 \u0935\u093e sloping ( \u092a\u094d\u0930\u0935\u0923\u0903 \u0915\u094d\u0930\u092e\u0928\u093f\u092e\u094d\u0928\u094b\u093d\u0925 \u092a\u094d\u0930\u0939\u094d\u0935\u0947 \u0928\u093e\",\"end\":\"join\"},{\"n\":12,\"text\":\"\u092a\u0941\u0902 \u091a\u0924\u0941\u0937\u094d\u092a\u0925\u0947 \u0964 Amara; ), inclined, disposed; \u0928\u0943\u092d\u093f\u0903 \u0928\u092e\u0926\u094d\u092d\u093f\u0903\u2014instr.\",\"end\":\"space\"},{\"n\":13,\"text\":\"absolute, same as the loc. absolute, \u0928\u0943\u0937\u0941 \u0928\u092e\u0924\u094d\u0938\u0941 \u0938\u0924\u094d\u0938\u0941 or the inst.\",\"end\":\"space\"},{\"n\":14,\"text\":\"may be \u0939\u0947\u0924\u094c ( the whole being equivalent to \u0928\u0943\u0923\u093e\u0902 \u0928\u092e\u0928\u0947\u0903 as Mr.\",\"end\":\"space\"},{\"n\":15,\"text\":\"Telang has it. ) \u0926\u0930\u094d\u092a\u091c\u094d\u0935\u0930\u092d\u0930\u0903\u2014excess of feverish or morbid pride.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit quotations and grammatical forms are difficult to read.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 62. \u092a\u094d\u0930\u0938\u093e\u0926\u0902 \u0928\u0947\u0924\u0941\u092e\u094d-to propitiate. \u0915\u094d\u0932\u0947\u0936\u0915\u0932\u093f\u0932\u092e\u094d\u2014The confused\",\"end\":\"space\"},{\"n\":2,\"text\":\"mass of misery. Cf. \u092e\u094b\u0939\u0915\u0932\u093f\u0932\u092e\u094d Bhg. XI. 52, \u0915\u0932\u0924\u0947 \u0915\u0932\u094d\u092f\u0924\u0947 \u0935\u093e;\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0915\u0932\u094d+\u0907\u0932 ( \u091a\u094d ); Un 1 54. \u0915\u0932\u093f\u0932\u0902 \u0917\u0939\u0928\u0902 \u0938\u092e\u0947 \u0964 Amara. Mr. Telang\",\"end\":\"space\"},{\"n\":4,\"text\":\"reads \u0915\u0932\u093f\u0924\u092e\u094d. He says \u2018\u0915\u0932\u093f\u0924\u0902 might mean \u092c\u0928\u094d\u0927\u0928 but this re-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"quires a straining\u2019. \u0938\u094d\u0935\u092f\u092e\u0941\u0926\u093f\u0924 &c.\u2014\u091a\u093f\u0928\u094d\u0924\u093e\u092e\u0923\u093f is a jewel the\",\"end\":\"space\"},{\"n\":6,\"text\":\"possession of which is believed to give any desired objects.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit derivation and quotation are difficult to read.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 68 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"60\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"61\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"62\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
