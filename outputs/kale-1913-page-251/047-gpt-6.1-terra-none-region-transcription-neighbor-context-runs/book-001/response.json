          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"blandishments and sportive gestures.; \u0938\u0941\u092d\u0917\u0902\u2014such a man falls a\",\"end\":\"space\"},{\"n\":2,\"text\":\"ready victim to their charms. \u0935\u093e\u092e\u0928\u092f\u0928\u093e-mark the pun on \u0935\u093e\u092e\",\"end\":\"space\"},{\"n\":3,\"text\":\"which means (1) beautiful; (2) crooked, destructive.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The first Sanskrit word is indistinct.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 35. \u0916\u0930\u2014rough. The moral is-Magnanimous persons\",\"end\":\"space\"},{\"n\":2,\"text\":\"never become slaves of passions.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 36. \u0939\u0928\u094d\u0924\u2014a particle expressive of joy. \u0939\u0930\u093f\u0923\u0948\u0903 \u092a\u0930\u093f\u091a\u092f\u0903\u2014a\",\"end\":\"space\"},{\"n\":2,\"text\":\"favourite idea with the poet and referred to in many places.\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0907\u0924\u093f\u2014Cf. supra sl. 27. \u0939\u0930\u0935\u093e\u0915\u094d\u092f\u0938\u094d\u092e\u0943\u0924\u0947\u0930\u0940\u092a\u094d\u0938\u093f\u0924\u0903 P\u00e2n. \u0908\u092a\u094d\u0938\u093f\u0924\u092e\u093e\u0924\u094d\u0930\u0947 \u0939\u094d\u092f\u0902\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0938\u0902\u091c\u094d\u091e\u093e \u0964 \u092a\u094d\u0930\u0915\u0930\u094d\u0937\u0935\u093f\u0935\u0915\u094d\u0937\u093e\u092f\u093e\u0902 \u0924\u0941 \u092a\u0930\u0924\u094d\u0935\u093e\u0924\u094d\u0915\u0930\u094d\u092e\u0938\u0902\u091c\u094d\u091e\u093e \u0964 \u092a\u0941\u0937\u094d\u092a\u093e\u0923\u093f \u0938\u094d\u092a\u0943\u0939\u092f\u0924\u093f \u0964 Sid. Kau.\u2014\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0909\u092a\u0936\u093e\u0928\u094d\u0924\u091a\u0947\u0924\u0903 whose minds are set on tranquillity alone ( i. e. who\",\"end\":\"space\"},{\"n\":6,\"text\":\"are self-restrained. )\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit grammatical quotations are indistinct.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 37. \u0938\u094d\u0935\u093e\u0926\u093f\u0937\u094d\u0920\u2014is superlative. Its use with the ablative is\",\"end\":\"space\"},{\"n\":2,\"text\":\"unusual. Construe\u2014\u0926\u0948\u0935\u0940 \u0935\u093e\u0915\u094d \u0930\u0938\u0935\u0924\u0903 \u0905\u092e\u0943\u0924\u093e\u0924\u094d\u092e\u0928\u0903 \u092f\u0924\u094d \u092e\u0927\u0941\u0928\u0903 \u0918\u0943\u0924\u093e\u091a\u094d\u091a\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0938\u094d\u0935\u093e\u0926\u093f\u0937\u094d\u0920\u0902 \u0930\u0938\u0935\u0924\u094d \u0905\u0915\u094d\u0937\u0930\u0902 \u092a\u094d\u0930\u0938\u0935\u0924\u093f \u0924\u0947\u0928 &c. \u0926\u0948\u0935\u0940 \u0935\u093e\u0915\u094d\u2014The Veda, especially\",\"end\":\"space\"},{\"n\":4,\"text\":\"the Upanishads which are chiefly concerned with Brahma. No\",\"end\":\"space\"},{\"n\":5,\"text\":\"earthly enjoyments give that pleasure to a Yogin which the\",\"end\":\"space\"},{\"n\":6,\"text\":\"teaching of the Upanishads does. \u0905\u092e\u0943\u0924\u093e may also be taken\",\"end\":\"space\"},{\"n\":7,\"text\":\"separately. The vedas are eternal. \u0927\u0943\u0924\u093f-support, sustenance. There\",\"end\":\"space\"},{\"n\":8,\"text\":\"may also be here a reference to the divine speech of the poet\",\"end\":\"space\"},{\"n\":9,\"text\":\"whose substratum is Rasa sending forth an immortal creation\",\"end\":\"space\"},{\"n\":10,\"text\":\"sweeter than honey &c,\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit construction is not fully clear.\"},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 39. \u0915\u0930\u0941\u0923\u093e, \u092e\u0948\u0924\u094d\u0930\u0940, and \u092a\u094d\u0930\u091c\u094d\u091e\u093e (power of discernment), are here\",\"end\":\"space\"},{\"n\":2,\"text\":\"called \u0935\u0927\u0942\u091c\u0928\u2014ladies who are desirable companions. \u0936\u0930\u0923\u092e\u094d\u2014\",\"end\":\"space\"},{\"n\":3,\"text\":\"protector, saviour. \u092e\u0923\u093f\u092e\u0947\u0916\u0932\u093e a waist band set with jewels.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 40. The sl. describes the state of feelings of one in whom\",\"end\":\"space\"},{\"n\":2,\"text\":\"Vair\u00e2gya is produced. \u092e\u0928\u094d\u0925\u0930\u093e\u0903-(1) slow; (2) crooked. \u0906\u0938\u094d\u0925\u093e ear-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"nest desire. \u0915\u094d\u0937\u0940\u0923\u0903\u2014wasted: has ceased. \u091c\u0917\u091c\u094d\u091c\u093e\u0932\u2014this net-work\",\"end\":\"space\"},{\"n\":4,\"text\":\"of the world i. e. all its intricate and confounding incidents.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 41. \u092a\u094d\u0930\u092d\u093e\u0935\u0940\u0930\u2014one that robs another of its brilliancy i. e.\",\"end\":\"space\"},{\"n\":2,\"text\":\"is as brilliant as that, possesses its brilliancy. Cf. \u0938\u0930\u094b\u0930\u0941\u0939\u0926\u094d\u092f\u0941\u0924\u093f\u092e\u0941\u0937\u0903\",\"end\":\"space\"},{\"n\":3,\"text\":\"Rat. I. \u0905\u0928\u092f\u093e \u0915\u093f\u092e\u092d\u093f\u092a\u094d\u0930\u0947\u0924\u092e\u094d\u2014What can she have intended? what is\",\"end\":\"space\"},{\"n\":4,\"text\":\"her object? \u0935\u0930\u093e\u0915\u0940\u2014miserable, wretched; expresses pity. Also\",\"end\":\"space\"},{\"n\":5,\"text\":\"sometimes used as a word of contempt.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The first Sanskrit lemma and the quotation in line 2 are indistinct.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 86 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"34\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"35\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"36\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"37\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"39\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"stanza_note\",\"number\":\"40\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"stanza_note\",\"number\":\"41\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
