{
 "regions": {
  "r3": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "प्रायः कन्दुकपातेनोत्पत्यार्यः पतन्नपि ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "तथा त्वनार्यः पतति मृत्पिण्डपतनं यथा ॥ १८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "कन्दुकपातेन कन्दुकवत्पुनरपि उत्पत्युन्नतं पदं प्राप्नोति ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यदि नाम दैवगत्या जगदसरोजं कदाचिदपि जातम् ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "अवकरनिकरं विकिरति तत्किं कुक्कुट इव हंसः ॥ १९ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The compound before इव is not entirely clear."
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "यदि कदाचित् । असरोजमविद्यमानकमलम् । तथापि हंसः कुक्कुटः कु-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "क्कुट इव अवकरनिकरं धूल्यादिसमूहम् । आर्या वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The word divided between lines and the preceding reading are unclear."
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यन्नागा मदवारिभिन्नकरटास्तिष्ठन्ति निद्रालसा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "द्वारे हेमविभूषणाश्च तुरगा वल्गन्ति यद्दर्पिताः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "वीणावेणुमृदङ्गशङ्खपटहैः सुस्वस्तु यद्घोष्यते",
     "end": "line"
    },
    {
     "n": 4,
     "text": "तत्सर्वं सुरलोकदेवसदृशं धर्मस्य विस्फूर्जितम् ॥ २० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The instrument compound and the wording in the third and fourth lines are difficult to read."
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "यत् मदवारिणा भिन्नौ करटौ गण्डौ येषां तादृशा नागा गजा द्वारे निद्रा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "लसाः तिष्ठन्ति । यत् दर्पिताः तुरगा द्वारे वल्गन्ति नृत्यन्ति । सुरलोके ये देवा-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "स्तेषां सुरलोकस्य देव इन्द्रः तस्य वा सदृशम् । ऐश्वर्यमिति शेषः । विस्फूर्जितं",
     "end": "space"
    },
    {
     "n": 4,
     "text": "विलसितम् । उदात्तालंकारः । शार्दूलवि० वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "रक्तत्वं कमलानां सत्पुरुषाणां परोपकारित्वम् ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "असतां च निर्दयत्वं स्वभावसिद्धं त्रिषु त्रितयम् ॥ २१ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r10": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "असतां खलानाम् । त्रयोऽवयवा अस्य त्रितयम् । संख्याया अवयवे तयप् ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r11": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "वचो हि सत्यं परमं विभूषणं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "लज्जा (गजा-) ङ्गनायाः क्रूरता कटौ च ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "द्विजस्य विद्या पुनस्तथा क्षमा",
     "end": "line"
    },
    {
     "n": 4,
     "text": "शीलं हि सर्वस्य नरस्य भूषणम् ॥ २२ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The wording in the second line is indistinct."
  },
  "r12": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "गजाङ्गनाया इति पाठे हस्तिनाख्यायाः स्त्रियाः ।",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The compound before स्त्रियाः is difficult to read."
  },
  "r13": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "प्रियसखि विपद्दण्डाघातप्रपातपरम्परा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "परिचयचले चिन्ताचक्रे निधाय विधिः खलः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "मृदमिव बलात्पिण्डीकृत्य प्रगल्भकुलालव-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "द्भ्रमयति मनो नो जानीमः किमत्र विधास्यति ॥२३॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r14": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ भिन्नगण्डकर०.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
