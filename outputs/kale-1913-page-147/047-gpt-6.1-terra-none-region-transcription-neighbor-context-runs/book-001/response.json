          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"one left at last; thus revolving day and night as if they\",\"end\":\"space\"},{\"n\":2,\"text\":\"were two dice, the God of Death plays ( at dice ) with his\",\"end\":\"space\"},{\"n\":3,\"text\":\"wife K\u00e2li making mortals their dice-pieces and the earth\",\"end\":\"space\"},{\"n\":4,\"text\":\"the board.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"44. With the setting and rising of the sun life becomes\",\"end\":\"space\"},{\"n\":2,\"text\":\"shorter and shorter day by day; the lapse of time is not felt\",\"end\":\"space\"},{\"n\":3,\"text\":\"in business which weighs down a man with the great weight\",\"end\":\"space\"},{\"n\":4,\"text\":\"of work; the feeling of disgust is not awakened on beholding\",\"end\":\"space\"},{\"n\":5,\"text\":\"the aggregate of birth, old age, misery and death; the\",\"end\":\"space\"},{\"n\":6,\"text\":\"world has been maddened by drinking the intoxicating wine\",\"end\":\"space\"},{\"n\":7,\"text\":\"of delusion.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"45. Believing that the night is the same and again the\",\"end\":\"space\"},{\"n\":2,\"text\":\"same day, ignorant people run busily in the same manner\",\"end\":\"space\"},{\"n\":3,\"text\":\"resolutely ( or secretly ) setting about their diverse vocations.\",\"end\":\"space\"},{\"n\":4,\"text\":\"Oh, how do we not, through infatuation, feel ashamed\",\"end\":\"space\"},{\"n\":5,\"text\":\"( though ) disgraced by transactions in which there is a\",\"end\":\"space\"},{\"n\":6,\"text\":\"repetition of the enjoyment of pleasures, and by this worldly\",\"end\":\"space\"},{\"n\":7,\"text\":\"life of such nature !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"46. For the annihilation of worldly existence we did\",\"end\":\"space\"},{\"n\":2,\"text\":\"not contemplate the feet of the Lord, according to the\",\"end\":\"space\"},{\"n\":3,\"text\":\"prescribed rules; nor did we accumulate religious merit\",\"end\":\"space\"},{\"n\":4,\"text\":\"which is capable of throwing open the doors of heaven; nor\",\"end\":\"space\"},{\"n\":5,\"text\":\"did we embrace, even in a dream, the pair of the stout (full-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"grown) breasts and thighs of a beautiful woman. We have\",\"end\":\"space\"},{\"n\":7,\"text\":\"been (serviceable ) simply as axes in cutting down the forest\",\"end\":\"space\"},{\"n\":8,\"text\":\"\",\"end\":\"space\"},{\"n\":9,\"text\":\"in the form of our mother\u2019s prime of life.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"47. We did not in this world acquire learning capable of\",\"end\":\"space\"},{\"n\":2,\"text\":\"silencing a host of controversialists, and befitting modest\",\"end\":\"space\"},{\"n\":3,\"text\":\"persons; we did not lead our fame to heaven by shattering\",\"end\":\"space\"},{\"n\":4,\"text\":\"with the point of our sword the temples of elephants; we did\",\"end\":\"space\"},{\"n\":5,\"text\":\"not, at moon-rise, sip the nectar of the tender-foliage-like\",\"end\":\"space\"},{\"n\":6,\"text\":\"lower lip of our beloved; alas ! like a lamp in a tenantless\",\"end\":\"space\"},{\"n\":7,\"text\":\"house, our youth has, indeed, passed away uselessly.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 34 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\