          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u0939\u093f\u092e\u093e\u092e\u094d\u092d\u094b\u0928\u093f\u0927\u092f\u0903 \u0965\u201d It will be seen, however, that R\u00e1marshi\u2019s ex-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"planation is more to the point, as already explained by us\",\"end\":\"space\"},{\"n\":3,\"text\":\"above. Cf. Bh\u00e1g, P. VIII. 24. Mr. Joglekar quotes\u2013\u0917\u093f\u0930\u092f\u094b \u0917\u0941\u0930\u0935\u0938\u094d\u0924\u0947-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"\u092d\u094d\u092f\u094b\u093d\u092a\u094d\u092f\u0941\u0930\u094d\u0935\u0940 \u0917\u0941\u0930\u094d\u0935\u0940 \u0924\u0924\u094b\u093d\u092a\u093f \u091c\u0917\u0926\u0923\u094d\u0921\u092e\u094d \u0964 \u0924\u0938\u094d\u092e\u093e\u0926\u092a\u094d\u092f\u0924\u093f\u0917\u0941\u0930\u0935\u0903 \u092a\u094d\u0930\u0932\u092f\u0947\u093d\u092a\u094d\u092f\u091a\u0932\u093e \u092e\u0939\u093e\u0924\u094d\u092e\u093e\u0928\u0903 \u0965\",\"end\":\"space\"},{\"n\":5,\"text\":\"Bhami. I. The fig. is \u0935\u094d\u092f\u0924\u093f\u0930\u0947\u0915; see. mis. sl. 10.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words in the quotation are difficult to read.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 25. \u0938\u094d\u092a\u0943\u0939\u092f\u0924\u093f\u2014\u0938\u094d\u092a\u0943\u0939\u094d generally governs the dative but when\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"there is ardent longing or a strong desire, it governs the acc.;\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u092a\u094d\u0930\u0915\u0930\u094d\u0937\u0935\u093f\u0935\u0915\u094d\u0937\u093e\u092f\u093e\u0902 \u0924\u0941 \u092a\u0930\u0924\u094d\u0935\u093e\u0924\u094d\u0915\u0930\u094d\u092e\u0938\u0902\u091c\u094d\u091e\u093e\u0964 \u092a\u0941\u0937\u094d\u092a\u093e\u0923\u093f \u0938\u094d\u092a\u0943\u0939\u092f\u0924\u093f \u0964 Sid. Kau. \u092d\u0941\u091c\u092f\u094b-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0930\u0928\u094d\u0924\u0930\u092e\u094d\u2013The space between the arms, i. e. the chest. \u0915\u0930\u0935\u093e\u0932\u0915\u0930\u0919\u094d\u0915\u2013\",\"end\":\"space\"},{\"n\":7,\"text\":\"applies to \u0936\u094d\u0930\u0940 and \u0935\u0928\u093f\u0924\u093e; ( 1 ) \u0915\u0930\u0935\u093e\u0932\u0903 \u0915\u0930\u0919\u094d\u0915 \u0907\u0935 the nail-like\",\"end\":\"space\"},{\"n\":8,\"text\":\"sword; (2) \u0906\u092f\u0924\u093e\u0903 \u0915\u0930\u0935\u093e\u0932 \u0907\u0935 \u0915\u0930\u0919\u094d\u0915\u093e\u0903 long nails piercing like a\",\"end\":\"space\"},{\"n\":9,\"text\":\"sword. For the idea of the nail-marks inflicted by lovers on the\",\"end\":\"space\"},{\"n\":10,\"text\":\"bodies of their beloveds, comp. \u0938\u0916\u094d\u092f\u094b \u0935\u0938\u0928\u094d\u0924\u0947\u0928 \u0938\u092e\u093e\u0917\u0924\u093e\u0928\u093e\u0902 \u0928\u0916\u0915\u094d\u0937\u0924\u093e-\",\"end\":\"hyphen\"},{\"n\":11,\"text\":\"\u0928\u0940\u0935 \u0935\u0928\u0938\u094d\u0925\u0932\u0940\u0928\u093e\u092e\u094d \u0965 Kum. III. 29 \u0909\u092a\u093e\u0939\u093f\u0924\u0902 \u0936\u093f\u0936\u093f\u0930\u093e\u092a\u0917\u092e\u0936\u094d\u0930\u093f\u092f\u093e \u092e\u0941\u0915\u0941\u0932\u091c\u093e-\",\"end\":\"hyphen\"},{\"n\":12,\"text\":\"\u0932\u092e\u0936\u094b\u092d\u0924 \u0915\u093f\u0902\u0936\u0941\u0915\u0947 \u0964 \u092a\u094d\u0930\u0923\u092f\u093f\u0928\u0940\u0935 \u0928\u0916\u0915\u094d\u0937\u0924\u092e\u0923\u094d\u0921\u0928\u0902 \u092a\u094d\u0930\u092e\u0926\u092f\u093e \u092e\u0926\u092f\u093e\u092a\u093f\u0924\u0932\u091c\u094d\u091c\u092f\u093e \u0965\",\"end\":\"space\"},{\"n\":13,\"text\":\"Rag. IX. 31. \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928\u2014instructed in, well versed in (love affairs ).\",\"end\":\"space\"},{\"n\":14,\"text\":\"\u0935\u0928\u093f\u0924\u093e\u2014\u2018\u0935\u0928\u093f\u0924\u093e \u091c\u0928\u093f\u0924\u093e\u0930\u094d\u0925\u093e\u0928\u0941\u0930\u093e\u0917\u093e\u092f\u093e\u0902 \u091a \u092f\u094b\u0937\u093f\u0924\u093f\u2019 Amara; a woman in\",\"end\":\"space\"},{\"n\":15,\"text\":\"whom amour is produced. Since the words \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 and \u092a\u094d\u0930\u094c\u0922 are\",\"end\":\"space\"},{\"n\":16,\"text\":\"used \u0935\u0928\u093f\u0924\u093e here simply means a woman. The fig. is \u0909\u092a\u092e\u093e.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit compounds and quoted verse readings are indistinct.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 50 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"25\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
