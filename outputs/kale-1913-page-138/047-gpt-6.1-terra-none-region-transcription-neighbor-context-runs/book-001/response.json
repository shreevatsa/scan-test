          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r1\":{\"type\":\"heading\",\"lines\":[{\"n\":1,\"text\":\"VAIRA'GYAS'ATAKA.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"1. Hara, the powerful lamp of knowledge, shines bright\",\"end\":\"space\"},{\"n\":2,\"text\":\"in the house of the heart of ascetics; the lamp, which is\",\"end\":\"space\"},{\"n\":3,\"text\":\"resplendent with the flickering flame of light from the\",\"end\":\"space\"},{\"n\":4,\"text\":\"beautiful digit of the moon, worn as crest-ornament, which\",\"end\":\"space\"},{\"n\":5,\"text\":\"burnt, with ease, the moth in the shape of the bustling K\u00e1ma\",\"end\":\"space\"},{\"n\":6,\"text\":\"( the god of love ), which sheds its quivering light at the\",\"end\":\"space\"},{\"n\":7,\"text\":\"top of the wick of supreme happiness and which completely\",\"end\":\"space\"},{\"n\":8,\"text\":\"destroys the mass of darkness of unbounded infatuation\",\"end\":\"space\"},{\"n\":9,\"text\":\"existing inside ( i. e. in the heart ).\",\"end\":\"space\"},{\"n\":10,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"2. Learned men ( who can appreciate good speech ) are\",\"end\":\"space\"},{\"n\":2,\"text\":\"overpowered by jealousy; rich men are blinded by arrogance;\",\"end\":\"space\"},{\"n\":3,\"text\":\"and by ignorance are smitten the rest of the people. (Hence)\",\"end\":\"space\"},{\"n\":4,\"text\":\"good speech is absorbed in the body (finds no vent for want\",\"end\":\"space\"},{\"n\":5,\"text\":\"of encouragement ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"3. I dug up the earth expecting to find a treasure;\",\"end\":\"space\"},{\"n\":2,\"text\":\"smelted the ores found in mountains; crossed the lord of\",\"end\":\"space\"},{\"n\":3,\"text\":\"rivers (the ocean), assiduously propitiated kings; passed\",\"end\":\"space\"},{\"n\":4,\"text\":\"several nights in the cemetery solely intent upon securing\",\"end\":\"space\"},{\"n\":5,\"text\":\"the efficacy of incantations; ( but after all ) I have not\",\"end\":\"space\"},{\"n\":6,\"text\":\"obtained even a broken cowrie. Leave me now, thou, Greed.\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"4. I wandered over the country rugged with numerous\",\"end\":\"space\"},{\"n\":2,\"text\":\"impassable tracts but did not gain any thing; giving\",\"end\":\"space\"},{\"n\":3,\"text\":\"up the proper pride for race and lineage I served (but) to no\",\"end\":\"space\"},{\"n\":4,\"text\":\"purpose; banishing all sense of self-respect, I dined in\",\"end\":\"space\"},{\"n\":5,\"text\":\"strange houses, fearing like a crow ( of being driven away at\",\"end\":\"space\"},{\"n\":6,\"text\":\"any moment ); but thou waxest still, oh Greed\u2014delighting\",\"end\":\"space\"},{\"n\":7,\"text\":\"in wicked deeds\u2014and art not satisfied.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":\"Translation\",\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"heading\",\"number\":null,\"label\":\"VAIRA'GYAS'ATAKA\",\"open_start\":false,\"open_end\":false,\"children\":[\"r1\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"1\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"2\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"3\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"4\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
