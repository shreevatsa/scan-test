{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स्थाल्यां वैडूर्यमय्यां पचति तिलखलीमिन्धनैश्चन्दनाद्यैः",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सौवर्णैर्लाङ्गलाग्रैर्विलिखति वसुधामर्कमूलस्य हेतोः ।",
     "end": "line"
    },
    {
     "n": 5,
     "text": "छित्त्वा कर्पूरखण्डान्वृतिमिव कुरुते कोद्रवाणां समन्तात्",
     "end": "line"
    },
    {
     "n": 6,
     "text": "",
     "end": "line"
    },
    {
     "n": 7,
     "text": "प्राप्येमां कर्मभूमिं न चरति मनुजो यस्तपो मन्दभाग्यः॥ १००",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": "line 5 looks like वृतिमिह in image"
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "मज्जत्वम्भसि यातु मेरुशिखरं शत्रूञ्जयत्वाहवे",
     "end": "line"
    },
    {
     "n": 2,
     "text": "वाणिज्यं कृषिसेवनादि सकला विद्याः कलाः शिक्षतु ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "आकाशं विपुलं प्रयातु खगवत्कृत्वा प्रयत्नं परं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "नाभाव्यं भवतीह भाग्यवशतो भाव्यस्य नाशः कुतः ॥ १०१ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "भीमं वनं भवति तस्य पुरं प्रधानं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सर्वो जनः सुजनतामुपयाति तस्य ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "कृत्स्ना च भूर्भवति सन्निधिरत्नपूर्णा",
     "end": "line"
    },
    {
     "n": 4,
     "text": "यस्यास्ति पूर्वसुकृतं विपुलं नरस्य ॥ १०२ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "heading",
   "lines": [
    {
