          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"the swan only of the luxury of residing in a bed of lotus\",\"end\":\"space\"},{\"n\":2,\"text\":\"plants; but he cannot rob the bird of his universal reputation\",\"end\":\"space\"},{\"n\":3,\"text\":\"for skill in separating milk from water.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"19. Bracelets do not beautify a person, nor do necklaces\",\"end\":\"space\"},{\"n\":2,\"text\":\"resplendent like the moon, nor bathing, nor anointing ( with\",\"end\":\"space\"},{\"n\":3,\"text\":\"rubbed sandal &c), nor (wearing) flowers, nor bedecked hair.\",\"end\":\"space\"},{\"n\":4,\"text\":\"Speech alone beautifies a person when it is possessed in a\",\"end\":\"space\"},{\"n\":5,\"text\":\"refined form.(Other) ornaments wear away continuously; the\",\"end\":\"space\"},{\"n\":6,\"text\":\"ornament of speech is the (only) one which lasts for ever.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"20. Learning is verily the highest (mark of or, addition-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"al ) beauty for man; it is a treasure concealed and well-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"protected; it places within his reach enjoyments, honour and\",\"end\":\"space\"},{\"n\":4,\"text\":\"happiness; it is an object of reverence even to those who are\",\"end\":\"space\"},{\"n\":5,\"text\":\"worthy of reverence; while journeying in strange lands it is\",\"end\":\"space\"},{\"n\":6,\"text\":\"a friend; and it is the highest deity; learning is honoured by\",\"end\":\"space\"},{\"n\":7,\"text\":\"kings, but not wealth; one destitute of learning is a beast.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"21. If men have forgiveness, why should they require\",\"end\":\"space\"},{\"n\":2,\"text\":\"an armour; no (other) enemies (are required to ruin) them\",\"end\":\"space\"},{\"n\":3,\"text\":\"if they are hot-tempered; if there are kins-people, where is\",\"end\":\"space\"},{\"n\":4,\"text\":\"the necessity of fire? ( i. e. they will do the destructive work\",\"end\":\"space\"},{\"n\":5,\"text\":\"of fire ); if there is a friend, what use is there of medicines\",\"end\":\"space\"},{\"n\":6,\"text\":\"of sovereign virtue? What need is there of serpents if\",\"end\":\"space\"},{\"n\":7,\"text\":\"wicked men (exist)? Of what account is wealth if there is\",\"end\":\"space\"},{\"n\":8,\"text\":\"blameless learning? What is the use of ornaments if ( one\",\"end\":\"space\"},{\"n\":9,\"text\":\"has) (a proper sense of) shame? If there is sweet poesy, of\",\"end\":\"space\"},{\"n\":10,\"text\":\"what good is a kingdom?\",\"end\":\"space\"},{\"n\":11,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"22. The stability of the world solely depends on those\",\"end\":\"space\"},{\"n\":2,\"text\":\"men who are expert in the following arts:\u2014courtesy to-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"wards one\u2019s relations, kindness towards strangers, cunning\",\"end\":\"space\"},{\"n\":5,\"text\":\"towards the wicked, affection for virtuous men, policy to-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"wards princes, humility towards the learned, bravery in\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 4 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"18\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"19\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"20\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"21\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"22\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
