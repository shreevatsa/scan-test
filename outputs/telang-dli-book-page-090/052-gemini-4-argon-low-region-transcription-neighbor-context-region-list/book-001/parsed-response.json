{
 "regions": [
  {
   "id": "r2",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "रूपतिरस्कारमाह ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "स्तनौ मांसग्रन्थी कनककलशावित्युपमितौ",
     "end": "line"
    },
    {
     "n": 2,
     "text": "मुखं श्लेष्मागारं तदपि च शशाङ्केन तुलितम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "स्रवन्मूत्रक्लिन्नं करिवरकरस्पर्धि जघन-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "महो निन्द्यं रूपं कविजनविशेषैर्गुरु कृतम् ॥ २० ॥",
     "end": "space"
    },
    {
     "n": 5,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अजानन्माहात्म्यं पततु शलभो दीपदहने",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स मीनोप्यज्ञानाद्वडिशयुतमश्नातु पिशितम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "विजानन्तोप्येते वयमिह विपज्जालजटिला-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "न्न मुञ्चामः कामानहह गहनो मोहमहिमा ॥ २१ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अथ दुर्जनमुद्दिश्याह ।",
     "end": "space"
    },
    {
     "n": 2,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "बिसमलमशनाय स्वादु पानाय तोयं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "शयनमवनिपृष्ठे वल्कले वाससी च ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "line"
    },
    {
     "n": 4,
     "text": "नवधनमधुपानभ्रान्तसर्वेन्द्रियाणा-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "मविनयमनुमन्तुं नोत्सहे दुर्जनानाम् ॥ २२ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "apparatus_entry",
   "lines": [
    {
