          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"rendered. Good luck, the result of ( lit stored by ) past\",\"end\":\"space\"},{\"n\":2,\"text\":\"religious performances fructifies for man seasonably, as do\",\"end\":\"space\"},{\"n\":3,\"text\":\"trees.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"102. Meritorious deeds done in a former life protect a man in\",\"end\":\"space\"},{\"n\":2,\"text\":\"a forest, on a battlefield, in the midst of foes, or water or fire,\",\"end\":\"space\"},{\"n\":3,\"text\":\"in the vast ocean, or on a mountain-top, whether he be asleep\",\"end\":\"space\"},{\"n\":4,\"text\":\"or careless or in a perilous condition.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"103. O good man, to obtain your cherished desire, adore\",\"end\":\"space\"},{\"n\":2,\"text\":\"that goddess\u2014Good conduct\u2014that changes wicked men into\",\"end\":\"space\"},{\"n\":3,\"text\":\"good, fools into wise men, enemies into friends, the invisible\",\"end\":\"space\"},{\"n\":4,\"text\":\"into the visible and deadly poison into nectar, in an instant.\",\"end\":\"space\"},{\"n\":5,\"text\":\"Fix not your hopes on numerous other qualities with\",\"end\":\"space\"},{\"n\":6,\"text\":\"persistent application.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"104. When good luck is favourable to one ( lit. closely\",\"end\":\"space\"},{\"n\":2,\"text\":\"linked ), a splendid mansion, sportive women, and prosperity\",\"end\":\"space\"},{\"n\":3,\"text\":\"brilliant with the white umbrella\u2014all these things are en-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"joyed for a long time; but when unfavourable ( lit. when its\",\"end\":\"space\"},{\"n\":5,\"text\":\"thread is snapped ) behold ! all these vanish in all directions\",\"end\":\"space\"},{\"n\":6,\"text\":\"like a wreath of pearls, the thread of which is broken in the\",\"end\":\"space\"},{\"n\":7,\"text\":\"sport of amorous quarrels.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"105. A wise man, bent on doing a thing, good or bad,\",\"end\":\"space\"},{\"n\":2,\"text\":\"should first carefully consider its consequence. The issue of\",\"end\":\"space\"},{\"n\":3,\"text\":\"actions done in hot haste becomes, till death, like a dart,\",\"end\":\"space\"},{\"n\":4,\"text\":\"poignant to the heart.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"106. The luckless man that does not practise penance\",\"end\":\"space\"},{\"n\":2,\"text\":\"on coming into this Land of karman, cooks ( as it were )\",\"end\":\"space\"},{\"n\":3,\"text\":\"with sandal-wood &c. for fuel, in a utensil made of the\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"Vaid\u00fbrya gem, the oil-cake of sesamum; or ploughs the\",\"end\":\"space\"},{\"n\":6,\"text\":\"earth with a golden ploughshare for the sake of the root of\",\"end\":\"space\"},{\"n\":7,\"text\":\"the arka tree, or makes a hedge round a crop of kodravas of\",\"end\":\"space\"},{\"n\":8,\"text\":\"camphor-trees having cut them down.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 19 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"101\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translat