          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"30. The joys of those who always rejoice in contentment\",\"end\":\"space\"},{\"n\":2,\"text\":\"have not been interrupted, nor is the thirst of those others\",\"end\":\"space\"},{\"n\":3,\"text\":\"quenched, that have their minds agitated by covetousness for\",\"end\":\"space\"},{\"n\":4,\"text\":\"wealth. This being the case for whose sake was that Meru\",\"end\":\"space\"},{\"n\":5,\"text\":\"made by Brahman a peerless repository of wealth ? I like\",\"end\":\"space\"},{\"n\":6,\"text\":\"not it, the glory of whose gold is for itself alone.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"31. The great ascetics say that the cult of S'iva is a\",\"end\":\"space\"},{\"n\":2,\"text\":\"treasure of inexhaustible happiness which cannot be refused\",\"end\":\"space\"},{\"n\":3,\"text\":\"to any one\u2014a cult in which there is ( i. e. which enjoins, )\",\"end\":\"space\"},{\"n\":4,\"text\":\"maintenance on charity, in which there is no degradation,\",\"end\":\"space\"},{\"n\":5,\"text\":\"which yields unparalleled happiness, which always removes\",\"end\":\"space\"},{\"n\":6,\"text\":\"fear, does away with the haughty pride resulting from\",\"end\":\"space\"},{\"n\":7,\"text\":\"wicked jealousy, and counteracts the current of miseries,\",\"end\":\"space\"},{\"n\":8,\"text\":\"which is easily accessible every day at all places, is preferred\",\"end\":\"space\"},{\"n\":9,\"text\":\"by the good, and is holy.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"32. Enjoyment (of pleasures) is accompanied with fear of\",\"end\":\"space\"},{\"n\":2,\"text\":\"disease, noble birth is liable to a fall, wealth is exposed to\",\"end\":\"space\"},{\"n\":3,\"text\":\"danger from the king, dignity to misfortune, an army to\",\"end\":\"space\"},{\"n\":4,\"text\":\"fear from the enemy, beauty to danger from old age, know-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"ledge of S'\u00e2stra to controversy, merits to danger from the\",\"end\":\"space\"},{\"n\":6,\"text\":\"wicked, and body to the fear of death; all objects are thus\",\"end\":\"space\"},{\"n\":7,\"text\":\"beset with danger; asceticism alone is invulnerable on earth.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"33. Birth is attended with death; vivacious youth with\",\"end\":\"space\"},{\"n\":2,\"text\":\"old age; contentment with cupidity; the felicity of renunci-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"ation stands in the danger of being disturbed by the sportive\",\"end\":\"space\"},{\"n\":4,\"text\":\"movements of youthful women, and virtues by malicious\",\"end\":\"space\"},{\"n\":5,\"text\":\"people; wood-lands are infested by serpents; kings are\",\"end\":\"space\"},{\"n\":6,\"text\":\"surrounded by wicked people; even prosperity is affected by\",\"end\":\"space\"},{\"n\":7,\"text\":\"inconstancy; or, what is there that is not smitten by some-\",\"end\":\"hyphen\"},{\"n\":8,\"text\":\"thing else ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"34. The health of man is undermined by hundreds of\",\"end\":\"space\"},{\"n\":2,\"text\":\"mental and physical infirmities; to where there is wealth\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 31 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"30\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"31\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"32\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"33\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"34\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
