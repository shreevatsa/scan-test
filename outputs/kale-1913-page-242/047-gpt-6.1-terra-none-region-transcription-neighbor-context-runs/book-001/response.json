          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u0906\u092d\u094b\u0917 enjoyment in full ( \u0906 ); or with R\u00e2marshi, \u092a\u0930\u093f\u092a\u0942\u0930\u094d\u0923\u0924\u093e. Cf.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u092d\u094b\u0917\u0948\u0915\u092c\u0926\u094d\u0927\u0938\u094d\u092a\u0943\u0939 Nit. 29.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation in line 2 is not fully clear.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 97. \u0924\u0924\u094d\u0924\u094d\u0935 &c.\u2014whose intellect is keen in discerning\",\"end\":\"space\"},{\"n\":2,\"text\":\"( thinking out ) the truth, discrimination of the real from the\",\"end\":\"space\"},{\"n\":3,\"text\":\"unreal. \u0907\u0924\u0903 &c.\u2014wise men do not care what others speak\",\"end\":\"space\"},{\"n\":4,\"text\":\"about them, but silently go their own way. \u0938\u094d\u0935\u092f\u0902\u2014\u0938\u094d\u0935\u0947\u0928\u0948\u0935 \u0930\u0942\u092a\u0947\u0923\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0906\u0928\u0928\u094d\u0926\u0935\u0928\u094d\u0924\u0903 \u0964 \u2018 by themselves; R\u00e2marshi or without meddling\",\"end\":\"space\"},{\"n\":6,\"text\":\"with others \u2019 will also do.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 98. \u092e\u0939\u0926\u0936\u0928\u0902 \u0915\u0932\u094d\u092a\u093f\u0924\u0902\u2014In such constructions the noun\",\"end\":\"space\"},{\"n\":2,\"text\":\"used to complete the sense of verbs of incomplete predication\",\"end\":\"space\"},{\"n\":3,\"text\":\"is put in the Nom. case; See A. G. \u00a7 12. ( a ). \u0939\u093f\u0902\u0938\u093e\u0936\u0942\u0928\u094d\u092f\u092e\u094d\u2014\",\"end\":\"space\"},{\"n\":4,\"text\":\"free from the sin of causing the destruction of animal life Cf.\",\"end\":\"space\"},{\"n\":5,\"text\":\"Goldsmith\u2014\u201cAnd from the mountain\u2019s grassy side. A guilt-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"less feast I bring.\u201d \u092a\u0936\u0935\u0903\u2014beasts are created so as to live on\",\"end\":\"space\"},{\"n\":7,\"text\":\"grass. \u0938\u094d\u0925\u0932\u0940\u0936\u093e\u092f\u093f\u0928\u0903\u2014lying on the lawn; \u0938\u094d\u0925\u0932\u0940 means a natural\",\"end\":\"space\"},{\"n\":8,\"text\":\"plot of land. \u0938\u0902\u0938\u093e\u0930 &c.\u2014To those that do not possess the\",\"end\":\"space\"},{\"n\":9,\"text\":\"faculty of reason, God has assigned a cheap, easy livelihood;\",\"end\":\"space\"},{\"n\":10,\"text\":\"but to those who can think out the means of their salvation\",\"end\":\"space\"},{\"n\":11,\"text\":\"( i. e. men ) He has assigned a mode of life in pursuit of which\",\"end\":\"space\"},{\"n\":12,\"text\":\"all their good qualities are exhausted. The struggle for\",\"end\":\"space\"},{\"n\":13,\"text\":\"existence, in the case of man, engrosses all his energies, and\",\"end\":\"space\"},{\"n\":14,\"text\":\"leaves him neither time, nor energy to seek eternal bliss. It is\",\"end\":\"space\"},{\"n\":15,\"text\":\"difficult to see the bearing of this sl. here. Probably the poet\",\"end\":\"space\"},{\"n\":16,\"text\":\"means\u2014Men should, therefore, feel disgust for worldly life and\",\"end\":\"space\"},{\"n\":17,\"text\":\"direct their efforts to the acquisition of Moksha.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit quotations are difficult to read.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 99. \u092a\u0926\u094d\u092e\u093e\u0938\u0928\u0902 is a particular posture in religious me-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"ditation, thus described:\u2014\u0909\u0924\u094d\u0924\u093e\u0928\u094c \u091a\u0930\u0923\u094c \u0915\u0943\u0924\u094d\u0935\u093e \u090a\u0930\u0941\u0938\u0902\u0938\u094d\u0925\u094c \u092a\u094d\u0930\u092f-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\u0924\u094d\u0928\u0924\u0903 \u0964 \u090a\u0930\u0941\u092e\u0927\u094d\u092f\u0947 \u0924\u0925\u094b\u0924\u094d\u0924\u093e\u0928\u094c \u092a\u093e\u0923\u0940 \u092a\u0926\u094d\u092e\u093e\u0938\u0928\u0902 \u0938\u094d\u0925\u093f\u0924\u092e\u094d \u0965 Or \u090a\u0930\u0941\u092e\u0942\u0932\u0947 &c. see\",\"end\":\"space\"},{\"n\":4,\"text\":\"com: \u092f\u094b\u0917\u0928\u093f\u0926\u094d\u0930\u093e\u2014A sleep of meditation or contemplation. \u092f\u094b\u0917\u0940\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u092e\u0928\u0938\u094b \u0935\u093f\u0937\u092f\u093e\u0928\u094d\u0924\u0930\u0935\u094d\u092f\u093e\u0935\u0943\u0924\u094d\u0924\u093f\u0903 \u0924\u0926\u094d\u0930\u0942\u092a\u093e \u0928\u093f\u0926\u094d\u0930\u093e \u0964 contemplation of the mind\",\"end\":\"space\"},{\"n\":6,\"text\":\"on Brahma is here likened to sleep because the Yog\u00ee is dead to\",\"end\":\"space\"},{\"n\":7,\"text\":\"the external world during the time of mediation\u2013his mind takes\",\"end\":\"space\"},{\"n\":8,\"text\":\"cognisance of no external objects like that of a man fast asleep.\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u0915\u093f\u0902 \u0924\u0948\u0930\u094d\u092d\u093e\u0935\u094d\u092f\u092e\u094d\u2014will they ever be? \u0915\u0923\u094d\u0921\u0942\u092f\u0928\u094d\u0924\u0947-A denom. from \u0915\u0923\u094d\u0921\u0942\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit verse and explanatory quotation are partly indistinct.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 77 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"97\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"98\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"99\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
