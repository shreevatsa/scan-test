          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"71. O mind with your celerity you dive into the neither\",\"end\":\"space\"},{\"n\":2,\"text\":\"world, soar beyond the heavens and wander as far as the\",\"end\":\"space\"},{\"n\":3,\"text\":\"encircling directions. How is it that even by mistake you\",\"end\":\"space\"},{\"n\":4,\"text\":\"never remember that pure Brahman which is ( always )\",\"end\":\"space\"},{\"n\":5,\"text\":\"beneficial to oneself and by which you attain beatitude?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"72. What is the use of ( studying ) the Vedas and the\",\"end\":\"space\"},{\"n\":2,\"text\":\"sm\u1e5bties, of reciting the Pur\u00e0nas, of the S\u2019astras of mighty\",\"end\":\"space\"},{\"n\":3,\"text\":\"extent, and of the distractions of rites and ceremonies, which\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"result in giving us an abode in the hut of heaven alone?\",\"end\":\"space\"},{\"n\":6,\"text\":\"Barring one encompassment of the entrance into the seat\",\"end\":\"space\"},{\"n\":7,\"text\":\"wherein there is joy to the soul and which is like the world-\",\"end\":\"hyphen\"},{\"n\":8,\"text\":\"destroying fire in annihilating the array of misfortunes aris-\",\"end\":\"hyphen\"},{\"n\":9,\"text\":\"ing from worldly ties, all things else are meretricious.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The diacritics in sm\u1e5bties and Pur\u00e0nas are not fully clear.\"},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"73. When the great mountain Meru, struck by the fire\",\"end\":\"space\"},{\"n\":2,\"text\":\"at the time of the destruction of the world, falls; when the\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"seas, which are the abode of a vast number of sharks and\",\"end\":\"space\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"alligators, dry up; when the earth, supported by the feet of\",\"end\":\"space\"},{\"n\":7,\"text\":\"mountains, goes to end; why talk of the human body which\",\"end\":\"space\"},{\"n\":8,\"text\":\"is unsteady like the end of a young elephant\u2019s ear?\",\"end\":\"space\"},{\"n\":9,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"4. (In old age) the body is shrivelled, the gait falters, the\",\"end\":\"space\"},{\"n\":2,\"text\":\"row of teeth is displaced, the vision is obscured, deafness\",\"end\":\"space\"},{\"n\":3,\"text\":\"grows ( upon a man), and his mouth slobbers; the relations\",\"end\":\"space\"},{\"n\":4,\"text\":\"do not obey his order and his wife does not serve him; alas!\",\"end\":\"space\"},{\"n\":5,\"text\":\"even the son acts inimically towards an aged man.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"75. Seeing the white colour of the hair on the head,\",\"end\":\"space\"},{\"n\":2,\"text\":\"which is the place where men are defeated by old age,\",\"end\":\"space\"},{\"n\":3,\"text\":\"young ladies go away leaving them at a distance, as they do\",\"end\":\"space\"},{\"n\":4,\"text\":\"leaving a well used by low-castes over which a piece of bone\",\"end\":\"space\"},{\"n\":5,\"text\":\"is suspended.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"76. While this body is at ease and free from disease,\",\"end\":\"space\"},{\"n\":2,\"text\":\"while old age is at a distance, while physical power is unim-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"paired and while life is not yet exhausted, so long only\",\"end\":\"space\"},{\"n\":4,\"text\":\"should a wise man make a great effort for the welfare of his\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 39 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"71\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"72\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"73\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"4\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"75\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"76\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
