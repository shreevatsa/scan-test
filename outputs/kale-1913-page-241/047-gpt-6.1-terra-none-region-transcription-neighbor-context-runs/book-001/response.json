          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Kau. \u0905\u0924\u094d\u092f\u093e\u0917\u0947\u092a\u093f &c.\u2014Even though the body is not cast off i. e.\",\"end\":\"space\"},{\"n\":2,\"text\":\"he will not have to wait for a second birth. \u0938\u0902\u092a\u0924\u094d\u0938\u094d\u092f\u0924\u0947\u2014see\",\"end\":\"space\"},{\"n\":3,\"text\":\"Kum. II. 54 &c. \u0938\u0941\u0916\u0902 \u0938\u0902\u092a\u0924\u094d\u0938\u094d\u092f\u0924\u0947 v. l.\u2014In this case \u0938\u0902\u092a\u0926\u094d must be\",\"end\":\"space\"},{\"n\":4,\"text\":\"understood as used transitively.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit readings are somewhat unclear.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 92. \u0915\u094c\u092a\u0940\u0928\u0902\u2014a small piece of cloth used to cover the\",\"end\":\"space\"},{\"n\":2,\"text\":\"privities. \u091c\u0930\u094d\u091c\u0930\u0924\u0930\u2014extremely ragged. \u091a\u093f\u0928\u094d\u0924\u093e act of contemplation.\",\"end\":\"space\"},{\"n\":3,\"text\":\"Also a thought about (i. e. a wish for) a secluded place; \u0927\u094d\u0935\u0938\u094d\u0924\u093e\u0936\u0947\u0937\",\"end\":\"space\"},{\"n\":4,\"text\":\"&c.\u2014delighted at the total destruction of egotism and errors;\",\"end\":\"space\"},{\"n\":5,\"text\":\"or \u092e\u0926\u092a\u094d\u0930\u092e\u093e\u0926\u093e\u0903 errors arising from egotism or pride.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words are difficult to distinguish.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 93. \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0923\u094d\u0921\u0902 \u092e\u0923\u094d\u0921\u0932\u0940\u092e\u093e\u0924\u094d\u0930\u0902\u2014v. l.\u2014a mere circular body i. e.\",\"end\":\"space\"},{\"n\":2,\"text\":\"which is limited in space and not \u0905\u092a\u0930\u093f\u091a\u094d\u091b\u093f\u0928\u094d\u0928 like Brahman.\",\"end\":\"space\"},{\"n\":3,\"text\":\"This is perhaps a better reading. \u0936\u092b\u0930\u0940\u2014a small fish. \u0915\u094d\u0937\u0941\u092c\u094d\u0927\u0924\u093e\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u091c\u093e\u0924\u0941 \u091c\u093e\u092f\u0924\u0947\u2014a question implying the negative answer in itself\u2014\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u2018Is ever agitation produced &c. ?\u2019\u2014\u2018Never.\u2019 \u091c\u093e\u0924\u0941 ever, at\",\"end\":\"space\"},{\"n\":6,\"text\":\"any time.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit in the first and third lines is indistinct.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 94. \u092e\u093e \u0938\u094d\u092e \u092d\u0942\u0903-\u092e\u093e sometimes followed by \u0938\u094d\u092e, is used with\",\"end\":\"space\"},{\"n\":2,\"text\":\"a form of the Imperf. or Aorist with the aug. \u0905 dropped. Cf.\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0915\u094d\u0932\u0948\u092c\u094d\u092f\u0902 \u092e\u093e\u0938\u094d\u092e \u0917\u092e\u0903 \u092a\u093e\u0930\u094d\u0925 &c. Bhg. II. 3. \u092d\u094b\u0917\u0947\u092d\u094d\u092f\u0903\u2014\u2018the dat. by\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0938\u094d\u092a\u0943\u0939\u0947\u0930\u0940\u092a\u094d\u0938\u093f\u0924\u0903 P\u00e2n. I. 4. 36. In the case of the root \u0938\u094d\u092a\u0943\u0939\u094d the object\",\"end\":\"space\"},{\"n\":5,\"text\":\"desired is put in the dative case. \u0938\u094d\u092a\u0943\u0939\u092f\u093e\u0932\u0941\u2014from \u0938\u094d\u092a\u0943\u0939\u094d + \u0906\u0932\u0941\",\"end\":\"space\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"by \u2018\u0938\u094d\u092a\u0943\u0939\u0947\u0930\u094d\u0917\u0943\u0927\u093f \u092a\u0924\u093f\u0926\u092f\u093f\u0928\u093f\u0926\u094d\u0930\u093e\u0924\u0928\u094d\u0926\u094d\u0930\u093e\u0936\u094d\u0930\u0926\u094d\u0927\u093e\u092d\u094d\u092f \u0906\u0932\u0941\u091a\u094d\u2014\u2019 P\u00e2n. III. 2.\",\"end\":\"space\"},{\"n\":8,\"text\":\"\",\"end\":\"space\"},{\"n\":9,\"text\":\"358; so \u0917\u0943\u0927\u092f\u093e\u0932\u0941, \u092a\u0924\u092f\u093e\u0932\u0941 &c. \u0938\u094d\u092f\u0942\u0924\u2014stitched; p. p. p. of \u0938\u093f\u0935\u094d 4 cl.\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u092d\u093f\u0915\u094d\u0937\u093e\u0938\u0915\u094d\u0924\u0941\u2014barley-flour ( obtained by ) begging. Cf. infra Mis.\",\"end\":\"space\"},{\"n\":11,\"text\":\"sl. 37.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The grammatical quotation and several Sanskrit forms are hard to read; lines 6 and 8 contain detached vowel marks.\"},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 95. \u0909\u092a\u0927\u093e\u0928\u092e\u094d\u2014pillow; fr. \u0909\u092a + \u0927\u093e + \u0932\u094d\u092f\u0941\u091f\u094d ( \u0905\u0928 ). \u0935\u093f\u0924\u093e\u0928\u2014\",\"end\":\"space\"},{\"n\":2,\"text\":\"m. n. a canopy. \u0935\u093f\u0924\u0928\u094d\u092f\u0924\u0947 \u0907\u0924\u093f fr. \u0924\u0928\u094d with \u0935\u093f + \u0918\u091e\u094d ( \u0905 ). \u0935\u093f\u0930\u0924\u093f\u0935\u0928\u093f\u0924\u093e-\",\"end\":\"space\"},{\"n\":3,\"text\":\"Cf. infra mis. 39, \u0915\u0941\u0930\u094d\u0935\u0924 \u0915\u0930\u0941\u0923\u093e\u092e\u0948\u0924\u094d\u0930\u0940\u092a\u094d\u0930\u091c\u094d\u091e\u093e\u0935\u0927\u0942\u091c\u0928\u0938\u0902\u0917\u092e\u092e\u094d where \u0915\u0930\u0941\u0923\u093e, \u092e\u0948\u0924\u094d\u0930\u0940\",\"end\":\"space\"},{\"n\":4,\"text\":\"and \u092a\u094d\u0930\u091c\u094d\u091e\u093e are likewise called wives. \u0938\u0941\u0916\u092e\u094d\u2014an adv. here. \u0905\u0924\u0928\u0941\",\"end\":\"space\"},{\"n\":5,\"text\":\"&c.\u2014from the adj. \u0924\u0928\u0941 the fem. forms are \u0924\u0928\u0941 or \u0924\u0928\u094d\u0935\u0940. \u092d\u0942\u0924\u093f has\",\"end\":\"space\"},{\"n\":6,\"text\":\"two meanings viz. ( 1 ) \u2018prosperity\u2019 as applicable to the king\",\"end\":\"space\"},{\"n\":7,\"text\":\"and (2) \u2018ashes\u2019 as applicable to the Muni. Cf. Mis. Sl. 31. infra.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The quoted Sanskrit in line 3 is indistinct.\"},\"r7\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 96. \u0938\u094d\u0935\u093e\u092f\u0924\u094d\u0924 &c.\u2014\u091c\u093f\u0924\u0947\u0928\u094d\u0926\u094d\u0930\u093f\u092f\u0903 whose movements are under\",\"end\":\"space\"},{\"n\":2,\"text\":\"control; who practises self-restraint. \u0906\u0938\u094d\u092f\u0942\u0924 &c.\u2014an \u090f\u0915\u0926\u0947\u0936\u0940\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0905\u0928\u094d\u0935\u092f. \u0938\u0902\u092a\u094d\u0930\u094b\u0924 v. l. sewn together, patched with. \u0938\u092e\u0938\u0941\u0916\u092d\u094b\u0917 &c.\u2014\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The final Sanskrit expression is difficult to read.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 76 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"91\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"92\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"93\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"94\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"95\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"stanza_note\",\"number\":\"96\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
