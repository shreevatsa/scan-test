{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "करे श्लाघ्यस्त्यागः शिरसि गुरुपादप्रणयिता",
     "end": "line"
    },
    {
     "n": 2,
     "text": "मुखे सत्या वाणी विजयिभुजयोर्वीर्यमतुलम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "हृदि स्वस्था वृत्तिः श्रुतमधिगतं च श्रवणयो-",
     "end": "line"
    },
    {
     "n": 4,
     "text": "र्विनाप्यैश्वर्येण प्रकृतिमहतां मण्डनमिदम् ॥ ६५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "संपत्सु महतां चित्तं भवत्युत्पलकोमलम् ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "आपत्सु च महाशैलशिलासंघातकर्कशम् ॥ ६६ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "संतप्तायसि संस्थितस्य पयसो नामापि न ज्ञायते",
     "end": "line"
    },
    {
     "n": 2,
     "text": "मुक्ताकारतया तदेव नलिनीपत्रस्थितं राजते ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "स्वात्यां सागरशुक्तिमध्यपतितं तन्मौक्तिकं जायते",
     "end": "line"
    },
    {
     "n": 4,
     "text": "प्रायेणाधममध्यमोत्तमगुणः संसर्गतो जायते ॥ ६७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "LXV. (a) श्लाघ्यस्त्यागः; त्यागः श्लाघ्यः. D. °यिता; °यनम् L. P. R. (b)",
     "end": "space"
    },
    {
     "n": 2,
     "text": "°यि; °य. T. K. Be. W. Bo. ( orig. Bo.n. ) वीर्यमतुलम्; पौरुषमहो.",
     "end": "space"
    },
    {
     "n": 3,
     "text": "P. R. (c) स्वस्था; स्वच्छा. X. N. Bo.n. स्वेच्छा K. Be.n. °धिगतं च श्र-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "वणयोः; °वगतं च श्रवणयोः L. Bo.n. °धिगतैकव्रतफलम्. C. W. S. T.",
     "end": "space"
    },
    {
     "n": 5,
     "text": "X. (where and in S. ले for लम् ).",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "LXVI. (a) °त्सु; °द्य. Be.n. °वत्यु°; °वेदु°. S. K. Be.n. N. (b)",
     "end": "space"
    },
    {
     "n": 2,
     "text": "कर्कशम्; कं यथा. S.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "LXVII (a) ज्ञा°; श्रू°. L. D. N. (b) °त्र, °त्रै. K. Be.n. राज°;",
     "end": "space"
    },
    {
     "n": 2,
     "text": "दृश्य°. N. (c) स्वात्याम्; स्वातौ. P. R. Bo.n. स्वात्मा Bo.n. अन्तः. D. N.",
     "end": "space"
    },
    {
     "n": 3,
     "text": "शुक्तिमध्यपतितम्; मुक्तिमध्यपतितम् Bo.n. शुक्तिकुक्षिपतितम् Bo.n. (P.) शुक्तिसंपु-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "टगतम् P. R. तन्मौक्तिकं जायते; सन्मौक्तिकं जायते. T. मुक्ताफलं जायते. Bo.n.",
     "end": "space"
    },
    {
     "n": 5,
     "text": "K. Be.n. तज्जायते मौक्तिकम् Bo.n. (P.) & X. P. R. (where ज्जा rightly).",
     "end": "space"
    },
    {
     "n": 6,
     "text": "(d) °णः; °णाः. C. Bo. D. P. R. °णाधममध्यमोत्तमगुणः; °णोत्तममध्यमाध-",
     "end": "hyphen"
    },
    {
     "n": 7,
     "text": "मगुणः Bo.n. and probably also W. as appears from the Comment-",
     "end": "hyphen"
    },
    {
     "n": 8,
     "text": "ary the line being omitted in the text. गुणः; °जुषाम्. N.",
     "end": "space"
    },
    {
     "n": 9,
     "text": "संसर्गतो जायते; संवासतो जायते T. Bo.n. संवासतो देहिनाम् C. P. R. एवंविधा",
     "end": "space"
    },
    {
     "n": 10,
     "text": "वृत्तयः N.",
     "end": "space"
    }
   ],
