          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"92. Happily lives the ascetic ( with his ) strip of cloth\",\"end\":\"space\"},{\"n\":2,\"text\":\"extremely threadbare and torn in a hundred pieces, and a\",\"end\":\"space\"},{\"n\":3,\"text\":\"wallet to match, ( with his ) freedom from care and meal\",\"end\":\"space\"},{\"n\":4,\"text\":\"consisting of alms got with ease, ( with his ) bed in a forest\",\"end\":\"space\"},{\"n\":5,\"text\":\"or a cemetery, ( with his ) equal regard for friends and foes,\",\"end\":\"space\"},{\"n\":6,\"text\":\"with his extremely serene contemplation in a secluded place,\",\"end\":\"space\"},{\"n\":7,\"text\":\"and glad that all his errors arising from arrogance have\",\"end\":\"space\"},{\"n\":8,\"text\":\"been corrected.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"93. The mere ( insignificant ) group of worlds is nothing\",\"end\":\"space\"},{\"n\":2,\"text\":\"for the temptation of one who has restrained his mind. Is\",\"end\":\"space\"},{\"n\":3,\"text\":\"ever agitation produced in the sea by the motions of a\",\"end\":\"space\"},{\"n\":4,\"text\":\"S'afari ( a female fish )?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"94. O mother, Lakshmi, repair to some one else; do not\",\"end\":\"space\"},{\"n\":2,\"text\":\"yearn for me. We are not hankerers after pleasures. What\",\"end\":\"space\"},{\"n\":3,\"text\":\"are you to those ( i. e. to us ) who are free from desires?\",\"end\":\"space\"},{\"n\":4,\"text\":\"We now wish to live on barley-flour obtained by begging\",\"end\":\"space\"},{\"n\":5,\"text\":\"( and placed ) in a hollowed vessel of pal\u00e2sa leaves, stitched\",\"end\":\"space\"},{\"n\":6,\"text\":\"together at the moment.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"95. Like a king possessed of by no means small wealth\",\"end\":\"space\"},{\"n\":2,\"text\":\"an ascetic, with ashes profusely besmeared ( to his body ) and\",\"end\":\"space\"},{\"n\":3,\"text\":\"peaceful, sleeps quietly, delighted in the company of the\",\"end\":\"space\"},{\"n\":4,\"text\":\"woman, viz. indifference ( to worldly attachments ), the earth\",\"end\":\"space\"},{\"n\":5,\"text\":\"( being to him ) a delightful bed, his creeper-like arm a\",\"end\":\"space\"},{\"n\":6,\"text\":\"spacious pillow, the sky his canopy, the favourable breeze\",\"end\":\"space\"},{\"n\":7,\"text\":\"(or, the breeze, always at his service ) his fan, and the moon\",\"end\":\"space\"},{\"n\":8,\"text\":\"a brilliant lamp.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"96. There is ( rarely found ) an ascetic, living on alms;\",\"end\":\"space\"},{\"n\":2,\"text\":\"free from attachment ( though ) in the midst of the people,\",\"end\":\"space\"},{\"n\":3,\"text\":\"his movements ever under his control, attached to the path\",\"end\":\"space\"},{\"n\":4,\"text\":\"which is free from giving and taking, wearing a wallet\",\"end\":\"space\"},{\"n\":5,\"text\":\"made of old threadbare clothes thrown away in the streets,\",\"end\":\"space\"},{\"n\":6,\"text\":\"not caring for honour, not proud, and wishing solely for the\",\"end\":\"space\"},{\"n\":7,\"text\":\"enjoyment of tranquil pleasure.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 43 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"92\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"93\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"94\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"95\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"96\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
