{
 "regions": [
  {
   "id": "r3",
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "( १. ४. २७ ) इति पञ्चमी । हिताय सत्कर्माचरणाय प्रवर्तयति । गुह्यं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "गोप्यम् । आपदं गत आपद्गतस्तम् । वसन्ततिलका वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अधुना सतां स्वभावत एव परहिते प्रवृत्तिरित्याह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "पद्माकरं दिनकरो विकचीकरोति",
     "end": "line"
    },
    {
     "n": 2,
     "text": "चन्द्रो विकाशयति कैरवचक्रवालम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "नाभ्यर्थितो जलधरोपि[१] जलं ददाति",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सन्तः स्वयं परहितेषु[२] कृताभियोगाः ॥ ७३ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "दिनं दिवसं करोतीति दिनकरः सूर्यः । कृञो हेतुताच्छील्यानुलोम्येषु",
     "end": "space"
    },
    {
     "n": 2,
     "text": "(३. २. २०) इति टप्रत्ययः । न अभ्यर्थितो याचितः अनभ्यर्थितः । सन्नपि ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "पद्मानामाकरः पद्मसमूहस्तम् । विकचं प्रफुल्लं करोति । प्रफुल्लोत्फुल्लसंफुल्ल-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "व्याकोचविकचस्फुटाः । इत्यमरः । कैरवचक्रवालं कुमुदखण्डम् । सिते",
     "end": "space"
    },
    {
     "n": 5,
     "text": "कुमुदकैरवौ इत्यमरः । विहितः । अभितो योगः अभियोग उत्साहपूर्वको यत्नः",
     "end": "space"
    },
    {
     "n": 6,
     "text": "यैस्ते । अर्थान्तरन्यासालं० । वसन्त० वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अथ पुरुषाणामुत्तमादिप्रकारमाह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r8",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "एते[३] सत्पुरुषाः परार्थघटकाः स्वार्थं[४] परित्यज्य ये",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सामान्यास्तु परार्थमुद्यमभृतः स्वार्थाविरोधेन ये ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तेमी मानवराक्षसाः[५] परहितं स्वार्थाय निघ्नन्ति ये",
     "end": "line"
    },
    {
     "n": 4,
     "text": "ये तु घ्नन्ति निरर्थकं परहितं ते के न जानीमहे ॥ ७४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r9",
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "परेषामर्थः प्रयोजनं तद्घटनशीलाः । अर्थोभिधेयरैवस्तुप्रयोजननिवृत्तिषु ।",
     "end": "space"
    },
    {
     "n": 2,
     "text": "इत्यमरः । ये परार्थं परकार्यनिर्वाहार्थमुद्यभृत उद्योगभाजः । ते मध्यमा इत्यर्थः ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "मानवा राक्षसा इव मानवराक्षसाः । तद्वत्क्रूराचारा इत्यर्थः । निरर्थकं प्रयोजन-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "मन्तरेणैव । शार्दूल० वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r10",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अथ नीरक्षीरदृष्टान्तेन सन्मैत्रीं वर्णयति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r11",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "क्षीरेणात्मगतोदकाय हि गुणा[६] दत्ताः पुरा तेऽखिलाः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "क्षीरे तापमवेक्ष्य[७] तेन पयसा स्वात्मा[८] कृशानौ हुतः ।",
     "end": "line"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r12",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ पि जलदः सलिलम्",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r13",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "२ परहिते सुकृताभियोगाः.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r14",
   "type": "footnote",
   "lines": [
