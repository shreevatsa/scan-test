     "text": "४ स्वार्थान्.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r16",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "५ मानुष .",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r17",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "६ सकला दत्ता निजा ये गुणाः",
     "end": "space"
    }
   ],
   "uncertain": false,
