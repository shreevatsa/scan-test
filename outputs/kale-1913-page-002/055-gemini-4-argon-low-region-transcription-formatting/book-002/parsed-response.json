{
 "regions": [
  {
   "id": "r1",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "॥ श्रीः ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r2",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "",
     "end": "space"
    },
    {
     "n": 2,
     "text": "अथ श्रीमद्भर्तृहरिविरचितं",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "नीतिशतकम् ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "commentator_verse",
   "lines": [
    {
     "n": 1,
     "text": "योनादिरप्यनुजिघृक्षुरपत्यहेतो-",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स्तीव्रं तपो विदधतं मुनिमत्रिसंज्ञम् ॥",
     "end": "line"
    },
    {
     "n": 3,
     "text": "त्रेधा विभज्य निजरूपमगात्स्वयं तं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "भूयात्सदा स भगवान्भजकार्तिहारी ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "commentator_verse",
   "lines": [
    {
     "n": 1,
     "text": "कृतं यद्भर्तृहरिणा सुभाषितशतत्रयम् ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "टीकां बालहितां तस्य विदधामि यथामति ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "commentator_verse",
   "lines": [
    {
     "n": 1,
     "text": "दत्तात्रेयं नमस्कृत्य परं कारुणिकं गुरुम् ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "तत्प्रसादबलादत्र प्रवृत्तोहं न धीगुणात् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "introduction",
   "lines": [
    {
     "n": 1,
     "text": "अथ तत्रभवान्नृपश्रेष्ठः श्रीभर्तृहरिः कविः सदाचारस्य नीतिज्ञानपूर्वक-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "त्वान्नीतिशतकं विषयोपभोगस्य परिणामविरसत्वाद्वैराग्यं प्रति हेतुतया शृंगार-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "शतकमुत्पन्नाया वैराग्यबुद्धेर्दृढीकरणाय वैराग्यशतकं च अज्ञानोपहतात्मजिधृक्षया",
     "end": "space"
    },
    {
     "n": 4,
     "text": "रिरचयिषुरादौ नीतिशतकमारभमाणो मङ्गलादीनि...हि शास्त्राणि प्रथन्ते वीर-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "पुरुषाण्यायुष्मत्पुरुषकाणि च भवन्ति अध्येतारश्च प्रवक्तारो भवन्ति परिसमा-",
     "end": "hyphen"
    },
    {
     "n": 6,
     "text": "प्तिकामो मङ्गलमाचरेदित्यादिवचनानुरोधात् प्रारिप्सिताविघ्नपरिसमाप्तिसंप्रदाया-",
     "end": "hyphen"
    },
    {
     "n": 7,
     "text": "विच्छेदादिफलकामो ब्रह्मरूपेष्टदेवतानमस्कारात्मकं मङ्गलमुपनिबध्नाति ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r8",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "दिक्का[१]लाद्यनवच्छिन्नानन्तचिन्मात्रमूर्तये ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स्वानुभू[२]त्येकमाना[३]य नमः शान्ताय तेजसे ॥ १ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r9",
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "<b>दिगिति</b>—दिग्दिशा । कालो भूतभविष्यद्वर्तमानलक्षणः । दिक्च कालश्च",
     "end": "space"
    },
    {
     "n": 2,
     "text": "दिक्कालौ तावादी येषां ते दिक्कालादयः । आदिशब्देन गुणादयो ग्राह्याः ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "दिक्कालादिभिरनवच्छिन्नमपरिमितम् । न विद्यते अन्तो यस्य तदनन्तम् । चिदेव",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r10",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ दिक्कालानवच्छिन्नाय चिन्मात्रानन्तमूर्तये.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r11",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "२ भूत्यै.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r12",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "३ साराय. इ० पा०.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  }
 ],
