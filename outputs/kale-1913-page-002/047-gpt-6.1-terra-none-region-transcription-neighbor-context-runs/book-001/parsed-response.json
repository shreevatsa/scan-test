{
 "regions": {
  "r1": {
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "॥ श्रीः ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r2": {
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "",
     "end": "space"
    },
    {
     "n": 2,
     "text": "अथ श्रीमद्भर्तृहरिविरचितं",
     "end": "line"
    },
    {
     "n": 3,
     "text": "नीतिशतकम् ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r3": {
   "type": "commentator_verse",
   "lines": [
    {
     "n": 1,
     "text": "योऽनादिरप्यनुजिघृक्षुरपत्यहेतो-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "स्तीव्रं तपो विदधतं मुनिमत्रिसंज्ञम् ॥",
     "end": "line"
    },
    {
     "n": 3,
     "text": "त्रेधा विभज्य निजरूपमगात्स्वयं तं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "भूयात्सदा स भगवान्भजकार्तिहारी ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some characters in the first and last lines are difficult to distinguish."
  },
  "r4": {
   "type": "commentator_verse",
   "lines": [
    {
     "n": 1,
     "text": "कृतं यद्भर्तृहरिणा सुभाषितशतत्रयम् ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "टीकां बालहितां तस्य विदधामि यथामति ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "commentator_verse",
   "lines": [
    {
     "n": 1,
     "text": "दत्तात्रेयं नमस्कृत्य परं कारुणिकं गुरुम् ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "तत्प्रसादंबलादत्र प्रवृत्तोऽहं न धीगुणात् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The reading and spacing of तत्प्रसादंबलादत्र are uncertain."
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "अथ तत्रभवान्नृपश्रेष्ठः श्रीभर्तृहरिः कविः सदाचारस्य नीतिज्ञानपूर्वक-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "त्वान्नीतिशतकं विषयोपभोगस्य परिणामविरसत्वाद्वैराग्यं प्रति हेतुतया शृंगार-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "शतकमुत्पन्नाया वैराग्यबुद्धेर्दृढीकरणाय वैराग्यशतकं च अज्ञानोपहतात्मजिघृक्षया",
     "end": "space"
    },
    {
     "n": 4,
     "text": "रिरचयिषुरादौ नीतिशतकमारभमाणो मङ्गलादीनि...हि शास्त्राणि प्रथन्ते वीर-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "पुरुषाण्यायुष्मत्पुरुषकाणि च भवन्ति अध्येतारश्च प्रवक्तारो भवन्ति परिसमा-",
     "end": "hyphen"
    },
    {
     "n": 6,
     "text": "प्तिकामो मङ्गलमाचरेदित्यादिवचनानुरोधात् प्रारिप्सिताविघ्नपरिसमाप्तिसंप्रदाया-",
     "end": "hyphen"
    },
    {
     "n": 7,
     "text": "विच्छेदादिफलकामो ब्रह्मरूपेष्टदेवतानमस्कारात्मकं मङ्गलमुपनिबध्नाति ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several densely printed words, especially in lines 2–4, are uncertain."
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "दिक्कालाद्यनवच्छिन्नानन्तचिन्मात्रमूर्तये[१] ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स्वानुभूत्येकमानाय[३] नमः शान्ताय तेजसे ॥ १ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The first footnote marker is printed over the beginning of the line; marker २ appears over मूर्तये."
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "दिगिति—दिग्दिशा । कालो भूतभविष्यद्वर्तमानलक्षणः । दिक्च कालश्च",
     "end": "space"
    },
    {
     "n": 2,
     "text": "दिक्कालौ तावादी येषां ते दिक्कालादयः । आदिशब्देन गुणादयो ग्राह्याः ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "दिक्कालादिभिरनवच्छिन्नमपरिमितम् । न विद्यते अन्तो यस्य तदनन्तम् । चिदेव",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The right edge of each line is heavily inked."
  },
  "r9": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ दिक्कालानवच्छिन्नाय चिन्मात्रानन्तमूर्तये.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r10": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "२ मूर्त्तये.",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The form of the conjunct in मूर्त्तये is uncertain."
  },
  "r11": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "३ साराय. इ० पा०.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  }
 },
