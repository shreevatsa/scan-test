{
 "regions": [
  {
   "id": "r2",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "मानितामुद्दिश्याह ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "",
     "end": "join"
    },
    {
     "n": 2,
     "text": "विपुलहृदयैर्धन्यैः कैश्चिज्जगज्जनितं पुरा",
     "end": "line"
    },
    {
     "n": 3,
     "text": "विधृतमपरैर्दत्तं चान्यैर्विजित्य तृणं यथा ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "",
     "end": "join"
    },
    {
     "n": 5,
     "text": "इह हि भुवनान्यन्ये धीराश्चतुर्दश भुञ्जते",
     "end": "line"
    },
    {
     "n": 6,
     "text": "कतिपयपुरस्वाम्ये पुंसां क एष मदज्वरः ॥ २३ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "निस्पृहाणामधिकारमाह ।",
     "end": "join"
    },
    {
     "n": 2,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "त्वं राजा वयमप्युपासितगुरुप्रज्ञाभिमानोन्नताः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "ख्यातस्त्वं विभवैर्यशांसि कवयो दिक्षु प्रतन्वन्ति नः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इत्थं मानद नातिदूरमुभयोरप्यावयोरन्तरं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "यद्यस्मासु पराङ्मुखोसि वयमप्येकान्ततो निस्पृहाः ॥ २४ ॥",
     "end": "join"
    },
    {
     "n": 5,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अभुक्तायां यस्यां क्षणमपि न यातं नृपशतै-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "",
     "end": "join"
    },
    {
     "n": 3,
     "text": "र्भुवस्तस्या लाभे क इव बहुमानः क्षितिभुजाम् ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "तदंशस्याप्यंशे तदवयवलेशेपि पतयो",
     "end": "line"
    },
    {
     "n": 5,
     "text": "विषादे कर्तव्ये विदधति जडाः प्रत्युत मुदम् ॥ २५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
