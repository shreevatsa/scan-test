          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"the first line comp. Manu VII. 89. quoted in the com.; also Bg.\",\"end\":\"space\"},{\"n\":2,\"text\":\"II. 38. or the following stanza quoted by Madhus\u00fbdana\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"Saraswati. under Git\u00e2 1. 31.\u2014\u0926\u094d\u0935\u093e\u0935\u093f\u092e\u094c \u092a\u0941\u0930\u0941\u0937\u094c \u0932\u094b\u0915\u0947 \u0938\u0942\u0930\u094d\u092f\u092e\u0923\u094d\u0921\u0932\u092d\u0947\u0926\u093f\u0928\u094c \u0964\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u092a\u0930\u093f\u0935\u094d\u0930\u093e\u0921\u094d \u092f\u094b\u0917\u092f\u0941\u0915\u094d\u0924\u0936\u094d\u091a \u0930\u0923\u0947 \u091a\u093e\u092d\u093f\u092e\u0941\u0916\u094b \u0939\u0924\u0903 \u0965 \u0924\u093f\u0937\u094d\u0920\u0924\u0941 \u0924\u093e\u0935\u0924\u094d\u2014let that be\",\"end\":\"space\"},{\"n\":6,\"text\":\"apart, leave aside all consideration about. Cf. \u0924\u093f\u0937\u094d\u0920\u0924\u0941 \u0924\u093e\u0935\u0926\u094d\u0930\u0935\u0924\u094b\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0935\u0940\u0930\u0924\u093e Vik. \u0938\u093e\u0927\u0941\u0935\u093e\u0926\u0903\u2014praise\u2014\u0938\u093e\u0927\u0941 \u0907\u0924\u093f \u0935\u093e\u0926\u0903 \u0935\u091a\u0928\u092e\u094d \u0964 \u0936\u094d\u0930\u0935\u0923\u0938\u0941\u0916\u0903\u2014\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0936\u094d\u0930\u0935\u0923\u0902 \u0938\u0941\u0916\u092f\u0924\u0940\u0924\u093f. Leaving aside all consideration of the\",\"end\":\"space\"},{\"n\":9,\"text\":\"attainment of heaven or victory, the applause of both the\",\"end\":\"space\"},{\"n\":10,\"text\":\"armies is not an insignificant gain for a man who falls wounded\",\"end\":\"space\"},{\"n\":11,\"text\":\"in the front rank in a battle.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit in the damaged lines is difficult to read.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl 9. \u0907\u092f\u0924\u093f\u2014of this extent. \u090f\u0924\u0938\u094d\u092e\u093f\u0928\u094d\u2014seems to mean\u2013of this\",\"end\":\"space\"},{\"n\":2,\"text\":\"nature. \u092a\u094d\u0930\u092d\u0935\u0924\u093f\u2014stands at the top; appears preeminently in the\",\"end\":\"space\"},{\"n\":3,\"text\":\"front. \u0935\u0930\u093e\u0939\u2014the third incarnation of Vishnu who lifted up the\",\"end\":\"space\"},{\"n\":4,\"text\":\"earth when the demon Hira\u1e47y\u00e1ksha, brother of Hira\u1e47yakashipu,\",\"end\":\"space\"},{\"n\":5,\"text\":\"was carrying it with him into the depths of the ocean, and\",\"end\":\"space\"},{\"n\":6,\"text\":\"killed the demon. The reading, \u0926\u0928\u094d\u0924\u0938\u0932\u093f\u0932\u0948\u0903, is evidently a\",\"end\":\"space\"},{\"n\":7,\"text\":\"misprint occasioned by a copyist\u2019s blunder, and so it has been\",\"end\":\"space\"},{\"n\":8,\"text\":\"changed to \u0926\u0928\u094d\u0924 \u0938\u0932\u093f\u0932\u0947. The former hardly gives any sense.\",\"end\":\"space\"},{\"n\":9,\"text\":\"\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u0926\u0928\u094d\u0924\u092e\u0941\u0915\u0941\u0932\u0948\u0903 v. l. will not do, as the tusks of such Var\u00e2ha cannot,\",\"end\":\"space\"},{\"n\":11,\"text\":\"with any propriety, be compared to Mukulas. \u092a\u0930\u0903\u2013the other i. e.\",\"end\":\"space\"},{\"n\":12,\"text\":\"R\u00e2hu. For the allusion see note on \u0936\u0940\u0930\u094d\u0937\u093e\u0935\u0936\u0947\u0937\u093e\u0915\u0943\u0924\u0903 Sl. 34. The great-\",\"end\":\"hyphen\"},{\"n\":13,\"text\":\"ness of Var\u00e2ha consists in lifting up the earth on his tusk, and\",\"end\":\"space\"},{\"n\":14,\"text\":\"of R\u00e2hu in being generous enough to let go an enemy whom he\",\"end\":\"space\"},{\"n\":15,\"text\":\"has in his clutches. The figures are \u0915\u093e\u0935\u094d\u092f\u0932\u093f\u0902\u0917 and \u092f\u0925\u093e\u0938\u0902\u0916\u094d\u092f.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit readings and transliteration marks are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 10. \u0909\u0926\u0928\u094d\u0935\u0924\u094d\u2014the ocean, \u0909\u0926\u0915\u093e\u0928\u093f \u0938\u0928\u094d\u0924\u094d\u092f\u0924\u094d\u0930; from \u0909\u0926\u0915 + \u0935\u0924\u094d; \u0909\u0926\u0915\",\"end\":\"space\"},{\"n\":2,\"text\":\"is changed to \u0909\u0926\u0928\u094d by \u0909\u0926\u0928\u094d\u0935\u093e\u0928\u0941\u0926\u0927\u094c \u091a\u2019 \u0964 P\u00e2n VIII. 2. 13.\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0938\u0926\u093e \u092a\u093e\u0928\u094d\u0925\u0903\u2014ever moving along a path. \u092a\u093e\u0928\u094d\u0925 is derived as \u092a\u0928\u094d\u0925\u093e\u0928\u0902\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0928\u093f\u0924\u094d\u092f\u0902 \u0917\u091a\u094d\u091b\u0924\u0940\u0924\u093f; fr. \u092a\u0925\u093f\u0928\u094d+\u0905 (\u0905\u0923\u094d, \u092a\u0928\u094d\u0925\u093e\u0926\u0947\u0936\u0903). The space of the sky,\",\"end\":\"space\"},{\"n\":5,\"text\":\"although it may appear extensive, is everyday traversed by the\",\"end\":\"space\"},{\"n\":6,\"text\":\"sun. \u0915\u0932\u092f\u0924\u093f\u2014comprehends, takes the measure of. \u092d\u093e\u0935\u093e\u0903\u2014things.\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0938\u094d\u092b\u0941\u091f\u2013clear, well-defined. \u0905\u0935\u0927\u093f\u092e\u0941\u0926\u094d\u0930\u093e\u2014boundary-marks. \u092e\u0941\u0915\u0941\u0932\u093f\u0924\u093e\u0903\u2014\",\"end\":\"space\"},{\"n\":8,\"text\":\"encased, as the flower is in the bud; hence confined, delimited.\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u092a\u094d\u0930\u091c\u094d\u091e\u094b\u0928\u094d\u092e\u0947\u0937\u2014opening, blooming of the intellect, hence its brilliancy.\",\"end\":\"space\"},{\"n\":10,\"text\":\"The fig. in this sl. is \u0935\u094d\u092f\u0924\u093f\u0930\u0947\u0915 which is defined as \u0909\u092a\u092e\u093e\u0928\u093e\u0926\u094d\u092f\u0926\u0928\u094d\u092f\u0938\u094d\u092f\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words are difficult to distinguish in the scan.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 45 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"8\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"9\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"10\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
