          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"97. Is he a Chandala ( pariah ) or a Br\u00e2hmana ( twice-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"born ); is he a S\u00fadra or an ascetic, or is he some great saint,\",\"end\":\"space\"},{\"n\":3,\"text\":\"whose intellect is acute enough to understand philosophical\",\"end\":\"space\"},{\"n\":4,\"text\":\"truths: ascetics, although thus spoken of by people, garrulous\",\"end\":\"space\"},{\"n\":5,\"text\":\"on account of the doubts rising within them, quietly (or, self-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"delighted) go their way neither offended nor pleased at heart.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"98. The creator ordained the air to serve the serpents as\",\"end\":\"space\"},{\"n\":2,\"text\":\"food\u2014not involving the sin of destroying life, and accessible\",\"end\":\"space\"},{\"n\":3,\"text\":\"without any effort; animals living on land he made to eat\",\"end\":\"space\"},{\"n\":4,\"text\":\"grass; (but) to men, whose talents are capable of bearing\",\"end\":\"space\"},{\"n\":5,\"text\":\"them over the ocean of life, he has assigned such a living\",\"end\":\"space\"},{\"n\":6,\"text\":\"that while in pursuit of it all their good qualities are inva-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"riably brought to an end ( exhausted ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"99. Can those blessed days be ( in store ) for me, when\",\"end\":\"space\"},{\"n\":2,\"text\":\"I, having fixed myself in the Padm\u00e2sana posture on a slab in\",\"end\":\"space\"},{\"n\":3,\"text\":\"the Him\u00e2layas on the bank of the Ganges, and having gone\",\"end\":\"space\"},{\"n\":4,\"text\":\"to the sleep of concentration while in the act of constantly\",\"end\":\"space\"},{\"n\":5,\"text\":\"contemplating Br\u00e2hman, the old stags (growing) fearless\",\"end\":\"space\"},{\"n\":6,\"text\":\"will rub their bodies against mine ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"100. Those blessed ones\u2014whose hand is ( to them ) a clean\",\"end\":\"space\"},{\"n\":2,\"text\":\"pot, and alms acquired by wandering ( an ) inexhaus-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"tible ( supply of ) food, to whom the extensive ten quarters\",\"end\":\"space\"},{\"n\":4,\"text\":\"are as a spotless garment, and the earth as a spacious bed,\",\"end\":\"space\"},{\"n\":5,\"text\":\"whose development is in accepting renunciation, who are\",\"end\":\"space\"},{\"n\":6,\"text\":\"contented with themselves, and who have got rid of a num-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"ber of opportunities of humiliation\u2014root out Karma.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"101. O mother, earth; O father, wind; O friend, light;\",\"end\":\"space\"},{\"n\":2,\"text\":\"O water, my good relation, and O brother, sky; here do\",\"end\":\"space\"},{\"n\":3,\"text\":\"I fold, for the last time, my palms in salutation to you; by\",\"end\":\"space\"},{\"n\":4,\"text\":\"means of pure knowledge resulting from the preponderance\",\"end\":\"space\"},{\"n\":5,\"text\":\"of merit accumulated by virtue of association with you, all\",\"end\":\"space\"},{\"n\":6,\"text\":\"the trammels of infatuation having been removed, I now\",\"end\":\"space\"},{\"n\":7,\"text\":\"merge in the Supreme Brahman.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 44 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"97\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"98\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"99\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"100\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"101\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
