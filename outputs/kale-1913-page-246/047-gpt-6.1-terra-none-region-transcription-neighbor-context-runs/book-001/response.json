          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 11. \u0928\u0948\u0930\u094d\u091d\u0930-\u0928\u093f\u0930\u094d\u091d\u0930\u0938\u092e\u094d\u092c\u0928\u094d\u0927\u093f of a spring. \u0909\u091a\u093f\u0924 proper. \u0935\u093f\u0926\u094d\u092f\u093e\u0919\u094d\u0917\u0928\u093e\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u2014\u0935\u093f\u0926\u094d\u092f\u093e \u090f\u0935 \u0905\u0919\u094d\u0917\u0928\u093e ( \u092a\u094d\u0930\u0936\u0938\u094d\u0924\u093e\u0928\u093f \u0905\u0919\u094d\u0917\u093e\u0928\u093f \u092f\u0938\u094d\u092f\u093e\u0903 \u0938\u093e; fr. \u0905\u0919\u094d\u0917+\u0928 ) a\",\"end\":\"space\"},{\"n\":3,\"text\":\"beautiful woman. \u0930\u0924\u094d\u092f\u0948\u2014for deriving pleasure which is usually\",\"end\":\"space\"},{\"n\":4,\"text\":\"had from woman\u2019s society. The dat. is \u0924\u093e\u0926\u0930\u094d\u0925\u094d\u092f\u0947\u2014Mr. Telang who\",\"end\":\"space\"},{\"n\":5,\"text\":\"reads \u0930\u0924\u094d\u092f\u0947\u0935 supposes that \u0930 might be a mislection for \u0938 ( \u092f\u0947\u0928\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0935\u093f\u0926\u094d\u092f\u0948\u0935 \u0938\u0924\u0940 \u0905\u0919\u094d\u0917\u0928\u093e ). \u0938\u0947\u0935\u093e\u091e\u094d\u091c\u0932\u093f\u0903\u2014the bow of obeisance.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words are blurred, particularly in the first two lines.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 12. \u0924\u094d\u0930\u093f\u0932\u094b\u0915\u0940\u0938\u0930\u093f\u0924\u094d\u2014the Ganges, so called because it flows\",\"end\":\"space\"},{\"n\":2,\"text\":\"through the three worlds, \u0938\u094d\u0935\u0930\u094d\u0917, \u092e\u0943\u0924\u094d\u092f, and \u092a\u093e\u0924\u093e\u0932. \u0928\u0940\u0935\u093f-the tie-knot\",\"end\":\"space\"},{\"n\":3,\"text\":\"of a woman\u2019s under-garment and sometimes the garment itself.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0915\u0932\u094d\u092a\u092f\u0928\u094d\u0924\u0940\u0966 providing, supplying; for \u091b\u093e\u0924\u093f comp. the preceding\",\"end\":\"space\"},{\"n\":5,\"text\":\"sloka. \u0926\u0941\u0903\u0916\u093e\u0938\u093f\u0915\u093e\u0928\u093e\u092e\u094d\u2014trying or painful circumstances; or \u0926\u0941\u0903\u0916\u092e-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\u0938\u093f\u0915\u093e \u0907\u0935 poignant pain (lit. misery cutting like a poniard ). For\",\"end\":\"space\"},{\"n\":7,\"text\":\"a similar idea cf. \u0926\u0940\u0928\u093e \u0926\u0940\u0928\u092e\u0941\u0916\u0948\u0903 &c. sl. 22. supra.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit readings are indistinct, especially the split word in lines 5\u20136.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 13. \u0924\u0940\u0935\u094d\u0930\u093e\u0924\u093f\u0924\u0940\u0935\u094d\u0930\u0902 \u0924\u092a\u0903\u2014is the same to an ascetic as \u0909\u0926\u094d\u092f\u093e\u0928\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0966\u0935\u093f\u0927\u093f to ordinary mortals. The two expressions are here identifi-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"ed and mean-to the ascetic penance is like a garden-party. Some\",\"end\":\"space\"},{\"n\":4,\"text\":\"take the two expressions separately, but then there is hardly\",\"end\":\"space\"},{\"n\":5,\"text\":\"any propriety of garden parties in the case of a saint. \u0905\u092e\u093f\u0924\u0902\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u092d\u093f\u0915\u094d\u0937\u093e\u091f\u0928\u0902 \u092e\u0923\u094d\u0921\u0928\u092e\u094d\u2014( where) a roaming for alms, not measured, i. e.\",\"end\":\"space\"},{\"n\":7,\"text\":\"at one\u2019s will, is a glory. \u0939\u0928\u094d\u0924 is here used \u0916\u0947\u0926\u0947, to show the\",\"end\":\"space\"},{\"n\":8,\"text\":\"poet\u2019s regret at wise men staying elsewhere, and not in Benares.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit expressions in lines 1 and 5 are not entirely clear.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 14. The first line and half of the second contain the\",\"end\":\"space\"},{\"n\":2,\"text\":\"replies of gate-keepers or guards to supposed questions. \u0938\u092e\u092f\u0903\u2014\",\"end\":\"space\"},{\"n\":3,\"text\":\"the proper time. \u0930\u0939\u0938\u094d\u092f\u0902\u2014He ( the master ) is now engaged in\",\"end\":\"space\"},{\"n\":4,\"text\":\"confidential matters; or as Mr. Telang takes it-now he is in\",\"end\":\"space\"},{\"n\":5,\"text\":\"private. \u0926\u094d\u0930\u0915\u094d\u0937\u094d\u092f\u0924\u093f\u2014\u0926\u094d\u0930\u0915\u094d\u0937\u094d\u092f\u0924\u093f v. l. does not make good sense. \u0926\u094c\u0935\u093e\u0930\u093f\u0915-\",\"end\":\"space\"},{\"n\":6,\"text\":\"( fr. \u0926\u094d\u0935\u093e\u0930+\u0920\u0915\u094d ) a door-keeper. \u0905\u092a\u0942\u0930\u094d\u0935\u0902\u2014may be taken as a\",\"end\":\"space\"},{\"n\":7,\"text\":\"separate word or as part of the preceding compound word.\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0928\u093f\u0903\u0938\u0940\u092e\u0902 &c.\u2014\u0928\u093f\u0903\u0938\u0940\u092e\u0902 \u0936\u0930\u094d\u092e \u092a\u094d\u0930\u0926\u0926\u093e\u0924\u0940\u0924\u093f \u0964 conferring unbounded\",\"end\":\"space\"},{\"n\":9,\"text\":\"happiness.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit lemma and variant in line 5 and the word in line 6 are difficult to distinguish.\"},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 15. \u092b\u0932\u0935\u0924\u093f-breaks the symmetry as this is the only noun\",\"end\":\"space\"},{\"n\":2,\"text\":\"having an adj. to qualify it. \u0924\u0943\u0923\u0947 \u0935\u093e \u0938\u094d\u0924\u094d\u0930\u0948\u0923\u0947 \u0935\u093e\u2014\u0938\u094d\u0924\u094d\u0930\u0948\u0923 is used here more\",\"end\":\"space\"},{\"n\":3,\"text\":\"for the sake of alliteration than as being the recognised opposite\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The first Sanskrit lemma is somewhat blurred.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 81 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"other\",\"lines\":[{\"n\":1,\"text\":\"6\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"11\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"12\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"13\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"14\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"15\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
