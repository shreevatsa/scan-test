      "content": [
        {
          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"of a prince's eye-brows. \u0915\u0928\u094d\u0925\u093e\u0915\u091e\u094d\u091a\u0941\u0915\u093f\u0924\u093e\u0903\u2014\u0915\u091e\u094d\u091a\u0941\u0915\u0903 \u090f\u0937\u093e\u0902 \u0938\u0902\u091c\u093e\u0924\u0903 \u0915\u091e\u094d\u091a\u0941-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u0915\u093f\u0924\u093e\u0903 \u0964 \u0915\u091e\u094d\u091a\u0941\u0915 is a word of the \u0924\u093e\u0930\u0915\u093e\u0926\u093f group and therefore it\",\"end\":\"space\"},{\"n\":3,\"text\":\"takes the possessive aff. \u0907\u0924. Cf. \u0938\u094d\u092f\u0941\u0924\u0915\u0902\u0925\u093e \u0927\u0930\u0903. Sl. 96. Infra.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit text is unclear.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 67. \u0926\u093e\u0915\u094d\u0937\u093f\u0923\u093e\u0924\u094d\u092f\u093e\u0903\u2014Fr. \u0926\u0915\u094d\u0937\u093f\u0923 + \u0924\u094d\u092f\u0915\u094d meaning \u2018of that place\u2019;\",\"end\":\"space\"},{\"n\":2,\"text\":\"poets of the Deccan who were masters of the Vaidarbhi style of\",\"end\":\"space\"},{\"n\":3,\"text\":\"composition which is regarded as the best. The Vaid. style\",\"end\":\"space\"},{\"n\":4,\"text\":\"has ten qualities; see K\u00e1vya. I. S\u00e0h. Dar. describes it as \u092e\u093e\u0927\u0941\u0930\u094d\u092f-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"\u0935\u094d\u092f\u091e\u094d\u091c\u0915\u0948\u0930\u094d\u0935\u0930\u094d\u0923\u0948 \u0930\u091a\u093f\u0924\u093e \u0932\u0932\u093f\u0924\u093e\u0924\u094d\u092e\u093f\u0915\u093e \u0964 \u0905\u0935\u0943\u0924\u094d\u0924\u093f\u0930\u0932\u094d\u092a\u0935\u0943\u0924\u094d\u0924\u093f\u0930\u094d\u0935\u093e ( having no or very\",\"end\":\"space\"},{\"n\":6,\"text\":\"few compounds ) \u0935\u0948\u0926\u0930\u094d\u092d\u0940\u0930\u0940\u0924\u093f\u0930\u093f\u0937\u094d\u092f\u0924\u0947 \u0965 \u092f\u0925\u0947\u0937\u094d\u091f\u092e\u0947\u0935\u092e\u094d\u2014but this is not\",\"end\":\"space\"},{\"n\":7,\"text\":\"possible except in very few instances, and so the didactic chara-\",\"end\":\"hyphen\"},{\"n\":8,\"text\":\"cter of the verse cannot be marred by its apparent acquiescence\",\"end\":\"space\"},{\"n\":9,\"text\":\"in the enjoyment of pleasures.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit and transliterated readings are unclear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 68. \u0915\u0932\u094d\u092a\u0902 \u0938\u094d\u0925\u093f\u0924\u0902\u2014Nouns showing duration of time are\",\"end\":\"space\"},{\"n\":2,\"text\":\"put in the Acc. case. P\u00e1n. II. 3. 5. For \u0915\u0932\u094d\u092a see notes, N\u00edt. 16.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 69. \u092e\u0930\u0923\u091c\u0928\u094d\u092e\u092d\u092f\u0902 \u0939\u0943\u0926\u093f\u0938\u094d\u0925\u092e\u094d\u2014If this fear is present in the\",\"end\":\"space\"},{\"n\":2,\"text\":\"mind of man, he will try to obtain final beatitude; but if he is\",\"end\":\"space\"},{\"n\":3,\"text\":\"not aware of it, he will not work out his salvation. \u0939\u0943\u0926\u093f\u0938\u094d\u0925\u092e\u094d an\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"aluk compound. Cf. this with the preceding sl.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 70. \u0905\u091c\u0930\u2014not subject to old age as it is \u0928\u093f\u0930\u094d\u0935\u093f\u0915\u093e\u0930; comp.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0938\u0924\u094d\u092f\u0902 \u091c\u094d\u091e\u093e\u0928\u092e\u0928\u0928\u094d\u0924\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\u2019 Tait. Up.; \u092a\u0941\u0930\u093e\u0923\u092e\u091c\u0930\u0902 \u0935\u093f\u0926\u0941\u0903 \u0964 Rag. X. 19. \u092a\u0930\u092e\u092e\u094d\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u2014The highest. \u092a\u0930\u093e \u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f\u093e \u092e\u093e \u0936\u092c\u094d\u0926\u0947\u0928 \u092e\u093e\u092f\u093e\u0916\u094d\u092f\u093e \u0936\u0915\u094d\u0924\u093f\u0930\u094d\u092f\u0938\u094d\u092f \u0964 \u0905\u0925\u0935\u093e\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u092a\u0930\u093e \u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f\u093e \u092e\u093e \u0936\u094b\u092d\u093e \u092f\u0938\u094d\u092f \u0924\u0924\u094d\u0924\u0925\u093e \u0964 R\u00e2marshi. \u0935\u093f\u0915\u093e\u0938\u093f\u2014Cf The\",\"end\":\"space\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"S\u2019rutis \u092a\u0930\u093e\u0938\u094d\u092f \u0936\u0915\u094d\u0924\u093f\u0930\u094d\u0935\u093f\u0935\u093f\u0927\u0948\u0935 \u0936\u094d\u0930\u0942\u092f\u0924\u0947 \u0938\u094d\u0935\u093e\u092d\u093e\u0935\u093f\u0915\u0940 \u091c\u094d\u091e\u093e\u0928\u092c\u0932\u0915\u094d\u0930\u093f\u092f\u093e \u091a and\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0924\u092e\u0947\u0935 \u092d\u093e\u0928\u094d\u0924\u092e\u0928\u0941\u092d\u093e\u0924\u093f \u0938\u0930\u094d\u0935\u0902 \u0924\u0938\u094d\u092f\u0948\u0935 \u092d\u093e\u0938\u093e \u0938\u0930\u094d\u0935\u092e\u093f\u0926\u0902 \u0935\u093f\u092d\u093e\u0924\u093f \u0964 \u0935\u093f\u0915\u0932\u094d\u092a\u2014\u0935\u093f\u0937\u092f\",\"end\":\"space\"},{\"n\":9,\"text\":\"R\u00e1marshi; or rather fancies, dreams, as Mr. Telang takes it.\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u0905\u0928\u0941\u092a\u093e\u0919\u094d\u0917\u093f\u0923\u0903\u2014those that follow, depend upon. \u0915\u0943\u092a\u0923\u0948\u0903\u2014highly valued\",\"end\":\"space\"},{\"n\":11,\"text\":\"by mean people. \u0915\u0943\u092a\u0923 may also mean poor, to be pitied ( for los-\",\"end\":\"hyphen\"},{\"n\":12,\"text\":\"ing sight of the real ); see com.; supra\u2013\u0917\u0939\u0928\u093e\u0915\u094d\u0937\u0947\u092a\u0915\u0943\u092a\u0923\u0903 \u0964 Mis. 2.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words are difficult to distinguish.\"},\"r7\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 71. \u092e\u093e\u0928\u0938 Voc. sing.; some take \u092e\u093e\u0928\u0938\u091a\u093e\u092a\u0932\u0947\u0928 as a comp.\",\"end\":\"space\"},{\"n\":2,\"text\":\"meaning \u2018with the swiftness of thought ( lit. mind ;\u2019 and\",\"end\":\"space\"},{\"n\":3,\"text\":\"suppose the verse to be addressed to man in general. R\u00e2marshi\",\"end\":\"space\"},{\"n\":4,\"text\":\"favours the former view. \u091c\u093e\u0924\u0941\u2014with the negative means\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u2018Never.\u2019 \u0906\u0924\u094d\u092e\u0928\u0940\u0928\u092e\u094d\u2014\u0906\u0924\u094d\u092e\u0928\u0947 \u0939\u093f\u0924\u092e\u094d tending to one's benefit. \u0906\u0924\u094d\u092e-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\u0935\u093f\u092d\u091c\u0928\u092d\u094b\u0917\u094b\u0924\u094d\u0924\u0930\u092a\u0926\u093e\u0924\u094d \u0916\u0903 \u0964 P\u00e1n. V. 1. 9. \u0906\u0924\u094d\u092e\u0928\u094d, \u0935\u093f\u092d\u091c\u0928, and\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The punctuation and Sanskrit grammatical quotation are not fully clear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 70 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"67\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"68\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"69\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"70\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"stanza_note\",\"number\":\"71\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]},{\"flow\":\"notes\",\"units\":[]}],\"relations\":[]}"
        }
