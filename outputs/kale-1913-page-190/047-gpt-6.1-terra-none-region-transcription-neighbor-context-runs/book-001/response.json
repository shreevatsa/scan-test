          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Nan. Bah. \u0938\u094d\u0935\u093e\u0915\u0943\u0924\u0947\u0903\u2014\u092c\u0939\u0941 \u0906\u0915\u0943\u0924\u093f\u0930\u094d\u092f\u0938\u094d\u092f \u0924\u0938\u094d\u092f \u0964 Cf. \u2018unlettered, illiterate\u2019\",\"end\":\"space\"},{\"n\":2,\"text\":\"in English. Want of learning becomes a disgrace more marked\",\"end\":\"space\"},{\"n\":3,\"text\":\"in such a case. \u0938\u0924\u0924\u0926\u0941\u0930\u094d\u0917\u0924\u0903\u2014Here the word \u0938\u0924\u0924 is to be empha-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"sised. \u0928\u0943\u092a\u093e\u0919\u094d\u0917\u0923\u2013Both \u0905\u0919\u094d\u0917\u0928 and \u0905\u0919\u094d\u0917\u0923 are found used by classical\",\"end\":\"space\"},{\"n\":5,\"text\":\"writers, though the former is the correct form. The change of\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0928 to \u0923 in \u0905\u0919\u094d\u0917\u0923 is explained by referring it to the \u092a\u0943\u0937\u094b\u0926\u0930\u093e\u0926\u093f\",\"end\":\"space\"},{\"n\":7,\"text\":\"group.\u2013\u00b0\u0917\u0924\u0903 \u0916\u0932\u0903 a wicked man gone to the courtyard of a king\u2019s\",\"end\":\"space\"},{\"n\":8,\"text\":\"palace. This may also be metaphorical\u2014who has curried royal\",\"end\":\"space\"},{\"n\":9,\"text\":\"favour. This sl. is quoted in the K. P. as an instance of the\",\"end\":\"space\"},{\"n\":10,\"text\":\"fig. \u0938\u092e\u0941\u091a\u094d\u091a\u092f\u2013\u0905\u0924\u094d\u0930 \u0936\u0936\u093f\u0928\u093f \u0927\u0942\u0938\u0930\u0947 \u0938\u0924\u093f \u0936\u0932\u094d\u092f\u093e\u0928\u094d\u0924\u0930\u093e\u0923\u093e\u092e\u093f\u0924\u093f \u0936\u094b\u092d\u0928\u093e\u0936\u094b\u092d\u0928\u092f\u094b\u0917\u0903 ( of\",\"end\":\"space\"},{\"n\":11,\"text\":\"causes which are partly agreeable and partly otherwise ). For\",\"end\":\"space\"},{\"n\":12,\"text\":\"definition see com. Here the moon alone obscured by day is\",\"end\":\"space\"},{\"n\":13,\"text\":\"sufficient to become a s'alya ( sore affliction ) and yet others\",\"end\":\"space\"},{\"n\":14,\"text\":\"are mentioned.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words, especially in lines 1 and 10, are difficult to read.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 57. \u0939\u094b\u0924\u093e\u0930\u092e\u094d\u2014Here the word is used in its general sense;\",\"end\":\"space\"},{\"n\":2,\"text\":\"any sacrificer ( comp. \u092f\u093e \u091a \u0939\u094b\u0924\u094d\u0930\u0940 S'ak. I. ) and has nothing to do\",\"end\":\"space\"},{\"n\":3,\"text\":\"with the priest of that name at a great sacrifice. \u091c\u0941\u0939\u094d\u0935\u093e\u0928\u0902\u2013This is\",\"end\":\"space\"},{\"n\":4,\"text\":\"not the pre. p. of the root as it is always Par; but formed with\",\"end\":\"space\"},{\"n\":5,\"text\":\"the aff. \u091a\u093e\u0928\u0936\u094d; see note on \u091c\u0940\u0935\u092e\u093e\u0928\u0903 sl. 12. \u092a\u093e\u0935\u0915\u0903\u2014\u092a\u0941\u0928\u093e\u0924\u0940\u0924\u093f fire;\",\"end\":\"space\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u092a\u0942+\u0923\u094d\u0935\u0941\u0932\u094d ( \u0905\u0915 ) The fig. is \u0926\u0943\u0937\u094d\u091f\u093e\u0928\u094d\u0924 which is thus defined\u2014\u0926\u0943\u0937\u094d\u091f\u093e\u0928\u094d\u0924\u0903\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u092a\u0941\u0928\u0930\u0947\u0924\u0947\u0937\u093e\u0902 ( \u0909\u092a\u092e\u093e\u0928\u094b\u092a\u092e\u0947\u092f\u0938\u093e\u0927\u0930\u094d\u092e\u094d\u092f\u093e\u0923\u093e\u0902 ) \u0938\u0930\u094d\u0935\u0947\u0937\u093e\u0902 \u092a\u094d\u0930\u0924\u093f\u092c\u093f\u092e\u094d\u092c\u0928\u092e\u094d \u0964 K. P. X.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit participle in line 3 and grammatical affixes are not entirely clear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 58. \u091a\u093e\u091f\u0941\u0932\u0903\u2014\u091a\u091f\u0941\u0932 \u090f\u0935 \u091a\u093e\u091f\u0941\u0932\u0903 \u0964 \u091a\u091f\u0941\u0932 from \u091a\u091f\u094d+\u0932 ( \u0932\u091a\u094d )\",\"end\":\"space\"},{\"n\":2,\"text\":\"a possessive affix added to the words of the \u0938\u093f\u0927\u094d\u092e\u093e\u0926\u093f class; see\",\"end\":\"space\"},{\"n\":3,\"text\":\"P\u00e2n. V. 2. 97; garrulous, officious. \u091c\u0932\u094d\u092a\u0915\u0903\u2014The proper form is\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u091c\u0932\u094d\u092a\u093e\u0915\u0903; if we add \u0906\u0915 ( \u0918\u093e\u0915\u0928\u094d ) by \u091c\u0932\u094d\u092a\u092d\u093f\u0915\u094d\u0937\u2014P\u00e2n. III. 2. 155.\",\"end\":\"space\"},{\"n\":5,\"text\":\"Cf. Amara \u0938\u094d\u092f\u093e\u091c\u094d\u091c\u0932\u094d\u092a\u093e\u0915\u0938\u094d\u0924\u0941 \u0935\u093e\u091a\u093e\u0932\u0903. But as the form stands, it must\",\"end\":\"space\"},{\"n\":6,\"text\":\"be explained as \u091c\u0932\u094d\u092a\u0924\u0940\u0924\u093f \u091c\u0932\u094d\u092a\u0903, \u0915\u0941\u0924\u094d\u0938\u093f\u0924\u0903 \u091c\u0932\u094d\u092a\u0903 \u091c\u0932\u094d\u092a\u0915\u0903. \u0905\u092a\u094d\u0930\u0917\u0932\u094d\u092d\u2014\",\"end\":\"space\"},{\"n\":7,\"text\":\"timid. For the meaning of \u092a\u094d\u0930\u0917\u0932\u094d\u092d cf. \u2018\u0927\u0943\u0937\u094d\u091f \u092a\u094d\u0930\u0917\u0932\u094d\u092d\u093e \u092a\u094d\u0930\u0924\u093f\u0939\u093e\u0930\u0930\u0915\u094d\u0937\u0940\",\"end\":\"space\"},{\"n\":8,\"text\":\"Rag. VI. 20. \u0905\u092d\u093f\u091c\u093e\u0924\u0903\u2014noble-born, polite in behaviour,\",\"end\":\"space\"},{\"n\":9,\"text\":\"courteous. \u092f\u094b\u0917\u093f\u0928\u093e\u092e\u092a\u093f\u2014Yogins have superhuman power by their\",\"end\":\"space\"},{\"n\":10,\"text\":\"practice of contemplation and so they must know every thing.\",\"end\":\"space\"},{\"n\":11,\"text\":\"But this is unfathomable even to them. \u0905\u0917\u092e\u094d\u092f\u0903\u2014difficult to\",\"end\":\"space\"},{\"n\":12,\"text\":\"obtain success in; difficult properly to carry out. The other\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit grammatical terms and the quotation in line 7 are unclear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 25 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"56\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"57\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"58\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
