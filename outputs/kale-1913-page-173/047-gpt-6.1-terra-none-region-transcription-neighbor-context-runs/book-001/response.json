          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"the river in its literal sense; in the other case it means \u2018 in a\",\"end\":\"space\"},{\"n\":2,\"text\":\"hundred ways.\u2019 The fig. is Arth\u00e2ntarany\u00e2sa.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"Sl. 11. \u0939\u0941\u0924\u092d\u0941\u0915\u094d\u2014\u0939\u0941\u0924\u0902 \u092d\u0941\u0919\u094d\u0915\u094d\u0924\u0947 ( aff. \u0915\u094d\u0935\u093f\u092a\u094d ) fire. \u0938\u0942\u0930\u094d\u092f\u0903\u2013\u0938\u0930\u0924\u093f \u0906\u0915\u093e\u0936\u0947\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u092f\u0926\u094d\u0935\u093e \u0938\u0941\u0935\u0924\u093f \u0915\u0930\u094d\u092e\u0923\u093f \u0932\u094b\u0915\u0902 \u092a\u094d\u0930\u0947\u0930\u092f\u0924\u093f ( urges men to action ) \u0907\u0924\u093f. See\",\"end\":\"space\"},{\"n\":5,\"text\":\"Sid. Kau. on Pan. III, 1. 114. \u0928\u093e\u0917\u2014\u0928 \u0917\u091a\u094d\u091b\u0924\u0940\u0924\u093f \u0905\u0917\u0903 \u0928 \u0905\u0917\u0903 \u0928\u093e\u0917\u0903\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u092f\u0926\u094d\u0935\u093e \u0928\u0917\u0947 \u092d\u0935\u0903 \u0964 \u0928\u093e\u0917\u0947\u0937\u0941 \u0907\u0928\u094d\u0926\u094d\u0930\u0903 \u0936\u094d\u0930\u0947\u0937\u094d\u0920\u0903 \u092f\u0926\u094d\u0935\u093e \u0928\u093e\u0917\u094b\u092a\u092e\u0907\u0928\u094d\u0926\u094d\u0930 \u0907\u0935 upamita sam\u00e2sa.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit letters in the etymologies are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u0928\u093f\u0936\u093f\u0924\u2014p. p. of \u0936\u094b to sharpen; also \u0936\u093e\u0924. \u092e\u0928\u094d\u0924\u094d\u0930\u092a\u094d\u0930\u092f\u094b\u0917\u2014\u092e\u0928\u094d\u0924\u094d\u0930 is a\",\"end\":\"space\"},{\"n\":2,\"text\":\"spell, a charm, \u092a\u094d\u0930\u092f\u094b\u0917 is its employment for practical purposes.\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0935\u093f\u0937\u2014is m. and neu. \u0914\u0937\u0927 from \u0914\u0937\u0927\u093f + \u0905\u0923\u094d medicine. \u0913\u0937\u0903\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u092a\u093e\u0915\u0903 \u0927\u0940\u092f\u0924\u0947 \u0905\u0938\u094d\u092f\u093e\u092e\u093f\u0924\u093f \u0914\u0937\u0927\u093f\u0903 \u0964 \u0935\u093f\u0939\u093f\u0924 prescribed or laid down in\",\"end\":\"space\"},{\"n\":5,\"text\":\"the S'\u00e2stras. \u092e\u0942\u0930\u094d\u0916\u0938\u094d\u092f &c.\u2014i. e. for his folly.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit word after also is not fully clear.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 12. \u0938\u093e\u0939\u093f\u0924\u094d\u092f\u0966\u2014The best way is to take the comp. as\",\"end\":\"space\"},{\"n\":2,\"text\":\"consisting of three things, viz \u0938\u093e\u0939\u093f\u0924\u094d\u092f (\u0938\u0939\u093f\u0924\u0938\u094d\u092f \u092d\u093e\u0935\u0903 \u0937\u094d\u092f\u091e\u094d) poetics,\",\"end\":\"space\"},{\"n\":3,\"text\":\"composition, \u0938\u0902\u0917\u0940\u0924 music and \u0915\u0932\u093e or arts. See com. \u091c\u0940\u0935\u092e\u093e\u0928\u0903\u2014\",\"end\":\"space\"},{\"n\":4,\"text\":\"The verb \u091c\u0940\u0935\u094d is not Atm. and so the pre. p. ought to be \u091c\u0940\u0935\u0924\u094d.\",\"end\":\"space\"},{\"n\":5,\"text\":\"But the form is defended by the following rule of P\u00e2n. \u0924\u093e\u091a\u094d\u091b\u0940\u0932\u094d\u092f-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\u0935\u092f\u094b\u0935\u091a\u0928\u0936\u0915\u094d\u0924\u093f\u0937\u0941 \u091a\u093e\u0928\u0936\u094d. The term. \u0906\u0928 ( \u091a\u093e\u0928\u0936\u094d and not \u0936\u093e\u0928\u091a\u094d )\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"},{\"n\":8,\"text\":\"is applied to a root when it implies habit, age or power; \u092d\u094b\u0917\u0902 \u092d\u0941\u091e\u094d\u091c\u093e\u0928\u0903\",\"end\":\"space\"},{\"n\":9,\"text\":\"( habit ), \u0915\u0935\u091a\u0902 \u092c\u093f\u092d\u094d\u0930\u093e\u0923\u0903 ( age, a young man ), \u0936\u0924\u094d\u0930\u0942\u0928\u094d \u0928\u093f\u0918\u094d\u0928\u093e\u0928\u0903\",\"end\":\"space\"},{\"n\":10,\"text\":\"( power ). \u091c\u0940\u0935\u092e\u093e\u0928\u0903 may, therefore, mean \u2018 accustomed to live \u2019\",\"end\":\"space\"},{\"n\":11,\"text\":\"(\u0924\u093e\u091a\u094d\u091b\u0940\u0932\u094d\u092f); living. \u092d\u093e\u0917\u0927\u0947\u092f\u2013\u092d\u093e\u0917 \u090f\u0935 \u092d\u093e\u0917\u0927\u0947\u092f\u0902 Good luck. \u0927\u0947\u092f is added\",\"end\":\"space\"},{\"n\":12,\"text\":\"to \u0930\u0942\u092a, \u0928\u093e\u092e and \u092d\u093e\u0917, \u0938\u094d\u0935\u093e\u0930\u094d\u0925\u0947 i. e. without any alteration of sense.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit grammatical forms are indistinct.\"},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 13. \u091c\u094d\u091e\u093e\u0928\u092e\u094d may here refer to \u2018 knowledge of the self, or\",\"end\":\"space\"},{\"n\":2,\"text\":\"higher knowledge. \u0917\u0941\u0923\u0903\u2013Such as courage, generosity of mind\",\"end\":\"space\"},{\"n\":3,\"text\":\"&c. \u0927\u0930\u094d\u092e\u0903\u2014discharge of duty or religious merit. \u092d\u0941\u0935\u093f \u092d\u093e\u0930\u092d\u0942\u0924\u093e\u0903\u2014\",\"end\":\"space\"},{\"n\":4,\"text\":\"a burden to the earth. \u092e\u0930\u094d\u0924\u094d\u092f\u0932\u094b\u0915\u0947. In this world of mortals\u2014\",\"end\":\"space\"},{\"n\":5,\"text\":\"should be construed with \u091a\u0930\u0928\u094d\u0924\u093f.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u092e\u0928\u0941\u0937\u094d\u092f\u0930\u0942\u092a\u0947\u0923 &c\u2014The fig. here is Apahnuti. \u092a\u094d\u0930\u0915\u0943\u0924\u0902 \u092f\u0928\u094d\u0928\u093f\u0937\u093f\u0927\u094d\u092f\u093e\u0928\u094d\u092f-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u0924\u094d\u0938\u094d\u0925\u093e\u092a\u094d\u092f\u0924\u0947 \u0938\u093e\u092a\u0939\u094d\u0928\u0941\u0924\u093f\u0903\u2019 where the real thing ( the matter in hand,\",\"end\":\"space\"},{\"n\":3,\"text\":\"the \u0909\u092a\u092e\u0947\u092f ) is denied and some thing unreal ( the \u0909\u092a\u092e\u093e\u0928 ) is\",\"end\":\"space\"},{\"n\":4,\"text\":\"affirmed in its place, that is Apahnuti. cf. \u0935\u093f\u0926\u094d\u092f\u093e\u0935\u093f\u0939\u0940\u0928\u0903 \u092a\u0936\u0941\u0903 Sl. 20.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 14. \u092a\u0930\u094d\u0935\u0924 fr. ( \u092a\u0930\u094d\u0935\u0928\u094d a joint, a part ). \u0926\u0941\u0930\u094d\u0917\u0947\u2014the impassable\",\"end\":\"space\"},{\"n\":2,\"text\":\"places. \u092d\u094d\u0930\u093e\u0928\u094d\u0924\u092e\u094d p. p. used as a noun; for a similar use cf. \u0917\u0924\u0902\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 8 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"11\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\",\"r4\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"12\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"13\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\",\"r7\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"14\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
