          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 47. \u0935\u093e\u0926\u093f &c.\u2014Mr. Telang proposes that this adj. and\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0935\u093f\u0928\u0940\u0924\u094b\u091a\u093f\u0924\u093e should denote two kinds of learning and quotes the\",\"end\":\"space\"},{\"n\":3,\"text\":\"subhashita \u0935\u093f\u0926\u094d\u092f\u093e \u0935\u093f\u0935\u093e\u0926\u093e\u092f \u0927\u0928\u0902 \u092e\u0926\u093e\u092f &c. to support his position.\",\"end\":\"space\"},{\"n\":4,\"text\":\"There, however, two kinds of persons are specially mentioned\",\"end\":\"space\"},{\"n\":5,\"text\":\"as possessing two kinds of learning. Here we have no mention\",\"end\":\"space\"},{\"n\":6,\"text\":\"made of two persons of different temperaments as in the\",\"end\":\"space\"},{\"n\":7,\"text\":\"subh\u00e2shita; but the adj. \u0935\u093f\u0928\u0940\u0924\u094b\u091a\u093f\u0924\u093e seems to have been purposely\",\"end\":\"space\"},{\"n\":8,\"text\":\"added to signify that the kind of learning meant here is not\",\"end\":\"space\"},{\"n\":9,\"text\":\"that which falls under the category (\u0916\u0932\u0938\u094d\u092f) \u0935\u093f\u0926\u094d\u092f\u093e \u0935\u093f\u0935\u093e\u0926\u093e\u092f. High\",\"end\":\"space\"},{\"n\":10,\"text\":\"learning is capable of putting down an antagonist, but it need\",\"end\":\"space\"},{\"n\":11,\"text\":\"not at the same time be prone to controversy when it is posses-\",\"end\":\"hyphen\"},{\"n\":12,\"text\":\"sed by good men. \u0915\u0930\u093f\u0915\u0941\u092e\u094d\u092d\u0966\u2014i. e. the elephants of the enemy.\",\"end\":\"space\"},{\"n\":13,\"text\":\"\u0924\u093e\u0930\u0941\u0923\u094d\u092f which is the fittest period of life for achieving the three\",\"end\":\"space\"},{\"n\":14,\"text\":\"things mentioned in the foregone lines.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words and the transliteration of subhashita are difficult to read.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 48. \u0936\u0941\u0936\u094d\u0930\u0942\u0937\u093e\u2014properly desire to hear; hence \u2018service,\",\"end\":\"space\"},{\"n\":2,\"text\":\"attendance.\u2019 \u0938\u092e\u093e\u0939\u093f\u0924\u0902\u2013\u0938\u092e\u094d\u092f\u0915\u094d \u0906\u0939\u093f\u0924\u0902 firmly placed, concentrated,\",\"end\":\"space\"},{\"n\":3,\"text\":\"devoted. \u092a\u093f\u0924\u094d\u0930\u094b\u0903\u2014\u090f\u0915\u0936\u0947\u0937\u0926\u094d\u0935\u0902\u0926\u094d\u0935; \u092e\u093e\u0924\u093e \u091a \u092a\u093f\u0924\u093e \u091a \u092a\u093f\u0924\u0930\u094c; by \u092a\u093f\u0924\u093e \u092e\u093e\u0924\u094d\u0930\u093e \u2019 \u0964\",\"end\":\"space\"},{\"n\":4,\"text\":\"P\u00e1n. 1, 2, 70; also (\u092e\u093e\u0924\u093e\u092a\u093f\u0924\u0930\u094c) \u0924\u092f\u094b\u0903 \u0964 \u092a\u0930 &c.\u2014coveting a\",\"end\":\"space\"},{\"n\":5,\"text\":\"morsel of food from others. \u0915\u093e\u0915\u0948\u0930\u093f\u0935\u2014Cf. supra Sl. 46 and. \u092e\u0942\u0930\u094d\u0916\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u092e\u093e\u0928\u0935\u093f\u0935\u0930\u094d\u091c\u093f\u0924\u0902 \u092a\u0930\u0917\u0943\u0939\u0917\u094d\u0930\u093e\u0938\u0936\u0902\u0915\u092f\u093e \u0915\u093e\u0915\u0935\u0924\u094d \u0964 Sl. 4.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation and punctuation are partly unclear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 49. \u092a\u0930\u093f\u0917\u0924\u093e\u0903\u2014died; cf. \u092a\u0930\u093f\u0917\u0924\u0903 V. l. Veni. III. \u0905\u092a\u0917\u0924\u093e\u0903\",\"end\":\"space\"},{\"n\":2,\"text\":\"is simpler. To explain \u0917\u092e\u093f\u0924\u093e\u0903 R\u00e2marshi adds \u0915\u093e\u0932\u0947\u0928\u0947\u0924\u093f \u0936\u0947\u0937\u0903. This\",\"end\":\"space\"},{\"n\":3,\"text\":\"will do very well. But Mr. Telang thinks \u0917\u092e\u093f\u0924 to be an in-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"stance of \u0938\u094d\u0935\u093e\u0930\u094d\u0925\u0947 \u0923\u093f\u091a\u094d and refers for a parallel instance to Rag. II.\",\"end\":\"space\"},{\"n\":5,\"text\":\"50 In the passage referred to, however, the causal sense is\",\"end\":\"space\"},{\"n\":6,\"text\":\"not at all justifiable, which is not the case in the present passage.\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0938\u093f\u0915\u0924\u093f\u0932 &c.\u2014see P\u00e1n. V. 2. 105. quoted in the com; \u091a\u093e\u0926\u0943\u0936\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u092e\u0924\u0941\u092a\u094d \u091a \u0964 \u0938\u093f\u0915\u0924\u093e\u0903 \u0938\u0928\u094d\u0924\u094d\u092f\u0938\u094d\u092e\u093f\u0928\u094d\u0926\u0947\u0936\u0947 \u0907\u0924\u093f \u0938\u093f\u0915\u0924\u093f\u0932\u0903, \u0938\u0948\u0915\u0924\u0903, \u0938\u093f\u0915\u0924\u093e\u0935\u093e\u0928\u094d Sid.\",\"end\":\"space\"},{\"n\":9,\"text\":\"Kau. Fig. Upam\u00e1.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Parts of the Sanskrit grammatical quotation are indistinct.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 50. \u0924\u0938\u094d\u092f\u093e\u0930\u094d\u0927\u0938\u094d\u092f \u092a\u0930\u0938\u094d\u092f \u091a\u093e\u0930\u094d\u0927\u0902\u2014Explain \u0924\u0938\u094d\u092f\u093e\u0930\u094d\u0927\u0938\u094d\u092f \u092a\u091e\u094d\u091a\u093e\u0936\u0926\u094d\u0935\u0930\u094d\u0937-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u0930\u0942\u092a\u0938\u094d\u092f \u0905\u0930\u094d\u0927\u0938\u094d\u092f \u0905\u0930\u094d\u0927\u0902 \u0938\u093e\u0930\u094d\u0927\u0926\u094d\u0935\u093e\u0926\u0936 \u0935\u0930\u094d\u0937\u093e\u0923\u093f (\u092c\u093e\u0932\u094d\u092f\u0947) \u092a\u0941\u0928\u0903 \u0924\u0938\u094d\u092f \u092a\u0930\u0938\u094d\u092f\u093e-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\u0930\u094d\u0927\u0938\u094d\u092f\u093e\u0930\u094d\u0927\u0902 \u0938\u093e\u0930\u094d\u0927\u0926\u094d\u0935\u093e\u0926\u0936\u0935\u0930\u094d\u0937\u093e\u0923\u093f (\u0935\u0943\u0926\u094d\u0927\u0924\u094d\u0935\u0947) \u0907\u0924\u094d\u092f\u0930\u094d\u0925\u0903 \u0964 \u0936\u0947\u0937\u0902 \u0924\u094d\u0935\u0928\u093f\u0924\u092e\u093e\u092f\u0941\u0903 \u092a\u091e\u094d\u091a\u0935\u093f\u0902\u0936\u0924\u093f-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"\u0935\u0930\u094d\u0937\u092a\u0930\u093f\u092e\u093f\u0924\u092e\u093f\u0924\u094d\u092f\u0930\u094d\u0925\u0903 \u0964 Human life extends over 100 years.\",\"end\":\"space\"},{\"n\":5,\"text\":\"Half of this is passed in the night, one fourth of the\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit explanation is partly indistinct.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 65 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"other\",\"lines\":[{\"n\":1,\"text\":\"5\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"47\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"48\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"49\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"50\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]},{\"flow\":\"notes\",\"units\":[]}],\"relations\":[]}"
