          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"tion it depends on the will of the writer. Rhetoricians, how-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"ever, consider it a fault called \u2018 \u0935\u093f\u0938\u0902\u0927\u093f\u0926\u094b\u0937 \u2019 See K\u00e2v. P. VII.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 3. \u0905\u091c\u094d\u091e\u2014\u091c\u093e\u0928\u093e\u0924\u0940\u0924\u093f \u091c\u094d\u091e\u0903 ( \u091c\u094d\u091e\u093e+\u0915 ) \u0928 \u091c\u094d\u091e\u0903 \u0905\u091c\u094d\u091e\u0903 \u0964 \u0938\u0941\u0916\u0902, \u0938\u0941\u0916\u0924\u0930\u0902\",\"end\":\"space\"},{\"n\":2,\"text\":\"used as adverbs. \u0935\u093f\u0936\u0947\u0937\u0902 \u091c\u093e\u0928\u093e\u0924\u0940\u0924\u093f \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u0903 \u0964 \u091c\u094d\u091e\u093e\u0928\u0932\u0935\u0966-\u0932\u0935 m. is de-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"rived from \u0932\u0942 to cut, to divide; a particle. \u0926\u0941\u0930\u094d\u0935\u093f\u0926\u0917\u094d\u0927-\u0935\u093f\u0926\u0917\u094d\u0927 properly\",\"end\":\"space\"},{\"n\":4,\"text\":\"means what is well burnt, polished and burnished; hence refined\",\"end\":\"space\"},{\"n\":5,\"text\":\"with culture, learned; \u0926\u0941\u0937\u094d\u091f\u0902 \u092f\u0925\u093e \u0924\u0925\u093e \u0935\u093f\u0926\u0917\u094d\u0927\u0903 \u0926\u0941\u0930\u094d\u0935\u093f\u0926\u0917\u094d\u0927 badly learned\",\"end\":\"space\"},{\"n\":6,\"text\":\"or wise, vain, arrogant ( with little learning; \u091c\u094d\u091e\u093e\u0928\u0932\u0935\u0947\u0928 \u0926\u0941\u0930\u094d\u0935\u093f\u0926\u0917\u094d\u0927\u0903 ).\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0926\u0941\u0930\u094d\u0935\u093f\u0926\u0917\u094d\u0927\u094b \u0926\u0941\u0937\u094d\u091a\u0924\u0941\u0930\u0903 \u0905\u0930\u094d\u0927\u091c\u094d\u0935\u0932\u093f\u0924 \u0907\u0924\u094d\u092f\u0930\u094d\u0925\u0903 \u0964 R\u00e2marshi. Cf. Little know-\",\"end\":\"hyphen\"},{\"n\":8,\"text\":\"ledge is a dangerous thing. \u092c\u094d\u0930\u0939\u094d\u092e\u093e-derived fr. \u092c\u0943\u0939\u094d 1. 6. P. to grow\",\"end\":\"space\"},{\"n\":9,\"text\":\"+\u092e\u0928\u093f\u0928\u094d, the \u090b being changed to \u0930\u094d before it by Un. IV.\",\"end\":\"space\"},{\"n\":10,\"text\":\"145. \u0930\u0902\u091c\u092f\u0924\u093f\u2014\u0930\u0902\u091c\u094d cau. means to colour, to impart one's hue\",\"end\":\"space\"},{\"n\":11,\"text\":\"to : hence to win over, to gratify or propitiate. The cau. form\",\"end\":\"space\"},{\"n\":12,\"text\":\"is \u0930\u091c\u092f\u0924\u093f when the meaning is to sport with or hunt deer;\",\"end\":\"space\"},{\"n\":13,\"text\":\"see Kir. VI. 24. Some read the line as \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u092a\u093f \u0924\u0902 \u0928\u0930\u0902 &c. but this\",\"end\":\"space\"},{\"n\":14,\"text\":\"violates the laws of metre ( as it makes 17 m\u00e2tra\u2019s in the P\u00e2da\",\"end\":\"space\"},{\"n\":15,\"text\":\"instead of 15 or 18 ) and is therefore inadmissible.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words, particularly in lines 5\u20138, are difficult to read.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 4. \u092a\u094d\u0930\u0938\u0939\u094d\u092f\u2014Indec., with great force. \u092e\u0923\u093f from. \u092e\u0923\u094d to sound\",\"end\":\"space\"},{\"n\":2,\"text\":\"+\u0907 ( \u0928 ). \u092e\u0915\u0930\u0966-\u092e\u0902 \u0935\u093f\u0937\u0902 \u0915\u093f\u0930\u0924\u0940\u0924\u093f ( \u0915\u0944 + \u0905\u091a\u094d ) a crocodile, a shark.\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0935\u0915\u094d\u0924\u094d\u0930\u2014\u0935\u0915\u094d\u0924\u094d\u092f\u0928\u0947\u0928\u0947\u0924\u093f from \u0935\u091a\u094d+\u0937\u094d\u091f\u094d\u0930\u0928\u094d \u0915\u0930\u0923\u0947. \u0926\u0902\u0937\u094d\u091f\u094d\u0930\u093e-also der. with \u0937\u094d\u091f\u094d\u0930\u0928\u094d\",\"end\":\"space\"},{\"n\":5,\"text\":\"from \u0926\u0902\u0936\u094d to bite. \u0966\u2014\u0905\u0902\u0915\u0941\u0930 V. l.\u2014from \u0905\u0902\u0915\u094d to mark, stamp+\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0909\u0930\u091a\u094d, means pointed, sharp. \u0926\u0902\u0937\u094d\u091f\u094d\u0930\u093e\u0902\u0915\u0941\u0930\u093e\u0924\u094d-from the tips or points\",\"end\":\"space\"},{\"n\":7,\"text\":\"( i. e when held fast between the points ) of the jaws; sing. for\",\"end\":\"space\"},{\"n\":8,\"text\":\"pl. Cf. \u0926\u0930\u094d\u092d\u093e\u0902\u0915\u0941\u0930 S\u2019ak, and \u0926\u0940\u092a\u093e\u0902\u0915\u0941\u0930 Vair. S\u2019a 63. \u092a\u094d\u0930\u091a\u0932\u0926\u0942\u0966\u2014ruffled or\",\"end\":\"space\"},{\"n\":9,\"text\":\"agitated with a series of rolling billows. \u0966\u090a\u0930\u094d\u092e\u093f m. f. from \u090b+\u092e\u093f,\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u090b\u0924\u0947\u0936\u094d\u091a Un. IV. 44.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit derivational forms are unclear, especially in lines 2, 4 and 10.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u092d\u0941\u091c\u0902\u0917\u0903\u2014\u092d\u0941\u091c\u0903 ( bent, curved \u0915\u0941\u091f\u093f\u0932\u0940\u092d\u0935\u0928\u094d ) \u0938\u0928\u094d \u0917\u091a\u094d\u091b\u0924\u0940\u0924\u093f; \u092d\u0941\u091c\u094d+\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u092e\u0941\u092e\u094d+\u0916\u091a\u094d; \u092e\u0941\u092e\u094d ( the nasal ) inserted by \u2018 \u0905\u0930\u0941\u0930\u094d\u0926\u094d\u0935\u093f\u0937\u0926\u091c\u0928\u094d\u0924\u0938\u094d\u092f \u092e\u0941\u092e\u094d \u2019 P\u00e2n\",\"end\":\"space\"},{\"n\":3,\"text\":\"VI. 3. 67.\u2014Before the aff. \u0916\u091a\u094d and \u0916\u0936\u094d the words \u0905\u0930\u0941\u0938\u094d, \u0926\u094d\u0935\u093f\u0937\u0924\u094d,\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"and such as end in \u0905 take the aug. \u092e\u094d when used preposi-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"tionally with verbs. \u092a\u0941\u0937\u094d\u092a\u0935\u0924\u094d-\u092a\u0941\u0937\u094d\u092a\u0947\u0923 \u0924\u0941\u0932\u094d\u092f\u092e\u094d like a flower. \u0924\u0947\u0928 \u0924\u0941\u0932\u094d\u092f\u0902\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0915\u094d\u0930\u093f\u092f\u093e \u091a\u0947\u0926\u094d\u0935\u0924\u093f\u0903 P\u00e2n. V. I. 15. \u0935\u0924\u094d is attached to a noun in the\",\"end\":\"space\"},{\"n\":8,\"text\":\"sense of \u0924\u0947\u0928 \u0924\u0941\u0932\u094d\u092f\u0902 \u2018 equally with that \u2019 when the equality refers\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit forms in the derivation and grammatical quotation are difficult to read.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 4 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"3\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"4\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\",\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
