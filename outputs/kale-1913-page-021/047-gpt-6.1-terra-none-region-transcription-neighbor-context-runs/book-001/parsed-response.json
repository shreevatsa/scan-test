{
 "regions": {
  "r3": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "प्रस्तुतानां च मण्यादीनां शोभारूपधर्मस्य सहोपादानाद्दीपकमलंकारः ।",
     "end": "space"
    },
    {
     "n": 2,
     "text": "शिखरिणी वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some letters in the compound describing the figure of speech are unclear."
  },
  "r4": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "इदानीं नृणां धनाभावतत्सद्भावावस्थाकृतमाचरणभेदं निर्दिशति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "परिक्षीणः कश्चित्स्पृहयति यवानां प्रसृतये",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स पश्चात्संपूर्णः कलयति धरित्रीं तृणसमाम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "अतश्चानैकान्त्याद्गुरुलघुतयार्थेषु धनिना-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "मवस्था वस्तूनि प्रथयति च संकोचयति च ॥ ४५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "कश्चिद्धनिकः परिक्षीणोऽकिंचनतां गतः सन् । प्रसृतिः निकुञ्चः पाणिः ।",
     "end": "space"
    },
    {
     "n": 2,
     "text": "यवानां प्रसृतिलक्षणया प्रसृतिमात्रयवास्तेभ्य इत्यर्थः । स्पृहयति । स्पृहेरी-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "प्सितः ( १-४-३६ ) इति संप्रदानत्वाच्चतुर्थी । स पश्चाद्दैवात्संपूर्णः धनसं-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "पन्नः सन् । तृणेन समां कलयति मनुते । धनमदेन सर्वं जगत्तृणमिव गणयती-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "त्यर्थः । अतः अर्थेषु यवधरित्र्यादिषु पदार्थेषु विषये गुरुलघुतया महत्त्वाल्पत्व-",
     "end": "hyphen"
    },
    {
     "n": 6,
     "text": "भावेन । न एकान्तमनेकान्तं तस्य भावोऽनैकान्त्यं व्यभिचारः । तस्मात् ।",
     "end": "space"
    },
    {
     "n": 7,
     "text": "गुरौ गुरुत्वमेव लघुनि लघुत्वमेवेति नियमाभावात् । धनिनामवस्था वस्तूनि",
     "end": "space"
    },
    {
     "n": 8,
     "text": "प्रथयति क्षीणावस्था यवादि लघ्वपि वस्तु गुरूकरोति । संकोचयति च । सं-",
     "end": "hyphen"
    },
    {
     "n": 9,
     "text": "पन्नावस्था गुर्वपि वस्तु लघूकरोतीत्यर्थः । अतस्तत्त्ववेदिना पुरुषेण सर्वदा सम-",
     "end": "hyphen"
    },
    {
     "n": 10,
     "text": "बुद्धिना भवितव्यमित्यर्थः ॥ वृत्तं पूर्वोक्तम् ।",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several small-type letters, especially in lines 1–3, are difficult to distinguish."
  },
  "r7": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अथ राजानं संबोध्यर्थसाधनोपायमुपदिशति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "राजन्दुधुक्षसि यदि क्षितिधेनुमेतां",
     "end": "line"
    },
    {
     "n": 2,
     "text": "तेनाद्य[२] वत्समिव लोकममुं पुषाण ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तस्मिंश्च सम्यगनिशं परिपोष्यमाणे[३]",
     "end": "line"
    },
    {
     "n": 4,
     "text": "नानाफलं[४] फलति कल्पलतेव भूमिः ॥ ४६ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "क्षितिर्धेनुरिवेत्युपमितसमासः । न तु क्षितिरिव धेनुरिति रूपकम् । वत्समि-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "वेत्युपमालंकारः । तां दुधुक्षसि यदि दोग्धुमिच्छसि चेत् । दुहेः सन्नन्ताल्लट् ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "वत्सं तर्णकमिव । परिपोष्यमाणे परिपाल्यमाने इत्यर्थः । नानाफलं धनधान्या-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "दिकम् । फलति निष्पादयति । वसन्ततिलका वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The grammatical explanation at the end of line 2 is somewhat unclear."
  },
