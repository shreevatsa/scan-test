          "text": "{\"regions\":{\"r3\":{\"type\":\"commentary\",\"lines\":[{\"n\":1,\"text\":\"\u091a\u093f\u0928\u094d\u092e\u093e\u0924\u094d\u0930\u0902 \u092e\u0942\u0930\u094d\u0924\u093f\u0930\u094d\u092f\u0938\u094d\u092f \u0924\u091a\u094d\u091a\u093f\u0928\u094d\u092e\u093e\u0924\u094d\u0930\u092e\u0942\u0930\u094d\u0924\u093f \u0915\u0947\u0935\u0932\u0902 \u091c\u094d\u091e\u093e\u0928\u0938\u094d\u0935\u0930\u0942\u092a\u092e\u094d \u0964 \u0926\u093f\u0915\u094d\u0915\u093e\u0932\u093e\u0926\u094d\u092f\u0928\u0935-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u091a\u094d\u091b\u093f\u0928\u094d\u0928\u0902 \u091a \u0924\u0926\u0928\u0928\u094d\u0924\u0902 \u091a \u091a\u093f\u0928\u094d\u092e\u093e\u0924\u094d\u0930\u092e\u0942\u0930\u094d\u0924\u093f \u091a \u0924\u0938\u094d\u092e\u0948 \u0964 \u0924\u0925\u093e \u091a \u0936\u094d\u0930\u0941\u0924\u093f\u0903-\u0938\u0924\u094d\u092f\u0902 \u091c\u094d\u091e\u093e\u0928\u092e\u0928\u0928\u094d\u0924\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0907\u0924\u093f \u0964 \u0938\u094d\u0935\u0938\u094d\u092f\u093e\u0928\u0941\u092d\u0942\u0924\u093f\u0903 \u0938\u094d\u0935\u093e\u0928\u0941\u092d\u0942\u0924\u093f\u0930\u0947\u0935 \u090f\u0915\u0902 \u092e\u0941\u0916\u094d\u092f\u0902 \u092e\u093e\u0928\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\u0923\u0903 \u092a\u0930\u093f\u0928\u093f\u0936\u094d\u091a\u093f\u0924\u0930\u0942\u092a\u0924\u094d\u0935\u093e\u0924\u094d\u0924\u0926-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"\u0935\u0917\u092e\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u0902 \u092f\u0938\u094d\u092f \u0924\u0938\u094d\u092e\u0948 \u0964 \u090f\u0915\u0902 \u092e\u0941\u0916\u094d\u092f\u093e\u0928\u094d\u092f\u0915\u0947\u0935\u0932\u093e\u0903 \u0964 \u0907\u0924\u094d\u092f\u092e\u0930\u0903 \u0964 \u0936\u093e\u0928\u094d\u0924\u093e\u092f \u0964 \u0928\u093f\u0937\u094d\u0915\u0932\u0902\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f\u0902 \u0936\u093e\u0928\u094d\u0924\u0902 \u0928\u093f\u0930\u0935\u0926\u094d\u092f\u0902 \u0928\u093f\u0930\u091e\u094d\u091c\u0928\u092e\u093f\u0924\u093f \u0936\u094d\u0930\u0941\u0924\u0947\u0903 \u0964 \u0924\u0947\u091c\u0938\u0947 \u092a\u0930\u0938\u094d\u092e\u0948 \u091c\u094d\u092f\u094b\u0924\u093f\u0937\u0947 \u092c\u094d\u0930\u0939\u094d\u092e\u0923\u0947 \u0928\u092e\u0903 \u0964\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0924\u0926\u0947\u0935 \u091c\u094d\u092f\u094b\u0924\u093f\u0937\u093e\u0902 \u091c\u094d\u092f\u094b\u0924\u093f\u0903 ( \u0909\u092a\u093e\u0938\u0924\u0947 ) \u0907\u0924\u093f \u0936\u094d\u0930\u0941\u0924\u0947\u0903 \u0964 \u0928\u092e\u0903\u0938\u094d\u0935\u0938\u094d\u0924\u094d\u092f\u093e\u0926\u093f\u0928\u093e \u091a\u0924\u0941\u0930\u094d\u0925\u0940 \u0964\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0909\u0915\u094d\u0924\u0902 \u091a \u092a\u091e\u094d\u091a\u0926\u0936\u094d\u092f\u093e\u0902-\u0926\u0947\u0936\u0915\u093e\u0932\u093e\u0928\u094d\u092f\u0935\u0938\u094d\u0924\u0942\u0928\u093e\u0902 \u0915\u0932\u094d\u092a\u093f\u0924\u0924\u094d\u0935\u093e\u091a\u094d\u091a \u092e\u093e\u092f\u092f\u093e \u0964 \u0928 \u0926\u0947\u0936\u093e\u0926\u093f-\",\"end\":\"hyphen\"},{\"n\":8,\"text\":\"\u0915\u0943\u0924\u094b\u093d\u0928\u094d\u0924\u094b\u093d\u0938\u094d\u0924\u093f \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0928\u0928\u094d\u0924\u094d\u092f\u0902 \u0938\u094d\u092b\u0941\u091f\u0902 \u0924\u0925\u093e \u0965 \u0907\u0924\u093f \u0965\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several compounds and readings in the small print are uncertain.\"},\"r4\":{\"type\":\"lead_in\",\"lines\":[{\"n\":1,\"text\":\"\u0905\u0938\u094d\u092e\u093f\u091e\u094d\u091c\u0917\u0924\u0940\u0928\u094d\u0926\u094d\u0930\u093f\u092f\u093e\u0923\u093e\u0902 \u091a\u091e\u094d\u091a\u0932\u092a\u094d\u0930\u0915\u0943\u0924\u093f\u0915\u0924\u094d\u0935\u093e\u0926\u094d\u0926\u0941\u0930\u094d\u0935\u093e\u0930\u0926\u094b\u0937\u093e\u0926\u094d\u0935\u093e \u0928 \u0915\u0926\u093e\u091a\u093f\u0924\u094d\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0915\u0938\u094d\u092f\u091a\u093f\u0924\u094d\u0915\u0938\u094d\u092f\u093e\u091e\u094d\u091a\u093f\u0926\u094d\u0935\u093e \u0915\u093e\u091a\u093f\u0924\u094d\u092a\u094d\u0930\u0940\u0924\u093f\u0903 \u0938\u094d\u0925\u093f\u0930\u093e\u0924\u094b \u0928\u0930\u0948\u0923 \u0924\u0925\u093e \u0935\u0930\u094d\u0924\u093f\u0924\u0935\u094d\u092f\u0902 \u092f\u0925\u093e \u092e\u0926\u0928\u0935-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\u0936\u0917\u094b \u0928 \u092d\u0935\u0947\u0926\u093f\u0924\u093f \u0926\u0930\u094d\u0936\u092f\u0928\u094d\u0928\u093e\u0939\u2013\u2013\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some compounds in the first two lines are difficult to read.\"},\"r5\":{\"type\":\"verse\",\"lines\":[{\"n\":1,\"text\":\"\u092f\u093e\u0902 \u091a\u093f\u0928\u094d\u0924\u092f\u093e\u092e\u093f \u0938\u0924\u0924\u0902 \u092e\u092f\u093f \u0938\u093e \u0935\u093f\u0930\u0915\u094d\u0924\u093e\",\"end\":\"line\"},{\"n\":2,\"text\":\"\u0938\u093e\u092a\u094d\u092f\u0928\u094d\u092f\u092e\u093f\u091a\u094d\u091b\u0924\u093f \u091c\u0928\u0902 \u0938 \u091c\u0928\u094b\u093d\u0928\u094d\u092f\u0938\u0915\u094d\u0924\u0903[\u0967] \u0964\",\"end\":\"line\"},{\"n\":3,\"text\":\"\u0905\u0938\u094d\u092e\u0924\u094d\u0915\u0943\u0924\u0947 \u091a \u092a\u0930\u093f\u0936\u0941\u0937\u094d\u092f\u0924\u093f[\u0968] \u0915\u093e\u091a\u093f\u0926\u0928\u094d\u092f\u093e\",\"end\":\"line\"},{\"n\":4,\"text\":\"\u0927\u093f\u0915\u094d\u0924\u093e \u091a \u0924\u0902 \u091a \u092e\u0926\u0928\u0902 \u091a \u0907\u092e\u093e\u0902 \u091a \u092e\u093e\u0902 \u091a \u0965 \u0968 \u0965\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"commentary\",\"lines\":[{\"n\":1,\"text\":\"\u0915\u0938\u094d\u092f\u093e\u092a\u093f \u0928\u093f\u0930\u094