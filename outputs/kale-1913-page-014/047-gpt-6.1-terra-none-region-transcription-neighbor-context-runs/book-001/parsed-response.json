{
 "regions": {
  "r3": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "प्राणानामाघातस्तस्मात् । संयमः मनसो नियमनम् । युवतीनां जनः युवति-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "जनः । परेषां युवतिजनस्य कथाः तासु मूकभावः । तृष्णायाः स्रोतः प्रवाहः तस्य",
     "end": "space"
    },
    {
     "n": 3,
     "text": "विभङ्गः । न उपहतः अनुपहतः अनुपहतः विधिर्यस्य । स्रग्धरावृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some characters in the first and third lines are indistinct."
  },
  "r4": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "प्रारभ्यते न खलु विघ्नभयेन नीचैः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "प्रारभ्य विघ्नविहता विरमन्ति मध्याः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "विघ्नैः पुनः पुनरपि प्रतिहन्यमानाः",
     "end": "line"
    },
    {
     "n": 4,
     "text": "प्रारब्धमुत्तमजना न परित्यजन्ति ॥ २७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "नीचैः क्षुद्रैः । ये विघ्नभयात् किमप्यारभन्ते ते नीचा इत्यर्थः । स्पष्टमन्यत् ।",
     "end": "space"
    },
    {
     "n": 2,
     "text": "वसन्ततिलका वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The reading of किमप्यारभन्ते is uncertain."
  },
  "r6": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "इदानीं सतामनन्यसाधारणं व्रतमाह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "प्रिया न्याय्या वृत्तिर्मलिनमसुभङ्गेऽप्यसुकरं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "त्वसन्तो नाभ्यर्थ्याः सुहृदपि न याच्यः कृशधनः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "विपद्युच्चैः स्थेयं पदमनुविधेयं च महतां",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सतां केनोद्दिष्टं विषममसिधाराव्रतमिदम् ॥ २८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "न्यायादनपेता न्याय्या । धर्मपथ्यर्थन्यायादनपेते ( ४. ४. ९२ ) इति",
     "end": "space"
    },
    {
     "n": 2,
     "text": "यत् । वृत्तिर्वर्तनम् । मलिनं पापं कर्म । असूनां भङ्गः असुभङ्गः तस्मिन् ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "प्राणसङ्कटेऽपि न कुर्यादित्यर्थः । स्थेयं स्थितिः । असेर्धारा इवासिधारायां चङ्क्रम-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "णमिव वा व्रतमसिधाराव्रतम् । तदुक्तम्–यत्रैकशयनस्थापि प्रमदा नोपभुज्यते ।",
     "end": "space"
    },
    {
     "n": 5,
     "text": "असिधाराव्रतं नाम वदन्ति मुनिपुङ्गवाः । उद्दिष्टमुपदिष्टम् । सन्तो निसर्गादेवै-",
     "end": "hyphen"
    },
    {
     "n": 6,
     "text": "वंशीला इत्यर्थः । शिखरिणी वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small commentary characters are indistinct."
  },
  "r9": {
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "अथ मानशौर्यपद्धतिः—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r10": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "क्षुत्क्षामोऽपि जराकृशोऽपि शिथिलप्रायोऽपि कष्टां दशा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "मापन्नोऽपि विपन्नदीधितिरपि प्राणेषु नश्यत्स्वपि ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "मत्तेन्द्रद्विभिन्नकुम्भकवलग्रासैकबद्धस्पृहः",
     "end": "line"
    },
    {
     "n": 4,
     "text": "किं जीर्णं तृणमत्ति मानमहतामग्रेसरः केसरी ॥ २९ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The compound in line 3 is difficult to distinguish."
  },
  "r11": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "क्षुधा क्षामः क्षीणः क्षुत्क्षामः । क्षायो मः इति मत्वम् । जरया कृशः जरा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "कृशोऽपि । शिथिलप्रायः बाहुल्येन विश्लथाङ्गोऽपि । प्रायो बाहुल्यतुल्ययोः इति",
     "end": "space"
    },
    {
     "n": 3,
     "text": "मेदिनी । कष्टां कठिनामवस्थां प्राप्तोऽपि । विपन्ना दीधितिः तेजः यस्य । नष्ट-",
     "end": "hyphen"
    }
   ],
   "uncertain": true,
   "note": "Some small commentary characters are unclear."
  },
