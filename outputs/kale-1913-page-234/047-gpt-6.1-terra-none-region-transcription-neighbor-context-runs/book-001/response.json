          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"When the mind is content it has acquired the power of the\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u091a\u093f\u0928\u094d\u0924\u093e\u092e\u0923\u093f; for having nothing to wish for it can be said that it\",\"end\":\"space\"},{\"n\":3,\"text\":\"has given itself all that it longs for. \u0935\u093f\u092e\u0941\u0915\u094d\u0924\u0903 \u0938\u0902\u0915\u0932\u094d\u092a\u0903 &c.\u2014When\",\"end\":\"space\"},{\"n\":4,\"text\":\"all desires have been foregone, every desire has in fact been\",\"end\":\"space\"},{\"n\":5,\"text\":\"gratified. Cf. Gita II. 70, 79. \u092f\u0926\u093e \u0938\u0930\u094d\u0935\u0947 \u092a\u094d\u0930\u092e\u0941\u091a\u094d\u092f\u0928\u094d\u0924\u0947 \u0915\u093e\u092e\u093e \u092f\u0947\u093d\u0938\u094d\u092f \u0939\u0943\u0926\u093f\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0936\u094d\u0930\u093f\u0924\u093e\u0903 \u0964 \u0905\u0925 \u092e\u0930\u094d\u0924\u094d\u092f\u094b\u093d\u092e\u0943\u0924\u094b \u092d\u0935\u0924\u094d\u092f\u0924\u094d\u0930 \u092c\u094d\u0930\u0939\u094d\u092e \u0938\u092e\u0936\u094d\u0928\u0941\u0924\u0947 \u0965 Kathop. 2. 3, 14.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Devanagari is indistinct.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 63. \u0938\u094d\u0935\u092f\u092e\u094d &c.\u2014The line gives expression to fatalism. Cf.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u092f\u0926\u092d\u093e\u0935\u093f \u0928 \u0924\u0926\u094d\u092d\u093e\u0935\u093f \u092d\u093e\u0935\u093f \u091a\u0947\u0928\u094d\u0928 \u0924\u0926\u0928\u094d\u092f\u0925\u093e \u0964 \u0907\u0924\u093f \u091a\u093f\u0928\u094d\u0924\u093e\u0935\u093f\u0937\u0918\u094d\u0928\u094b\u093d\u092f\u092e\u0917\u0926\u0903 \u0915\u093f\u0902 \u0928\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u092a\u0940\u092f\u0924\u0947 \u0965 H. 1. The line may also be interpreted as\u2013things happen\",\"end\":\"space\"},{\"n\":4,\"text\":\"in the best way when they are allowed their natural way. They\",\"end\":\"space\"},{\"n\":5,\"text\":\"are not brought about so well by exertions. \u0905\u0938\u0902\u0915\u0932\u094d\u092a\u092f\u0928\u094d\u2014not\",\"end\":\"space\"},{\"n\":6,\"text\":\"forming anticipations or expectations. \u0905\u0928\u0941\u092d\u0935\u0938\u094d\u0935\u2014\u092d\u0942 \u2018to be\",\"end\":\"space\"},{\"n\":7,\"text\":\"with \u0905\u0928\u0941 is Par; so this must be taken as a form of \u092d\u0942 to get or\",\"end\":\"space\"},{\"n\":8,\"text\":\"\",\"end\":\"space\"},{\"n\":9,\"text\":\"obtain which is P. A.; or separate \u0905\u0928\u0941\u092d\u0935 \u0938\u094d\u0935\u092d\u094b\u0917\u093e\u0928\u094d.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation and some quoted words are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 64. \u0906\u092f\u093e\u0938\u0915\u2013troublesome; goes with \u0917\u0939\u0928\u093e\u0924\u094d. \u0935\u093f\u0930\u092e\u094d governs\",\"end\":\"space\"},{\"n\":2,\"text\":\"the abl. of the object from which cessation is meant. \u0936\u094d\u0930\u0947\u092f\u094b\u092e\u093e\u0930\u094d\u0917\u092e\u094d\",\"end\":\"space\"},{\"n\":3,\"text\":\"(the obj. of \u0906\u0936\u094d\u0930\u092f in l. 1.)\u2014the path of final beatitude. \u0905\u0924\u093f\u0936\u092f\u0947\u0928\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u092a\u094d\u0930\u0936\u0938\u094d\u092f\u0902 \u0936\u094d\u0930\u0947\u092f\u0903 what is most to be praised\u2013hence sought, i. e. \u092e\u094b\u0915\u094d\u0937\u0903;\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u092e\u0941\u0915\u094d\u0924\u093f\u0903 \u0915\u0948\u0935\u0932\u094d\u092f\u0928\u093f\u0930\u094d\u0935\u093e\u0923\u0936\u094d\u0930\u0947\u092f\u094b\u0928\u093f\u0903\u0936\u094d\u0930\u0947\u092f\u0938\u093e\u092e\u0943\u0924\u092e\u094d \u0964 \u092e\u094b\u0915\u094d\u0937\u094b\u093d\u092a\u0935\u0930\u094d\u0917\u0903\u2014Amara. \u0915\u094d\u0937\u0923\u093e\u0924\u094d goes\",\"end\":\"space\"},{\"n\":6,\"text\":\"with \u0936\u092e\u0928. \u0936\u093e\u0928\u094d\u0924\u0902 \u092d\u093e\u0935\u0902 which is necessary for entering on the \u0936\u094d\u0930\u0947\u092f\u094b-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"\u092e\u093e\u0930\u094d\u0917\u0947. \u0917\u0924\u093f course, movements. Cf. \u0935\u093f\u0927\u093f\u0917\u0924\u093f\u0903 sl. 87 Infra. \u092d\u0942\u092f\u0903\u2014\",\"end\":\"space\"},{\"n\":8,\"text\":\"again, with persistence.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words and inflections are indistinct.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 65. Addressed to the mind. \u092e\u093e\u0930\u094d\u0917\u092f Imper. 2nd sing.\",\"end\":\"space\"},{\"n\":2,\"text\":\"Some read \u092e\u094b\u0939\u0902 \u092e\u093e\u0930\u094d\u091c\u092f\u0924\u093e\u092e\u094d\u2014of those who have swept away infatu-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"ation. \u0924\u093e\u092e\u094d in our reading means \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927\u093e\u092e\u094d. \u0924\u091f\u092d\u0941\u0935\u093e\u092e\u094d of the grounds\",\"end\":\"space\"},{\"n\":5,\"text\":\"on the bank. \u0906\u0938\u0928\u094d\u0928\u092e\u093e\u0936\u094d\u0930\u092f\u2013resort to the vicinity of. \u0915\u094b \u0935\u093e \u092a\u094d\u0930\u0924\u094d\u092f\u092f\u0903-\",\"end\":\"space\"},{\"n\":6,\"text\":\"what faith can be placed ? the answer being \u2018none.\u2019 \u0935\u0940\u091a\u093f \u0936\u094d\u0930\u0940\u0937\u0941 v. l.\",\"end\":\"space\"},{\"n\":7,\"text\":\"may equally do. Cf. \u0905\u092a\u0923\u094d\u0921\u093f\u0924\u093e\u0938\u094d\u0924\u0947 \u092a\u0941\u0930\u0941\u0937\u093e \u092e\u0924\u093e \u092e\u0947 \u092f\u0947 \u0935\u0940\u091a\u093f \u091a \u0936\u094d\u0930\u0940\u0937\u0941 \u091a\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u094d\u0924\u093f \u0964 \u092a\u0935\u0928-\u092a\u0930\u094d\u0923\u0902 \u092a\u0924\u093f\u0924\u0902 \u092f\u0925\u093e \u0924\u0925\u093e \u0917\u091a\u094d\u091b\u0924\u0940\u0924\u093f.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words in the quotation and gloss are difficult to read.\"},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 66. \u0906\u0938\u094d\u0925\u093e\u2014earnestness. \u092d\u0942\u092a\u093e\u0932\u0966\u2014Fortune very often\",\"end\":\"space\"},{\"n\":2,\"text\":\"depends upon the royal favour a man enjoys and its stability or\",\"end\":\"space\"},{\"n\":3,\"text\":\"otherwise is to be determined from a look of pleasure or a\",\"end\":\"space\"},{\"n\":4,\"text\":\"frown that the king\u2019s face wears. Lakshm\u012b is, therefore, com-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"pared to a dancing girl dancing in imitation of the movements\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 69 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"62\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"63\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"64\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"65\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"66\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r6\"]}],\"flo