{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "मान्यान्मानय विद्विषोप्यनुनय प्रच्छादय स्वान्गुणान्",
     "end": "line"
    },
    {
     "n": 2,
     "text": "कीर्तिं पालय दुःखिते कुरु दयामेतत्सतां चेष्टितम् ॥ ७७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "मनसि वचसि काये पुण्यपीयूषपूर्णा-",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स्त्रिभुवनमुपकारश्रेणिभिः पूरयन्तः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "परगुणपरमाणून्पर्वतीकृत्य नित्यं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "निजहृदि विकसन्तः सन्ति सन्तः कियन्तः ॥ ७८ ॥",
     "end": "space"
    },
    {
     "n": 5,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "किं तेन हेमगिरिणा रजताद्रिणा वा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "यत्राश्रिताश्च तरवस्तरवस्त एव ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "मन्यामहे मलयमेव यदाश्रयेण",
     "end": "line"
    },
    {
     "n": 4,
     "text": "कङ्कोलनिम्बकुटजान्यपि चन्दनानि ॥ ७९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "इति परोपकारः ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "अथ धैर्यप्रशंसा ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "रत्नैर्महार्हैस्तुतुषुर्न देवा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "न भेजिरे भीमविषेण भीतिम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "सुधां विना न प्रययुर्विरामं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "न निश्चितार्थाद्विरमन्ति धीराः ॥ ८० ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r8",
   "type": "apparatus_entry",
