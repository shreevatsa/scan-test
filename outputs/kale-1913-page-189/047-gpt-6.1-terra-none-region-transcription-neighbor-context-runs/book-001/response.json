          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"the poet allows the ellipsis to remain because it is so easy to\",\"end\":\"space\"},{\"n\":2,\"text\":\"supply it. \u0915\u0947\u091a\u093f\u0924\u094d......\u0915\u0947\u091a\u093f\u0924\u094d-some...others. \u092f\u0902 \u092f\u0902 \u092a\u0936\u094d\u092f\u0938\u093f \u0924\u0938\u094d\u092f \u0924\u0938\u094d\u092f\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u092a\u0941\u0930\u0924\u0903\u2014before every one that you see. The fig. is \u0905\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924\u092a\u094d\u0930\u0936\u0902\u0938\u093e\",\"end\":\"space\"},{\"n\":4,\"text\":\"here.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 52. \u0905\u0915\u093e\u0930\u0923\u0935\u093f\u0917\u094d\u0930\u0939\u0903\u2014causeless strife, unprovoked quarrel.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0907\u0926\u092e\u094d refers to each of the foregoing nominatives.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 53. Every serpent of a particular species is supposed to\",\"end\":\"space\"},{\"n\":2,\"text\":\"have in its crest a jewel which shines by night. \u2018 The verse is\",\"end\":\"space\"},{\"n\":3,\"text\":\"attributed to Ch\u00e1nakya. See K\u00e2vyasangraha p. 293. and S'\u00e1rng-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"adhara p. 63, \u2019 Telang. The fig. is \u0926\u0943\u0937\u094d\u091f\u093e\u0928\u094d\u0924 by \u0938\u093e\u0927\u0930\u094d\u092e\u094d\u092f. There is\",\"end\":\"space\"},{\"n\":5,\"text\":\"however a mixture of \u0935\u0938\u094d\u0924\u0941\u092a\u094d\u0930\u0924\u093f\u0935\u0938\u094d\u0924\u0941\u092d\u093e\u0935 also.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 54. The language here is somewhat condensed. \u0917\u0941\u0923\u0903,\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0926\u0941\u0930\u094d\u091c\u0928\u0948\u0903 and \u0917\u0923\u094d\u092f\u0924\u0947 have to be supplied with every clause. \u0939\u094d\u0930\u0940\u092e\u0924\u093f \u092f\u0903\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0939\u094d\u0930\u0940\u0930\u0942\u092a\u0903 \u0917\u0941\u0923\u0903 \u0938 \u091c\u093e\u0921\u094d\u092f\u092e\u093f\u0924\u093f \u0917\u0923\u094d\u092f\u0924\u0947 &c. \u0935\u094d\u0930\u0924\u0930\u0941\u091a\u093f\u2014one who likes to stick\",\"end\":\"space\"},{\"n\":4,\"text\":\"fast to religious observances. \u092e\u0941\u0928\u093f\u2014ordinarily means \u092e\u0928\u0928\u0936\u0940\u0932\",\"end\":\"space\"},{\"n\":5,\"text\":\"( from \u092e\u0928 + \u0907\u0928\u094d the \u0905 being changed to \u0909 by Un. IV. 123 )\",\"end\":\"space\"},{\"n\":6,\"text\":\"one given to contemplation; hence here, a man of reserve, one\",\"end\":\"space\"},{\"n\":7,\"text\":\"who keeps silence. \u2018 \u0935\u093e\u091a\u0902\u092f\u092e\u094b \u092e\u0941\u0928\u093f\u0903 \u2019 Amara. for the Ved\u00e1ntic\",\"end\":\"space\"},{\"n\":8,\"text\":\"meaning see Bg. II. 56. quoted in the com. \u092e\u0941\u0916\u0930\u0924\u093e\u2014\u092e\u0941\u0916\u0930\u0938\u094d\u092f\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u092d\u093e\u0935\u0903 \u0964 fr. \u092e\u0941\u0916 + \u0930. The possessive aff. \u0930 here implies censure.\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u0928\u093e\u092e is used here \u0938\u0902\u092d\u093e\u0935\u094d\u092f\u0947 i. e. to express possibility; or it may\",\"end\":\"space\"},{\"n\":11,\"text\":\"have the sense of \u2018indeed.\u2019 \u0905\u0919\u094d\u0915\u093f\u0924\u0903\u2014branded.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some small Devanagari characters and diacritics are difficult to distinguish.\"},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 55. \u0932\u094b\u092d\u2014is regarded as the greatest of all evils being\",\"end\":\"space\"},{\"n\":2,\"text\":\"the origin of most of them. Cf. \u0932\u094b\u092d\u0903 \u092a\u093e\u092a\u0938\u094d\u092f \u0915\u093e\u0930\u0923\u092e\u094d \u2019 H. I 27.\",\"end\":\"space\"},{\"n\":3,\"text\":\"see com. \u0905\u0917\u0941\u0923\u2014Here the \u0928\u091e\u094d shows \u0935\u093f\u0930\u094b\u0927 or opposition. \u0928\u093f\u091c\u0948\u0903\u2014\",\"end\":\"space\"},{\"n\":4,\"text\":\"If a man has \u0938\u094c\u091c\u0928\u094d\u092f his courteous conduct will easily win over\",\"end\":\"space\"},{\"n\":5,\"text\":\"strangers and so there will be no lack of relatives to him where-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"ver he may go. \u0927\u0928\u0948\u0903\u2014The other reading \u091c\u0928\u0948\u0903 does not yield a\",\"end\":\"space\"},{\"n\":8,\"text\":\"good sense. Bhart\u1e5bhari considers Vidy\u00e1 as the best treasure.\",\"end\":\"space\"},{\"n\":9,\"text\":\"Cf. Sl. 16, 20, 21. and 103. \u0905\u092a\u092f\u0936\u0903\u2014Cf. Bg. II. 34.\",\"end\":\"space\"},{\"n\":10,\"text\":\"quoted in the com. \u0928 \u092d\u0940\u0924\u094b\u092e\u0930\u0923\u093e\u0926\u0938\u094d\u092e\u093f \u0915\u0947\u0935\u0932\u0902 \u0926\u0942\u0937\u093f\u0924\u0902 \u092f\u0936\u0903 \u0964 M\u1e5bch.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit characters and English transliteration marks are unclear.\"},\"r7\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl.s 56. \u0926\u093f\u0935\u0938\u0966\u2014\u0926\u093f\u0935\u0938\u0947\u0928 ( Inst. \u0939\u0947\u0924\u094c ) \u0927\u0942\u0938\u0930\u0903 rendered pale by\",\"end\":\"space\"},{\"n\":2,\"text\":\"( the overpowering light of ) day. \u0905\u0928\u0915\u094d\u0937\u0930\u092e\u094d\u2014\u0905\u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928\u092e\u0915\u094d\u0937\u0930\u0902 \u092f\u0924\u094d\u0930 \u0924\u0924\u094d \u0964\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The abbreviated Sanskrit entry and its gloss are somewhat unclear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 24 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"52\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"53\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"54\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"55\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"stanza_note\",\"number\":\"56\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
