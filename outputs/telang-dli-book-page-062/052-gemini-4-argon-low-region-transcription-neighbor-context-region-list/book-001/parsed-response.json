{
 "regions": [
  {
   "id": "r1",
   "type": "page_number",
   "lines": [
    {
     "n": 1,
     "text": "[ १२ ]",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "ह्रीर्मद्यादनवेक्षणादपि कृषिः स्नेहः प्रवासाश्रया-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "न्मैत्री चाप्रणयात्समृद्धिरनयात्त्यागात्प्रमादाद्धनम् ॥ ४२ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "दानं भोगो नाशस्तिस्रो गतयो भवन्ति वित्तस्य ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "यो न ददाति न भुङ्क्ते तस्य तृतीया गतिर्भवति ॥ ४३ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "मणिः शाणोल्लीढः समरविजयी हेतिनिहतो",
     "end": "line"
    },
    {
     "n": 2,
     "text": "मदक्षीणो नागः शरदि सरितः श्यानपुलिनाः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "कलाशेषश्चन्द्रः सुरतमृदिता बालवनिता",
     "end": "line"
    },
    {
     "n": 4,
     "text": "",
     "end": "space"
    },
    {
     "n": 5,
     "text": "तनिम्ना शोभन्ते गलितविभवाश्चार्थिषु जनाः ॥ ४४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "परिक्षीणः कश्चित्स्पृहयति यवानां प्रसृतये",
     "end": "line"
    },
    {
     "n": 2,
     "text": "",
     "end": "space"
    },
    {
     "n": 3,
     "text": "स पश्चात्संपूर्णः कलयति धरित्रीं तृणसमाम् ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "",
     "end": "space"
    },
    {
     "n": 5,
     "text": "अतश्चैकान्त्याद्गुरुलघुतयार्थेषु धनिना-",
     "end": "hyphen"
    },
    {
     "n": 6,
     "text": "",
     "end": "space"
    },
    {
     "n": 7,
     "text": "मवस्था वस्तूनि प्रथयति च संकोचयति च ॥ ४५ ॥",
     "end": "space"
    },
    {
     "n": 8,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
