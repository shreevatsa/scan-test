          "text": "{\"regions\":{\"r2\":{\"type\":\"heading\",\"lines\":[{\"n\":1,\"text\":\"MISCELLANEOUS.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"1. The sun is covered by day with the same strip of\",\"end\":\"space\"},{\"n\":2,\"text\":\"ambara (sky; cloth) with which the moon is covered at\",\"end\":\"space\"},{\"n\":3,\"text\":\"night: oh the misery of these !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"2. When self-restraint developed by discrimination be-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"comes manifest, and when the strong hold desire has upon\",\"end\":\"space\"},{\"n\":3,\"text\":\"man is relaxed, there appears that perfection (the last stage\",\"end\":\"space\"},{\"n\":4,\"text\":\"of contemplation) wherein even the lord of gods, becomes\",\"end\":\"space\"},{\"n\":5,\"text\":\"an object of pity, wretched (as he is under the influence of\",\"end\":\"space\"},{\"n\":6,\"text\":\"desire) on account of the strong distraction caused by the\",\"end\":\"space\"},{\"n\":7,\"text\":\"enjoyment of greatness worn out of age.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"3. Learning formerly served to remove the pain (of\",\"end\":\"space\"},{\"n\":2,\"text\":\"existence) of those who possessed self-restraint. In course\",\"end\":\"space\"},{\"n\":3,\"text\":\"of time it came to be used for securing sensual happiness\",\"end\":\"space\"},{\"n\":4,\"text\":\"to sensualists. Seeing that the rulers of the earth are now\",\"end\":\"space\"},{\"n\":5,\"text\":\"averse to learning, alas ! it is even going down and down\",\"end\":\"space\"},{\"n\":6,\"text\":\"every day.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"4. The time (that was) happy on account of the enjoy-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"ment of lovely women is passed; and having, for long, wan-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"dered along this avenue of the world we are exhausted; now\",\"end\":\"space\"},{\"n\":4,\"text\":\"(stationed) on the bank of the Ganges (lit. the river of\",\"end\":\"space\"},{\"n\":5,\"text\":\"heaven) we send forth (lit. extend) with deep sighs (the\",\"end\":\"space\"},{\"n\":6,\"text\":\"cries of invocation with the words\u2014S'iva, S'iva, S'iva.\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"5. Mah\u00e2deva is the god, and the stream of the gods (the\",\"end\":\"space\"},{\"n\":2,\"text\":\"Ganges) alone is the stream (for me); caves are (my) abode,\",\"end\":\"space\"},{\"n\":3,\"text\":\"and even the quarters (my) raiment; the Destroyer is (to\",\"end\":\"space\"},{\"n\":4,\"text\":\"me) as a friend; and my vow\u2014such conduct (as is) free\",\"end\":\"space\"},{\"n\":5,\"text\":\"from meanness; or why say more (on this subject), let me\",\"end\":\"space\"},{\"n\":6,\"text\":\"be wedded to the Vata tree alone (lead a life of seclusion\",\"end\":\"space\"},{\"n\":7,\"text\":\"and piety).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"6. How very blessed, indeed, are some persons who, with\",\"end\":\"space\"},{\"n\":2,\"text\":\"their shackles of worldly ties snapped and not looking out\",\"end\":\"space\"},{\"n\":3,\"text\":\"for the irregular course of serpentine sensualism, pass, in the\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 45 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"heading\",\"number\":null,\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"1\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"2\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"3\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"4\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"5\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"6\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
