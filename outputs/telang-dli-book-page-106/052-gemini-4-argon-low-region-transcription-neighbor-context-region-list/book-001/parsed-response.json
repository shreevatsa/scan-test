{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "एकाकी निस्पृहः शान्तः पाणिपात्रो दिगम्बरः ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "कदा शम्भो भविष्यामि कर्मनिर्मूलनक्षमः ॥ ७२ ॥",
     "end": "space"
    },
    {
     "n": 3,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "प्राप्ताः श्रियः सकलकामदुघास्ततः किं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "दत्तं पदं शिरसि विद्विषतां ततः किम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सन्मानिताः प्रणयिनो विभवैस्ततः किं",
     "end": "line"
    },
    {
     "n": 5,
     "text": "कल्पं स्थितं तनुभृतां तनुभिस्ततः किम् ॥ ७३ ॥",
     "end": "space"
    },
    {
     "n": 6,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "जीर्णा कन्था ततः किं सितममलपटं पट्टसूत्रं ततः कि-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "मेका भार्या ततः किं हयकरिसुगणैरावृतो वा ततः किम् ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "",
     "end": "line"
    },
    {
     "n": 5,
     "text": "भक्तं भुक्तं ततः किं कदशनमथवा वासरान्ते ततः किं",
     "end": "line"
    },
    {
     "n": 6,
     "text": "व्यक्तज्योतिर्नवान्तर्मथितभवभयं वैभवं वा ततः किम् ॥ ७४ ॥",
     "end": "space"
    },
    {
     "n": 7,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "भक्तिर्भवे मरणजन्मभयं हृदिस्थं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स्नेहो न बन्धुषु न मन्मथजा विकाराः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "line"
    },
    {
     "n": 4,
     "text": "संसर्गदोषरहिता विजना वनान्ता",
     "end": "line"
    },
    {
     "n": 5,
     "text": "वैराग्यमस्ति किमतः परमर्थनीयम् ॥ ७५ ॥",
     "end": "space"
    },
    {
     "n": 6,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "LXXIII. (b) दत्तम्; न्यस्तम्. T. K. N. R. P. Bo. (orig. Bo.n.) G.",
     "end": "space"
    },
    {
     "n": 2,
     "text": "A. (c) सन्मानिताः; सन्मानिनाम् A. संपादिताः T. K. Bo. G. N. संमानिताः R. P.",
     "end": "space"
    },
    {
     "n": 3,
     "text": "Bo.n. °नो; °नाम्. A. °वै°; °वा° T. K. Bo. (orig. Bo.n.) G. (d) °ल्प-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "म्; °ल्प°. A. T. Bo. G. °तम्; °ताम्. A. °ताः T. Bo. (orig. Bo.n.)",
     "end": "space"
    },
    {
     "n": 5,
     "text": "G. K. N. °तांत°; °तस्त° T. Bo. (orig. Bo.n.) G. °नुभिः; नवः T. Bo.",
     "end": "space"
    },
    {
     "n": 6,
     "text": "(orig. Bo.n.) G. K. N. In P. & R. the fourth line is second,",
     "end": "space"
    },
    {
     "n": 7,
     "text": "second third & third fourth.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "LXXIV. (a) जी°; शी° Bo.n °पटम्; °वरम्. Bo.n °सूत्रम्; °वस्त्रम्;",
     "end": "space"
    },
    {
     "n": 2,
     "text": "Bo.n. (b) for हयकरि &c. बहुगुणगुणिता कोटिरेका ततः किम् Bo.n. (c) भक्ति भुक्तं",
     "end": "space"
    },
    {
     "n": 3,
     "text": "ततः किं वदशनमथवा वासरी ते ततः किम्. This line is fourth in Bo.n. (d)",
     "end": "space"
    },
    {
     "n": 4,
     "text": "एकः. श्रान्त (भ्रान्त cod) स्ततः किं करितुरङ्गवरैरावृतो वा ततः किम् Bo.n.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r8",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "LXXV. (b) °हो; °हे. N. बन्धु°; वस्तु° A. न म°; च म° T. Bo. G.",
     "end": "space"
    },
    {
     "n": 2,
     "text": "(d) °मतः; °मितः N. °मर्थ°; °मार्थ° M. G. T. C. किमतः परमर्थनीयम्;",
     "end": "space"
    },
    {
     "n": 3,
     "text": "",
     "end": "space"
    },
    {
     "n": 4,
     "text": "हृदि चेत्परमर्थयन्ति A.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
