          "text": "{\"regions\":{\"r2\":{\"type\":\"heading\",\"lines\":[{\"n\":1,\"text\":\"MISCELLANEOUS.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"Sl. 1. \u092e\u0928\u0941\u0937\u094d\u092f\u0903\u2014\u092e\u0928\u094b\u0930\u092a\u0924\u094d\u092f\u092e\u094d \u0964 \u092e\u0928\u094b\u0930\u094d\u091c\u093e\u0924\u093e\u0935\u091e\u094d\u092f\u0924\u094c \u0937\u0941\u0915\u094d \u091a P\u00e2n. IV. 1.\",\"end\":\"space\"},{\"n\":3,\"text\":\"161; \u092e\u0928\u0941 + \u092f with augment \u0937\u094d, \u092e\u0928\u0941\u0937\u094d\u092f\u0903 with \u0905\u0923\u094d we have \u092e\u093e\u0928\u0941\u0937.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0928\u093e\u0935\u0938\u0940\u0926\u0924\u093f\u2014Does not suffer, is not ruined. The construction of\",\"end\":\"space\"},{\"n\":5,\"text\":\"the second line is rhetorically faulty as \u092f\u0902 refers to \u0909\u0926\u094d\u092f\u092e which\",\"end\":\"space\"},{\"n\":6,\"text\":\"is not prominent being the member of a compound. The Fig.\",\"end\":\"space\"},{\"n\":7,\"text\":\"is \u0930\u0942\u092a\u0915 in the first half and \u0909\u092a\u092e\u093e in the second.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some of the Sanskrit grammatical quotation and the referent in line 5 are difficult to read.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 2. \u0938\u092e\u092f\u091a\u094d\u092f\u0941\u0924\u093f\u0903\u2014losing an opportunity, letting slip right\",\"end\":\"space\"},{\"n\":2,\"text\":\"time; see com.; \u0938\u092e\u092f may also mean \u2018a condition, an engagement\u2019;\",\"end\":\"space\"},{\"n\":3,\"text\":\"not keeping an engagement. \u0905\u0928\u0941\u0935\u094d\u0930\u0924\u093e\u2014see com. Obedient or\",\"end\":\"space\"},{\"n\":4,\"text\":\"devoted to her husband. \u0906\u091c\u094d\u091e\u093e\u092b\u0932\u092e\u094d\u2014\u0906\u091c\u094d\u091e\u093e power to enforce\",\"end\":\"space\"},{\"n\":5,\"text\":\"obedience. The fig. is \u092a\u0930\u093f\u0938\u0902\u0916\u094d\u092f\u093e; see sl. 71.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 3. \u0917\u0924\u0940 \u0939\u2014Not separable as \u0917\u0924\u0940 \u0907\u0939 as \u0917\u0924\u0940 is a dual form.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0939 must be taken as a particle laying stress on the preceding\",\"end\":\"space\"},{\"n\":3,\"text\":\"word Verily there are &c. It is, however, rarely used in clas-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"sical literature. Mr. Telang remarks\u2014\u201c The first line is un-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"grammatical unless \u0939 is taken as an expletive by itself. But\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0939 is not used in the class of works to which these S'atakas\",\"end\":\"space\"},{\"n\":7,\"text\":\"belong.\u201d The verse is the same as sl. 33 ( q. v. ) with some\",\"end\":\"space\"},{\"n\":8,\"text\":\"variations. Fig. Upam\u00e2,\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"Sl. 4. \u0905\u092a\u094d\u0930\u093f\u092f\u0935\u091a\u0928\u0926\u0930\u093f\u0926\u094d\u0930\u0948\u0903\u2014by those who are poor only in harsh\",\"end\":\"space\"},{\"n\":3,\"text\":\"words, i. e. who will not utter harsh words. \u0906\u0922\u094d\u092f\u2014rich in-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"\u0938\u094d\u0935\u0926\u093e\u0930\u092a\u0930\u093f\u0924\u0941\u0937\u094d\u091f\u0948\u0903\u2014For a similar expression, cf. \u0938\u094d\u0935\u092f\u094b\u0937\u093f\u0924\u093f \u0930\u0924\u093f\u0903; sl. 63.\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u092a\u0930\u093f\u0935\u093e\u0926 or \u092a\u0930\u0940\u0935\u093e\u0926 = censure: \u0905\u0935\u0930\u094d\u0923\u093e\u0915\u094d\u0937\u0947\u092a\u0928\u093f\u0930\u094d\u0935\u093e\u0926\u092a\u0930\u0940\u0935\u093e\u0926\u093e\u092a\u0935\u093e\u0926\u0935\u0924\u094d \u0964 \u0909\u092a\u0915\u094d\u0930\u094b\u0936\u094b\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u091c\u0941\u0917\u0941\u092a\u094d\u0938\u093e \u091a \u0915\u0941\u0924\u094d\u0938\u093e \u0928\u093f\u0928\u094d\u0926\u093e \u091a \u0917\u0930\u094d\u0939\u0923\u0947 \u0965 Amara.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words in the Amara quotation are indistinct.\"},\"r7\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 5. \u092a\u093e\u0926\u093e\u0915\u094d\u0930\u093e\u0928\u094d\u0924\u092e\u094d\u2014(1) covered over with his rays; (2) trod-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"den under the feet, subdued. Mr. Telang thinks that in the\",\"end\":\"space\"},{\"n\":3,\"text\":\"latter sense there would seem to be an allusion to the V\u00e2mana\",\"end\":\"space\"},{\"n\":4,\"text\":\"incarnation of Vish\u1e47u. \u0938\u094d\u092b\u093e\u0930\u2014(from \u0938\u094d\u092b\u093e\u092f\u094d + \u0930\u0915\u094d Un. 2. 33. )\",\"end\":\"space\"},{\"n\":5,\"text\":\"profuse, wide. \u0924\u0947\u091c\u0938\u094d\u2014(1) valour; ( 2 ) lustre; light. The figures\",\"end\":\"space\"},{\"n\":6,\"text\":\"are Upam\u00e2. and S'lesha.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 6. \u0932\u091c\u094d\u091c\u093e &c.\u2014This is interpreted in three ways:\u2014( 1 )\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0932\u091c\u094d\u091c\u093e \u090f\u0935 \u0917\u0941\u0923\u0903 \u0924\u0938\u094d\u092f\u0948\u0935; ( 2 ) \u0932\u091c\u094d\u091c\u093e\u0926\u092f\u094b \u092f\u0947 \u0917\u0941\u0923\u093e\u0938\u094d\u0924\u0947\u0937\u093e\u0902 &c. and ( 3 )\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit compound at the end of the first interpretation is indistinct.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 43 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":\"Notes\",\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"heading\",\"number\":null,\"label\":\"Miscellaneous\",\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"1\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"2\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"3\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"4\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"stanza_note\",\"number\":\"5\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"stanza_note\",\"number\":\"6\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]},{\"flow\":\"notes\",\"units\":[]}],\"relations\":[]}"
        }
