          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u092e\u0942\u0930\u094d\u0924\u093f\u092e\u0924\u0940 \u091a \u0938\u0924\u094d\u0915\u094d\u0930\u093f\u092f\u093e\u2019 S'a. V. 15. \u201cWith the reading \u0935\u0915\u094d\u0930\u093f\u0915\u093e\u092e\u094d which\",\"end\":\"space\"},{\"n\":2,\"text\":\"would seem to mean \u201ccrookedness\u201d the meaning of the Stanza\",\"end\":\"space\"},{\"n\":3,\"text\":\"must be \u2018that which makes wicked men of good ones,\u2019 &c.\",\"end\":\"space\"},{\"n\":4,\"text\":\"This is also the meaning according to R\u00e2marhi with the reading\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0935\u0915\u094d\u0930\u093f\u0915\u093e\u092e\u094d, which he interprets to be either \u0938\u0930\u0938\u094d\u0935\u0924\u0940 or \u0932\u0915\u094d\u0937\u094d\u092e\u0940, \u0935\u0915\u094d\u0930\u0947\u0923\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0935\u093f\u0928\u093e\u0938\u094d\u092e\u093f\u0928\u094d\u092f\u0941\u0917\u0947 \u092b\u0932\u0902 \u0928 \u092d\u0935\u0924\u093f (commentary.)\u201d Mr. Telang. \u0935\u094d\u092f\u0938\u0928\u0948\u0903\u2014used\",\"end\":\"space\"},{\"n\":7,\"text\":\"adverbially here, meaning \u2018with persistent application ( for the\",\"end\":\"space\"},{\"n\":8,\"text\":\"acquisition of merits ). \u0906\u0938\u094d\u0925\u093e\u2014an energetic effort.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words are blurred, particularly in lines 5\u20136.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 104. \u0935\u093f\u092d\u094d\u0930\u092e\u2014amorous sport; it is also one of the bh\u00e2vas of\",\"end\":\"space\"},{\"n\":2,\"text\":\"love ( S'ring\u00e2ra. ) \u0936\u094d\u0935\u0947\u0924\u093e\u0924\u092a\u0924\u094d\u0930\u094b\u091c\u094d\u091c\u094d\u0935\u0932\u093e\u0903\u2014i. e. universal sovereignty.\",\"end\":\"space\"},{\"n\":3,\"text\":\"An emperor only has the privilege of using a white umbrella.\",\"end\":\"space\"},{\"n\":4,\"text\":\"Cf. \u0905\u092d\u094d\u092f\u0941\u0926\u093f\u0924\u093e\u0928\u094d\u092f\u0938\u093f\u0924\u093e\u0924\u092a\u0924\u094d\u0930\u093e\u0923\u0903 Rag. IX. 15. \u0905\u0928\u0941\u0938\u094d\u092f\u0942\u0924\u2014interwoven i. e.\",\"end\":\"space\"},{\"n\":5,\"text\":\"continuous. \u0935\u093f\u091a\u094d\u091b\u0947\u0926\u0947\u2014when the continuity is broken. \u0905\u0928\u0919\u094d\u0917\u0966\u2014\",\"end\":\"space\"},{\"n\":6,\"text\":\"may also be taken as \u0905\u0928\u0919\u094d\u0917\u0915\u0932\u0939\u0947\u0937\u0941 ( in love quarrels ) \u0915\u094d\u0930\u0940\u0921\u093e\u0938\u0941 ( and\",\"end\":\"space\"},{\"n\":7,\"text\":\"sports ) \u091a \u0924\u094d\u0930\u0941\u091f\u0928\u094d\u0924\u0903 &c. The propriety of the words \u0905\u0928\u0919\u094d\u0917\u0966 is not\",\"end\":\"space\"},{\"n\":8,\"text\":\"clear. Probably the idea is that pearls dropped down at such\",\"end\":\"space\"},{\"n\":9,\"text\":\"a time are not noticed; so Lakshm\u00ee vanishes imperceptibly.\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u0926\u093f\u0936\u0903 &c.\u2014see com.; \u0926\u093f\u0936\u094b \u0926\u0943\u0936\u094d\u092f\u0924\u093e\u092e\u094d\u2014\u2014v. l. Lit. the state of being\",\"end\":\"space\"},{\"n\":11,\"text\":\"visible only at the end of quarters i. e. not within the reach of\",\"end\":\"space\"},{\"n\":12,\"text\":\"eyesight. The words may also be taken separately \u0926\u093f\u0936\u094b\u093d\u0926\u0943\u0936\u094d\u092f\u0924\u093e\u092e\u094d\",\"end\":\"space\"},{\"n\":13,\"text\":\"\u0926\u093f\u0936\u0903 \u092d\u091c\u094d\u092f\u093e\u0926\u0943\u0936\u094d\u092f\u0924\u093e\u0902 \u092a\u094d\u0930\u092f\u093e\u0928\u094d\u0924\u093f Running in all directions disappears.\",\"end\":\"space\"},{\"n\":14,\"text\":\"Mr. Telang proposes the reading \u0926\u0943\u0936\u094b\u093d\u0926\u0943\u0936\u094d\u092f\u0924\u093e\u092e\u094d\u0966 Fig. Upam\u00e2.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit quotations, particularly in lines 4 and 10\u201314, are difficult to read.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 105. \u0917\u0941\u0923\u0935\u0924\u094d\u2014\u0917\u0941\u0923\u093e \u0935\u093f\u0926\u094d\u092f\u0928\u094d\u0924\u0947\u093d\u0938\u094d\u092e\u093f\u0928\u094d. \u0905\u0935\u0927\u093e\u0930\u094d\u092f\u0902\u2014should be thought\",\"end\":\"space\"},{\"n\":2,\"text\":\"over or considered. \u0906\u0935\u093f\u092a\u0924\u094d\u0924\u0947\u0903\u2014till death; cf. \u0939\u093f\u092e\u0938\u0947\u0915\u0935\u093f\u092a\u0924\u094d\u0924\u093f\u0903,\",\"end\":\"space\"},{\"n\":3,\"text\":\"and \u2018\u0928\u0930\u0947\u0928\u094d\u0926\u094d\u0930\u0935\u093f\u092a\u0924\u094d\u0924\u093f\u0936\u094b\u0915\u093e\u0924\u094d\u2019 Rag. VIII. 45, XIX. 56. also Veni. IV. 6.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0935\u093f\u092a\u093e\u0915\u0903\u2014from \u0935\u093f+\u092a\u091a\u094d+\u0905 ( \u0905\u0923\u094d or \u0915\u0928\u094d ) originally means cook-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"ing, and thence, ripeness, development, consequence. \u0939\u0943\u0926\u092f\u0926\u093e\u0939\u0940\u2014\",\"end\":\"space\"},{\"n\":7,\"text\":\"burning ( i. e. giving pain to ) the vitals of the heart like the\",\"end\":\"space\"},{\"n\":8,\"text\":\"barb of an arrow ( supposed to be poisoned that it should\",\"end\":\"space\"},{\"n\":9,\"text\":\"cause burning ); Cf. \u0938\u0935\u093f\u0937\u092e\u093f\u0935 \u0936\u0932\u094d\u092f\u0902 \u0926\u0939\u0924\u093f \u092e\u093e\u092e\u094d \u0964 S'ak. VI. 9.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit readings are unclear. Line 5 is a stray part of an adjoining line.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 106. \u0938\u094d\u0925\u093e\u0932\u0940-a cooking vessel; \u0938\u094d\u0925\u093e\u0932\u094d\u092f\u093e\u0902 \u0938\u093f\u0927\u094d\u092f\u0924\u094d\u092f\u0928\u094d\u0928\u092e\u094d \u0964 \u0935\u0948\u0926\u0942\u0930\u094d\u092f-lapis-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"lazuli; \u0935\u093f\u0926\u0942\u0930\u0947 \u0905\u0926\u094d\u0930\u094c \u092d\u0935\u092e\u094d (\u0905\u0923\u094d i. e. \u0905) so called because first obtain-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"ed from the mountain Vid\u00fbra. \u0924\u093f\u0932\u0916\u0932\u0940\u2014The cake of sesamum\",\"end\":\"space\"},{\"n\":4,\"text\":\"after oil has been pressed out of it; oil-cake. \u0935\u093f\u0932\u093f\u0916\u0924\u093f-Scratches,\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit explanation on the first line is indistinct.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 40 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"104\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"105\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"106\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
