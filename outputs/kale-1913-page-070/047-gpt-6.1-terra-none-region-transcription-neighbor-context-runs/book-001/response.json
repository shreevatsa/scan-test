          "text": "{\"regions\":{\"r3\":{\"type\":\"commentary\",\"lines\":[{\"n\":1,\"text\":\"\u092f\u0924\u094d\u0930 \u092f\u0938\u094d\u092e\u093f\u0928\u094d\u092d\u094b\u0917\u0947 \u0938\u094d\u0925\u093f\u0924\u0903 \u0964 \u092a\u0941\u0930\u0941\u0937 \u0907\u0924\u093f \u0936\u0947\u0937\u0903 \u0964 \u092c\u094d\u0930\u0939\u094d\u092e\u0947\u0928\u094d\u0926\u094d\u0930\u093e\u0926\u092f\u094b \u092f\u0947\u0937\u093e\u0902 \u0924\u0947 \u092e\u0918\u0935\u0924\u093e\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0926\u0947\u0935\u0938\u0902\u0918\u093e\u0938\u094d\u0924\u093e\u0928\u092a\u093f \u0964 \u0915\u093e \u0915\u0925\u0947\u0924\u094d\u0924\u0930\u0947\u0937\u093e\u092e\u094d \u0964 \u0924\u0943\u0923\u0932\u0918\u093e\u0928\u093f\u0935 \u0924\u0941\u091a\u094d\u091b\u093e\u0928\u094d\u092e\u0928\u094d\u092f\u0924\u0947 \u0964 \u092e\u0928\u094d\u092f\u0915\u0930\u094d\u092e-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\u0923\u094d\u092f\u0928\u093e\u0926\u0930\u0947 \u0935\u093f\u092d\u093e\u0937\u093e\u093d\u092a\u094d\u0930\u093e\u0923\u093f\u0937\u0941 \u0964 (\u0968-\u0969-\u0967\u096d) \u0907\u0924\u093f \u0935\u093f\u0915\u0932\u094d\u092a\u093e\u0926\u094d \u0926\u094d\u0935\u093f\u0924\u0940\u092f\u093e \u0964\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u092f\u0938\u094d\u092f\u093e\u0938\u094d\u0935\u093e\u0926\u093e\u0926\u094d\u0930\u0941\u091a\u094d\u092f\u0928\u0941\u092d\u0935\u093e\u0924\u094d \u0964 \u0924\u094d\u0930\u092f\u094b \u0932\u094b\u0915\u093e\u0938\u094d\u0924\u094d\u0930\u0948\u0932\u094b\u0915\u094d\u092f\u092e\u094d \u0964 \u092c\u094d\u0930\u093e\u0939\u094d\u092e\u0923\u093e\u0926\u093f\u0924\u094d\u0935\u093e\u0924\u094d\u0937\u094d\u092f\u091e\u094d \u0964 \u0924\u0924\u094d\u0930\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u092e\u0939\u093e\u0930\u093e\u091c\u094d\u092f\u0902 \u0924\u0926\u093e\u0926\u093f \u092f\u0947\u0937\u093e\u0902 \u0924\u0947 \u0935\u093f\u092d\u0935\u093e \u0935\u093f\u0930\u0938\u093e \u093