          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 2. \u0935\u093f\u0935\u0947\u0915\u0935\u094d\u092f\u093e\u0915\u094b\u0936\u0947\u2014\u0935\u093f\u0935\u0947\u0915 is the same as \u0928\u093f\u0924\u094d\u092f\u093e\u0928\u093f\u0924\u094d\u092f\u0935\u0938\u094d\u0924\u0941-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u0935\u093f\u0935\u0947\u0915 discrimination of the real from the unreal. When one\",\"end\":\"space\"},{\"n\":3,\"text\":\"knows wherein lies permanent happiness, which alone can be\",\"end\":\"space\"},{\"n\":4,\"text\":\"called true happiness, he tries to acquire it. For this purpose\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0936\u092e and others ( \u0936\u092e\u0926\u092e\u094b\u092a\u0930\u0924\u093f\u0924\u093f\u0924\u093f\u0915\u094d\u0937\u093e\u0938\u092e\u093e\u0927\u093e\u0928\u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0916\u094d\u092f\u093e\u0903 \u0964 Ved. S\u00e1. )\",\"end\":\"space\"},{\"n\":6,\"text\":\"are necessary. \u0935\u094d\u092f\u093e\u0915\u094b\u0936 means \u2018unfolding\u2019 budding;\u2019 hence deve-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"lopment. When one has discrimination, one should try to\",\"end\":\"space\"},{\"n\":8,\"text\":\"acquire s'ama and others. \u0936\u092e is defined as \u0936\u092e\u0938\u094d\u0924\u093e\u0935\u091a\u094d\u091b\u094d\u0930\u0935\u0923\u093e\u0926\u093f\u0935\u094d\u092f-\",\"end\":\"hyphen\"},{\"n\":9,\"text\":\"\u0924\u093f\u0930\u093f\u0915\u094d\u0924\u0935\u093f\u0937\u092f\u0947\u092d\u094d\u092f\u094b \u092e\u0928\u0938\u094b \u0928\u093f\u0917\u094d\u0930\u0939\u0903 i. e. restraining the mind from all\",\"end\":\"space\"},{\"n\":10,\"text\":\"other objects and devoting it to the hearing of the recital of\",\"end\":\"space\"},{\"n\":11,\"text\":\"holy texts &c. ( i. e. \u092e\u0928\u0928, \u0928\u093f\u0926\u093f\u0927\u094d\u092f\u093e\u0938\u0928 &c. ).\u2014\u0935\u094d\u092f\u093e\u0915\u094b\u0936 may also be\",\"end\":\"space\"},{\"n\":12,\"text\":\"taken as an adj; see com. \u0935\u093f\u0915\u0938\u0924\u093f when it blooms and so pro-\",\"end\":\"hyphen\"},{\"n\":13,\"text\":\"duces the wished for result, viz. the annihilation of all desires-\",\"end\":\"space\"},{\"n\":14,\"text\":\"\u0924\u0941\u0919\u094d\u0917-lofty; hence strong attachment. \u0938\u093e \u092a\u0930\u093f\u0923\u0924\u093f\u0903\u2014 that well\",\"end\":\"space\"},{\"n\":15,\"text\":\"known perfection ( of contemplation ) viz. what is called\",\"end\":\"space\"},{\"n\":16,\"text\":\"\u091c\u0940\u0935\u0928\u094d\u092e\u0941\u0915\u094d\u0924\u093f in which one enjoys the joy of Brahma.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit compounds and punctuation are indistinct.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 3. \u0915\u094d\u0932\u0947\u0936\u0939\u0943\u0924\u092f\u0947\u2014for the removal of miseries, (which consoled\",\"end\":\"space\"},{\"n\":2,\"text\":\"them in their afflictions). Or \u0935\u093f\u0926\u094d\u092f\u093e may mean \u092a\u0930\u092e\u093e\u0930\u094d\u0925\u091c\u094d\u091e\u093e\u0928 and \u0915\u094d\u0932\u0947\u0936\",\"end\":\"space\"},{\"n\":3,\"text\":\"the trouble of birth and rebirth. \u0935\u093f\u0937\u092f\u0938\u0941\u0916\u0938\u093f\u0926\u094d\u0927\u094d\u092f\u0948 \u0917\u0924\u093e\u2014( in course\",\"end\":\"space\"},{\"n\":4,\"text\":\"of time ) it came to be the means of attaining sensual pleasures;\",\"end\":\"space\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"it became subservient to sensualism. \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0935\u093f\u092e\u0941\u0916\u2013 averse or\",\"end\":\"space\"},{\"n\":7,\"text\":\"indifferent to the study of S'\u00e1stra; or not disposed to encourage\",\"end\":\"space\"},{\"n\":8,\"text\":\"learning. The same cause of the decline of learning has been\",\"end\":\"space\"},{\"n\":9,\"text\":\"given already in sl. 2 supra.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 4. \u0932\u0932\u093e\u092e\u2014lovely, attractive; when a n. ( \u0932\u0932\u0928\u093e ) it means\",\"end\":\"space\"},{\"n\":2,\"text\":\"a beautiful woman. \u0938\u0941\u092d\u0917\u2014Properly \u2018fortunate\u2019, hence pleasant,\",\"end\":\"space\"},{\"n\":3,\"text\":\"charming. \u0938\u0930\u0923\u093f is derived from \u0938\u0943 to move+\u0905\u0928\u093f: by Un. II.\",\"end\":\"space\"},{\"n\":4,\"text\":\"102. \u0905\u092f\u0928\u0902 \u0935\u0930\u094d\u0924\u094d\u092e \u092e\u093e\u0930\u094d\u0917\u093e\u0927\u094d\u0935\u092a\u0928\u094d\u0925\u093e\u0928\u0903 \u092a\u0926\u0935\u0940 \u0938\u0943\u0924\u093f\u0903 \u0964 \u0938\u0930\u0923\u093f\u0903 \u092a\u0926\u094d\u0927\u0924\u093f\u0903 \u092a\u0926\u094d\u092f\u093e \u0935\u0930\u094d\u0924\u094d\u092e\u0948\u0915\u093e-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"\u092f\u0928\u092a\u0926\u0940\u0924\u093f \u091a \u0965 Amara. \u0938\u094d\u0935\u0903\u0938\u093f\u0928\u094d\u0927\u094b\u0903\u2014see sl. 86 and note on \u0938\u094d\u0935\u0903 supra\",\"end\":\"space\"},{\"n\":6,\"text\":\"sl. 19. \u0917\u093f\u0930\u0903 \u092a\u094d\u0930\u0924\u0928\u0941\u092e\u0903\u2014We raise ( lit. stretch forth ) our cries of\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"},{\"n\":8,\"text\":\"invocation. \u0938\u0941\u0924\u093e\u0930\u0948\u0903\u2014\u0924\u093e\u0930\u094b\u093d\u0924\u094d\u092f\u0941\u091a\u094d\u091a\u0948\u0903 ( \u0927\u094d\u0935\u0928\u093f\u0903 ) Amara. \u092b\u0942\u0924\u094d\u0915\u093e\u0930\u0948\u0903--with sighs.\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u092b\u0942\u0924\u094d\u0915\u093e\u0930 is an onomatop\u0153ic word.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation and some headwords are difficult to read.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"Sl. 5. \u0905\u092e\u0930\u0938\u0930\u093f\u0924\u094d\u2014The Ganges. \u0939\u0930\u093f\u0924\u0903-the quarters. \u0905\u0926\u0948\u0928\u094d\u092f-Not\",\"end\":\"space\"},{\"n\":3,\"text\":\"showing one\u2019s poverty; or (2) freedom from meanness. \u0938\u094d\u0935\u091a\u094d\u091b\u0928\u094d\u0926-\u0935\u093e\",\"end\":\"space\"},{\"n\":4,\"text\":\"is used here either in the sense of \u090f\u0935 or \u0938\u092e\u0941\u091a\u094d\u091a\u092f ( as also ). \u0915\u094d\u0930\u093f\u092f\u093e\u0926\u094d\u0935\u093e\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit words near the end are indistinct.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 79 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"2\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"3\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"4\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"5\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
