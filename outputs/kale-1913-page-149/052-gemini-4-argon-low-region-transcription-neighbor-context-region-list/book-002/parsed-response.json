   "type": "translated_stanza",
   "lines": [
    {
     "n": 1,
     "text": "54. Here we are satisfied with barks, and you with silk",
     "end": "space"
    },
    {
     "n": 2,
     "text": "garments; the satisfaction is equal in this case and the dis-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "tinction is without difference. Let him be ( called ) poor",
     "end": "space"
    },
    {
     "n": 4,
     "text": "whose greed is boundless; the heart being content who is",
     "end": "space"
    },
    {
     "n": 5,
     "text": "rich and who is poor ?",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
