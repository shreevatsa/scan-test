      "content": [
        {
          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"the feverish pride of a controversialist is inexhaustible; those\",\"end\":\"space\"},{\"n\":2,\"text\":\"who are filled with wealth serve you; even me serve those\",\"end\":\"space\"},{\"n\":3,\"text\":\"that have a longing to listen to me that the taint of their\",\"end\":\"space\"},{\"n\":4,\"text\":\"hearts may be removed; if you have no respect for me, the\",\"end\":\"space\"},{\"n\":5,\"text\":\"less have I for you; O king, here am I off.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"54. Here we are satisfied with barks, and you with silk\",\"end\":\"space\"},{\"n\":2,\"text\":\"garments; the satisfaction is equal in this case and the dis-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"tinction is without difference. Let him be ( called ) poor\",\"end\":\"space\"},{\"n\":4,\"text\":\"whose greed is boundless; the heart being content who is\",\"end\":\"space\"},{\"n\":5,\"text\":\"rich and who is poor ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"55. Fruits for a meal, sweet water for drink, the (bare)\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"surface of the earth for a bed, and barks for raiment, are\",\"end\":\"space\"},{\"n\":4,\"text\":\"all good (preferable) enough; but I cannot tolerate ( lit.\",\"end\":\"space\"},{\"n\":5,\"text\":\"sanction ) the impudence of wicked men, all whose senses\",\"end\":\"space\"},{\"n\":6,\"text\":\"have been maddened by the fresh ( acquisition of ) wealth as\",\"end\":\"space\"},{\"n\":7,\"text\":\"if by drinking wine.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"56. We live on alms, cover ourselves with the directions\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"serving as garments, and lie down on the surface of the earth:\",\"end\":\"space\"},{\"n\":4,\"text\":\"what have we to do with big folks ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"57. Of what value, indeed, are we in a royal palace since\",\"end\":\"space\"},{\"n\":2,\"text\":\"we are neither actors, nor flatterers, nor singers; nor have\",\"end\":\"space\"},{\"n\":3,\"text\":\"we our hearts set on hating others; nor are we ( beautiful )\",\"end\":\"space\"},{\"n\":4,\"text\":\"women bent down with the burden of the breasts ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"58. The world was formerly created by certain large-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"hearted blessed persons; by some it was sustained, and by\",\"end\":\"space\"},{\"n\":3,\"text\":\"others it was conquered and given away as if it were grass;\",\"end\":\"space\"},{\"n\":4,\"text\":\"other noble persons even now rule the fourteen worlds.\",\"end\":\"space\"},{\"n\":5,\"text\":\"What morbid infatuation is it on the part of men when they\",\"end\":\"space\"},{\"n\":6,\"text\":\"have acquired rulership over a few towns ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"59. What honour is it to kings to obtain ( the rulership\",\"end\":\"space\"},{\"n\":2,\"text\":\"of ) the earth, which was not left unenjoyed even for a mo-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"ment by hundreds of kings; but the lords of a part of its\",\"end\":\"space\"},{\"n\":4,\"text\":\"( earth\u2019s ) part, and of even a small part of that part\u2014fools\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 36 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"53\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"54\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"55\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"56\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"57\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"58\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"59\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
