          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"12. A person, unacquainted with poetics, music and the\",\"end\":\"space\"},{\"n\":2,\"text\":\"arts, is, in fact, a beast without the horns and the tail; and it\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"is the highest piece of good luck for beasts that he lives\",\"end\":\"space\"},{\"n\":5,\"text\":\"without eating grass.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"13. Those who do not possess learning, or practise\",\"end\":\"space\"},{\"n\":2,\"text\":\"penance or give gifts, or have knowledge, character, virtue\",\"end\":\"space\"},{\"n\":3,\"text\":\"or religious merit, roam in the mortal world as beasts in\",\"end\":\"space\"},{\"n\":4,\"text\":\"a human form, a mere burden to the earth.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"14. Better would it be to wander in company with for-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"esters through the inaccessible regions of mountains than to\",\"end\":\"space\"},{\"n\":3,\"text\":\"live in the company of fools even in the halls of the Lord\",\"end\":\"space\"},{\"n\":4,\"text\":\"of gods.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"15. That renowned learned men whose speech is charming\",\"end\":\"space\"},{\"n\":2,\"text\":\"owing to the use of words refined by the S'\u00e1stras and whose\",\"end\":\"space\"},{\"n\":3,\"text\":\"knowledge is worth being imparted to disciples live in\",\"end\":\"space\"},{\"n\":4,\"text\":\"poverty in the dominions of a king, bespeaks the stupidity\",\"end\":\"space\"},{\"n\":5,\"text\":\"(want of appreciation) of the king. Even without wealth\",\"end\":\"space\"},{\"n\":6,\"text\":\"learned men are kings. The jewels are not to blame but the\",\"end\":\"space\"},{\"n\":7,\"text\":\"wicked lapidaries by whom they are appraised much below\",\"end\":\"space\"},{\"n\":8,\"text\":\"their worth.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"16 The secret treasure of knowledge is not destroyed\",\"end\":\"space\"},{\"n\":2,\"text\":\"even at the end of the world, does not fall into the hands of a\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"thief, ever yields some ( indescribable ) happiness, and when\",\"end\":\"space\"},{\"n\":5,\"text\":\"given to those that solicit it, increases plentifully. Cast away\",\"end\":\"space\"},{\"n\":6,\"text\":\"your pride, ye kings, towards those who have this treasure.\",\"end\":\"space\"},{\"n\":7,\"text\":\"Who can rival them ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"17. Do not despise wise men who have obtained the\",\"end\":\"space\"},{\"n\":2,\"text\":\"highest good; wealth, worthless as grass, stands not in their\",\"end\":\"space\"},{\"n\":3,\"text\":\"way; a lotus-fibre cannot present any obstacle to elephants\",\"end\":\"space\"},{\"n\":4,\"text\":\"whose temples have been darkened with a stream of fresh\",\"end\":\"space\"},{\"n\":5,\"text\":\"rut.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"18. ( If he is ) highly incensed, the Creator can deprive\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 3 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"12\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"13\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"14\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"15\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"16\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"17\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"18\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
