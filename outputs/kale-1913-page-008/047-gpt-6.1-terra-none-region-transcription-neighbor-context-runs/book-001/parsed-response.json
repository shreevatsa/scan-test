{
 "regions": {
  "r3": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "शिरः शार्वं स्वर्गात्पशुपतिशिरस्तः क्षितिधरं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "महीध्रादुत्तुङ्गादवनिमवनेश्चापि जलधिम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "अधोऽधो गङ्गेयं पदमुपगता स्तोकमथवा",
     "end": "line"
    },
    {
     "n": 4,
     "text": "विवेकभ्रष्टानां भवति विनिपातः शतमुखः ॥ १० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The small footnote markers in the verse are not clearly legible."
  },
  "r4": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "इयं गङ्गा स्वर्गात् शर्वस्य शिवस्येदं शार्वं शिरः उपगता । पशूनां जीवानां",
     "end": "space"
    },
    {
     "n": 2,
     "text": "पतिः पशुपतिः ईश्वरस्तस्य शिरस्तस्मात् । क्षितिधरं हिमाचलम् । महीं धर-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "तीति महीध्रः । मूलविभुजादित्वात्कप्रत्ययः । उत्तुङ्गादुन्नतात् । एवमियं गङ्गा",
     "end": "space"
    },
    {
     "n": 4,
     "text": "अधोऽधो गच्छन्ती स्तोकमल्पं नीचमित्यर्थः । पदमुपगता । अथवा विवेकभ्र-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "ष्टानां सदसद्विचारच्युतानाम् । शतमुखो बहुप्रकारः । पुरा किल भगीरथो",
     "end": "space"
    },
    {
     "n": 6,
     "text": "नाम राजा पितुरश्वमेधीयाश्वान्वेषणक्रमेण पातालमुपगतान् अयमेवाश्वापहारीति",
     "end": "space"
    },
    {
     "n": 7,
     "text": "कृतावस्कन्देन महर्षिणा कपिलेन हुङ्कारमात्रेण दग्धान् सगरसुतान् आत्मनः",
     "end": "space"
    },
    {
     "n": 8,
     "text": "प्रपितामहान् सुरलोकाद्गङ्गाया अवतरणं कारयित्वा तस्या जलेनोददीधरदिति",
     "end": "space"
    },
    {
     "n": 9,
     "text": "कथात्रानुसन्धेया । अत्रैकस्या गङ्गाया अनेकस्मिन्नाधारेऽवस्थितेः पर्यायाख्योलं-",
     "end": "hyphen"
    },
    {
     "n": 10,
     "text": "कारः । चतुर्थपादेऽर्थान्तरन्यासश्च । शिखरिणी वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some compound readings in the commentary are difficult to distinguish."
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "शक्यो वारयितुं जलेन हुतभुक्छत्रेण सूर्यतपो",
     "end": "line"
    },
    {
     "n": 2,
     "text": "नागेन्द्रो निशिताङ्कुशेन समदो[३] दण्डेन गोगर्दभौ ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "व्याधिर्भेषजसंग्रहैश्च विविधैर्मन्त्रप्रयोगैर्विषं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सर्वस्यौषधमस्ति शास्त्रविहितं मूर्खस्य नास्त्यौषधम् ॥११॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Only marker ३ is clearly visible; other possible markers are unclear."
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "हुतं भुनक्तीति हुतभुगिति व्युत्पत्त्या वैदिकाग्निपरोऽप्ययं शब्दोऽत्र लौकिकाग्नि-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "परः । निशितश्चासौ अङ्कुशश्च तेन । भेषजमौषधम् । संग्रहेणेति पाठे यथावद्ग्र-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "हणेन । मन्त्राश्च प्रयोगाश्च तैः । तदुक्तम्--तच्छान्तिरौषधैर्दानैर्जपहोमसुरार्चनैः ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "शार्दूलविक्रीडितं वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small-type compounds and punctuation are unclear."
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "साहित्यसङ्गीतकलाविहीनः साक्षात्पशुः पुच्छविषाणहीनः ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "तृणं न खादन्नपि जीवमानस्तद्भागधेयं परमं पशूनाम् ॥ १२॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "साहित्यं च सङ्गीतं च कलाश्च ताभिर्विहीनः । गीतं वाद्यं नर्तनं च त्रिभिः",
     "end": "space"
    },
    {
     "n": 2,
     "text": "सङ्गीतमुच्यते । यद्वा सङ्गीतस्य कला सङ्गीतकला । साहित्यं च सङ्गीतकला च",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ पतति शिरसस्ततः, पतति शिरसोतः॰",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The endings of the variant readings are indistinct."
  },
