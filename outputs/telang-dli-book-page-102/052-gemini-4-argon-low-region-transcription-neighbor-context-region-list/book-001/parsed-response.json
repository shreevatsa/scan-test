{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "सखे धन्याः केचित्त्रुटितभवबन्धव्यतिकरा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "वनान्ते चित्तान्तर्विषमविषयाशीविषगताः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "शरच्चन्द्रज्योत्स्नाधवलगगनाभोगसुभगां",
     "end": "line"
    },
    {
     "n": 4,
     "text": "नयन्ते ये रात्रिं सुकृतचयचित्तैकशरणाः ॥ ५७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "एतस्माद्विरमेन्द्रियार्थगहनादायासकादाश्रया-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "च्छ्रेयोमार्गमशेषदुःखशमनव्यापारदक्षं क्षणात् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "join"
    },
    {
     "n": 4,
     "text": "शान्तं भावमुपैहि संत्यज निजां कल्लोललोलां गतिं",
     "end": "line"
    },
    {
     "n": 5,
     "text": "मा भूयो भज भङ्गुरां भवरतिं चेतः प्रसीदाधुना ॥ ५८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "पुण्यैर्मूलफलैः प्रिये प्रणयिनि वृत्तिं कुरुष्वाधुना",
     "end": "line"
    },
    {
     "n": 2,
     "text": "",
     "end": "join"
    },
    {
     "n": 3,
     "text": "भूशय्या नववल्कलैरकरुणैरुत्तिष्ठ यामो वनम् ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "क्षुद्राणामविवेकमूढमनसां यत्रेश्वराणां सदा",
     "end": "line"
    },
    {
     "n": 5,
     "text": "चित्तव्याध्यविवेकविह्वलगिरां नामापि न श्रूयते ॥ ५९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "apparatus_entry",
   "lines": [
