          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"that they are\u2014rejoice when on the contrary they ought\",\"end\":\"space\"},{\"n\":2,\"text\":\"to grieve !!\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"60. The clod of earth is encircled by the watery edge.\",\"end\":\"space\"},{\"n\":2,\"text\":\"Even when taken as a whole, it is indeed very small; and it\",\"end\":\"space\"},{\"n\":3,\"text\":\"is apportioned by a number of kings and enjoyed after\",\"end\":\"space\"},{\"n\":4,\"text\":\"hundreds of battles. Abject and exceedingly poor, they\",\"end\":\"space\"},{\"n\":5,\"text\":\"therefore, give or would give nothing. Fie upon those\",\"end\":\"space\"},{\"n\":6,\"text\":\"mean fellows who wish to get even from them a piece of coin.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"61. He (lit. that singularly fortunate person) alone was\",\"end\":\"space\"},{\"n\":2,\"text\":\"born whose white skull was, by the enemy of the god of\",\"end\":\"space\"},{\"n\":3,\"text\":\"love, held prominently on his head as an ornament; ( and\",\"end\":\"space\"},{\"n\":4,\"text\":\"yet ) what height of morbid presumption is there on the part\",\"end\":\"space\"},{\"n\":5,\"text\":\"of men when a few persons solicitous of saving their own\",\"end\":\"space\"},{\"n\":6,\"text\":\"lives bow to them.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"62. Alas ! ( my ) heart, why dost thou enter the dense\",\"end\":\"space\"},{\"n\":2,\"text\":\"mass of misery ( suffer much distress ) in order to please the\",\"end\":\"space\"},{\"n\":3,\"text\":\"hearts of others by daily propitiation ? when with the\",\"end\":\"space\"},{\"n\":4,\"text\":\"powers of the Chint\u00e1mani spontaneously rising in thee, thou\",\"end\":\"space\"},{\"n\":5,\"text\":\"art inwardly satisfied, what object of thine foregone-desire\",\"end\":\"space\"},{\"n\":6,\"text\":\"will not satisfy ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"63. Why do you wander for nothing, oh mind ? Rest\",\"end\":\"space\"},{\"n\":2,\"text\":\"yourself somewhere. A thing that naturally ( lit. of itself )\",\"end\":\"space\"},{\"n\":3,\"text\":\"takes a particular course does take it; it changes not.\",\"end\":\"space\"},{\"n\":4,\"text\":\"Without, therefore, remembering what is past, or speculating\",\"end\":\"space\"},{\"n\":5,\"text\":\"about what is to come, do you in this world experience\",\"end\":\"space\"},{\"n\":6,\"text\":\"fruits, the coming and going of which cannot be determined\",\"end\":\"space\"},{\"n\":7,\"text\":\"beforehand.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"64. Now be pleased, O heart; cease from these trouble-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"some abyss of sensual objects; resort to the path of final bea-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"titude which is capable of removing, in a moment, all misery;\",\"end\":\"space\"},{\"n\":4,\"text\":\"assume a peaceful attitude, give up your course unsteady\",\"end\":\"space\"},{\"n\":5,\"text\":\"like a wave and never again be attached to transient worldly\",\"end\":\"space\"},{\"n\":6,\"text\":\"happiness.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 37 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"59\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"60\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"61\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"62\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"63\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"64\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
