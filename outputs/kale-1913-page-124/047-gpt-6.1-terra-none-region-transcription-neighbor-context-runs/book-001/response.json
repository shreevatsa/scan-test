          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"and a wicked man having access to a king\u2019s court\u2014these are\",\"end\":\"space\"},{\"n\":3,\"text\":\"the seven barbs in my heart.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"57. No one is, indeed, a favourite of kings whose anger\",\"end\":\"space\"},{\"n\":2,\"text\":\"is extremely fierce; the fire burns even the sacrificer offering\",\"end\":\"space\"},{\"n\":3,\"text\":\"an oblation, when touched.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"58. The duty of service is most difficult to be understood;\",\"end\":\"space\"},{\"n\":2,\"text\":\"it is beyond the ken of even sages: (for a servant is called),\",\"end\":\"space\"},{\"n\":3,\"text\":\"dumb if he is silent! ( if he is ) ready with his answer, he is\",\"end\":\"space\"},{\"n\":4,\"text\":\"talkative or garrulous; if he stands near, he is impudent; and\",\"end\":\"space\"},{\"n\":5,\"text\":\"then if he keeps at a distance, he is timid; if he bears pa-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"tiently, he is a coward; if he cannot brook ( harsh words, in-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"sults &c. ) he is generally considered mannerless.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"59. Who can live happily when within the range of a\",\"end\":\"space\"},{\"n\":2,\"text\":\"wicked man who hates merit, who has by chance attained\",\"end\":\"space\"},{\"n\":3,\"text\":\"greatness, and has forgotten his former mode of obtaining a\",\"end\":\"space\"},{\"n\":4,\"text\":\"living by base deeds, and who, free from all restraint, has\",\"end\":\"space\"},{\"n\":5,\"text\":\"whitewashed all other wicked people.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"60. The friendship of wicked men and of good men\",\"end\":\"space\"},{\"n\":2,\"text\":\"differs like the shadow in the first and the second half of the\",\"end\":\"space\"},{\"n\":3,\"text\":\"day (respectively)\u2014extensive at the beginning, but gradual-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"ly contracting ( in the first part while in the latter ) at first\",\"end\":\"space\"},{\"n\":5,\"text\":\"scant, but attaining growth afterwards.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"61. The deer, the fish, and the virtuous, living on grass,\",\"end\":\"space\"},{\"n\":2,\"text\":\"water and contentment respectively ( find ) in this world un-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"provoked enemies ( in ) the hunter, the fisherman, and the\",\"end\":\"space\"},{\"n\":4,\"text\":\"wicked.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"62. A bow to those men in whom reside the following\",\"end\":\"space\"},{\"n\":2,\"text\":\"sterling qualities:\u2014desire for the company of the virtuous,\",\"end\":\"space\"},{\"n\":3,\"text\":\"satisfaction at the merits of others, humility towards elders,\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"attachment to learning, love for one\u2019s own wife, fear of\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 11 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"56\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"57\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"58\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"59\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"60\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"61\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"62\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
