   "lines": [
    {
     "n": 1,
     "text": "57. No one is, indeed, a favourite of kings whose anger",
     "end": "space"
    },
    {
     "n": 2,
     "text": "is extremely fierce; the fire burns even the sacrificer offering",
     "end": "space"
    },
    {
     "n": 3,
     "text": "an oblation, when touched.",
     "end": "space"
    },
    {
     "n": 4,
