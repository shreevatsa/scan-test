          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 42. \u2014\u0915\u0902\u0926\u0930\u094d\u092a\u2014K\u00e1ma, the god of love; cf. \u0915\u0902\u0926\u0930\u094d\u092a\u092f\u093e\u092e\u0940\u0924\u093f \u092e\u0926-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u0928\u093e\u0924\u094d\u092e\u091c\u094b \u091c\u0917\u093e\u0926 \u091a \u0964 \u0924\u0947\u0928 \u0915\u0902\u0926\u0930\u094d\u092a\u0928\u093e\u092e\u093e\u0928\u0902 \u0924\u0902 \u091a\u0915\u093e\u0930 \u091a\u0924\u0941\u0930\u094d\u092d\u0941\u091c\u0903 \u0965 \u0915\u093f\u0902 \u0915\u0926\u0930\u094d\u0925-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\u092f\u0938\u093f\u2014why do you trouble your hand. \u091f\u0902\u0915\u093e\u0930\u093f\u0924\u0948\u0903\u2014\u091f\u0902\u0915\u093e\u0930\u0948\u0903 v. l.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u091f\u0902\u0915\u094d + \u0906\u0930\u0935; \u091f\u0902\u0915\u093e\u092f\u0924\u0940\u0924\u093f ( fr. \u091f\u0902\u0915\u094d + \u0905\u091a\u094d ) or \u091f\u092e\u093f\u0924\u093f \u0936\u092c\u094d\u0926\u0902 \u0915\u093e\u092f\u0924\u0940\u0924\u093f\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u091f\u0902\u0915\u0903 an onomatop\u0153ic word. \u091f\u0902\u0915\u093e\u0930\u093f\u0924 however is better and has\",\"end\":\"space\"},{\"n\":6,\"text\":\"therefore been preferred. For the third line cf. supra. \u092c\u093e\u0932\u0947 \u0932\u0940\u0932\u093e-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"\u092e\u0941\u0915\u0941\u0932\u093f\u0924\u092e\u092e\u0940 &c. Mis. sl. 40. \u0938\u094d\u0928\u093f\u0917\u094d\u0927 affectionate; \u0935\u093f\u0926\u0917\u094d\u0927 cleverly\",\"end\":\"space\"},{\"n\":8,\"text\":\"cast, artful.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words and the line-end portions are indistinct.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 43. \u0909\u0928\u094d\u092e\u0940\u0932\u0924\u094d &c.\u2014\u0924\u094d\u0930\u093f\u0935\u0932\u0940 the folds of skin above the navel\",\"end\":\"space\"},{\"n\":2,\"text\":\"of a woman regarded as a mark of beauty ( Cf. Kum. I. 39 ).\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0938\u094d\u0924\u0928 &c. pairs of Chakrav\u00e0ka birds are usually described as\",\"end\":\"space\"},{\"n\":4,\"text\":\"haunting river-banks. \u0915\u094d\u0930\u0942\u0930\u093e\u0936\u092f\u093e has two meanings (1) \u0915\u094d\u0930\u0942\u0930\u093e\u0903 \u0906\u0936\u092f\u093e-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"\u092f\u0938\u094d\u092f\u093e\u0928\u094d in which there are dangerous aquatic animals; (2) \u0915\u094d\u0930\u0942\u0930\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0906\u0936\u092f\u093e\u0903 thoughts (or \u0906\u0936\u092f mind) \u092f\u0938\u094d\u092f\u093e\u0903\u0964 \u0938\u0902\u0938\u093e\u0930\u093e\u0930\u094d\u0923\u0935\u2013Sams\u00e1ra is the\",\"end\":\"space\"},{\"n\":7,\"text\":\"sea to which the river, in the form of a woman, leads a man.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words and the right edge of the print are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 44. \u0939\u0943\u0924\u092a\u0930\u092e\u093e\u0930\u094d\u0925\u0948\u0903\u2014The Indriyas which are often compared\",\"end\":\"space\"},{\"n\":2,\"text\":\"to horses, tempt a man further and further away from real\",\"end\":\"space\"},{\"n\":3,\"text\":\"bliss ( \u092e\u094b\u0915\u094d\u0937 ).\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit lemma and the right edge of line 2 are somewhat indistinct.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 87 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"42\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"43\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"44\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
