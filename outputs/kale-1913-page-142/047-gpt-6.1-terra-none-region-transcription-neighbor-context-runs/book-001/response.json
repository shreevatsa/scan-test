          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"drinks sweet and fragrant water; when oppressed with\",\"end\":\"space\"},{\"n\":2,\"text\":\"hunger, he swallows rice mixed with vegetable and other\",\"end\":\"space\"},{\"n\":3,\"text\":\"condiments: and when the fire of love is kindled he clasps\",\"end\":\"space\"},{\"n\":4,\"text\":\"his wife closely.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"21. A man, infatuated on account of ignorance, enters\",\"end\":\"space\"},{\"n\":2,\"text\":\"on a worldly career which is like a prison, believing the\",\"end\":\"space\"},{\"n\":3,\"text\":\"world to be constant, on seeing the towering mansion, the\",\"end\":\"space\"},{\"n\":4,\"text\":\"sons esteemed by the good, the boundless wealth, the lovely\",\"end\":\"space\"},{\"n\":5,\"text\":\"wife, and the prime of life: but the blessed man renounces\",\"end\":\"space\"},{\"n\":6,\"text\":\"all this knowing it to be perishable in a moment.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"22. If a man did not see his wife distressed and wearing\",\"end\":\"space\"},{\"n\":2,\"text\":\"a care worn appearance, with hungry and noisy children\",\"end\":\"space\"},{\"n\":3,\"text\":\"ever tugging at her threadbare raiment with piteous looks,\",\"end\":\"space\"},{\"n\":4,\"text\":\"what man, who respects himself, would, for the sake of his\",\"end\":\"space\"},{\"n\":5,\"text\":\"accursed stomach, say\u2014\u201cGive me\u201d\u2014the syllables being\",\"end\":\"space\"},{\"n\":6,\"text\":\"broken and absorbed in the gurgling throat for fear of the\",\"end\":\"space\"},{\"n\":7,\"text\":\"supplication being rejected.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"23. The insatiable boiler of the stomach, which is clever\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"in dissolving (lit. cutting) the knot of high pride which is\",\"end\":\"space\"},{\"n\":4,\"text\":\"dearly prized, which is like the bright moonshine in causing\",\"end\":\"space\"},{\"n\":5,\"text\":\"the lotus-like higher virtues to fade, and which is like an axe\",\"end\":\"space\"},{\"n\":6,\"text\":\"in cleaving asunder the luxuriant creeper modesty, causes\",\"end\":\"space\"},{\"n\":7,\"text\":\"humiliation.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"24. Blessed is the man of self-respect, who, living in a\",\"end\":\"space\"},{\"n\":2,\"text\":\"holy city or in a trackless forest, rather goes, when hungry,\",\"end\":\"space\"},{\"n\":3,\"text\":\"from one door to another\u2014the vicinity of which has been\",\"end\":\"space\"},{\"n\":4,\"text\":\"darkened by the smoke arising from the fire into which\",\"end\":\"space\"},{\"n\":5,\"text\":\"oblations have been offered by Br\u00e2hmanas reciting the Vedic\",\"end\":\"space\"},{\"n\":6,\"text\":\"mantras with the proper accents\u2014in order to fill the cavity of\",\"end\":\"space\"},{\"n\":7,\"text\":\"his stomach, with a broken pot covered with a piece of white\",\"end\":\"space\"},{\"n\":8,\"text\":\"cloth; but not so the man who daily humiliates himself in\",\"end\":\"space\"},{\"n\":9,\"text\":\"(the presence of) his kinsmen, of equal rank with him.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 29 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"20\",\"label\":null,\"open_start\":true,\"open_end\"