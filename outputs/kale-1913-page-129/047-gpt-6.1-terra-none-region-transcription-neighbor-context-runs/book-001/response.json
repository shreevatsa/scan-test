          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"84. A mouse, gnawing a hole into a basket, at night, fell\",\"end\":\"space\"},{\"n\":2,\"text\":\"into the mouth of a serpent that, with its body pent up in a\",\"end\":\"space\"},{\"n\":3,\"text\":\"basket and its limbs weakened by starvation, had grown\",\"end\":\"space\"},{\"n\":4,\"text\":\"despondent. Filled with its meat the serpent quickly glided\",\"end\":\"space\"},{\"n\":5,\"text\":\"away through the same opening ( lit. the same passage, viz.\",\"end\":\"space\"},{\"n\":6,\"text\":\"the hole made by the mouse ); see, my men, it is destiny\",\"end\":\"space\"},{\"n\":7,\"text\":\"alone that is the cause of the rise and fall of men.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"85. A ball, though struck on the ground with a blow\",\"end\":\"space\"},{\"n\":2,\"text\":\"from the hand, does rebound upwards; generally the misfor-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"tunes of the virtuous are not everlasting ( are temporary ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"86. Sloth is a dreadfull enemy abiding in the body of\",\"end\":\"space\"},{\"n\":2,\"text\":\"man; there is no friend like industriousness by resorting to\",\"end\":\"space\"},{\"n\":3,\"text\":\"which a man is never ruined.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"87. A tree. though cut down, grows again; the moon,\",\"end\":\"space\"},{\"n\":2,\"text\":\"though waned, waxes again; thus reflecting good men are\",\"end\":\"space\"},{\"n\":3,\"text\":\"not troubled in this world, when plunged in misery.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"88. Indra was worsted in battle by his enemies, though\",\"end\":\"space\"},{\"n\":2,\"text\":\"possessed of greatness and prowess\u2014even he who had B\u1e5bhas-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"pati for his adviser, the thunderbolt for his weapon, the gods\",\"end\":\"space\"},{\"n\":4,\"text\":\"for his soldiers, and the heaven for his citadel; he verily\",\"end\":\"space\"},{\"n\":5,\"text\":\"enjoyed the favour of Hari ( Vishnu ), and had Air\u00e0vata for\",\"end\":\"space\"},{\"n\":6,\"text\":\"his elephant; it is clear, then, that it is better to submit to\",\"end\":\"space\"},{\"n\":7,\"text\":\"fate; oh, fie ! valour is useless.\",\"end\":\"space\"},{\"n\":8,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"89. The fruit which men get depends on action ( done in\",\"end\":\"space\"},{\"n\":2,\"text\":\"a former life), and the inducement to action is in consonance\",\"end\":\"space\"},{\"n\":3,\"text\":\"with it ( action done in a previous life ); still a wise man\",\"end\":\"space\"},{\"n\":4,\"text\":\"should be doing a thing only after mature consideration.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"90. A bald man, scorched on the head by the rays of the\",\"end\":\"space\"},{\"n\":2,\"text\":\"sun and wishing for a shady place, went to ( rest under ) a\",\"end\":\"space\"},{\"n\":3,\"text\":\"palm tree; even there, a big fruit falling ( from the tree )\",\"end\":\"space\"},{\"n\":4,\"text\":\"broke his pate with a crash. Verily misfortunes do, indeed,\",\"end\":\"space\"},{\"n\":5,\"text\":\"go there where a luckless man goes.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 16 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"84\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"85\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"86\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"87\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"88\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"89\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"90\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
