{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "स्फुरद्दीपश्चन्द्रो विरतिवनितासङ्गमुदितः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सुखं शान्तः शेते मुनिरतनुभूतिर्नृप इव ॥ ७९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "",
     "end": "space"
    },
    {
     "n": 2,
     "text": "त्रैलोक्याधिपतित्वमेव विरसं यस्मिन्महाशासने",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तल्लब्ध्वासनवस्त्रमानघटने भोगे रतिं मा कृथाः ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "भोगः कोपि स एक एव परमो नित्योदितो जृम्भते",
     "end": "line"
    },
    {
     "n": 5,
     "text": "यत्स्वादाद्विरसा भवन्ति विषयास्त्रैलोक्यराज्यादयः ॥ ८० ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "",
     "end": "space"
    },
    {
     "n": 2,
     "text": "किं वेदैः स्मृतिभिः पुराणपठनैः शास्त्रैर्महाविस्तरैः",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "space"
    },
    {
     "n": 4,
     "text": "",
     "end": "space"
    },
    {
     "n": 5,
     "text": "स्वर्गग्रामकुटीनिवासफलदैः कर्मक्रियाविभ्रमैः ।",
     "end": "line"
    },
    {
     "n": 6,
     "text": "मुक्तैकं भवबन्धदुःखरचनाविध्वंसकालानलं",
     "end": "line"
    },
    {
     "n": 7,
     "text": "",
     "end": "space"
    },
    {
     "n": 8,
     "text": "स्वात्मानन्दपदप्रवेशकलंनं शेषा वणिग्वृत्तयः ॥ ८१ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "line 6: मुक्त्वैकं looks like मुक्तैकं; line 8 has stray mark above ल in कलनं"
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "आयुः कल्लोललोलं कतिपयदिवसस्थायिनी यौवनश्री-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "रर्थाः संकल्पकल्पा घनसमयतडिद्विभ्रमा भोगपूराः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "line"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "(c) °स्फुरद्दीप श्चन्द्रो; शरच्चन्द्रो दीपो. N. (d) °खम्; °खी. N. °न्तः;",
     "end": "space"
    },
    {
     "n": 2,
     "text": "°न्तम् P.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "LXXX. (a) शासने; शोभनम्. A. (b) °स°; °श°. P. A. वस्त्र; मस्तु.",
     "end": "space"
    },
    {
     "n": 2,
     "text": "A. °सनवस्त्रमानघटने; परितोषमेषि च मनो. Bo.n. (d) विषया°; भवत°. A. वि-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "भवा°. P. R. In Bo. G. N. K. T. the first line is ब्रह्मेन्द्रादिमरुद्गणां",
     "end": "space"
    },
    {
     "n": 4,
     "text": "(णा. T.) स्तृणगणान्य (य. T.) त्र स्थितो मन्य (डज. T.) ते. The second is",
     "end": "space"
    },
    {
     "n": 5,
     "text": "the fourth above as in P. & R. except यच्छापात् for यत्स्वादात् in Bo. G.",
     "end": "space"
    },
    {
     "n": 6,
     "text": "T. K. The third is the same as above except बोधः for भोगः in Bo.",
     "end": "space"
    },
    {
     "n": 7,
     "text": "G. T. K. & एष for एक in N. The fourth line in all is भो (भोः",
     "end": "space"
    },
    {
     "n": 8,
     "text": "Bo. & K.) साधो क्षणभङ्गुरे तदितरे भोगे रतिं मा कृथाः.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r8",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "LXXXI. (a) °ठनै; °ठितैः. T. (c) मुक्त्वैकम्; भुक्तैः किम्. G. बन्ध; सा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "र A. भार. M. P. R. दुःख T. K. Bo. G. N. दुःख; भार. T. K. Bo. G.",
     "end": "space"
    },
    {
     "n": 3,
     "text": "N. °स; °सि. A. (d) °वे°; °का°. T. K. G. कलनम्; °नमिदम्. A.",
     "end": "space"
    },
    {
     "n": 4,
     "text": "°षा; °षैः A. Bo.n. N. °त्तयः; °त्तिभिः A. N. Bo.n.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
