          "text": "{\"regions\":{\"r2\":{\"type\":\"paragraph\",\"lines\":[{\"n\":1,\"text\":\"N. B. Read the slokas on p. 16 in this order\u201491, 86,\",\"end\":\"space\"},{\"n\":2,\"text\":\"1 ( mis. ); 89, 90, 92, 93.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"84. The virtue of courage of a heroic person cannot\",\"end\":\"space\"},{\"n\":2,\"text\":\"be obliterated though he be worried; though pointed down-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"wards, the flame of fire does not point to the ground.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"85. That courageous man conquers the triple world\",\"end\":\"space\"},{\"n\":2,\"text\":\"whose mind the arrow-like side-glances of women do not\",\"end\":\"space\"},{\"n\":3,\"text\":\"hurt, the heat-of-fire-like anger does not burn and the\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"numerous sensual objects do not draw ( towards them ) with\",\"end\":\"space\"},{\"n\":6,\"text\":\"their captivating snares.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"87. Better if this body falls from the lofty peak of a\",\"end\":\"space\"},{\"n\":2,\"text\":\"high mountain against some rugged surface and is shattered\",\"end\":\"space\"},{\"n\":3,\"text\":\"to pieces in the midst of rough rocks; better is the hand\",\"end\":\"space\"},{\"n\":4,\"text\":\"thrust into the fangs of a huge serpent of deadly bite;\",\"end\":\"space\"},{\"n\":5,\"text\":\"better falling into the fire; but not the wrecking of one's\",\"end\":\"space\"},{\"n\":6,\"text\":\"character.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"88. The fire acts like water, the ocean becomes like {a\",\"end\":\"space\"},{\"n\":2,\"text\":\"streamlet, Meru like a small stone, the lion like a deer, the\",\"end\":\"space\"},{\"n\":3,\"text\":\"serpent like a wreath of flowers, and poisonous juice like a\",\"end\":\"space\"},{\"n\":4,\"text\":\"shower of nectar, to him in whose person becomes manifest\",\"end\":\"space\"},{\"n\":5,\"text\":\"good character which is prized most} by all men.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"94. When I see the sun and the moon oppressed by the\",\"end\":\"space\"},{\"n\":2,\"text\":\"planet ( R\u00e2hu ), the captivity of the elephant and the snake\",\"end\":\"space\"},{\"n\":3,\"text\":\"and the poverty of men of intellect, I come to think\u2014Oh,\",\"end\":\"space\"},{\"n\":4,\"text\":\"destiny is all powerful !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"95. In the first place, the Creator creates an excellent\",\"end\":\"space\"},{\"n\":2,\"text\":\"man, the ornament of the earth and the mine of all good\",\"end\":\"space\"},{\"n\":3,\"text\":\"qualities; but if he makes him short-lived, then alas ! woe to\",\"end\":\"space\"},{\"n\":4,\"text\":\"the indiscretion of Vidhi !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r9\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"96. Though he is the repository of nectar, and the lord\",\"end\":\"space\"},{\"n\":2,\"text\":\"of herbs, though he is followed by S'atabhishak ( the con-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\",\"end\":\"join\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 17 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r10\":{\"type\":\"other\",\"lines\":[{\"n\":1,\"text\":\"2\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\",\"u9\"]},{\"id\":\"u2\",\"type\":\"paragraph\",\"number\":null,\"label\":\"N. B.\",\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"84\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"85\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"87\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"88\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"94\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"95\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r8\"]},{\"id\":\"u9\",\"type\":\"translated_stanza\",\"number\":\"96\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r9\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
