   "uncertain": false,
   "continues_from_earlier": true,
   "continues_later": true,
   "lines": [
    {
     "text": "इत्य् उक्ते भगवान् आह । भो वैनतेय ' सत्यम् उक्तं भवता । यतः ।",
     "end": "space"
    }
   ],
   "note": null
