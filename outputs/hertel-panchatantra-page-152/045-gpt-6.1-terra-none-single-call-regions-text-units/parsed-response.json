   "continues_from_earlier": false,
   "continues_later": false,
   "lines": [
    {
     "text": "सदा भृत्यापराधेन ' स्वामिनं दण्डयेत् किल ।",
     "end": "line"
    },
    {
     "text": "यदि क्रूरं च दुष्टं च ' स्वामी भृत्यं न मुञ्चति ॥३४८॥",
