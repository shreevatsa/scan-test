   "lines": [
    {
     "text": "येन स्याल् लघुता लोके ' पीडा च प्रभुचेतसि ।",
     "end": "line"
    },
    {
     "text": "प्राणत्यागे ऽपि तत् कर्म ' न कुर्यात् कुलसेवकः ॥३४७॥",
     "end": "space"
