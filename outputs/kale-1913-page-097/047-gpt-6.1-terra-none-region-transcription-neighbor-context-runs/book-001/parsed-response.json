{
 "regions": {
  "r3": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अथ योगिस्वरूपमाह द्वाभ्याम्—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "भिक्षाशी जनमध्यसंगरहितः स्वायत्तचेष्टः सदा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "दानादानविरक्तमार्गनिरतः कश्चित्तपस्वी स्थितः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "रथ्याकीर्णविशीर्णजीर्णवसनैरास्यूतकन्थाधरो",
     "end": "line"
    },
    {
     "n": 4,
     "text": "निर्मानो निरहंकृतिः शमसुखाभोगैकबद्धस्पृहः ॥ ९६ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The small variant-reading markers are not clearly legible."
  },
  "r5": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "भिक्षामश्नातीति भिक्षाशी । जनमध्ये यः संगः प्रीतिस्तेन रहितः । स्वस्य",
     "end": "space"
    },
    {
     "n": 2,
     "text": "आयत्ता अधीनाः चेष्टा इन्द्रियव्यापारा यस्य सः । दानं च आदानं",
     "end": "space"
    },
    {
     "n": 3,
     "text": "प्रतिग्रहकरणं च ताभ्यां विरक्त उदासीनो यो मार्गः तस्मिन्निरतः । रथ्यायां",
     "end": "space"
    },
    {
     "n": 4,
     "text": "यानि कीर्णानि विशीर्णानि च जीर्णानि वसनानि तैः आस्यूता कृता या कन्था",
     "end": "space"
    },
    {
     "n": 5,
     "text": "तां धारयतीति तथा । मानरहितः निर्मानः निरहंकृतिः निरहंकारः शमसुखस्य",
     "end": "space"
    },
    {
     "n": 6,
     "text": "आभोगोऽतिशयः स एव एकस्तस्मिन् बद्धा स्पृहा येन सः । उक्तलक्षणः पुरुषः",
     "end": "space"
    },
    {
     "n": 7,
     "text": "कश्चित्क्वचिदेव दृश्यते इत्यर्थः । स्वभावोक्तिरलंकारः । शार्दूल० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small characters are indistinct."
  },
  "r6": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "चाण्डालः किमयं द्विजातिरथवा शूद्रोऽथ किं तापसः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "किं वा तत्त्वविवेकपेशलमतिर्योगीश्वरः कोऽपि किम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इत्युत्पन्नविकल्पजल्पमुखरैः संभाष्यमाणा जनै-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "र्न क्रुद्धाः पथि नैव तुष्टमनसो यान्ति स्वयं योगिनः ९७",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The small variant-reading markers are not clearly legible."
  },
  "r7": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "द्विजातिः त्रैवर्णिकः । तत्त्वस्य विवेके पेशला पटुः मतिर्यस्य । उत्पन्ना ये",
     "end": "space"
    },
    {
     "n": 2,
     "text": "विकल्पाः तेषां जल्पैः जल्पैर्मुखरा वाचालास्तैः । एवंविधानि वाक्यान्युदाहर-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "द्भिरित्यर्थः । तुष्टं प्रीतं मनो येषाम् । यान्ति ब्रह्मनिष्ठत्वात्तृष्णीं गच्छन्ति ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "तदुक्तं गीतायां न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम् । स्थिरबुद्धिरसं-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "मूढो ब्रह्मविद्ब्रह्मणि स्थितः । शीतोष्णसुखदुःखेषु तथा मानावमानयोः ॥",
     "end": "space"
    },
    {
     "n": 6,
     "text": "इत्यादि । ‘अनाविष्कुर्वन्नन्वयात्’ इति उत्तरमीमांसान्यायेन ‘पाण्डित्यं",
     "end": "space"
    },
    {
     "n": 7,
     "text": "निर्विद्याथ बाल्येन तिष्ठासेत्’ इति बृहदारण्यकश्रुत्या ‘अद्वैतं समनुप्राप्य",
     "end": "space"
    },
    {
     "n": 8,
     "text": "जडवल्लोकमाचरेत्’ इति च गौडपादीयकारिकया आहितमर्यादामनुल्लङ्घ्य वर्तने",
     "end": "space"
    },
    {
     "n": 9,
     "text": "करोतीति तात्पर्यम् । शार्दूलवि० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several conjuncts in the commentary are indistinct."
  },
