          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"of \u0924\u0943\u0923 as the other parts above are. \u0938\u094d\u0924\u094d\u0930\u0948\u0923\u0902\u2014\u0938\u094d\u0924\u094d\u0930\u0940\u0923\u093e\u0902 \u0938\u092e\u0942\u0939\u0903 \u0938\u094d\u0924\u094d\u0930\u0948\u0923\u092e\u094d from\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0938\u094d\u0924\u094d\u0930\u0940+\u0928\u091e\u094d (\u0923) a collection of women. \u0938\u092e\u0926\u0943\u0915\u094d\u2014of one that looks\",\"end\":\"space\"},{\"n\":3,\"text\":\"upon all things as equal, having an equal regard for all things.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit is obscured by ink.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 16. \u0905\u0915\u093f\u0928\u094d\u091a\u0928\u0903\u2014one having nothing, extremely poor. \u0926\u093e\u0928\u094d\u0924\u0903\u2014\",\"end\":\"space\"},{\"n\":2,\"text\":\"with desires restrained, self-controlled ( Cf. \u0928\u093f\u0917\u094d\u0930\u0939\u094b \u092c\u093e\u0939\u094d\u092f\u0935\u0943\u0924\u094d\u0924\u0940\u0928\u093e\u0902 \u0926\u092e\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0907\u0924\u094d\u092f\u092d\u093f\u0927\u0940\u092f\u0924\u0947 \u0964 ). \u0936\u093e\u0928\u094d\u0924\u0903\u2014whose mind is always at peace. The\",\"end\":\"space\"},{\"n\":4,\"text\":\"Vedantic meaning of \u0936\u092e has been already explained; ( it is not\",\"end\":\"space\"},{\"n\":5,\"text\":\"however intended here ). \u0938\u092e\u091a\u0947\u0924\u0938\u0903\u2014i. e. equally regardless of\",\"end\":\"space\"},{\"n\":6,\"text\":\"happiness or misery, &c. \u0938\u0941\u0916\u092e\u092f\u093e\u0903\u2014A poetical license; \u0938\u0941\u0916\u092e\u092f\u094d\u092f\u0903\",\"end\":\"space\"},{\"n\":7,\"text\":\"is the correct form.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Devanagari characters are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 17. \u0905\u0928\u093e\u0935\u0930\u094d\u0924\u0940\u2014which never returns. \u0928\u093e\u0928\u093e\u0903 various. \u0935\u093f\u0927\u0941\u0930\u2014\",\"end\":\"space\"},{\"n\":2,\"text\":\"see Sl. 22 supra; distressing, causing affliction. \u092f\u093e\u0935\u0926\u094d \u0924\u093e\u0935\u0926\u094d\u2014\",\"end\":\"space\"},{\"n\":3,\"text\":\"Mr. Telang\u2019s rendering will also do\u2013\u2018alas ! what self-injury is\",\"end\":\"space\"},{\"n\":4,\"text\":\"there, having done which to yourself, you have not immediately\",\"end\":\"space\"},{\"n\":5,\"text\":\"worked at the same again. ( \u092f\u093e\u0935\u0926\u092a\u0915\u0943\u0924\u0902 \u0924\u093e\u0935\u0924\u094d\u0924\u0926\u0947\u0935 \u092a\u0941\u0928\u0930\u092a\u093f \u0935\u094d\u092f\u0935\u0938\u093f\u0924\u092e\u094d ).\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit is indistinct.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 18. \u0917\u0941\u0930\u0941\u2014heavy, unbearable. \u0927\u0928\u0935\u0930\u094d\u091c\u093f\u0924\u2014a poor man.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 19. This stanza occurs in the M\u1e5bchhakatika with variants.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0915\u0941\u0932\u0936\u0940\u0932 &c.-i. e. by people who possess noble birth and character,\",\"end\":\"space\"},{\"n\":3,\"text\":\"These are the people who are fit for, and must care to profit by,\",\"end\":\"space\"},{\"n\":4,\"text\":\"such counsel. Cf. \u0935\u091a\u0938\u094d\u0924\u0924\u094d\u0930 \u092a\u094d\u0930\u092f\u094b\u0915\u094d\u0924\u0935\u094d\u092f\u0902 \u092f\u0924\u094d\u0930\u094b\u0915\u094d\u0924\u0902 \u0938\u092b\u0932\u0902 \u092d\u0935\u0947\u0924\u094d \u0964 \u0936\u094d\u092e\u0936\u093e\u0928\u0918\u091f\u093f\u0915\u093e\u0903\u2014\",\"end\":\"space\"},{\"n\":5,\"text\":\"Pots used at funeral ceremonies or in cemeteries. The fig. is\",\"end\":\"space\"},{\"n\":6,\"text\":\"K\u00e2vyalinga.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The opening Sanskrit word on line 2 is ink-obscured.\"},\"r7\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl 20. \u0915\u093e\u0930\u094d\u0915\u0936\u094d\u092f\u092e\u094d\u2014This and the other corresponding words\",\"end\":\"space\"},{\"n\":2,\"text\":\"have here a double significance, which can be easily made out.\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0915\u093e\u0930\u094d\u0915\u0936\u094d\u092f-(1) cruelty; (2) hardness. \u0905\u0932\u0940\u0915-(1) falsehood; (2) fore-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"head; fr. \u0905\u0932+\u0908\u0915 (\u0915\u0940\u0915\u0928\u094d) Un. IV. 25. \u0915\u094c\u091f\u093f\u0932\u094d\u092f-(1) crookedness,\",\"end\":\"space\"},{\"n\":5,\"text\":\"dishonesty; (2) curliness. \u092e\u093e\u0928\u094d\u0926\u094d\u092f-(1) stupidity; (2) gentleness.\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0938\u094d\u0925\u0942\u0932\u0924\u093e\u2014(1) sluggishness, unwieldiness; (2) plumpness; \u092e\u093e\u092f\u093e\u092a\u094d\u0930\u092f\u094b\u0917\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u2014(1) practising deceit or fraud; employment of tricks; (2)\",\"end\":\"space\"},{\"n\":8,\"text\":\"spreading a charm upon. \u092e\u0943\u0917\u0926\u0943\u0936\u093e\u092e\u094d\u2014the eyes of women are often\",\"end\":\"space\"},{\"n\":9,\"text\":\"compared to those of the deer. Cf. \u092e\u0943\u0917\u093e\u0915\u094d\u0937\u0940, \u092e\u0943\u0917\u0932\u094b\u091a\u0928\u093e. &c.\",\"end\":\"space\"},{\"n\":10,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit etymology on line 4 is indistinct; line 10 is a stray fragment.\"},\"r8\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 21. The idea-The world presents puzzling scenes to the\",\"end\":\"space\"},{\"n\":2,\"text\":\"mind of a thinker. \u0935\u0940\u0923\u093e\u0935\u093e\u0926\u0903\u2014is preferable to \u0935\u0940\u0923\u093e\u0935\u093e\u0926\u094d\u092f\u0902 as opposed\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 82 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"16\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"17\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"18\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"19\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"stanza_note\",\"number\":\"20\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"stanza_note\",\"number\":\"21\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
