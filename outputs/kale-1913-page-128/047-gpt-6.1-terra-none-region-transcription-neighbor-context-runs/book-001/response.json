          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"bloom ) at heart in ever magnifying the minute good quali-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"ties of others.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"79. What is to be done with the mountain of gold or the\",\"end\":\"space\"},{\"n\":2,\"text\":\"mountain of silver, the trees growing ( lit. resting ) upon\",\"end\":\"space\"},{\"n\":3,\"text\":\"which remain the same as they are; we honour the mountain\",\"end\":\"space\"},{\"n\":4,\"text\":\"Malaya alone, by resorting to which even the Kankola, the\",\"end\":\"space\"},{\"n\":5,\"text\":\"Neem and the Kutaja become sandal trees.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"80. With ( the acquisition of ) valuable jewels the gods\",\"end\":\"space\"},{\"n\":2,\"text\":\"were not satisfied; and at the dread poison they were not\",\"end\":\"space\"},{\"n\":3,\"text\":\"terrified; they did not suspend their labours until they\",\"end\":\"space\"},{\"n\":4,\"text\":\"obtained nectar. Resolute persons do not swerve from a\",\"end\":\"space\"},{\"n\":5,\"text\":\"policy once determined upon.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"81. Sometimes lying on the ground and sometimes on a\",\"end\":\"space\"},{\"n\":2,\"text\":\"couch, sometimes subsisting on vegetables and sometimes tast-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"ing rice prepared from the S'\u00e2li variety, sometimes wear-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"ing a wallet and at others superfine garments, a high-souled\",\"end\":\"space\"},{\"n\":6,\"text\":\"man, pursuing ( his cherished ) object, does not care for ease\",\"end\":\"space\"},{\"n\":7,\"text\":\"or hardship.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"82. Good-naturedness ( kind behaviour ) is the ornament\",\"end\":\"space\"},{\"n\":2,\"text\":\"of greatness; silence of valour, restraint over the senses of\",\"end\":\"space\"},{\"n\":3,\"text\":\"learning, humility of ( Vedic ) knowledge, spending in the\",\"end\":\"space\"},{\"n\":4,\"text\":\"right direction ( or, bestowal on worthy recipients ) of\",\"end\":\"space\"},{\"n\":5,\"text\":\"wealth, freedom from anger of austerities;, forgiveness of\",\"end\":\"space\"},{\"n\":6,\"text\":\"a man in power, and freedom from hypocrisy of religious\",\"end\":\"space\"},{\"n\":7,\"text\":\"observances; while good character, which is the root of all\",\"end\":\"space\"},{\"n\":8,\"text\":\"these, is the highest ornament of all.\",\"end\":\"space\"},{\"n\":9,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"83, Let men versed in policy praise or blame; let the\",\"end\":\"space\"},{\"n\":2,\"text\":\"goddess of wealth enter ( their house ) or go away (from it)\",\"end\":\"space\"},{\"n\":3,\"text\":\"as she likes; let death come even to-day or in another age;\",\"end\":\"space\"},{\"n\":4,\"text\":\"persons of mental calibre do not swerve from the path\",\"end\":\"space\"},{\"n\":5,\"text\":\"of justice.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 15 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"78\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_