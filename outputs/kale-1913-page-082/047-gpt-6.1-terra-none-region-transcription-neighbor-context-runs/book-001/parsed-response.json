{
 "regions": {
  "r3": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "पुनः प्रकारान्तरेण संबोधयति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "चेतश्चिन्तय मा रमां सहृदिमामस्थायिनीमास्थया",
     "end": "line"
    },
    {
     "n": 2,
     "text": "भूपालभ्रुकुटीकुटी[१]विहरणव्यापारपण्याङ्गनाम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "कन्थाकञ्चुकिताः[२] प्रविश्य भवनद्वाराणि वाराणसी-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "रथ्यापङ्क्तिषु पाणिपात्रपतितां भिक्षामपेक्षामहे ॥ ६६ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The reading सहृदिमाम् and the exact placement of the footnote markers are uncertain."
  },
  "r5": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "हे चेतः सहृदपि आस्थया आदरपूर्वकं इमां अस्थायिनीं क्षणभङ्गुरां रमां",
     "end": "space"
    },
    {
     "n": 2,
     "text": "लक्ष्मीं मा चिन्तय । कथंभूता पुनः सा रमेत्यत आह भूपालेति । भूपालानां",
     "end": "space"
    },
    {
     "n": 3,
     "text": "भ्रुकुटी एव कुटी गृहं तत्र विहरणमेव व्यापारः तत्र पण्याङ्गना ताम् । पण्याङ्ग-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "नारूपेण विहारेऽनियमितत्वं द्योत्यते । कन्थाकञ्चुकिताः कन्थया कञ्चुकिताः",
     "end": "space"
    },
    {
     "n": 5,
     "text": "संजातकञ्चुकाः । कन्थाकृतगात्रावरणा इत्यर्थः । सन्तः वयं वाराणस्यां या",
     "end": "join"
    },
    {
     "n": 6,
     "text": "रथ्या मार्गाः तासां पङ्क्तिषु भवनद्वाराणि गृहद्वाराणि प्रविश्य पाणिः एव पात्रं",
     "end": "space"
    },
    {
     "n": 7,
     "text": "तस्मिन् पतितां भिक्षां अपेक्षामहे इच्छाम इत्यर्थः । पाणिपात्र उदरमात्रपात्रे",
     "end": "space"
    },
    {
     "n": 8,
     "text": "पतितमश्नीयादिति श्रुतेः । शार्दूल० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several small-type readings and word divisions are uncertain."
  },
  "r6": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "संसारे वक्ष्यमाणा सामग्री स्याच्चेत्तत्राभिनिवेशो युक्तः । अन्यथा निर्विकल्पे",
     "end": "space"
    },
    {
     "n": 2,
     "text": "समाधौ स श्रेयानित्याह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अग्रे गीतं सरसकवयः पार्श्वतो[३] दाक्षिणात्याः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "पृष्ठे[४] लीलावलयरणितं चामरग्राहिणीनाम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "यद्यस्त्येवं कुरु भवरसास्वादने लम्पटत्वं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "नो चेच्चेतः प्रविश सहसा निर्विकल्पे समाधौ ॥ ६७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "अग्रे संमुखे गीतं गायनम् । पार्श्वतः उभयतः दाक्षिणात्याः । दक्षिणदेशे",
     "end": "space"
    },
    {
     "n": 2,
     "text": "भवाः । दक्षिणापश्चात्पुरस्त्यक् (४-२-९८) इति त्यक्प्रत्ययः । सरसाः",
     "end": "space"
    },
    {
     "n": 3,
     "text": "उत्तमाः रसिका वा कवयः । तेषामेव विचित्रवस्तुप्रबन्धनिर्माणपाटवादि-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "ति भावः । चामरग्राहिणीनां बालव्यजनवाहिनीनां लीलया वलयानां कङ्कण-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "भूषणानां रणितं कणितम् । वीजनव्यापारे इति शेषः । भवरसस्य संसाररसस्य",
     "end": "space"
    },
    {
     "n": 6,
     "text": "आस्वादने । लम्पटत्वं लालसां कुरु । लोलुपो लोलुभो लोलो लालसो लम्पट-",
     "end": "hyphen"
    },
    {
     "n": 7,
     "text": "श्च सः । इति यादवः । एवं न स्याच्चेत्सहसा संभ्रमेण निर्विकल्पे ध्येयरूप-",
     "end": "hyphen"
    },
    {
     "n": 8,
     "text": "विकल्पवर्जिते असंप्रज्ञातसमाधौ । यत्र ध्येयस्फुरणमपि विलीयते स्वस्फुर-",
     "end": "hyphen"
    },
    {
     "n": 9,
     "text": "णमात्रं चावशिष्यते । मन्दाक्रान्ता ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small-type readings, particularly the grammatical citation and the compound in line 4, are uncertain."
  },
