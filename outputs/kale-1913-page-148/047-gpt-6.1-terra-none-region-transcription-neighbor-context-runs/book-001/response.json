          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"48. We did not acquire untainted knowledge; nor did\",\"end\":\"space\"},{\"n\":2,\"text\":\"we amass wealth; we did not even serve our parents with a\",\"end\":\"space\"},{\"n\":3,\"text\":\"devoted mind; nor did we embrace young women with\",\"end\":\"space\"},{\"n\":4,\"text\":\"long sparkling eyes even in a dream; like crows we have\",\"end\":\"space\"},{\"n\":5,\"text\":\"passed this period (of our life) craving a morsel from others.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"49. Those from whom we were born have long since pas-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"sed away; those too, with whom we grew up, have been\",\"end\":\"space\"},{\"n\":3,\"text\":\"consigned to the region of memory; now here we are, with\",\"end\":\"space\"},{\"n\":4,\"text\":\"our fall approaching nearer and nearer day by day, reduced\",\"end\":\"space\"},{\"n\":5,\"text\":\"to the same state as that of trees (growing) on the bank of\",\"end\":\"space\"},{\"n\":6,\"text\":\"a sandy river.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"50. The life of men is limited to a hundred years;\",\"end\":\"space\"},{\"n\":2,\"text\":\"half of it passes away in the night; of the remaining half\",\"end\":\"space\"},{\"n\":3,\"text\":\"one-half made up of its first and last fourths is occupied by\",\"end\":\"space\"},{\"n\":4,\"text\":\"youth and old age; the remainder is passed in servitude\",\"end\":\"space\"},{\"n\":5,\"text\":\"&c., accompanied by disease and grief for the separation (of\",\"end\":\"space\"},{\"n\":6,\"text\":\"relations). Whence can there be any happiness for mortals\",\"end\":\"space\"},{\"n\":7,\"text\":\"in wordly life which is even more unsteady than a wave?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"51. Like an actor, a man for a time plays the child,\",\"end\":\"space\"},{\"n\":2,\"text\":\"and then for an instant the youth delighting in pleasures;\",\"end\":\"space\"},{\"n\":3,\"text\":\"for a moment he plays the part of poverty, at another he is\",\"end\":\"space\"},{\"n\":4,\"text\":\"full of prosperity; and at the close of life he retires behind\",\"end\":\"space\"},{\"n\":5,\"text\":\"the curtain of Yama\u2019s seat, his limbs wasted by old age, and\",\"end\":\"space\"},{\"n\":6,\"text\":\"his body graced by wrinkles.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"52. You are a king; we too are exalted by the pride we\",\"end\":\"space\"},{\"n\":2,\"text\":\"take in the wisdom acquired from the preceptor whom we\",\"end\":\"space\"},{\"n\":3,\"text\":\"served; you are known for your greatness, (even) our fame\",\"end\":\"space\"},{\"n\":4,\"text\":\"the poets spread in all directions; thus, O mortifier (of men)\",\"end\":\"space\"},{\"n\":5,\"text\":\"the difference between us is not very great; if you turn\",\"end\":\"space\"},{\"n\":6,\"text\":\"away your face from us, we too are utterly indifferent\",\"end\":\"space\"},{\"n\":7,\"text\":\"(to you).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"53. You are the lord of riches in full, we too of words in\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"all their senses; you are brave, our skill in the act of subduing\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 35 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"48\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"49\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"50\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"51\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"52\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"53\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
