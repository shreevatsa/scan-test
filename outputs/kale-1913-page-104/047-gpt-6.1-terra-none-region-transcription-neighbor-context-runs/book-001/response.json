          "text": "{\"regions\":{\"r3\":{\"type\":\"verse\",\"lines\":[{\"n\":1,\"text\":\"\u0909\u0926\u094d\u092f\u093e\u0928\u0947\u0937\u0941 \u0935\u093f\u091a\u093f\u0924\u094d\u0930\u092d\u094b\u091c\u0928\u0935\u093f\u0927\u093f\u0938\u094d\u0924\u0940\u0935\u094d\u0930\u093e\u0924\u093f\u0924\u0940\u0935\u094d\u0930\u0902 \u0924\u092a\u0903\",\"end\":\"line\"},{\"n\":2,\"text\":\"\u0915\u094c\u092a\u0940\u0928\u093e\u0935\u0930\u0923\u0902 \u0938\u0941\u0935\u0938\u094d\u0924\u094d\u0930\u092e\u092e\u093f\u0924\u0902 \u092d\u093f\u0915\u094d\u0937\u093e\u091f\u0928\u0902 \u092e\u0923\u094d\u0921\u0928\u092e\u094d \u0964\",\"end\":\"line\"},{\"n\":3,\"text\":\"\u0906\u0938\u0928\u094d\u0928\u0902 \u092e\u0930\u0923\u0902 \u091a \u092e\u0919\u094d\u0917\u0932\u0938\u092e\u0902 \u092f\u0938\u094d\u092f\u093e\u0902 \u0938\u092e\u0941\u0924\u094d\u092a\u0926\u094d\u092f\u0924\u0947\",\"end\":\"line\"},{\"n\":4,\"text\":\"\u0924\u093e\u0902 \u0915\u093e\u0936\u0940\u0902 \u092a\u0930\u093f\u0939\u0943\u0924\u094d\u092f \u0939\u0928\u094d\u0924 \u0935\u093f\u092c\u0941\u0927\u0948\u0930\u0928\u094d\u092f\u0924\u094d\u0930 \u0915\u093f\u0902 \u0938\u094d\u0925\u0940\u092f\u0924\u0947 \u0965 \u0967\u0969 \u0965\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"commentary\",\"lines\":[{\"n\":1,\"text\":\"\u092f\u0938\u094d\u092f\u093e\u0902 \u0915\u093e\u0936\u094d\u092f\u093e\u092e\u094d \u0964 \u0924\u0940\u0935\u094d\u0930\u093e\u0924\u093f\u0924\u0940\u0935\u094d\u0930\u092e\u0924\u094d\u092f\u0928\u094d\u0924\u0924\u0940\u0935\u094d\u0930\u0902 \u0924\u092a\u0903 \u0915\u0943\u091a\u094d\u091b\u094d\u0930\u093e\u0926\u093f \u0964 \u0905\u0926\u094d\u092d\u0941\u0924\u092d\u094b\u091c\u0928\u092a\u094d\u0930-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u0915\u093e\u0930\u0938\u0926\u0943\u0936\u0902 \u092d\u0935\u0924\u093f \u0964 \u0915\u094c\u092a\u0940\u0928\u0938\u094d\u092f \u0917\u0941\u0939\u094d\u092f\u0938\u094d\u092f \u0906\u0935\u0930\u0923\u092e\u093e\u091a\u094d\u091b\u093e\u0926\u0928\u0902 \u0938\u0941\u0935\u0938\u094d\u0924\u094d\u0930\u092e\u094d \u0964 \u0905\u092e\u093f\u0924\u0902\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u092a\u0930\u093f\u092e\u093f\u0924\u093f\u0930\u0939\u093f\u0924\u0902 \u092d\u093f\u0915\u094d\u0937\u093e\u091f\u0928\u0902 \u092d\u093f\u0915\u094d\u0937\u093e\u0930\u094d\u0925\u092e\u091f\u0928\u0902 \u092e\u0923\u094d\u0921\u0928\u0902 \u092d\u0942\u0937\u0923\u092e\u094d \u0964 \u092f\u0938\u094d\u092f\u093e\u0902 \u091a \u0906\u0938\u0928\u094d\u0928\u0902\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0928\u093f\u0915\u091f\u0938\u094d\u0925\u093f\u0924\u0902 \u092e\u0930\u0923\u0902 \u092e\u0919\u094d\u0917\u0932\u0938\u092e\u0902 \u0938\u092e\u0941\u0924\u094d\u092a\u0926\u094d\u092f\u0924\u0947 \u0964 \u0924\u093e\u0902 \u0915\u093e\u0936\u0940\u0902 \u092a\u0930\u093f\u0939\u0943\u0924\u094d\u092f \u092a\u0930\u093f\u0924\u094d\u092f\u091c\u094d\u092f \u0964 \u0939\u0928\u094d\u0924\u0947\u0924\u093f\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0916\u0947\u0926\u0947 \u0964 \u0935\u093f\u092c\u0941\u0927\u0948\u0903 \u0938\u0941\u0930\u0948\u0903 \u0915\u093f\u092e\u0928\u094d\u092f\u0924\u094d\u0930 \u0938\u094d\u0925\u0940\u092f\u0924\u0947 \u0964 \u0905\u0924\u094d\u092f\u0928\u094d\u0924\u092e\u093e\u0936\u094d\u091a\u0930\u094d\u092f\u092e\u093f\u0926\u092e\u093f\u0924\u094d\u092f\u0930\u094d\u0925\u0903 \u0964 \u0936\u093e\u0930\u094d\u0926\u0942\u0932\u0966\u0965\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some small-type readings, especially in the first two lines, are uncertain.\"},\"r5\":{\"type\":\"verse\",\"lines\":[{\"n\":1,\"text\":\"\u0928\u093e\u092f\u0902 \u0924\u0947 \u0938\u092e\u092f\u094b \u0930\u0939\u0938\u094d\u092f\u092e\u0927\u0941\u0928\u093e \u0928\u093f\u0926\u094d\u0930\u093e\u0924\u093f \u0928\u093e\u0925\u094b \u092f\u0926\u093f\",\"end\":\"line\"},{\"n\":2,\"text\":\"\u0938\u094d\u0925\u093f\u0924\u094d\u0935\u09