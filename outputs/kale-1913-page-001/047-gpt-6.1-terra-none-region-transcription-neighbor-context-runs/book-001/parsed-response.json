   "uncertain": false,
   "note": null
  },
  "r2": {
   "type": "paragraph",
   "lines": [
    {
     "n": 1,
     "text": "The S'atakas treat of the following themes:—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r3": {
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "NITI S'ATAKA.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "I Introductory—Salutation to Brahma.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "2—14 अज्ञनिन्दा or Ignorance censured.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r6": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "15—28 विद्वत्पद्धति or Learning praised.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r7": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "29—38 मानशौर्यप० or Self-respect and fortitude praised.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "39—51 अर्थप० or wealth and what relates to it.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "52—61 दुर्जनप or wickedness described.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r10": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "62—69 सुजनप० The conduct of the virtuous extolled.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r11": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "70—79 परोपकारपद्धति or the ways of the benevolent.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r12": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "80—89 धैर्यप० or Courage described.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r13": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "90—96 दैवप्रशंसा or The power of Fate described.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r14": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "99—106 कर्मप०-the working of the power of Karman.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r15": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "Miscellaneous. 1—25",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r16": {
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "VAIRA'GYAS'ATAKA.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r17": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "I Salutation to S'iva.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r18": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "2—11 तृष्णादूषणं or desire condemned.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r19": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "12—21 विषयपरित्यागविडम्बना—The pursuit of pleasures a mere",
     "end": "space"
    },
    {
     "n": 2,
     "text": "mockery. They should be abandoned.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r20": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "22—31 याच्ञादैन्य the misery of beggary.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r21": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "32—41 भोगास्थैर्यप०—The impermanency of sensual pleasures.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r22": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "42—51 कालमहिमा—The power of time described.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r23": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "52—61 यतिनृपतिसंवादः— a conversation between a Yati (one who",
     "end": "space"
    },
    {
     "n": 2,
     "text": "has renounced the world) and a king.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r24": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "62—71 मनःसंबोधनप०—An address to the mind.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r25": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "72—81 नित्यानित्यवस्तुविचारः-distinction of the real from the unreal.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r26": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "82—91 शिवार्चनप०—or the way to worship god S'iva.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r27": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "92—101 अवधूतचर्या-or the life of one quite disattached to the world.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r28": {
   "type": "contents_entry",
   "lines": [
    {
     "n": 1,
     "text": "Miscellaneous. 1—44.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  }
