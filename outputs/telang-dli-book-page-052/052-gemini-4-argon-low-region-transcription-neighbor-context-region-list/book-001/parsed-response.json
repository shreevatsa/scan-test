{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "लभेत सिकतासु तैलमपि यत्नतः पीडयन्",
     "end": "line"
    },
    {
     "n": 2,
     "text": "पिबेच्च मृगतृष्णिकासु सलिलं पिपासार्दितः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "space"
    },
    {
     "n": 4,
     "text": "कदाचिदपि पर्यटञ्शशविषाणमासादये-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "न्न तु प्रतिनिविष्टमूर्खजनचित्तमाराधयेत् ॥ ५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "व्यालं बालमृणालतन्तुभिरसौ रोद्धुं समुज्जृम्भते",
     "end": "line"
    },
    {
     "n": 2,
     "text": "",
     "end": "space"
    },
    {
     "n": 3,
     "text": "छेत्तुं वज्रमणीञ्शिरीषकुसुमप्रान्तेन संनह्यते ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "माधुर्यं मधुबिन्दुना रचयितुं क्षाराम्बुधेरीहते",
     "end": "line"
    },
    {
     "n": 5,
     "text": "नेतुं वाञ्छति यः खलान्पथि सतां सूक्तैः सुधास्यन्दिभिः ॥ ६ ॥",
     "end": "space"
    },
    {
     "n": 6,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "स्वायत्तमेकान्तगुणं विधात्रा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "विनिर्मितं छादनमज्ञतायाः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "विशेषतः सर्वविदां समाजे",
     "end": "line"
    },
    {
     "n": 4,
     "text": "विभूषणं मौनमपण्डितानाम् ॥ ७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यदा किञ्चिज्ज्ञोहं द्विप इव मदान्धः समभवं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "तदा सर्वज्ञोस्मीत्यभवदवलिप्तं मम मनः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "यदा किञ्चित्किञ्चिद्बुधजनसकाशादवगतं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "तदा मूर्खोस्मीति ज्वर इव मदो मे व्यपगतः ॥ ८ ॥",
     "end": "space"
    },
    {
     "n": 5,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
