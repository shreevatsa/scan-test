{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यः प्रीणयेत्सुचरितैः पितरं स पुत्रो",
     "end": "line"
    },
    {
     "n": 2,
     "text": "यद्भर्तुरेव हितमिच्छति तत्कलत्रम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तन्मित्रमापदि सुखे च समक्रियं य-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "देतत्त्रयं जगति पुण्यकृतो लभन्ते ॥ ६८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "नम्रत्वेनोन्नमन्तः परगुणकथनैः स्वान्गुणान्ख्यापयन्तः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स्वार्थान्संपादयन्तो विततपृथुतरारम्भयत्नाः परार्थे ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "क्षान्त्यैवाक्षेपरूक्षाक्षरमुखरमुखान्दुर्मुखान्दूषयन्तः",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सन्तः साश्चर्यचर्या जगति बहुमताः कस्य नाभ्यर्चनीयाः ॥६९॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "इति सुजनप्रशंसा ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "अथ परोपकारपद्धतिः ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "भवन्ति नम्रास्तरवः फलोद्गमै-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "र्नवाम्बुभिर्भूरिविलम्बिनो घनाः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "line"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
