          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"to which a door has been opened, for which an entrance is\",\"end\":\"space\"},{\"n\":2,\"text\":\"effected. \u091c\u093e\u0924\u0902 \u091c\u093e\u0924\u092e\u094d\u2014every born being. \u0935\u093f\u0935\u0936\u2014helpless.\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0906\u0924\u094d\u092e\u0938\u093e\u0924\u094d \u0915\u0930\u094b\u0924\u093f\u2014takes entirely in his custody. \u0906\u0924\u094d\u092e\u0938\u093e\u0924\u094d\u2014in\",\"end\":\"space\"},{\"n\":4,\"text\":\"one\u2019s possession. \u2018\u0924\u0926\u0927\u0940\u0928\u0935\u091a\u0928\u0947\u2019 ( P\u00e1n. V. 4. 54. ) \u0938\u093e\u0924\u093f\u0903 \u0938\u094d\u092f\u093e\u0924\u094d.\",\"end\":\"space\"},{\"n\":5,\"text\":\"The aff. \u0938\u093e\u0924\u094d is added to express possession and used with a\",\"end\":\"space\"},{\"n\":6,\"text\":\"form of the roots \u0915\u0943, \u092d\u0942 or \u0905\u0938\u094d or \u0938\u0902\u092a\u0926\u094d \u0928\u093e\u092e \u2014indeed, I should\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"},{\"n\":8,\"text\":\"like to know; cf. \u0924\u0924\u094d\u0930 \u0915\u094b \u0928\u093e\u092e \u0917\u0941\u0923\u094b \u092d\u0935\u0947\u0924\u094d \u0938 \u0917\u0941\u0923\u093f\u0928\u093e\u0902 &c. Nit. 54.\",\"end\":\"space\"},{\"n\":9,\"text\":\"\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u0938\u0941\u0938\u094d\u0925\u093f\u0924\u092e\u094d v. l.\u2014Standing well or firmly, secure, safe.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit readings are difficult to distinguish in the scan.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 35. \u0924\u0941\u0919\u094d\u0917\u2014This adds to the \u091a\u092a\u0932\u0924\u094d\u0935 \u092d\u0919\u094d\u0917\u2014Mr, Telang\",\"end\":\"space\"},{\"n\":2,\"text\":\"translates this by \u2018breaking\u2019 preferring it to its usual sense of\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u2018\u0930\u091a\u0928\u093e\u2019 ( the waves rising in succession ) but we think the\",\"end\":\"space\"},{\"n\":4,\"text\":\"sense of \u0930\u091a\u0928\u093e is more poetical and better as it corresponds to\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u092d\u094b\u0917, the idea of breaking or vanishing being left to be implied.\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0926\u093f\u0928\u093e\u0928\u093f\u2014the acc. by \u0915\u093e\u0932\u093e\u0927\u094d\u0935\u0928\u094b\u0930\u0924\u094d\u092f\u0928\u094d\u0924\u0938\u0902\u092f\u094b\u0917\u0947\u2019 P\u00e1n. II, 3. 5. \u092c\u094b\u0927\u0915\u093e\u0903\u2014\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0938\u0928\u094d\u0924\u0903 being instructors of people. The word has no special\",\"end\":\"space\"},{\"n\":8,\"text\":\"propriety here; it seems to be used for alliteration. \u092a\u0947\u0936\u0932\u2014may\",\"end\":\"space\"},{\"n\":9,\"text\":\"also mean \u091a\u093e\u0930\u0941 beautiful, the \u091a\u093e\u0930\u0941\u0924\u094d\u0935 lying in its excellence. \u091a\u093e\u0930\u094c\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u0926\u0915\u094d\u0937\u0947 \u091a \u092a\u0947\u0936\u0932\u0903 \u0964 Amara \u092f\u0924\u094d\u0928\u0903\u2014effort; may mean an effort to lead\",\"end\":\"space\"},{\"n\":11,\"text\":\"people to Moksha or may simply refer to the transactions of\",\"end\":\"space\"},{\"n\":12,\"text\":\"daily life. Cf. Bg III. 21. quoted in the com.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words and punctuation are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 36. \u0935\u093f\u0924\u093e\u0928\u0902\u2014lit. expansion; a canopy; hence a collection\",\"end\":\"space\"},{\"n\":2,\"text\":\"or mass spread all round. \u0938\u094c\u0926\u093e\u092e\u093f\u0928\u0940\u2014lightning: \u0938\u0941\u0926\u093e\u092e\u094d\u0928\u093f \u092e\u0947\u0918\u0947 \u092d\u0935\u093e;\",\"end\":\"space\"},{\"n\":3,\"text\":\"fr. \u0938\u0941\u0926\u093e\u092e\u0928\u094d a cloud and \u0905\u0923\u094d. \u092d\u0919\u094d\u0917\u0941\u0930\u092e\u094d\u2014frail, liable to speedy\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"dissolution; from \u092d\u091e\u094d\u091c\u094d+\u0917\u0941\u0930\u091a\u094d ( \u0909\u0930 ), see com. \u092f\u094c\u0935\u0928\u0932\u093e\u0932\u0928\u093e\u2014the\",\"end\":\"space\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"indulgences of youth, youthful happiness R\u00e1marshi explains\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0932\u093e\u0932\u0928\u093e by \u0927\u093e\u0930\u0923\u093e, and another commentary by \u0905\u0924\u093f\u092a\u093e\u0932\u0928\u093e; but\",\"end\":\"space\"},{\"n\":9,\"text\":\"neither of these is satisfactory. \u0932\u093e\u0932\u0938\u093e v. l.\u2014the ardent desire\",\"end\":\"space\"},{\"n\":10,\"text\":\"for pleasures which youth begets. \u092f\u094b\u0917\u094b\u2014\u092f\u094b\u0917 seems to be used\",\"end\":\"space\"},{\"n\":11,\"text\":\"here in the sense of \u2018Union with, or manifestation in con-\",\"end\":\"hyphen\"},{\"n\":12,\"text\":\"templation of, the Supreme Spirit. Its usual meaning is\",\"end\":\"space\"},{\"n\":13,\"text\":\"\u091a\u093f\u0924\u094d\u0924\u0935\u0943\u0924\u094d\u0924\u093f\u0928\u093f\u0930\u094b\u0927\u0903 \u2018controlling the functions of the mind,\u2019 by means\",\"end\":\"space\"},{\"n\":14,\"text\":\"of which the individual soul can be in complete union with\",\"end\":\"space\"},{\"n\":15,\"text\":\"the Supreme soul. \u0927\u0948\u0930\u094d\u092f\u0938\u092e\u093e\u0927\u093f &c.\u2014\u0927\u0948\u0930\u094d\u092f\u0947\u0923 (by patience) \u092f\u093e \u0938\u092e\u093e-\",\"end\":\"hyphen\"},{\"n\":16,\"text\":\"\u0927\u093f\u0938\u093f\u0926\u094d\u0927\u093f\u0903 success in the acquisition of the Sam\u00e1dhi by patient\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit forms are indistinct, especially the grammatical derivation and final compound.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 61 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"34\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"35\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"36\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
