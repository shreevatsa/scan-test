          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"74. Those are the noblest persons who, giving up self-in-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"terest, bring about the good of others; those that undertake\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"a business for the sake of others, not inconsistent with their\",\"end\":\"space\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"own good, are men of the middle order; those that stand\",\"end\":\"space\"},{\"n\":7,\"text\":\"in the way of the good of others for their own benefit are\",\"end\":\"space\"},{\"n\":8,\"text\":\"demons in a human form; but we know not what to call\",\"end\":\"space\"},{\"n\":9,\"text\":\"\",\"end\":\"space\"},{\"n\":10,\"text\":\"them ( lit. who they are ) that oppose the good of others\",\"end\":\"space\"},{\"n\":11,\"text\":\"without any advantage to themselves.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"75. Milk, at first, imparted all (its) qualities to its consti-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"tuent water; on seeing the distress of milk (i. e. when it was\",\"end\":\"space\"},{\"n\":3,\"text\":\"heated ) water sacrificed itself in the fire ( i. e. became evapo-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"rated ); seeing the distress of its friend ( i. e. water ), it ( viz.\",\"end\":\"space\"},{\"n\":5,\"text\":\"milk ) became very eager to throw itself into the fire ( lit. to\",\"end\":\"space\"},{\"n\":6,\"text\":\"go to the fire, i. e. began to boil over ); but it settled down\",\"end\":\"space\"},{\"n\":7,\"text\":\"when united with that water\u2014such is the friendship of\",\"end\":\"space\"},{\"n\":8,\"text\":\"the good.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"76. In one part sleeps Kes'ava; in another is the host of\",\"end\":\"space\"},{\"n\":2,\"text\":\"his foes; in a third the chain of mountains seeking shelter; in\",\"end\":\"space\"},{\"n\":3,\"text\":\"another part yet is V\u00e2dava ( submarine ) fire with all the\",\"end\":\"space\"},{\"n\":4,\"text\":\"world-destroying fires. Oh, how extensive, deep and endur-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"ing is the expanse of the sea !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"77. Cut down ( check ) desire, have recourse to patience,\",\"end\":\"space\"},{\"n\":2,\"text\":\"give up pride, fix not ( your ) attachment on sinful deeds,\",\"end\":\"space\"},{\"n\":3,\"text\":\"speak the truth, follow the footsteps of the good, serve the\",\"end\":\"space\"},{\"n\":4,\"text\":\"learned, reverence those that deserve respect, conciliate\",\"end\":\"space\"},{\"n\":5,\"text\":\"( your ) enemies, do not parade your good qualities, preserve\",\"end\":\"space\"},{\"n\":6,\"text\":\"fame and sympathise with those in distress; this is the charac-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"teristic of the good.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"78. Very few good men are there who, full of the nectar\",\"end\":\"space\"},{\"n\":2,\"text\":\"of holiness in thought, word and action and pleasing the\",\"end\":\"space\"},{\"n\":3,\"text\":\"three worlds with numerous acts of beneficence, rejoice ( lit.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 14 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"74\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"75\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"76\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"77\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"78\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
