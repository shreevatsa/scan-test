      "content": [
        {
          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u0917\u0919\u094d\u0917\u093e\u092a\u093e\u0930\u093e\u0924\u094d, \u0917\u0919\u094d\u0917\u093e\u092e\u0927\u094d\u092f\u093e\u0924\u094d. When the last word has the sense of the\",\"end\":\"space\"},{\"n\":2,\"text\":\"Loc. the final may be changed to \u0905\u092e\u094d as here, the sense being\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u092a\u0943\u0937\u094d\u0920\u0938\u094d\u092f \u092e\u0927\u094d\u092f\u0947. See Gr. \u00a7 274. \u0915\u094d\u0930\u094b\u0921\u093e\u0927\u0940\u0928-\u0915\u094d\u0930\u094b\u0921 properly means the\",\"end\":\"space\"},{\"n\":4,\"text\":\"bosom (\u092d\u0941\u091c\u093e\u0928\u094d\u0924\u0930 see Amara. 11. 77.); hence a portion, a corner,\",\"end\":\"space\"},{\"n\":5,\"text\":\"of the ocean\u2019s surface. \u0915\u094d\u0930\u094b\u0921\u0947 \u0905\u0927\u093f \u0915\u094d\u0930\u094b\u0921\u093e\u0927\u0940\u0928\u0902 Loc; Tat. The Tad.\",\"end\":\"space\"},{\"n\":6,\"text\":\"aff. \u0905 (\u0908\u0928) is necessarily added to a Tat. ending in \u0905\u0927\u093f by\",\"end\":\"space\"},{\"n\":7,\"text\":\"P\u00e1n. V. 4. 7. \u0905\u0928\u093e\u0926\u0930\u093e\u0924\u094d with but scanty regard. The ocean seems\",\"end\":\"space\"},{\"n\":8,\"text\":\"to take but little notice of the Tortoise with his immense body.\",\"end\":\"space\"},{\"n\":9,\"text\":\"For the story, see Mat. Pu. Cha. CCXLIX. 26, 27. \u0905\u0939\u0939 expres-\",\"end\":\"hyphen\"},{\"n\":10,\"text\":\"ses here \u2018wonder, astonishment,\u2019 (\u0905\u0926\u094d\u092d\u0941\u0924\u0947). \u0928\u093f\u0903\u0938\u0940\u092e\u093e\u0928\u0903\u2014\u0928 \u0935\u093f\u0926\u094d\u092f\u0924\u0947\",\"end\":\"space\"},{\"n\":11,\"text\":\"\u0938\u0940\u092e\u093e \u092f\u093e\u0938\u093e\u0902. The fem. of \u0928\u093f\u0903\u0938\u0940\u092e\u0928\u094d is formed in three ways; so the\",\"end\":\"space\"},{\"n\":12,\"text\":\"other forms of the pl. are \u0928\u093f\u0903 \u0938\u0940\u092e\u093e\u0903 and \u0928\u093f\u0903\u0938\u0940\u092e\u094d\u0928\u094d\u092f\u0903; see \u092c\u0939\u0941\u0930\u093e\u091c\u0928\u094d\",\"end\":\"space\"},{\"n\":13,\"text\":\"Gr \u00a7 329. The fig. in the first three lines is M\u00e1lad\u00edpaka,\",\"end\":\"space\"},{\"n\":14,\"text\":\"and in the fourth arth\u00e2ntarany\u00e1\u2019sa (confirming the general\",\"end\":\"space\"},{\"n\":15,\"text\":\"proposition about the magnanimity of the actions of the great\",\"end\":\"space\"},{\"n\":16,\"text\":\"by the particular instance of the sea).\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit forms and the transliterated figure name are difficult to read.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 36. \u092e\u0918\u0935\u0928\u094d\u2014Indra. The word here may be \u092e\u0918\u0935\u0928\u094d or\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u092e\u0918\u0935\u0924\u094d; \u092e\u0918\u0924\u0947 \u092a\u0942\u091c\u094d\u092f\u0924\u0947 \u0907\u0924\u093f \u092e\u0918\u0935\u093e or\u2014\u0935\u093e\u0928\u094d. The former is derived by\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u2018\u092e\u0918\u092e\u0928\u094d\u2019\u2014Un. I. 159; the latter by \u2018\u092e\u0918\u0935\u093e \u092c\u0939\u0941\u0932\u092e\u094d\u2019 P\u00e1n. VI. 4. 128.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0924\u0941\u0937\u093e\u0930\u093e\u0926\u094d\u0930\u0947\u0903 \u0938\u0941\u0924\u0903\u2014Main\u00e1ka, son of Him\u00e0laya and Men\u00e1. Cf. \u0905\u0938\u0942\u0924 \u0938\u093e\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0928\u093e\u0917\u0935\u0927\u0942\u092a\u092d\u094b\u0917\u094d\u092f\u0902 \u092e\u0948\u0928\u093e\u0915\u092e\u092e\u094d\u092d\u094b\u0928\u093f\u0927\u093f\u092c\u0926\u094d\u0927\u0938\u0916\u094d\u092f\u092e\u094d \u0964 \u0915\u094d\u0930\u0941\u0926\u094d\u0927\u0947\u093d\u092a\u093f \u092a\u0915\u094d\u0937\u091a\u094d\u091b\u093f\u0926\u093f \u0935\u0943\u0924\u094d\u0930\u0936\u0924\u094d\u0930\u093e\u0935\u0935\u0947\u0926\u0928\u093e\u091c\u094d\u091e\u0902\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0915\u0941\u0932\u093f\u0936\u0915\u094d\u0937\u0924\u093e\u0928\u093e\u092e\u094d Kum. 1. 20. Allusion-Formerly the mountains had\",\"end\":\"space\"},{\"n\":7,\"text\":\"wings with which they flew about and grew very troublesome.\",\"end\":\"space\"},{\"n\":8,\"text\":\"To stop the evil Indra lopped off their wings with his thunder-\",\"end\":\"hyphen\"},{\"n\":9,\"text\":\"bolt when hundreds of them flew to the sea for protection.\",\"end\":\"space\"},{\"n\":10,\"text\":\"Only Main\u00e1ka escaped the fate which overtook others. For this\",\"end\":\"space\"},{\"n\":11,\"text\":\"legend, see R\u00e1m\u00e2. Sun. K. Adh. I. 115\u2013119. For the physical\",\"end\":\"space\"},{\"n\":12,\"text\":\"explanation, see Notes on Rag. 1. 68. Mark the use of the word\",\"end\":\"space\"},{\"n\":13,\"text\":\"\u0909\u091a\u093f\u0924 here. In the construction of \u0935\u0930\u0902 \u0928 \u091a or \u0928 \u092a\u0941\u0928\u0903, such a word\",\"end\":\"space\"},{\"n\":14,\"text\":\"is not usual, its signification being implied in the construction\",\"end\":\"space\"},{\"n\":15,\"text\":\"itself. Mr. Telang\u2019s note.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The derivation and some letters in the Sanskrit quotation are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 37. \u092f\u0924\u094d-\u0924\u0924\u094d\u2014since then; in as much as. \u092a\u093e\u0926\u0948\u0903 \u0938\u094d\u092a\u0943\u0937\u094d\u091f\u0903- (1)\",\"end\":\"space\"},{\"n\":2,\"text\":\"touched with the rays; (2) with feet. \u0924\u0947\u091c\u0938\u094d\u0935\u0940\u2014of pre-eminent\",\"end\":\"space\"},{\"n\":3,\"text\":\"valour. \u0935\u093f\u0928\u094d showing excess (\u092d\u0942\u092e\u093e\u0928\u094d) \u2018\u0905\u0938\u094d\u092e\u093e\u092f\u093e\u092e\u0947\u0927\u093e\u0938\u094d\u0930\u091c\u094b \u0935\u093f\u0928\u093f\u0903 P\u00e1n V\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit grammatical quotation is difficult to read; line 4 is a stray part of line 3.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 18 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"36\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"37\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
