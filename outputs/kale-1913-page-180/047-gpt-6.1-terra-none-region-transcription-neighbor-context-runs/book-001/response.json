          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u0905\u0938\u093f\u0927\u093e\u0930\u093e\u092f\u093e\u0902 \u0936\u092f\u0928\u092e\u093f\u0935 \u0926\u0941\u0937\u094d\u0915\u0930\u0902 \u0935\u094d\u0930\u0924\u0902 the vow difficult like that of lying\",\"end\":\"space\"},{\"n\":2,\"text\":\"on the edge of a sword. Cf. \u0915\u0923\u094d\u091f\u0915\u0935\u094d\u0930\u0924\u0936\u092f\u0928\u0932\u0940\u0932\u093e\u092e\u094d K\u00e2d. p. 369.;\",\"end\":\"space\"},{\"n\":3,\"text\":\"( 2 ) or as Malli. explains it ( Rag. XIII. 67. ) \u092f\u0941\u0935\u093e \u092f\u0941\u0935\u0924\u094d\u092f\u093e \u0938\u093e\u0930\u094d\u0927\u0902\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u092f\u0924\u094d\u0938\u0941\u0917\u094d\u0927\u092e\u0927\u0941\u0930\u0902 \u0935\u093e\u091a\u0930\u0947\u0924\u094d \u0964 \u0905\u0928\u094d\u0924\u0930\u094d\u0928\u093f\u0935\u0943\u0924\u094d\u0924\u0938\u0902\u0917\u0903 \u0938\u094d\u092f\u093e\u0926\u0938\u093f\u0927\u093e\u0930\u0902 \u0935\u094d\u0930\u0924\u0902 \u0939\u093f \u0924\u0924\u094d \u0965 \u0907\u0924\u093f \u092f\u093e\u0926\u0935\u0903 \u0964\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0907\u0926\u0902 \u091a\u093e\u0938\u093f\u0927\u093e\u0930\u093e\u091a\u0902\u0915\u094d\u0930\u092e\u0923 ( moving on ) \u0924\u0941\u0932\u094d\u092f\u0924\u094d\u0935\u093e\u0926\u0938\u093f\u0927\u093e\u0930\u093e\u0935\u094d\u0930\u0924\u092e\u093f\u0924\u094d\u092f\u0941\u091a\u094d\u092f\u0924\u0947 \u0964 Or (3)\",\"end\":\"space\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"according to some \u0936\u092f\u0928\u0947 \u092e\u0927\u094d\u092f\u0947 \u0916\u0921\u094d\u0917\u0902 \u0928\u093f\u0927\u093e\u092f \u0938\u094d\u0924\u094d\u0930\u0940\u092a\u0941\u0902\u0938\u094c \u092f\u0924\u094d\u0930 \u092c\u094d\u0930\u0939\u094d\u092e\u091a\u0930\u094d\u092f\u0947\u0923 \u0938\u094d\u0935\u092a\u0924-\",\"end\":\"hyphen\"},{\"n\":8,\"text\":\"\u0938\u094d\u0924\u0924\u094d \u0964 Or ( see com. ). This explains the extreme difficulty of\",\"end\":\"space\"},{\"n\":9,\"text\":\"the course of conduct marked out for themselves by the good.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several words in the Sanskrit quotation are difficult to distinguish.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 29. An Anyokti. \u0915\u094d\u0937\u093e\u092e-parched with; \u0915\u094d\u0937\u0948+\u0915\u0930\u094d\u0924\u0930\u093f \u0915\u0903 \u0964 \u0915\u0943\u0936\u2014p.\",\"end\":\"space\"},{\"n\":2,\"text\":\"p. of \u0915\u0943\u0936\u094d to be reduced; P\u00e2n. VII. 2. 55. \u0936\u093f\u0925\u093f\u0932\u092a\u094d\u0930\u093e\u092f\u0903\u2014Almost\",\"end\":\"space\"},{\"n\":3,\"text\":\"full of wrinkles, or decayed. N. B. At the end of a comp. \u092a\u094d\u0930\u093e\u092f\",\"end\":\"space\"},{\"n\":4,\"text\":\"may be translated by ( 1 ) for the most part, almost; as \u092e\u0943\u0924\u092a\u094d\u0930\u093e\u092f\u0903\",\"end\":\"space\"},{\"n\":5,\"text\":\"( 2 ) abounding or rich in, full of; as \u0936\u093e\u0932\u093f\u092a\u094d\u0930\u093e\u092f\u094b \u0926\u0947\u0936\u0903; and\",\"end\":\"space\"},{\"n\":6,\"text\":\"like, resembling; as \u0935\u0930\u094d\u0937\u0936\u0924\u092a\u094d\u0930\u093e\u092f\u0902 \u0926\u093f\u0928\u092e\u094d. \u0935\u093f\u092a\u0928\u094d\u0928\u0926\u0940\u0927\u093f\u0924\u093f\u0903\u2014\u0926\u0940\u0927\u093f\u0924\u093f means\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0924\u0947\u091c\u0938\u094d lustre, fire; hence vigour, energy.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit examples and grammatical derivation are somewhat unclear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u092e\u0924\u094d\u0924\u0947\u092d\u0947\u0928\u094d\u0926\u094d\u0930\u2014&c.\u2014\u092e\u0924\u094d\u0924\u093e\u0903 intoxicated, furious. \u0915\u0935\u0932\u2014a mouthful.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0924\u0938\u094d\u092f &c. whose desire is fixed solely on eating &c, \u092e\u093e\u0928\u092e\u0939\u0924\u093e\u092e\u094d\u2014\",\"end\":\"space\"},{\"n\":3,\"text\":\"great by self-respect or honour. \u0905\u0917\u094d\u0930\u0947\u0938\u0930\u0903\u2014\u0905\u0917\u094d\u0930\u092e\u0917\u094d\u0930\u0947\u0923\u093e\u0917\u094d\u0930\u0947 \u0935\u093e \u0938\u0930\u0924\u0940\u0924\u093f\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0905\u0917\u094d\u0930\u0947\u0938\u0930\u0903 \u0964 ( see com. ). \u0938\u0942\u0924\u094d\u0930\u0947\u093d\u0917\u094d\u0930\u0947 \u0907\u0924\u093f \u090f\u0926\u0928\u094d\u0924\u0924\u094d\u0935\u092e\u092a\u093f \u0928\u093f\u092a\u093e\u0924\u094d\u092f\u0924\u0947 \u0964 \u0915\u0925\u0902 \u0924\u0930\u094d\u0939\u093f \u2018\u092f\u0942\u0925\u0902\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0924\u0926\u0917\u094d\u0930\u0938\u0930\u0917\u0930\u094d\u0935\u093f\u0924\u0915\u0943\u0937\u094d\u0923\u0938\u093e\u0930\u092e\u094d ( Rag. IX. 55. ) \u0907\u0924\u093f \u0964 \u092c\u093e\u0939\u0941\u0932\u0915\u093e\u0926\u093f\u0924\u093f \u0939\u0930\u0926\u0924\u094d\u0924\u0903 \u0964\",\"end\":\"space\"},{\"n\":6,\"text\":\"Sid. Kau. The change of \u0905\u0917\u094d\u0930 to \u0905\u0917\u094d\u0930\u0947 is irregular. \u0915\u0947\u0938\u0930\u093f\u0928\u094d\u2014\u0915\u0947\u0938\u0930\u0903\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0905\u0938\u094d\u092f\u093e\u0938\u094d\u0924\u0940\u0924\u093f; as applied to the pollen of flowers, both \u0915\u0947\u0938\u0930 and\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0915\u0947\u0936\u0930 are correct; but as applied to the mane of a lion \u0915\u0947\u0938\u0930 is the\",\"end\":\"space\"},{\"n\":9,\"text\":\"only correct form. Hence \u0915\u0947\u0938\u0930\u093f\u0928\u094d is the only correct form and\",\"end\":\"space\"},{\"n\":10,\"text\":\"not \u0915\u0947\u0936\u0930\u093f\u0928\u094d when meaning a lion ( as written in some lexicons ).\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit derivational text is difficult to read.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 30. \u0928\u093f\u0930\u094d\u092e\u093e\u0902\u0938\u2014The word \u092e\u093e\u0902\u0938 is curiously derived in Manu\",\"end\":\"space\"},{\"n\":2,\"text\":\"Sm. V. 55. \u092e\u093e\u0902 \u0938 \u092d\u0915\u094d\u0937\u092f\u093f\u0924\u093e\u093d\u092e\u0941\u0924\u094d\u0930 \u092f\u0938\u094d\u092f \u092e\u093e\u0902\u0938\u092e\u093f\u0939\u093e\u0926\u094d\u092e\u094d\u092f\u0939\u092e\u094d \u0964 \u090f\u0924\u0928\u094d\u092e\u093e\u0902\u0938\u0938\u094d\u092f\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u092e\u093e\u0902\u0938\u0924\u094d\u0935\u0902 \u092a\u094d\u0930\u0935\u0926\u0928\u094d\u0924\u093f \u092e\u0928\u0940\u0937\u093f\u0923\u0903 \u0965 \u0905\u0938\u094d\u0925\u093f\u0915\u0902\u2014a small bone; \u0915 in such cases\",\"end\":\"space\"},{\"n\":4,\"text\":\"is used in a diminutive sense; it may also have a deprecatory\",\"end\":\"space\"},{\"n\":5,\"text\":\"sense here; \u0915\u0941\u0924\u094d\u0938\u093f\u0924\u092e\u0938\u094d\u0925\u093f \u0905\u0938\u094d\u0925\u093f\u0915\u092e\u094d. The reading \u0905\u0938\u094d\u0925\u093f \u0917\u094b\u0903 has\",\"end\":\"space\"},{\"n\":6,\"text\":\"no special propriety here. \u0938\u093f\u0902\u0939\u0903\u2014\u0939\u093f\u0928\u0938\u094d\u0924\u0940\u0924\u093f, a word of the \u092a\u0943\u0937\u094b\u0926\u0930\u093e\u0926\u093f\",\"end\":\"space\"},{\"n\":7,\"text\":\"class; \u0938\u093f\u0902\u0939\u094c \u0935\u0930\u094d\u0923\u0935\u093f\u092a\u0930\u094d\u092f\u092f\u093e\u0924\u094d \u0964 Sid. Kau. \u0938\u0924\u094d\u0924\u094d\u0935\u093e\u0928\u0941\u0930\u0942\u092a\u0902 worthy of, in\",\"end\":\"space\"},{\"n\":8,\"text\":\"keeping with, one's greatness or magnanimity of heart, inherent\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit derivation of \u0938\u093f\u0902\u0939\u0903 is not entirely clear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 15 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"29\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\",\"r4\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"30\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
