          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"and whose sovereignty in heaven is not permanent. \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u092f\u0924\",\"end\":\"space\"},{\"n\":2,\"text\":\"&c.\u2014\u090f\u0915\u0902 \u0915\u0947\u0935\u0932\u092e\u0947\u0935 \u092b\u0932\u092e\u0947\u0915\u092b\u0932\u0902 \u0915\u0930\u094d\u092e\u0923 \u090f\u0915\u092b\u0932\u0902 \u0915\u0930\u094d\u092e\u0948\u0915\u092b\u0932\u0902; \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u092f\u0924\u0902 \u0935\u094d\u092f\u0935-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\u0938\u094d\u0925\u093f\u0924\u0902 predetermind, fixed \u0915\u0930\u094d\u092e\u0948\u0915\u092b\u0932\u0902 \u0926\u0926\u093e\u0924\u093f \u0907\u0924\u093f, Even Vidhi has no\",\"end\":\"space\"},{\"n\":4,\"text\":\"arbitrary power to dispense fruits. It is entirely guided by\",\"end\":\"space\"},{\"n\":5,\"text\":\"men\u2019s actions in the distribution thereof. The poet here distin-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"guishes betweed Vidhi and Karmau.\u2014\u0915\u0930\u094d\u092e\u092d\u094d\u092f\u0903\u2014Every action\",\"end\":\"space\"},{\"n\":7,\"text\":\"must bear its fruit, good or bad. Cf. \u2018\u0928 \u0939\u093f \u0915\u0930\u094d\u092e\u093e\u0923\u093f \u0915\u094d\u0937\u0940\u092f\u0928\u094d\u0924\u0947 \u0964\",\"end\":\"space\"},{\"n\":8,\"text\":\"Mah\u00e1bh\u00e1rata, and the well known Smrti \u2018\u0928\u093e\u092d\u0941\u0915\u094d\u0924\u0902 \u0915\u094d\u0937\u0940\u092f\u0924\u0947 \u0915\u0930\u094d\u092e \u0964\u2019\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u0928 \u092f\u0947\u092d\u094d\u092f\u0903 \u092a\u094d\u0930\u092d\u0935\u0924\u093f\u2014The dat. by \u2018\u0928\u092e\u0903\u0938\u094d\u0935\u0938\u094d\u0924\u093f\u0938\u094d\u0935\u093e\u0939\u093e\u0938\u094d\u0935\u0927\u093e\u0932\u0902\u0935\u0937\u0921\u094d\u092f\u094b\u0917\u093e\u091a\u094d\u091a\u2019 \u0964 P\u00e1n.\",\"end\":\"space\"},{\"n\":10,\"text\":\"II. 3 16. Here \u0928 \u092a\u094d\u0930\u092d\u0935\u0924\u093f is equivalent to \u0928\u093e\u0932\u092e\u094d \u0964 The gen. may\",\"end\":\"space\"},{\"n\":11,\"text\":\"also be used with words like \u092a\u094d\u0930\u092d\u0941 &c.; \u2018\u092a\u094d\u0930\u092d\u094d\u0935\u093e\u0926\u093f\u092f\u094b\u0917\u0947 \u0937\u0937\u094d\u0920\u094d\u092f\u092a\u093f \u0938\u093e\u0927\u0941\u0903 \u0964\",\"end\":\"space\"},{\"n\":12,\"text\":\"\u0924\u0947\u0928 \u092a\u094d\u0930\u092d\u0941\u0930\u094d\u092c\u0941\u092d\u0941\u0935\u0928\u0924\u094d\u0930\u092f\u0938\u094d\u092f\u0947\u0924\u093f \u0938\u093f\u0926\u094d\u0927\u092e\u094d \u0964 Sid. Kau. The Fig. here is \u0938\u093e\u0930\",\"end\":\"space\"},{\"n\":13,\"text\":\"which is defined as \u0909\u0924\u094d\u0924\u0930\u094b\u0924\u094d\u0924\u0930\u094b\u0924\u094d\u0915\u0930\u094d\u0937\u094b \u092d\u0935\u0947\u0924\u094d\u0938\u093e\u0930\u0903 \u092a\u0930\u093e\u0935\u0927\u093f\u0903 \u0964 K. P. X.\",\"end\":\"space\"},{\"n\":14,\"text\":\"S\u2019ara or climax is that in which excellence rising successively\",\"end\":\"space\"},{\"n\":15,\"text\":\"ultimately reaches its culminating point.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit compounds, particularly in lines 2, 9 and 12, are difficult to distinguish.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 100. \u0915\u0941\u0932\u093e\u0932\u0935\u0924\u094d\u2014Like a potter. Here the aff. \u0935\u0924\u094d refers to the\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0915\u094d\u0930\u093f\u092f\u093e viz. the work of forming things which Brahm\u00e2 has to do\",\"end\":\"space\"},{\"n\":3,\"text\":\"like a potter fashioning his clay-things. \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0923\u094d\u0921\u092d\u093e\u0923\u094d\u0921\u094b\u0926\u0930\u0947\u2014in the\",\"end\":\"space\"},{\"n\":4,\"text\":\"cavity of the immense vessel of the primordial egg, (bursting\",\"end\":\"space\"},{\"n\":5,\"text\":\"which Brahm\u00e2 came out and out of which the universe sprang);\",\"end\":\"space\"},{\"n\":6,\"text\":\"See Manu. I. 11\u201413 and Mat. P. II. 24. et. seq. \u0909\u0926\u0930\u0947\u2014because\",\"end\":\"space\"},{\"n\":7,\"text\":\"the two shelves of the egg form the extreme boundaries of the\",\"end\":\"space\"},{\"n\":8,\"text\":\"universe within which every existing thing is situated. \u0928\u093f\u092f\u092e\u093f\u0924-\",\"end\":\"space\"},{\"n\":9,\"text\":\"restrained, chained down as it were. \u0935\u093f\u0937\u094d\u0923\u0941\u0903\u2014The name is thus\",\"end\":\"space\"},{\"n\":10,\"text\":\"popularly derived\u2014\u092f\u0938\u094d\u092e\u093e\u0926\u094d\u0935\u093f\u0936\u094d\u0935\u092e\u093f\u0926\u0902 \u0938\u0930\u094d\u0935\u0902 \u0924\u0938\u094d\u092f \u0936\u0915\u094d\u0924\u094d\u092f\u093e \u092e\u0939\u093e\u0924\u094d\u092e\u0928\u0903 \u0964 \u0924\u0938\u094d\u092e\u093e\u0926\u0947\u0935\u0947-\",\"end\":\"hyphen\"},{\"n\":11,\"text\":\"\u091a\u094d\u092f\u0924\u0947 \u0935\u093f\u0937\u094d\u0923\u0941\u0930\u094d\u0935\u093f\u0936\u0927\u093e\u0924\u094b\u0903 \u092a\u094d\u0930\u0935\u0947\u0936\u093e\u0928\u093e\u0924\u094d \u0965 \u0926\u0936\u093e\u0935\u0924\u093e\u0930\u0966\u2014two constructions are\",\"end\":\"space\"},{\"n\":12,\"text\":\"possible;\u2014(1) \u0917\u0939\u0928 may be taken as meaning a forest ( \u0926\u0936\u093e\u0935\u0924\u093e\u0930\u093e\",\"end\":\"space\"},{\"n\":13,\"text\":\"\u090f\u0935 \u0917\u0939\u0928\u0902 ) and \u092e\u0939\u093e\u0938\u0902\u0915\u091f\u0947 as a Bah. comp. meaning \u2018beset with\",\"end\":\"space\"},{\"n\":14,\"text\":\"great difficulty.\u2019 (2) The other way is to take \u0917\u0939\u0928 as an adj.\",\"end\":\"space\"},{\"n\":15,\"text\":\"qualifying \u092e\u0939\u093e\u0938\u0902\u0915\u091f\u0947 ( a noun ) meaning \u2018the great difficulty.\u2019\",\"end\":\"space\"},{\"n\":16,\"text\":\"The latter way is preferable. Vishnu was cursed by Dur-\",\"end\":\"hyphen\"},{\"n\":17,\"text\":\"v\u00e2sas to undergo the penalty of being born on the earth\",\"end\":\"space\"},{\"n\":18,\"text\":\"ten times. The ten incarnations are given in the follow-\",\"end\":\"hyphen\"},{\"n\":19,\"text\":\"ing couplet\u2014\u2014\u092e\u0924\u094d\u0938\u094d\u092f\u0903 \u0915\u0942\u0930\u094d\u092e\u094b \u0935\u0930\u093e\u0939\u0936\u094d\u091a \u0928\u0930\u0938\u093f\u0902\u0939\u094b\u0925 \u0935\u093e\u092e\u0928\u0903 \u0964 \u0930\u093e\u092e\u094b\",\"end\":\"space\"},{\"n\":20,\"text\":\"\u0930\u093e\u092e\u0936\u094d\u091a \u0915\u0943\u0937\u094d\u0923\u0936\u094d\u091a \u092c\u0941\u0926\u094d\u0927\u0903 \u0915\u0932\u094d\u0915\u0940 \u091a \u0924\u0947 \u0926\u0936 \u0965 \u0930\u0941\u0926\u094d\u0930\u0903\u2014\u0930\u094b\u0926\u092f\u0924\u094d\u092f\u0926\u094d\u0930\u093e\u0928\u094d \u0907\u0924\u093f fr.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Devanagari in the quotations, especially lines 10\u201311 and 20, is unclear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 37 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"100\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r3\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
