          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u091c\u0928\u0938\u094d\u0925\u093e\u0928\u0947 \u092d\u094d\u0930\u093e\u0928\u094d\u0924\u0902 \u0915\u0928\u0915\u092e\u0943\u0917\u0966 Utta. I. Or \u0926\u0947\u0936\u0902 may be taken as nom.\",\"end\":\"space\"},{\"n\":2,\"text\":\"sing. of \u0926\u0947\u0936 n. (which is rare). \u092d\u0941\u0915\u094d\u0924\u092e\u094d\u2014(meals were) eaten\",\"end\":\"space\"},{\"n\":3,\"text\":\"(by me). \u0915\u093e\u0915\u0935\u0924\u094d \u0906\u0936\u0919\u094d\u0915\u092f\u093e\u2014miserably and with fear like a crow.\",\"end\":\"space\"},{\"n\":4,\"text\":\"The meaning is\u2014being an unwelcome guest at the house of\",\"end\":\"space\"},{\"n\":5,\"text\":\"strangers I was afraid they might at any moment drive me\",\"end\":\"space\"},{\"n\":6,\"text\":\"away just as people drive away a crow. Mr. Telang puts on this\",\"end\":\"space\"},{\"n\":7,\"text\":\"a different interpretation. He says.\u2014\u201cThe fear, however,\",\"end\":\"space\"},{\"n\":8,\"text\":\"would rather seem to be the fear of being seen by others eating\",\"end\":\"space\"},{\"n\":9,\"text\":\"at the house of a stranger.\u201d There is no warrant, however, to\",\"end\":\"space\"},{\"n\":10,\"text\":\"take the word stranger to mean a person of a different caste.\",\"end\":\"space\"},{\"n\":11,\"text\":\"\u091c\u0943\u092e\u094d\u092d\u0938\u093f\u2014The Paras. is for the metre; it should be \u091c\u0943\u092e\u094d\u092d\u0938\u0947; \u091c\u0943\u092e\u094d\u092d\u094d\",\"end\":\"space\"},{\"n\":12,\"text\":\"\",\"end\":\"space\"},{\"n\":13,\"text\":\"to gape, increase, grow strong. R\u00e2marshi takes \u092a\u093e\u092a\u0948\u0915\u0928\u093f\u0930\u0924\u093e as\",\"end\":\"space\"},{\"n\":14,\"text\":\"a Bah. dissolving it as \u092a\u093e\u092a\u0948\u0915\u0938\u094d\u092e\u093f\u0928\u094d \u0928\u093f\u0930\u0924\u0903 \u092a\u0941\u092e\u093e\u0928\u094d \u092f\u092f\u093e (\u0939\u0947\u0924\u0941\u092d\u0942\u0924\u092f\u093e) \u0938\u093e\",\"end\":\"space\"},{\"n\":15,\"text\":\"but this is ungrammatical.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words, especially in the final lines, are difficult to read.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 5. \u0909\u0932\u094d\u0932\u093e\u092a\u093e\u0903\u2014taunting words. \u0906\u0930\u093e\u0927\u0928\u2014humouring, pleas-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"ing. \u0936\u0942\u0928\u094d\u092f\u0947\u0928 \u092e\u0928\u0938\u093e with a vacant mind; though my mind was not\",\"end\":\"space\"},{\"n\":3,\"text\":\"sympathetic. Some construe as (\u0916\u0932\u093e\u0928\u093e\u0902) \u0939\u0938\u093f\u0924\u092e\u092a\u093f \u0936\u0942\u0928\u094d\u092f\u0947\u0928 \u0915\u093e\u0930\u094d\u092f\u093e\u0915\u093e\u0930\u094d\u092f\u0935\u093f-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"\u091a\u093e\u0930\u0936\u0942\u0928\u094d\u092f\u0947\u0928 \u092e\u0928\u0938\u093e \u0938\u094b\u0922\u0902; but this is rather farfetched and is not so\",\"end\":\"space\"},{\"n\":5,\"text\":\"forcible \u091a\u093f\u0924\u094d\u0924\u0938\u094d\u0924\u092e\u094d\u092d\u0903 \u0915\u0943\u0924\u0903\u2014(my mind revolted against these\",\"end\":\"space\"},{\"n\":6,\"text\":\"things but) I controlled my temper. \u092a\u094d\u0930\u0924\u093f\u0939\u0924\u0927\u093f\u092f\u093e\u0902 (\u0924\u093e\u0928\u094d \u092a\u094d\u0930\u0924\u0940\u0924\u094d\u092f\u0930\u094d\u0925\u0903\u0964)\",\"end\":\"space\"},{\"n\":7,\"text\":\"of blunted faculties, senseless, wicked. \u092e\u094b\u0918\u093e\u0936\u0947-\u092e\u094b\u0918\u093e \u0906\u0936\u093e \u092f\u0938\u094d\u092f\u093e\u0903,\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0924\u0924\u094d\u0938\u0902\u092c\u0941\u0926\u094d\u0927\u093f\u0903; (O greed), of fruitless expectations. \u0928\u0930\u094d\u0924\u092f\u0938\u093f\u2014To incite\",\"end\":\"space\"},{\"n\":9,\"text\":\"to something bad. A derivative of this word is sometimes used\",\"end\":\"space\"},{\"n\":10,\"text\":\"in a similar sense in Marathi (\u0928\u093e\u091a\u0935\u0923\u0947\u0902.)\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit compounds and punctuation are unclear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 6. \u0924\u0941\u0932\u093f\u0924\u0966\u2014this comparison is very common. Cf. \u0928\u0932\u093f\u0928\u0940-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u0926\u0932\u00ad\u0917\u0924\u091c\u0932\u092e\u0924\u093f\u0924\u0930\u0932\u0902 \u0924\u0926\u094d\u0935\u091c\u094d\u091c\u0940\u0935\u093f\u0924\u092e\u0924\u093f\u0936\u092f\u091a\u092a\u0932\u092e\u094d Moh. M. 5. \u0915\u0943\u0924\u0947 goes with\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u092a\u094d\u0930\u093e\u0923\u093e\u0928\u093e\u092e\u094d; \u0906\u0922\u094d\u092f a rich man; derived from \u0906+\u0922\u094d\u092f\u0948+\u0915, \u092a\u0943\u0937\u094b\u0926\u0930\u093e\u0926\u093f\u0966.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0928\u093f\u091c\u0917\u0941\u0923\u0966-self-praise is forbidden, and is therefore considered to\",\"end\":\"space\"},{\"n\":5,\"text\":\"be a sin. Cf. \u091d\u0941\u0935\u0924\u0947 \u0939\u093f \u092b\u0932\u0947\u0928 \u0938\u093e\u0927\u0935\u094b \u0928 \u0924\u0941 \u0915\u0923\u094d\u0920\u0947\u0928 \u0928\u093f\u091c\u094b\u092a\u092f\u094b\u0917\u093f\u0924\u093e\u092e\u094d \u0964 Nai.\",\"end\":\"space\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"II. 48. \u0907\u0928\u094d\u0926\u094d\u0930\u094b\u092a\u093f \u0932\u0918\u0941\u0924\u093e\u0902 \u092f\u093e\u0924\u093f \u0938\u094d\u0935\u092f\u0902\u092a\u094d\u0930\u0916\u094d\u092f\u093e\u092a\u093f\u0924\u0948\u0930\u094d\u0917\u0941\u0923\u0948\u0903\u0964 Subh.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit readings, particularly the quotation on line 5, are uncertain.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 7. \u0915\u094d\u0937\u093e\u0928\u094d\u0924\u092e\u094d\u2014We forbore, pardoned. Cf. \u092d\u094d\u0930\u093e\u0928\u094d\u0924\u092e\u094d sl. 4. \u0928\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0915\u094d\u0937\u092e\u092f\u093e but not through forgiveness i. e. through inability to\",\"end\":\"space\"},{\"n\":3,\"text\":\"retaliate. \u0917\u0943\u0939\u094b\u091a\u093f\u0924 &c.\u2014The happiness which was not ours was\",\"end\":\"space\"},{\"n\":4,\"text\":\"as good as relinquished; but we were discontented, and there-\",\"end\":\"hyphen\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation on line 3 is not fully clear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 52 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"4\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"5\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"6\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"7\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
