          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"dealing with one\u2019s enemies, patience with the elders, and\",\"end\":\"space\"},{\"n\":2,\"text\":\"shrewdness towards women.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"23, Good company removes the dulness of intellect,\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"infuses truth into speech, bestows great honour, removes\",\"end\":\"space\"},{\"n\":4,\"text\":\"sin, purifies the heart, and spreads fame in all directions;\",\"end\":\"space\"},{\"n\":5,\"text\":\"say what it does not secure for men.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"24. Victorious are the blessed poets-in-chief, conversant\",\"end\":\"space\"},{\"n\":2,\"text\":\"with all sentiments, whose bodies in the form of fame enjoy\",\"end\":\"space\"},{\"n\":3,\"text\":\"immunity from old age and death.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"25. A well-behaved son, a chaste and loving wife, a master\",\"end\":\"space\"},{\"n\":2,\"text\":\"ready to bestow favours, an affectionate friend, honest ser-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"vants, the mind free from the least trouble, a lovely form,\",\"end\":\"space\"},{\"n\":4,\"text\":\"abiding prosperity, and a face effulgent with learning;\",\"end\":\"space\"},{\"n\":5,\"text\":\"all these can be obtained by a mortal if Hari, who gratifies\",\"end\":\"space\"},{\"n\":6,\"text\":\"desires and pleases the world, is propitiated.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"26. Refraining from destroying life, self-restraint as\",\"end\":\"space\"},{\"n\":2,\"text\":\"regards appropriating the wealth of others, truthful speech,\",\"end\":\"space\"},{\"n\":3,\"text\":\"charity at the right time and according to means, not\",\"end\":\"space\"},{\"n\":4,\"text\":\"talking about the young wives of others, impeding the\",\"end\":\"space\"},{\"n\":5,\"text\":\"stream of greed, humility towards elders, compassion for all\",\"end\":\"space\"},{\"n\":6,\"text\":\"creatures\u2014this is the way to happiness common in all the\",\"end\":\"space\"},{\"n\":7,\"text\":\"scriptures, that never fails in its operation ( or vitiates no\",\"end\":\"space\"},{\"n\":8,\"text\":\"other ordinance ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"27. For fear of obstacles, nothing is begun at all by\",\"end\":\"space\"},{\"n\":2,\"text\":\"persons who are low-spirited ordinary people begin and\",\"end\":\"space\"},{\"n\":3,\"text\":\"stop when thwarted by difficulties; but the best of ( i. e.\",\"end\":\"space\"},{\"n\":4,\"text\":\"resolute ) men, though repeatedly repelled by adverse cir-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"cumstances, do not give up what they have ( once ) un-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"dertaken.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"28. A course of conduct pleasing and upright ( at once ),\",\"end\":\"space\"},{\"n\":2,\"text\":\"not stooping to a sinful act even when life is in\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 5 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"22\",\"label\":