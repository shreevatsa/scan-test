          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"take this to be equivalent to \u0924\u0925\u093e\u092a\u093f. \u0924\u0924\u094d\u0915\u094d\u0937\u0923\u092d\u0919\u094d\u0917\u093f:\u2014\u0938 \u090f\u0935 \u0915\u094d\u0937\u0923: \u0924\u0924\u094d\u0915\u094d\u0937\u0923:\",\"end\":\"space\"},{\"n\":2,\"text\":\"the moment a man becomes a Purusharatna; \u0924\u0938\u094d\u092e\u093f\u0928\u094d \u092d\u091c\u094d\u092f\u0924\u0947\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0907\u0924\u094d\u092f\u0947\u0935\u0902\u0936\u0940\u0932\u092e\u094d \u0964\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Devanagari characters are unclear.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 96. \u0928\u093e\u092f\u0915\u094b\u093d\u092a\u094d\u092f\u094b\u0937\u0966-\u0913\u0937\u0903 ( fr. \u0909\u0937\u094d to burn ) \u092a\u093e\u0915\u0947 \u0927\u0940\u092f\u0924\u0947 \u0905\u0924\u094d\u0930 \u0907\u0924\u093f\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0914\u0937\u0927\u093f\u0903 \u0964 A plant, a medicinal drug.; also an herb which dies when\",\"end\":\"space\"},{\"n\":3,\"text\":\"its fruit becomes ripe. The moon is often called the Lord of\",\"end\":\"space\"},{\"n\":4,\"text\":\"herbs, probably because plants thrive under the influence of\",\"end\":\"space\"},{\"n\":5,\"text\":\"moon-light. Cf. Rg. X. \u096e\u096d.\u2014\u0938\u094b\u092e\u0947\u0928\u093e\u0926\u093f\u0924\u094d\u092f\u093e \u092c\u0932\u093f\u0928\u0903 \u0938\u094b\u092e\u0947\u0928 \u092a\u0943\u0925\u093f\u0935\u0940\",\"end\":\"space\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u092e\u0939\u0940 \u0964\u2019 where S\u00e1yana says\u2014\u0905\u092e\u0943\u0924\u0938\u0947\u0915\u0947\u0928\u094c\u0937\u0927\u094d\u092f\u092d\u093f\u0935\u0943\u0926\u094d\u0927\u094d\u092f\u093e \u092a\u0943\u0925\u093f\u0935\u094d\u092f\u093e \u092c\u0932\u0935\u0924\u094d\u0924\u094d\u0935\u092e\u094d \u0964\",\"end\":\"space\"},{\"n\":8,\"text\":\"\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u2018 \u0924\u0924\u0938\u094d\u0924\u0938\u094d\u092e\u0948 \u0926\u0926\u094c \u0930\u093e\u091c\u094d\u092f\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\u093e \u092c\u094d\u0930\u0939\u094d\u092e\u0935\u093f\u0926\u093e\u0902 \u0935\u0930\u0903 \u0964 \u092c\u0940\u091c\u094c\u0937\u0927\u0940\u0928\u093e\u0902 \u0935\u093f\u092a\u094d\u0930\u093e\u0923\u093e\u092e\u092a\u093e\u0902 \u091a\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u091c\u0928\u092e\u0947\u091c\u092f \u2019 \u0965 Hv. XXV. See also V\u00e1y. P. XXVIII. 12. 16. Mat.\",\"end\":\"space\"},{\"n\":11,\"text\":\"P. XXIII. 10-13. More probably, however, \u0914\u0937\u0927\u0940\u0928\u093e\u0925 is Soma,\",\"end\":\"space\"},{\"n\":12,\"text\":\"the plant, the juice of which formed the well known beverage\",\"end\":\"space\"},{\"n\":13,\"text\":\"of the ancient Rishis. By a curious misapplication of names\",\"end\":\"space\"},{\"n\":14,\"text\":\"the term Soma came to be an appellation of the moon and so all\",\"end\":\"space\"},{\"n\":15,\"text\":\"the epithets of Soma, the plant, were transferred to Soma, the\",\"end\":\"space\"},{\"n\":16,\"text\":\"moon. See notes on Rag. II. 73. \u092d\u093f\u0937\u0915\u094d\u2013\u092c\u093f\u092d\u0947\u0924\u094d\u092f\u0938\u094d\u092e\u093e\u0926\u094d\u0930\u094b\u0917\u0903 a physi-\",\"end\":\"hyphen\"},{\"n\":17,\"text\":\"cian. \u0936\u0924\u092d\u093f\u0937\u0915\u094d\u2014(1) a hundred physicians; (2) name of the\",\"end\":\"space\"},{\"n\":18,\"text\":\"24th lunar mansion ( the S'atat\u00e1rak\u00e0s ) containing one hundred\",\"end\":\"space\"},{\"n\":19,\"text\":\"stars. \u0905\u0935\u0924\u0902\u0938\u2014an ear-ring or an ornament worn on the head.\",\"end\":\"space\"},{\"n\":20,\"text\":\"All these adjectives indicate that the moon had the means to\",\"end\":\"space\"},{\"n\":21,\"text\":\"counteract the effects of the disease. \u0930\u093e\u091c\u092f\u0915\u094d\u0937\u094d\u092e\u093e\u2014consumption\",\"end\":\"space\"},{\"n\":22,\"text\":\"which attacked the moon; also consumption in general. So\",\"end\":\"space\"},{\"n\":23,\"text\":\"called because it is, as it were, the prince of diseases ( \u092f\u0915\u094d\u0937\u094d\u092e\u0923\u093e\u0902\",\"end\":\"space\"},{\"n\":24,\"text\":\"\u0930\u094b\u0917\u093e\u0923\u093e\u0902 \u0930\u093e\u091c\u093e ). Cf. \u0930\u093e\u091c\u092f\u0915\u094d\u0937\u094d\u092e\u0947\u0935 \u0930\u094b\u0917\u093e\u0923\u093e\u0902 \u0938\u092e\u0942\u0939\u0903 \u0938 \u092e\u0939\u0940\u092d\u0943\u0924\u093e\u092e\u094d S'is. II.\",\"end\":\"space\"},{\"n\":25,\"text\":\"96, commenting on which Malli. quotes from V\u00e0gbhatta\u2014\",\"end\":\"space\"},{\"n\":26,\"text\":\"\u0905\u0928\u0947\u0915\u0930\u094b\u0917\u093e\u0939\u0941\u0966 ( see com. )\u2014\u0936\u094b\u0937\u094b \u0930\u094b\u0917\u0930\u093e\u0921\u093f\u0924\u093f \u091a \u0938\u094d\u092e\u0943\u0924\u0903 \u0965 \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u093e\u0923\u093e\u0902 \u0926\u094d\u0935\u093f\u091c\u093e\u0928\u093e\u0902\",\"end\":\"space\"},{\"n\":27,\"text\":\"\u091a \u0930\u093e\u091c\u093e\u093d\u092d\u0942\u0926\u092f\u0902 \u092a\u0941\u0930\u093e \u0964 \u092f\u0915\u094d\u0937 \u0930\u093e\u091c\u093e \u091a \u092f\u0915\u094d\u0937\u094d\u092e\u093e \u091a \u0930\u093e\u091c\u092f\u0915\u094d\u0937\u094d\u092e\u093e \u0924\u0924\u094b \u092e\u0924\u0903 \u0965 The moon\",\"end\":\"space\"},{\"n\":28,\"text\":\"\",\"end\":\"space\"},{\"n\":29,\"text\":\"was cursed to be eternally consumptive by his father-in-law,\",\"end\":\"space\"},{\"n\":30,\"text\":\"Daksha, for paying sole attention to Rohini and neglecting his\",\"end\":\"space\"},{\"n\":31,\"text\":\"other daughters. At the intercession of his wives the sentence\",\"end\":\"space\"},{\"n\":32,\"text\":\"of eternal consumption was commuted to one of periodical\",\"end\":\"space\"},{\"n\":33,\"text\":\"consumption.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit readings and diacritics are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 97. \u092a\u094d\u0930\u092d\u0941\u0923\u093e\u2014\u092a\u094d\u0930\u092d\u0935\u0924\u0940\u0924\u093f \u092a\u094d\u0930\u092d\u0941\u0903, used in a literal sense, power-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"ful, having power to dispense. \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0943\u0924\u0902-\u092a\u094d\u0930\u093e\u092a\u094d\u092f\u0924\u094d\u0935\u0947\u0928 \u0928\u093f\u0930\u094d\u0923\u0940\u0924\u092e\u094d R\u00e1ma\",\"end\":\"join\"},{\"n\":3,\"text\":\"\",\"end\":\"join\"}],\"uncertain\":true,\"note\":\"The Sanskrit gloss is slightly unclear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 35 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"96\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"97\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
      ],
