          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"ways:\u2014\u0927\u093f\u0915\u094d \u0927\u093f\u0915\u094d as an interjection, and \u0935\u0943\u0925\u093e \u092a\u094c\u0930\u0941\u0937\u0902 separately; or\",\"end\":\"space\"},{\"n\":2,\"text\":\"the whole together as meaning\u2014\u2018Fie upon vain valour.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 91. \u092d\u0917\u094d\u0928\u093e\u0936\u0938\u094d\u092f\u2014whose hopes ( of escape ) had been baffled.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0915\u0930\u0923\u094d\u0921 &c.\u2014whose body was pressed in the basket. \u092e\u094d\u0932\u093e\u0928\u094b\u2014\",\"end\":\"space\"},{\"n\":3,\"text\":\"weakened ( by hunger ). \u092a\u093f\u0936\u093f\u0924\u0902\u2014from \u092a\u093f\u0936\u094d to shape+\u0907\u0924, ( \u092a\u093f\u0936\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0905\u0935\u092f\u0935\u0947; \u092a\u093f\u0936\u0947\u0903 \u0915\u093f\u091a\u094d\u091a Un. III. 95. \u0907\u0924\u093f \u0907\u0924\u0928\u094d ) raw flesh. \u0935\u0943\u0926\u094d\u0927\u094c \u0915\u094d\u0937\u092f\u0947\u2014When\",\"end\":\"space\"},{\"n\":5,\"text\":\"a noun indicating \u2018cause\u2019 is used, the effect is often put in the\",\"end\":\"space\"},{\"n\":6,\"text\":\"Loc.; Apte\u2019s Guide \u00a7 95.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit readings in the etymology are unclear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 92. \u092b\u0932\u0902 i. e. the good or bad result of their actions,\",\"end\":\"space\"},{\"n\":2,\"text\":\"happiness or misery. \u0915\u0930\u094d\u092e\u093e\u092f\u0924\u094d\u0924\u0902\u2014Cf. Sl.s. 99, 101, 102. Here\",\"end\":\"space\"},{\"n\":3,\"text\":\"there is a reference to the two of the three divisions of Karman\",\"end\":\"space\"},{\"n\":4,\"text\":\"viz. \u0938\u0902\u091a\u093f\u0924, \u092a\u094d\u0930\u093e\u0930\u092c\u094d\u0927 and \u0915\u094d\u0930\u093f\u092f\u092e\u093e\u0923. \u0938\u0941\u0927\u093f\u092f\u093e \u0938\u0941\u0935\u093f\u091a\u093e\u0930\u094d\u092f\u0948\u0935 \u0915\u0930\u094d\u0924\u093e \u092d\u093e\u0935\u094d\u092f\u092e\u094d = \u0938\u0941\u0927\u093f\u092f\u093e\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0938\u0941\u0935\u093f\u091a\u093e\u0930\u094d\u092f\u0948\u0935 \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u0903 \u0915\u093e\u0930\u094d\u092f\u0903 \u0964 The construction should be noted. When\",\"end\":\"space\"},{\"n\":6,\"text\":\"the potential pass. p. is used as predicate the noun or adjective\",\"end\":\"space\"},{\"n\":7,\"text\":\"coming after it ( as \u0915\u0930\u094d\u0924\u093e here ) must agree with the agent\",\"end\":\"space\"},{\"n\":8,\"text\":\"( \u0938\u0941\u0927\u093f\u092f\u093e here ).\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words are difficult to distinguish in the scan.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 93. \u0916\u0932\u094d\u0935\u093e\u091f\u0903\u2014a bald-headed man. \u0938\u0936\u092c\u094d\u0926\u0902\u2014i. e. the fruit\",\"end\":\"space\"},{\"n\":2,\"text\":\"making a loud noise as it fell. \u201c The fact of the tree being \u0924\u093e\u0932\",\"end\":\"space\"},{\"n\":3,\"text\":\"( Palm ) adds to the force of the lines as it gives little or no\",\"end\":\"space\"},{\"n\":4,\"text\":\"shade\u201d Telang. The fig. is \u0905\u0930\u094d\u0925\u093e\u0928\u094d\u0924\u0930\u0928\u094d\u092f\u093e\u0938.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 94. \u0917\u094d\u0930\u0939\u092a\u0940\u0921\u0928\u092e\u094d\u2014trouble from \u0917\u094d\u0930\u0939\u2014viz. R\u00e1hu. \u092e\u0924\u093f\u092e\u0924\u093e\u0902 here\",\"end\":\"space\"},{\"n\":2,\"text\":\"the aff. \u092e\u0924\u094d expresses \u092a\u094d\u0930\u093e\u0936\u0938\u094d\u0924\u094d\u092f or excellence. Cf. the last line\",\"end\":\"space\"},{\"n\":3,\"text\":\"with \u0932\u093f\u0916\u093f\u0924\u092e\u092a\u093f \u0932\u0932\u093e\u091f\u0947 \u092a\u094d\u0930\u094b\u091c\u094d\u091d\u093f\u0924\u0941\u0902 \u0915\u0903 \u0938\u092e\u0930\u094d\u0925\u0903 H. \u2018In the K\u00e2vyasangraha\",\"end\":\"space\"},{\"n\":4,\"text\":\"this stanza is given as Vet\u00e1labhatta\u2019s p. 39.\u2019 Mr. Telang\u2019s note.\",\"end\":\"space\"},{\"n\":5,\"text\":\"The fig.s are \u0905\u0930\u094d\u0925\u093e\u0928\u094d\u0924\u0930\u0928\u094d\u092f\u093e\u0938 and \u0915\u093e\u0935\u094d\u092f\u0932\u093f\u0902\u0917.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 95. \u0938\u0943\u091c\u0924\u093f the subject to this is \u0935\u093f\u0927\u093f to be supplied from\",\"end\":\"space\"},{\"n\":2,\"text\":\"the context. \u0924\u093e\u0935\u0924\u094d\u2014some commentators interpret this as \u092a\u094d\u0930\u0925\u092e\u092e\u094d.\",\"end\":\"space\"},{\"n\":3,\"text\":\"It seems, however, to be used here \u0905\u0935\u0927\u093e\u0930\u0923\u0947 \u2018indeed,\u2019 does create.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u092a\u0941\u0930\u0941\u0937\u0930\u0924\u094d\u0928\u092e\u094d\u2014The jewel of a man ( \u092a\u0941\u0930\u0941\u0937 \u090f\u0935 \u0930\u0924\u094d\u0928\u092e\u094d ); the best of men.\",\"end\":\"space\"},{\"n\":5,\"text\":\"It may also be explained though not preferably as \u092a\u0941\u0930\u0941\u0937\u0903 \u0930\u0924\u094d\u0928\u092e\u093f\u0935\",\"end\":\"space\"},{\"n\":6,\"text\":\"( jewel-like ). Cf. \u091c\u093e\u0924\u094c \u091c\u093e\u0924\u094c \u092f\u0926\u0941\u0924\u094d\u0915\u0943\u0937\u094d\u091f\u0902 \u0924\u0926\u094d\u0930\u0924\u094d\u0928\u092e\u093f\u0924\u093f \u0915\u0925\u094d\u092f\u0924\u0947 \u0964 Malli. on\",\"end\":\"space\"},{\"n\":7,\"text\":\"Rag. XVI. 1. \u0905\u0932\u0902\u0915\u0930\u0923\u092e\u094d\u2014an ornament ( beautifier ) of. Here\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0937\u0937\u094d\u0920\u0940 ( \u0905\u0928\u094d ) is added \u0915\u0930\u094d\u0924\u0930\u093f. \u0924\u0926\u092a\u093f\u2014\u0924\u0924\u094d refers to \u092a\u0941\u0930\u0941\u0937\u0930\u0924\u094d\u0928. Some\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit grammatical explanation in the last line is unclear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 34 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"91\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"92\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"93\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"94\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"stanza_note\",\"number\":\"95\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
