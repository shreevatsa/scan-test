          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"39. Old age stands threatening like a tigress; like enemies\",\"end\":\"space\"},{\"n\":2,\"text\":\"diseases smite the body; life runs away like water from a\",\"end\":\"space\"},{\"n\":3,\"text\":\"broken jar; and yet, oh wonder, man acts in a way detrimental\",\"end\":\"space\"},{\"n\":4,\"text\":\"to his interest ( does not try to secure moksha ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"40. The enjoyments are multifarious and of a transient\",\"end\":\"space\"},{\"n\":2,\"text\":\"nature; and by them is constituted this worldly life; what for\",\"end\":\"space\"},{\"n\":3,\"text\":\"should you then wander, oh people? Refrain from your actions\",\"end\":\"space\"},{\"n\":4,\"text\":\"(pursuit). If our word is to be believed, concentrate your\",\"end\":\"space\"},{\"n\":5,\"text\":\"mind, pure on account of the snapping of the bonds of desires,\",\"end\":\"space\"},{\"n\":6,\"text\":\"within its cell which can be within reach when passion is\",\"end\":\"space\"},{\"n\":7,\"text\":\"rooted out.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"41. That indescribable pleasure alone is the highest and\",\"end\":\"space\"},{\"n\":2,\"text\":\"ever abiding (lit keeping its flovour ever fresh ) being in the\",\"end\":\"space\"},{\"n\":3,\"text\":\"enjoyment of which one considers as straw ( of little impor-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"tance ) the hosts of gods such as Brahm\u0101, Indra and others\",\"end\":\"space\"},{\"n\":5,\"text\":\"and on tasting which high states (prosperity ) such as the\",\"end\":\"space\"},{\"n\":6,\"text\":\"sovereignty of the three worlds &c. lose all charm. O good\",\"end\":\"space\"},{\"n\":7,\"text\":\"man, fix not, therefore, your affection on any other enjoyment\",\"end\":\"space\"},{\"n\":8,\"text\":\"\",\"end\":\"space\"},{\"n\":9,\"text\":\"which is evanascent.[*]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"42. That delightful city, that great king, and the circle\",\"end\":\"space\"},{\"n\":2,\"text\":\"of feudatory kings, and that assembly of eminent scholars at\",\"end\":\"space\"},{\"n\":3,\"text\":\"his side, the ladies ( of the court ) with their faces like the\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"disc of the moon, and that group of haughty princes, those\",\"end\":\"space\"},{\"n\":6,\"text\":\"bards, and those stories\u2014a bow to Death through whose\",\"end\":\"space\"},{\"n\":7,\"text\":\"( destructive ) power all these things have become things of\",\"end\":\"space\"},{\"n\":8,\"text\":\"the past ( lit. things to be remembered ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"43. In a certain house ( also square of the dice board )\",\"end\":\"space\"},{\"n\":2,\"text\":\"where there were many, there ( now ) stands only one; even\",\"end\":\"space\"},{\"n\":3,\"text\":\"there where there was one many followed, and there is not\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"footnote\",\"lines\":[{\"n\":1,\"text\":\"* \u0924\u094d\u0930\u0948\u0932\u094b\u0915\u094d\u092f\u093e\u0903\u2014v. l. Having attained that knowledge of Brahman,\",\"end\":\"space\"},{\"n\":2,\"text\":\"compared with which the very sovereignty of the three worlds be-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"comes unpalatable, do not fix your attachment on pleasures consist-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"ing of food, clothes and honour ( position )\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Devanagari variant reading is partly obscured.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 33 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"other\",\"lines\":[{\"n\":1,\"text\":\"3\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"39\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"40\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"41\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"42\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"43\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"footnote\",\"number\":null,\"label\":\"*\",\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]},{\"flow\":\"notes\",\"units\":[\"u7\"]}],\"relations\":[{\"type\":\"note\",\"region\":\"r4\",\"line\":9,\"marker\":\"*\",\"to\":\"u7\"}]}"
