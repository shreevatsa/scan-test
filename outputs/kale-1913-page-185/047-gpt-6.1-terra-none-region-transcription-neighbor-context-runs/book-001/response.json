          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"93. ) \u0907\u0928\u094d\u0926\u094d\u0930\u093f\u092f\u092e\u093f\u0928\u094d\u0926\u094d\u0930\u0932\u093f\u0919\u094d\u0917\u092e\u093f\u0928\u094d\u0926\u094d\u0930\u0926\u0943\u0937\u094d\u091f\u092e\u093f\u0928\u094d\u0926\u094d\u0930\u0938\u0943\u0937\u094d\u091f\u092e\u093f\u0928\u094d\u0926\u094d\u0930\u091c\u0941\u0937\u094d\u091f\u092e\u093f\u0928\u094d\u0926\u094d\u0930\u0926\u0924\u094d\u0924\u092e\u093f\u0924\u093f \u0935\u093e \u0965 \u0907\u0928\u094d\u0926\u094d\u0930 is\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"the soul, the lord of the body. It is thus explained by V\u00e1man\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0907\u0928\u094d\u0926\u094d\u0930\u0938\u094d\u092f \u0932\u093f\u0919\u094d\u0917\u092e\u093f\u0928\u094d\u0926\u094d\u0930\u093f\u092f\u092e\u094d \u0964 \u0907\u0928\u094d\u0926\u094d\u0930 \u0906\u0924\u094d\u092e\u093e \u0938 \u091a\u0915\u094d\u0937\u0941\u0930\u093e\u0926\u093f\u0928\u093e \u0915\u0930\u0923\u0947\u0928\u0947\u0928\u0941\u092e\u0940\u092f\u0924\u0947 \u0964\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u092e\u093e\u0915\u0930\u094d\u0924\u0943\u0915\u0902 \u0915\u0930\u0923\u092e\u0938\u094d\u0924\u093f \u0964 \u0907\u0928\u094d\u0926\u094d\u0930\u0947\u0923 \u0926\u0943\u0937\u094d\u091f\u092e\u093e\u0924\u094d\u092e\u0928\u093e \u0926\u0943\u0937\u094d\u091f\u092e\u093f\u0924\u094d\u092f\u0930\u094d\u0925\u0903 \u0964 \u0907\u0928\u094d\u0926\u094d\u0930\u0947\u0923 \u0938\u0943\u0937\u094d\u091f\u092e\u093e\u0924\u094d\u092e\u0928\u093e\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0938\u0943\u0937\u094d\u091f\u092e\u094d \u0964 \u0924\u0924\u094d\u0915\u0943\u0924\u0947\u0928 \u0936\u0941\u092d\u093e\u0936\u0941\u092d\u0915\u0930\u094d\u092e\u0923\u094b\u0924\u094d\u092a\u0928\u094d\u0928\u092e\u093f\u0924\u093f \u0915\u0943\u0924\u094d\u0935\u093e \u0964 \u0907\u0928\u094d\u0926\u094d\u0930\u0947\u0923 \u091c\u0941\u0937\u094d\u091f\u092e\u093e\u0924\u094d\u092e\u0928\u093e \u0938\u0947\u0935\u093f-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"\u0924\u092e\u094d \u0964 \u0924\u0926\u094d\u0926\u094d\u0935\u093e\u0930\u0947\u0923 \u0935\u093f\u091c\u094d\u091e\u093e\u0928\u094b\u0924\u094d\u092a\u093e\u0926\u0928\u093e\u0924\u094d \u0965 \u0907\u0928\u094d\u0926\u094d\u0930\u0947\u0923 \u0926\u0924\u094d\u0924\u092e\u093e\u0924\u094d\u092e\u0928\u093e \u0935\u093f\u0937\u092f\u0947\u092d\u094d\u092f\u094b \u092f\u0925\u093e\u0930\u094d\u0925\u0902\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0917\u094d\u0930\u0939\u0923\u093e\u092f \u0964 Also. \u0907\u0928\u094d\u0926\u094d\u0930\u0947\u0923\u093e\u0924\u094d\u092e\u0928\u093e \u0926\u0941\u0930\u094d\u091c\u092f\u092e\u094d \u0964 Bhattoji. There are two kinds\",\"end\":\"space\"},{\"n\":9,\"text\":\"of Indriyas\u2014J\u00f1\u00e1nendriyas and Karmendriyas, thus given by\",\"end\":\"space\"},{\"n\":10,\"text\":\"Manu\u2014\u0936\u094d\u0930\u094b\u0924\u094d\u0930\u0902 \u0924\u094d\u0935\u0915\u094d\u091a\u0915\u094d\u0937\u0941\u0937\u0940 \u091c\u093f\u0939\u094d\u0935\u093e \u0928\u093e\u0938\u093f\u0915\u093e \u091a\u0948\u0935 \u092a\u091e\u094d\u091a\u092e\u0940 \u0964 \u092a\u093e\u092f\u0942\u092a\u0938\u094d\u0925\u0902\",\"end\":\"space\"},{\"n\":11,\"text\":\"\u0939\u0938\u094d\u0924\u092a\u093e\u0926\u0902 \u0935\u093e\u0915\u094d\u091a\u0948\u0935 \u0926\u0936\u092e\u0940 \u0938\u094d\u092e\u0943\u0924\u093e \u0965 \u092e\u0928\u0938\u094d is the eleventh organ of sense\",\"end\":\"space\"},{\"n\":12,\"text\":\"which is internal. In the Ved\u00e2nta \u092e\u0928\u0938\u094d, \u092c\u0941\u0926\u094d\u0927\u093f, \u0905\u0939\u0902\u0915\u093e\u0930 and \u091a\u093f\u0924\u094d\u0924\",\"end\":\"space\"},{\"n\":13,\"text\":\"are said to be the four internal organs. According to some\",\"end\":\"space\"},{\"n\":14,\"text\":\"these are the different faculties constituting the mind or \u0905\u0928\u094d\u0924\u0903-\",\"end\":\"hyphen\"},{\"n\":15,\"text\":\"\u0915\u0930\u0923. Others add \u0905\u0928\u094d\u0924\u0903\u0915\u0930\u0923 to the list making up a \u092a\u091e\u094d\u091a\u0915.\",\"end\":\"space\"},{\"n\":16,\"text\":\"\u092c\u0941\u0926\u094d\u0927\u093f is evidently used here for the mind and not in the sense\",\"end\":\"space\"},{\"n\":17,\"text\":\"of the Ved\u00e2ntins. \u0905\u092a\u094d\u0930\u0924\u093f\u0939\u0924\u2014unrepulsed, in full ( un-impaired )\",\"end\":\"space\"},{\"n\":18,\"text\":\"vigour. \u0935\u091a\u0928\u092e\u094d\u2014power or manner of speech. \u0905\u0930\u094d\u0925\u094b\u0937\u094d\u092e\u0928\u094d\u2014Comp.\",\"end\":\"space\"},{\"n\":19,\"text\":\"\",\"end\":\"space\"},{\"n\":20,\"text\":\"\u0935\u093f\u0924\u094d\u0924\u091c \u090a\u0937\u094d\u092e\u093e Pt. II.. \u0936\u094c\u0930\u094d\u092f\u094b\u0937\u094d\u092e\u0928\u094d Mv. \u0905\u0928\u094d\u092f\u0903 &c \u2014becomes quite a\",\"end\":\"space\"},{\"n\":21,\"text\":\"changed man ( in as much as he is differently treated by the\",\"end\":\"space\"},{\"n\":22,\"text\":\"world at large ); see the next sl.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words in the opening derivation are difficult to distinguish.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 41. \u0915\u0941\u0932\u0940\u0928\u0903\u2014nobly born; Cf. for the idea in the slokas\",\"end\":\"space\"},{\"n\":2,\"text\":\"39\u201341 the well known Subh\u00e2shita \u092f\u0938\u094d\u092f\u093e\u0930\u094d\u0925\u0938\u094d\u0924\u0938\u094d\u092f \u092e\u093f\u0924\u094d\u0930\u093e\u0923\u093f \u092f\u0938\u094d\u092f\u093e\u0930\u094d\u0925\u0938\u094d\u0924\u0938\u094d\u092f\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u092c\u093e\u0928\u094d\u0927\u0935\u093e\u0903 \u0964 \u092f\u0938\u094d\u092f\u093e\u0930\u094d\u0925\u0903 \u0938 \u092a\u0941\u092e\u093e\u0928\u094d \u0932\u094b\u0915\u0947 \u092f\u0938\u094d\u092f\u093e\u0930\u094d\u0925\u0903 \u0938 \u091a \u092a\u0923\u094d\u0921\u093f\u0924\u0903 \u0965 Also \u0927\u0928\u092e\u0930\u094d\u091c\u092f\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0915\u093e\u0915\u0941\u0924\u094d\u0938\u094d\u0925 \u0927\u0928\u092e\u0942\u0932\u092e\u093f\u0926\u0902 \u091c\u0917\u0924\u094d \u0964 \u0905\u0928\u094d\u0924\u0930\u0902 \u0928\u0948\u0935 \u092a\u0936\u094d\u092f\u093e\u092e\u093f \u0928\u093f\u0930\u094d\u0927\u0928\u0938\u094d\u092f \u092e\u0943\u0924\u0938\u094d\u092f \u091a \u0965 \u092c\u094d\u0930\u0939\u094d\u092e\u091c\u094d\u091e\u094b\u093d\u092a\u093f\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0928\u0930\u0903 \u092a\u0942\u091c\u094d\u092f\u094b \u092f\u0938\u094d\u092f\u093e\u0938\u094d\u0924\u093f \u0935\u093f\u092a\u0941\u0932\u0902 \u0927\u0928\u092e\u094d \u0964 \u0936\u0936\u093f\u0928\u093e \u0924\u0941\u0932\u094d\u092f\u0935\u0902\u0936\u094b\u093d\u092a\u093f \u0928\u093f\u0930\u094d\u0927\u0928\u0903 \u092a\u0930\u093f\u092d\u0942\u092f\u0924\u0947 \u0965 Fig.\",\"end\":\"space\"},{\"n\":7,\"text\":\"K\u00e1vyalinga, \u0938\u0930\u094d\u0935\u0947 \u0917\u0941\u0923\u093e\u0903 \u0915\u093e\u091e\u094d\u091a\u0928\u092e\u093e\u0936\u094d\u0930\u092f\u0928\u094d\u0924\u0947 explaining the reason of a\",\"end\":\"space\"},{\"n\":8,\"text\":\"wealthy man being considered \u0915\u0941\u0932\u0940\u0928 &c.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some words in the Sanskrit quotations are not fully clear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 42. \u0926\u094c\u0930\u094d\u092e\u0928\u094d\u0924\u094d\u0930\u094d\u092f\u093e\u0924\u094d\u2014see com. \u0938\u0902\u0917\u0903\u2014attachment to wordly\",\"end\":\"space\"},{\"n\":2,\"text\":\"objects, association with men. \u0915\u0941\u0924\u0928\u092f\u0903\u2014\u0924\u0928\u094b\u0924\u093f \u0915\u0941\u0932\u092e\u093f\u0924\u093f \u0924\u0928\u092f\u0903 from\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0924\u0928\u094d + \u0915\u094d\u092f\u0928\u094d ( \u0905\u092f ). \u0916\u0932\u094b\u092a\u093e\u0938\u0928\u2014serving, propitiating a wicked\",\"end\":\"space\"},{\"n\":4,\"text\":\"man. In doing this one is likely by habit to lose one\u2019s good\",\"end\":\"space\"},{\"n\":5,\"text\":\"disposition. \u0905\u0928\u092f\u2014impudence, impolitic conduct. \u0905\u0928\u0935\u0947\u0915\u094d\u0937\u0923\u2014\",\"end\":\"space\"},{\"n\":6,\"text\":\"want of proper care or supervision. \u0924\u094d\u092f\u093e\u0917\u092a\u094d\u0930\u092e\u093e\u0926\u2014carelessness or\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The first Sanskrit headword and the grammatical derivation are somewhat unclear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 20 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"40\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"41\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"42\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
