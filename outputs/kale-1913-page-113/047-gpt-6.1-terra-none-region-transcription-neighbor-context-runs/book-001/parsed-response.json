{
 "regions": {
  "r3": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "रे[१] कन्दर्प करं[२] कदर्थयसि किं कोदण्डटङ्कारितै",
     "end": "line"
    },
    {
     "n": 2,
     "text": "रे रे कोकिल कोमलैः कलरवैः[३] किं त्वं वृथा जल्पसि[४] ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "मुग्धे स्निग्धविदग्धमुग्धमधुरैर्लोलैः[५] कटाक्षैरलं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "चेतश्चुम्बितचन्द्रचूडचरणध्यानामृतं वर्तते ॥ ४२ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small superscript markers and their attachment are difficult to distinguish."
  },
  "r4": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "रे कन्दर्प पञ्चशर कोदण्डस्य धनुषः टङ्कारितैः टणत्कारैः किं वृथा निरर्थकं करं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "कदर्थयसि पीडयसि । रे रे कोकिल । आदरार्थं वीप्सा । त्वं कोमलैः कलरवै-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "रव्यक्तमधुरैः शब्दैः वृथा निष्फलं किं जल्पसि । हे मुग्धे बाले स्निग्धाश्च विदग्धाश्च",
     "end": "space"
    },
    {
     "n": 4,
     "text": "मुग्धा मधुराश्च तैः तथोक्तैः लोलैः चञ्चलैः कटाक्षैः अलं कृतं प्रयत्नेनार्थः ।",
     "end": "space"
    },
    {
     "n": 5,
     "text": "यतः अस्माकं चेतः चन्द्रः चूडायां यस्य स चन्द्रचूडः शिवः । चुम्बितं चन्द्रचूडस्य",
     "end": "space"
    },
    {
     "n": 6,
     "text": "चरणयोः ध्यानमेवामृतं येन तथाभूतं वर्तते । सर्वसङ्गरहिता वयमिदानीं",
     "end": "space"
    },
    {
     "n": 7,
     "text": "जाताः स्म इति भावः । शार्दूलवि० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several densely printed words are difficult to read."
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "उन्मीलत्त्रिवलीतरङ्गवलया प्रोतुङ्गपीनस्तन-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "द्वन्द्वेनोद्यतचक्रवाकमिथुना वक्त्राम्बुजोल्लासिनी ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "कान्ताकारधरा नदीयमभितः क्रूराशया नेष्यते",
     "end": "line"
    },
    {
     "n": 4,
     "text": "संसारार्णवमज्जनं यदि ततो दूरेण संत्यज्यताम् ॥ ४३ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "उन्मीलन्ती या त्रिवली वलित्रयं सैव तरङ्गवलयं यस्याः सा तथा । प्रक-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "र्षेण तुङ्गं पीनं च स्तनद्वन्द्वं तेन उद्यतं चक्रवाकमिथुनं यस्याः सा । वक्त्रमेवा-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "म्बुजं तेन उल्लासिनी प्रकाशमाना । कान्ताया आकार आकृतिः तस्य धरा ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "अभितः सर्वतः क्रूरा आशायाः मकरादयः यस्याः । पक्षे क्रूरः निष्ठुर आशयो",
     "end": "space"
    },
    {
     "n": 5,
     "text": "भावो यस्याः । सेयं नदी यदि संसारार्णवे मज्जनं नेष्यते ततः तर्हि दूरतः",
     "end": "space"
    },
    {
     "n": 6,
     "text": "संत्यज्यताम् । अन्यथा संसारार्णवमज्जनमपरिहार्यमेवेति तात्पर्यम् । शार्दूल० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The reading of आशायाः in line 4 is uncertain."
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "इह हि मधुरगीतं नृत्यमेतद्रसोऽयं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "स्फुरति परिमलोऽयं स्पर्श एष स्तनानाम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इति हतपरमार्थैरिन्द्रियैर्भ्राम्यमाणः",
     "end": "line"
    },
    {
     "n": 4,
     "text": "स्वहितकरणधूर्तैः पञ्चभिर्वञ्चितोऽस्मि ॥ ४४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "इहेत्यनेन पञ्चेन्द्रियाणां विषयाः उक्ताः । हतः परमार्थः यैः तैः इन्द्रियैः",
     "end": "space"
    },
    {
     "n": 2,
     "text": "भ्राम्यमाणः स्वहितकरणे धूर्तानि कुशलानि तैः पञ्चभिः ज्ञानेन्द्रियैः वञ्चि-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "तोऽस्मि अतस्तेषां दमनमेव सर्वार्थसाधकेन कर्तव्यमिति तात्पर्यम् । मालिनी ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
