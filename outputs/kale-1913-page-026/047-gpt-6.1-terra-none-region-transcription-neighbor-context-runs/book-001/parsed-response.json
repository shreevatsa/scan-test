{
 "regions": {
  "r3": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "क्षान्त्या भीर्यदि न सहते प्रायशो नाभिजातः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सेवाधर्मः परमगहनो योगिनामप्यगम्यः ॥ ५८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "मौनात् मौनं धारयति चेन्मूक इत्युच्यते । सेवक इति शेषः । प्रवचने पटुः",
     "end": "space"
    },
    {
     "n": 2,
     "text": "चेत् चाटुलः चाटुकारः । जल्पतीति जल्पः । पचाद्यच् । स्वार्थे कः । यद्वा",
     "end": "space"
    },
    {
     "n": 3,
     "text": "कुत्सितो जल्पः जल्पकः । धृष्टो निर्भीकः । अप्रगल्भोऽप्रौढः । न सहते परिभवा-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "दिकामिति शेषः । अभिजातः कुलीनः । योगिनां त्रिकालज्ञानिनामपि । किमुता-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "न्येषाम् । अगम्यो ज्ञातुमशक्यः । अत्र सेवाधर्मस्य योगिगम्यत्वेनागम्यत्वोक्तेः",
     "end": "space"
    },
    {
     "n": 6,
     "text": "सम्बन्धेऽसम्बन्धरूपातिशयोक्तिः । मन्दाक्रान्ता वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some compounds in the last two lines are difficult to distinguish."
  },
  "r5": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अतिनीचः सर्वथा त्याज्य इत्याह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r6": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "उद्घासिताखिलखलस्य विशृङ्खलस्य",
     "end": "line"
    },
    {
     "n": 2,
     "text": "प्राग्जात[१]विस्मृत[२]निजाधमकर्मवृत्तेः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "दैवादवाप्तविभवस्य गुणद्विषोऽस्य",
     "end": "line"
    },
    {
     "n": 4,
     "text": "नीचस्य गोचरगतैः सुखमास्यते[३] कैः ॥ ५९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r7": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "उद्घासिताः प्रकाशिताः अखिलाः खला येन तस्य । विगता शृंखला विधि-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "निषेधरूपा यस्य तस्य । स्वैरवृत्तेरित्यर्थः । प्राग्जाता पश्चात् विस्मृता प्राग्जात-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "विस्मृता । कर्मणि वृत्तिः कर्मवृत्तिः । प्राग्जातविस्मृता निजा अधमा कर्मवृत्तिर्येन ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "॰विस्तृतेति पाठे प्राग्जातानि पश्चाद्विस्तृतानि निजाधमकर्माणि तत्र वृत्तिर्यस्य ।",
     "end": "space"
    },
    {
     "n": 5,
     "text": "अवाप्तो विभवो येन तस्य । गुणान्द्वेष्टीति गुणद्विट् तस्य । वसन्ततिलका वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small print and compound readings are uncertain."
  },
  "r8": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "दुर्जनसुजनमैत्रीप्रकारं निर्दिशति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "आरम्भगुर्वी क्षयिणी क्रमेण",
     "end": "line"
    },
    {
     "n": 2,
     "text": "लघ्वी पुरा वृद्धिमती च पश्चात् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "दिनस्य पूर्वार्धपरार्धभिन्ना",
     "end": "line"
    },
    {
     "n": 4,
     "text": "छायेव मैत्री खलसज्जनानाम् ॥ ६० ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r10": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "आरम्भे गुर्वी गुरुः । वृद्धेत्यर्थः । लघ्वी ह्रस्वा । एवं खलस्य मैत्री प्रथमं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "गुर्वी पश्चात्क्षयिणी भवति सुजनस्य तु तद्विपरीता । यथासंख्यसंकीर्णोपमालं-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "कारः । वृत्तमुपजातिः ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r11": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ प्रौढ, प्रागेव.",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The first variant reading is not fully clear."
  },
  "r12": {
   "type": "footnote",
