          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"danger, never to supplicate the wicked nor to beg of a friend\",\"end\":\"space\"},{\"n\":2,\"text\":\"who has very little wealth, living nobly in adversity, and\",\"end\":\"space\"},{\"n\":3,\"text\":\"following in the footsteps of the great,\u2014by whom has this\",\"end\":\"space\"},{\"n\":4,\"text\":\"vow, as difficult ( to perform ) as walking on the edge of\",\"end\":\"space\"},{\"n\":5,\"text\":\"a sword, been taught to the good, ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"29. Though grown weak on account of hunger (starva-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"tion ), emaciated by old age, almost unnerved and reduced\",\"end\":\"space\"},{\"n\":3,\"text\":\"to a pitiable state, with all energy lost and life dying out of\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"him, will the lion, foremost among those who are great in\",\"end\":\"space\"},{\"n\":6,\"text\":\"self-respect, ever eat withered grass when his desire is\",\"end\":\"space\"},{\"n\":7,\"text\":\"( habitually ) fixed solely on making a morsel of the broken\",\"end\":\"space\"},{\"n\":8,\"text\":\"temples of a rutting elephant ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"30 On securing even a little bone, fleshless and dirty,\",\"end\":\"space\"},{\"n\":2,\"text\":\"with small remnants of fat and muscles (still left), a dog is\",\"end\":\"space\"},{\"n\":3,\"text\":\"satisfied although it does not satisfy his hunger. (But) a\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"lion kills an elephant, despising a jackal that has even fallen\",\"end\":\"space\"},{\"n\":6,\"text\":\"into his clutches. Every one, though overtaken by difficulty,\",\"end\":\"space\"},{\"n\":7,\"text\":\"desires a fruit according to the state of his mind (or inborn\",\"end\":\"space\"},{\"n\":8,\"text\":\"disposition ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"31. A dog wags his tail, falls at the feet of his master\",\"end\":\"space\"},{\"n\":2,\"text\":\"( lit. feeder ); and falling on the ground exhibits his mouth\",\"end\":\"space\"},{\"n\":3,\"text\":\"and maw; but the lordly elephant looks grave and eats after\",\"end\":\"space\"},{\"n\":4,\"text\":\"( when coaxed with ) hundreds of flattering words.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"32. In this revolving world who is not born and who is\",\"end\":\"space\"},{\"n\":2,\"text\":\"not dead (or, what dead person, indeed, is not born again) ?\",\"end\":\"space\"},{\"n\":3,\"text\":\"He ( alone is truly ) born by whose birth the family is\",\"end\":\"space\"},{\"n\":4,\"text\":\"raised to eminence.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"33. High-minded people have a two-fold course of action\",\"end\":\"space\"},{\"n\":2,\"text\":\"like a bunch of flowers. viz. to stand at the head ( in the case\",\"end\":\"space\"},{\"n\":3,\"text\":\"of flowers\u2014on the heads, ) of all men, or to wither away\",\"end\":\"space\"},{\"n\":4,\"text\":\"in a forest.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 6 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"28\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"29\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"30\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"31\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"32\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"33\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]},{\"flow\":\"notes\",\"units\":[]}],\"relations\":[]}"
