          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u0915\u0941\u0932\u0935\u094d\u0930\u0924\u0902 \u092a\u093e\u0932\u092f\u093f\u0937\u094d\u092f\u0924\u093f \u0915\u0903 \u0965 Bh\u00e2m. Vil. 1. 12. \u0935\u0948\u0926\u0917\u094d\u0927\u094d\u092f\u2014\u0935\u093f\u0926\u0917\u094d\u0927\u0938\u094d\u092f \u092d\u093e\u0935\u0903 \u0964\",\"end\":\"space\"},{\"n\":2,\"text\":\"See note on \u0926\u0941\u0930\u094d\u0935\u093f\u0926\u0917\u094d\u0927 sl. 3. The word is used here in the sense of\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u2018natural skill or capacity.\u2019 \u0915\u0943\u0924\u094d\u092f\u0935\u0938\u094d\u0924\u0941\u0937\u0941 \u091a\u093e\u0924\u0941\u0930\u094d\u092f\u0902 \u0935\u0948\u0926\u0917\u094d\u0927\u094d\u092f\u0902 \u092a\u0930\u093f\u0915\u0940\u0930\u094d\u0924\u094d\u092f\u0924\u0947 \u0964\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The first Sanskrit phrase is partly obscured.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 19. \u0915\u0947\u092f\u0942\u0930\u0903\u2014an armlet. \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093e\u2014polished or refined by\",\"end\":\"space\"},{\"n\":2,\"text\":\"culture. Cf. K\u00e2li. \u0938\u0902\u0938\u094d\u0915\u093e\u0930\u0935\u0924\u094d\u092f\u0947\u0935 \u0917\u093f\u0930\u093e \u092e\u0928\u0940\u0937\u0940 \u0924\u092f\u093e \u0938 \u092a\u0942\u0924\u0936\u094d\u091a \u0935\u093f\u092d\u0942\u0937\u093f\u0924\u0936\u094d\u091a\",\"end\":\"space\"},{\"n\":3,\"text\":\"Kum. I. 28, where Malli. renders the word \u0938\u0902\u0938\u094d\u0915\u093e\u0930 by \u0935\u094d\u092f\u093e\u0915-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"\u0930\u0923\u091c\u0928\u094d\u092f\u093e \u0936\u0941\u0926\u094d\u0927\u093f\u0903 \u0964 Here of course the word means more than that.\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0938\u0902\u0924\u0924\u2014Lasting for ever.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 20. \u0928\u093e\u092e\u2014is used here \u092a\u094d\u0930\u093e\u0915\u093e\u0936\u094d\u092f\u0947 \u2018as is well known\u2019; or it may\",\"end\":\"space\"},{\"n\":2,\"text\":\"have the sense of \u2018indeed, verily\u2019 as in \u092e\u092f\u093e \u0928\u093e\u092e \u091c\u093f\u0924\u0902 or \u0928 \u0928\u093e\u092e\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0936\u0930\u093e\u0938\u0928\u092e\u094d Vikra. \u092a\u094d\u0930\u091a\u094d\u091b\u0928\u094d\u0928\u0917\u0941\u092a\u094d\u0924\u2014The Comp. may be taken in two\",\"end\":\"space\"},{\"n\":4,\"text\":\"ways \u092a\u094d\u0930\u091a\u094d\u091b\u0928\u094d\u0928\u0902 \u092f\u0925\u093e \u0924\u0925\u093e \u0917\u0941\u092a\u094d\u0924\u0902 very carefully protected, or \u092a\u094d\u0930\u091a\u094d\u091b\u0928\u094d\u0928\u092e\u0924\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u090f\u0935 \u0917\u0941\u092a\u094d\u0924\u0902 \u091a carefully concealed ( from view and protected ). Cf.\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0939\u0930\u094d\u0924\u0941\u0930\u094d\u092f\u093e\u0924\u093f \u0928 \u0917\u094b\u091a\u0930\u0902 supra sl. 16. \u092d\u094b\u0917\u0915\u0930\u0940\u2014contributing to pleasures.\",\"end\":\"space\"},{\"n\":7,\"text\":\"from \u092d\u094b\u0917+\u0915\u0943+\u091f\u0903 ( \u0905 ) added \u0939\u0947\u0924\u094c, + \u0919\u0940; see com.; \u091f is attached\",\"end\":\"space\"},{\"n\":8,\"text\":\"to \u0915\u0943 in these senses:-\u092f\u0936\u0938\u094d\u0915\u0930\u0940 \u0935\u093f\u0926\u094d\u092f\u093e, \u0936\u094d\u0930\u093e\u0926\u094d\u0927\u0915\u0930\u0903 ( \u0924\u093e\u091a\u094d\u091b\u0940\u0932\u094d\u092f ), \u0935\u091a\u0928\u0915\u0930\u0903\",\"end\":\"space\"},{\"n\":9,\"text\":\"( \u0906\u0928\u0941\u0932\u094b\u092e\u094d\u092f ); Sid. Kau. \u0917\u0941\u0930\u0942\u0923\u093e\u0902 \u0917\u0941\u0930\u0941\u0903 the preceptor of preceptors,\",\"end\":\"space\"},{\"n\":10,\"text\":\"or the greatest of the great. For the gen. \u0917\u0941\u0930\u0942\u0923\u093e\u0902 see P\u00e2n II. 3.\",\"end\":\"space\"},{\"n\":11,\"text\":\"41. ( \u092f\u0924\u0936\u094d\u091a \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923\u092e\u094d ) and A. G. \u00a7 82. The fem. of \u0917\u0941\u0930\u0941 is \u0917\u0941\u0930\u094d\u0935\u0940 or\",\"end\":\"space\"},{\"n\":12,\"text\":\"\u0917\u0941\u0930\u0941\u0903 \u0964 The rule is \u2018\u0935\u094b\u0924\u094b \u0917\u0941\u0923\u0935\u091a\u0928\u093e\u0924\u094d\u2019 \u0964 P\u00e2n. IV. 1. 44. \u090b\u0926\u0941\u0938\u0902\u092f\u094b\u0917\u094b\u092a\u0927\u093e\u0924\u094d \u0964\",\"end\":\"space\"},{\"n\":13,\"text\":\"V\u00e2rt.\u2013Adjectives of quality ending in \u0909 not preceded by a con-\",\"end\":\"hyphen\"},{\"n\":14,\"text\":\"junct consonant, except \u0916\u0930, form their fem. by adding \u0919\u0940 option-\",\"end\":\"hyphen\"},{\"n\":15,\"text\":\"nally. See Gr. \u00a7 319. \u092c\u0928\u094d\u0927\u0941\u2014\u092c\u0927\u094d\u0928\u093e\u0924\u093f \u092e\u0928\u0903 \u0938\u094d\u0928\u0947\u0939\u093e\u0926\u093f\u0928\u0947\u0924\u093f \u092c\u0928\u094d\u0927\u0941\u0903 \u0964 \u092c\u0928\u094d\u0927\u094d + \u0909\",\"end\":\"space\"},{\"n\":16,\"text\":\"Un. I. 10. \u0930\u093e\u091c\u0938\u0941 \u092a\u0942\u091c\u093f\u0924\u093e\u2014The construction is rather unidiomatic\",\"end\":\"space\"},{\"n\":17,\"text\":\"from a grammatical point of view. The rule of P\u00e2n. is \u2018\u0915\u094d\u0924\u0938\u094d\u092f \u091a\",\"end\":\"space\"},{\"n\":18,\"text\":\"\u0935\u0930\u094d\u0924\u092e\u093e\u0928\u0947\u2019 II. 3. 67. Past p. participles ending in \u0924, when used in\",\"end\":\"space\"},{\"n\":19,\"text\":\"the sense of the present tense, are used with the gen.; \u0930\u093e\u091c\u094d\u091e\u093e\u0902 \u092e\u0924\u0903,\",\"end\":\"space\"},{\"n\":20,\"text\":\"\u092c\u0941\u0926\u094d\u0927\u0903, \u092a\u0942\u091c\u093f\u0924\u094b \u0935\u093e. The Loc may be explained as \u0935\u093f\u0937\u092f\u093e\u0927\u093f\u0915\u0930\u0923\u0947, \u0930\u093e\u091c\u0938\u0941\",\"end\":\"space\"},{\"n\":21,\"text\":\"\u0935\u093f\u0937\u092f\u0947 \u092a\u0942\u091c\u093f\u0924\u093e or the whole may be taken as a comp. word mean-\",\"end\":\"hyphen\"},{\"n\":22,\"text\":\"ing well ( \u0938\u0941 ) respected ( \u092a\u0942\u091c\u093f\u0924\u093e ) by kings ( \u0930\u093e\u091c\u092d\u093f\u0903 ). \u0935\u093f\u0926\u094d\u092f\u093e\u0935\u093f-\",\"end\":\"hyphen\"},{\"n\":23,\"text\":\"\u0939\u0940\u0928\u0903 \u092a\u0936\u0941\u0903:\u2014Comp. sl.s 12, 13.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit readings, particularly in lines 4, 7\u20138 and 12, are difficult to distinguish.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Fig.\u2014As there are many rupakas in this sl. the figure of\",\"end\":\"space\"},{\"n\":2,\"text\":\"speech is M\u00e2l\u00e2\u2014r\u00fbpaka. A \u0930\u0942\u092a\u0915 is defined as \u0924\u0926\u094d\u0930\u0942\u092a\u0915\u092e\u092d\u0947\u0926\u094b \u092f\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0909\u092a\u092e\u093e\u0928\u094b\u092a\u092e\u0947\u092f\u092f\u094b\u0903:\u2014the identity of the \u0909\u092a\u092e\u093e\u0928 and \u0909\u092a\u092e\u0947\u092f is R\u00fbpaka\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit definition in line 2 is not entirely clear.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 11 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"19\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"20\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\",\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
