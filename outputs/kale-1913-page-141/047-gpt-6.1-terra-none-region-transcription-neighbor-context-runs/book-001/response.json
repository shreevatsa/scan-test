          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"the tears of delight, fearlessly resting on their laps: our life,\",\"end\":\"space\"},{\"n\":2,\"text\":\"on the other hand, is being wasted, ( as ) we enjoy the de-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"light of sports in the pleasure gardens adjoining the walls of\",\"end\":\"space\"},{\"n\":4,\"text\":\"mansions reared up by our imagination.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"16. Alas ! the mind does not give up ( its longing ) for\",\"end\":\"space\"},{\"n\":2,\"text\":\"carnal pleasures even when one has to eat food obtained by\",\"end\":\"space\"},{\"n\":3,\"text\":\"begging, and that too unsubstantial and once ( only in a\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"day ); when one has the earth for a couch, and only one\u2019s\",\"end\":\"space\"},{\"n\":6,\"text\":\"self for an attendant, and when one\u2019s raiment is a wallet of\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"},{\"n\":8,\"text\":\"a hundred threadbare rags ( stitched together ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"17. The breasts which are fleshy protuberances are com-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"pared to golden jars; the mouth which is the receptacle of\",\"end\":\"space\"},{\"n\":3,\"text\":\"phlegm is likened to the moon; the hips * * * ( are de-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"scribed as ) rivalling the head of an elephant-king. Mark\",\"end\":\"space\"},{\"n\":5,\"text\":\"how the despicable form ( of a woman ) has been heightened\",\"end\":\"space\"},{\"n\":6,\"text\":\"( cried up ) by a certain class of poets.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":