{
 "regions": [
  {
   "id": "r2",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "पुनः कालमुद्दिश्याह ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "वयं येभ्यो जाताश्चिरपरिगता एव खलु ते",
     "end": "line"
    },
    {
     "n": 2,
     "text": "समं यैः संवृद्धाः स्मृतिविषयतां तेपि गमिताः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इदानीमेते स्मः प्रतिदिवसमासन्नपतना-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "द्गतास्तुल्यवस्थां सिकतिलनदीतीरतरुभिः ॥ ३८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यत्रानेकः क्वचिदपि गृहे तत्र तिष्ठत्यथैको",
     "end": "line"
    },
    {
     "n": 2,
     "text": "यत्राप्येकस्तदनु बहवस्तत्र चान्ते न चैकः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इत्थं चेमौ रजनिदिवसौ दोलयन्द्वाविवाक्षौ",
     "end": "line"
    },
    {
     "n": 4,
     "text": "कालः काल्या सह बहुकलः क्रीडति प्राणिसारैः ॥ ३९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "तपस्यन्तः सन्तः किमधिनिवसामः सुरनदीं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "गुणोदारान्दारानुत परिचरामः सविनयम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "पिबामः शास्त्रौघानुत विविधकाव्यामृतरसा-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "न्न विद्मः किं कुर्मः कतिपयनिमेषायुषि जने ॥ ४० ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "apparatus_entry",
