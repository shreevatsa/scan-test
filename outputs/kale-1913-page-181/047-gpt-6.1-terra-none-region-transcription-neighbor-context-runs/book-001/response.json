          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"disposition or character ( according to Malli; see com. on Rag.\",\"end\":\"space\"},{\"n\":2,\"text\":\"VI. 21. ). Fig\u2014Arth\u00e2ntarany\u00e2sa. For the idea comp. \u091c\u0920\u0930\u091c\u094d\u0935\u0932\u0928-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\u091c\u094d\u0935\u0932\u0924\u093e\u092a\u094d\u092f\u092a\u0917\u0924\u0936\u0919\u094d\u0915\u093e \u0938\u092e\u093e\u0917\u0924\u093e\u092a\u093f \u092a\u0941\u0930\u0903 \u0964 \u0915\u0930\u093f\u0923\u093e\u092e\u0930\u093f\u0923\u093e \u0939\u0930\u093f\u0923\u093e \u0939\u0930\u093f\u0923\u093e\u0932\u0940\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0939\u0928\u094d\u092f\u0924\u093e\u0902 \u0924\u0941 \u0915\u0925\u092e\u094d \u0965 Bha. VI. 1. 49.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation is difficult to read in places.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 31. \u0905\u0927\u0936\u094d\u091a\u0930\u0923\u092a\u093e\u0924\u092e\u094d\u2014( 1 ) He falls down on his knees;\",\"end\":\"space\"},{\"n\":2,\"text\":\"( 2 ) falls at the feet of another. Both the senses seem\",\"end\":\"space\"},{\"n\":3,\"text\":\"to be intended. \u092a\u093f\u0923\u094d\u0921\u0926\u2014the giver of food. \u0917\u091c\u092a\u0941\u0902\u0917\u0935\u2014\u092a\u0941\u0902\u0917\u0935 at\",\"end\":\"space\"},{\"n\":4,\"text\":\"the end of a comp. indicates excellence. Compare the similar\",\"end\":\"space\"},{\"n\":5,\"text\":\"use of such words as \u090b\u0937\u092d, \u0915\u0941\u0902\u091c\u0930 &c. see com. \u0927\u0940\u0930\u092e\u094d\u2014with\",\"end\":\"space\"},{\"n\":6,\"text\":\"patience or seriousness. \u091a\u093e\u091f\u0941\u0936\u0924\u0948\u0903\u2014with hundreds of cajoling\",\"end\":\"space\"},{\"n\":7,\"text\":\"expressions or words of coaxing ( addressed to him ). An\",\"end\":\"space\"},{\"n\":8,\"text\":\"Anyokti ( a kind of Aprastutapras'amsa' ).\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The first Sanskrit expression is somewhat unclear.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 32. \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u093f\u0928\u093f\u2014Rotating, revolving:\u2014an idea that fits\",\"end\":\"space\"},{\"n\":2,\"text\":\"in well with Sams\u00e0ra which means \u2018 that in which the soul\",\"end\":\"space\"},{\"n\":3,\"text\":\"passes from one corporeal existence to another. \u092e\u0943\u0924\u0903 \u0915\u094b \u0935\u093e \u0928 \u091c\u093e\u092f\u0924\u0947-\",\"end\":\"space\"},{\"n\":4,\"text\":\"who, indeed, being dead is not born again ? This is the sense\",\"end\":\"space\"},{\"n\":5,\"text\":\"in which the late Mr. Telang seems to take this passage. But\",\"end\":\"space\"},{\"n\":6,\"text\":\"the condition of death must follow that of birth, so it is better\",\"end\":\"space\"},{\"n\":7,\"text\":\"to construe it as \u0915\u0903 \u0928 \u092e\u0943\u0924\u0903 \u0915\u094b \u0935\u093e \u0928 \u091c\u093e\u092f\u0924\u0947 who is not born and\",\"end\":\"space\"},{\"n\":8,\"text\":\"who is not dead; birth and death are the necessary conditions\",\"end\":\"space\"},{\"n\":9,\"text\":\"through which every one must pass. Cf. Bg. II. 27. quoted in\",\"end\":\"space\"},{\"n\":10,\"text\":\"the com. \u0938\u092e\u0941\u0928\u094d\u0928\u0924\u093f\u2014elevation, eminence, a rise in status.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"Sl. 33. \u0926\u094d\u0935\u092f\u0940\u2014\u0926\u094d\u0935\u094c \u0905\u0935\u092f\u0935\u094c \u092f\u0938\u094d\u092f\u093e\u0903; twofold \u2018 \u0938\u0902\u0916\u094d\u092f\u093e\u092f\u093e \u0905\u0935\u092f\u0935\u0947 \u0924\u092f\u092a\u094d \u0964\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0926\u094d\u0935\u093f\u0924\u094d\u0930\u093f\u092d\u094d\u092f\u093e\u0902 \u0924\u092f\u0938\u094d\u092f\u093e\u092f\u091c\u094d\u0935\u093e \u0964 P\u00e0n. V. 2. 42, 43. \u0905\u092f is optionally substi-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"tuted for \u0924\u092f in the case of \u0926\u094d\u0935\u093f or \u0924\u094d\u0930\u093f:; \u0926\u094d\u0935\u093f\u0924\u092f\u0902, \u0926\u094d\u0935\u092f\u0902; \u0924\u094d\u0930\u093f\u0924\u092f\u0902,\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0924\u094d\u0930\u092f\u092e\u094d. \u092e\u0928\u0938\u094d\u0935\u093f\u0928\u094d\u2014noble-minded, high-souled. \u0926\u094d\u0935\u0947 \u0917\u0924\u0940 \u0938\u094d\u0924\u0903 &c. v. l.\",\"end\":\"space\"},{\"n\":6,\"text\":\"means:\u2014There are two courses ( of action ) for &c. The former\",\"end\":\"space\"},{\"n\":7,\"text\":\"is preferable as it implies an amount of consideration and de-\",\"end\":\"hyphen\"},{\"n\":8,\"text\":\"termination on the part of the Manishin. \u092e\u0942\u0930\u094d\u0927\u094d\u0928\u093f \u0935\u093e &c.\u2014(1) at the\",\"end\":\"space\"},{\"n\":9,\"text\":\"head of all; (2) on the head &c. For the idea expressed here\",\"end\":\"space\"},{\"n\":10,\"text\":\"\",\"end\":\"space\"},{\"n\":11,\"text\":\"comp. \u0928\u0948\u0938\u0930\u094d\u0917\u093f\u0915\u0940 \u0938\u0941\u0930\u092d\u093f\u0923\u0903 \u0915\u0941\u0938\u0941\u092e\u0938\u094d\u092f \u0938\u093f\u0926\u094d\u0927\u093e \u092e\u0942\u0930\u094d\u0927\u094d\u0928\u093f \u0938\u094d\u0925\u093f\u0924\u093f\u0930\u094d\u0928 \u091a\u0930\u0923\u0948\u0930\u0935\u0924\u093e\u0921\u0928\u093e\u0928\u093f \u0965\",\"end\":\"space\"},{\"n\":12,\"text\":\"Uttar. I. \u0935\u093f\u0936\u0940\u0930\u094d\u092f\u0947\u0924\u0970\u2014A high-minded man rather than occupy\",\"end\":\"space\"},{\"n\":13,\"text\":\"a low position retires from society and leads a secluded life.\",\"end\":\"space\"},{\"n\":14,\"text\":\"Fig. Upama'.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit forms and diacritics are difficult to distinguish.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 16 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"31\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"32\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"33\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
