{
 "regions": {
  "r3": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "सदोषं च वस्तु विहाय नित्यवस्तुनि परमेश्वरे अन्तःकरणाभिनिवेशः कर्तव्य",
     "end": "space"
    },
    {
     "n": 2,
     "text": "इत्यर्थः । वृत्तं शार्दू० ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "पुनस्तदेव भङ्ग्यन्तरेण प्रतिपादयति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "",
     "end": "space"
    },
    {
     "n": 2,
     "text": "आधिव्याधिशतैर्जनस्य विविधैरारोग्यमुन्मूल्यते",
     "end": "line"
    },
    {
     "n": 3,
     "text": "लक्ष्मीर्यत्र पतन्ति तत्र विवृतद्वारा इव व्यापदः[१] ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "जातं जातमवश्यमाशु विवशं मृत्युः करोत्यात्मसा-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "त्तत्किं नाम[२][३] निरङ्कुशेन विधिना यन्निर्मितं सुस्थिरम्[४] ॥३४॥.",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The superscript markers and punctuation at the end are faint."
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "विविधैः बहुप्रकारैः आधिर्मानसी व्यथा व्याधिः शरीररोगः तेषां शतैः",
     "end": "space"
    },
    {
     "n": 2,
     "text": "जनस्य पुरुषस्यारोग्यं शरीरस्वास्थ्यं समुन्मूल्यते । तथा यत्र लक्ष्मीः ऐश्वर्यं तत्र",
     "end": "space"
    },
    {
     "n": 3,
     "text": "व्यापदः विविधाः आपदः संकटानि विवृतद्वारा विवृतं द्वारमासां इति ता इव",
     "end": "space"
    },
    {
     "n": 4,
     "text": "पतन्ति । मृत्युः कालः जातं जातं जातमात्रं विवशमाशु त्वरितमवश्यं नियमेन",
     "end": "space"
    },
    {
     "n": 5,
     "text": "आत्मसात्करोति साकल्येन स्ववशं नयति । तदधीनवचने इति सातिप्रत्ययः ।",
     "end": "space"
    },
    {
     "n": 6,
     "text": "तत्किं नाम वस्तु यन्निरङ्कुशेन अप्रतिबन्धेन विधिना दैवेन प्रजापतिना वा",
     "end": "space"
    },
    {
     "n": 7,
     "text": "सुस्थिरं निर्मितम् । न किंचिदपीत्यर्थः । शार्दूलविक्रीडितम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small commentary characters are indistinct."
  },
  "r7": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "एवं चैतत्कर्तव्यमित्याकांक्षायां कर्तव्यं निर्दिशति त्रिभिः—",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The opening compound is somewhat indistinct."
  },
  "r8": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "भोगास्तुङ्गतरङ्गभङ्गचपलाः[५] प्राणाः क्षणध्वंसिन-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "स्तोकेनैव दिनानि यौवनसुखं[६] प्रीतिः प्रियेऽस्थिरा ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तत्संसारमसारमेव निखिलं बुद्ध्वा[७] बुधा बोधका",
     "end": "line"
    },
    {
     "n": 4,
     "text": "लोकानुग्रहपेशलेन मनसा यत्नः समाधीयताम् ॥ ३५ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The superscript markers and several letters are faint."
  },
  "r9": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "भोगाः तुङ्गतरंगाणां भङ्गवच्चपलाः चञ्चलाः । क्षणध्वंसिनः क्षणिका इति",
     "end": "space"
    },
    {
     "n": 2,
     "text": "यावत् । स्तोकानि अल्पानि एव दिनानि कतिपयदिनपर्यन्तस्थायि यौवन-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "सुखम् । प्रिये प्रीतिरस्थिरा । निखिलं संसारं असारमेव अनित्यमेव ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "बुद्ध्वा हे बुधा बोधका उपदेशकाः लोकानुग्रहे पेशलं चारु दक्षं वा तेन मनसा",
     "end": "space"
    },
    {
     "n": 5,
     "text": "यत्नः समाधीयतां क्रियताम् । सर्वमनित्यमिति परिचिन्त्य सर्वेषामपि सुखानां",
     "end": "space"
    },
    {
     "n": 6,
     "text": "स्वाचरणेन लोकोपकारकरणमेव उचितमिति तात्पर्यम् । तदुक्तं भगवद्गीतायां—",
     "end": "space"
    },
    {
     "n": 7,
     "text": "यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः । स यत्प्रमाणं कुरुते लोकस्तदनुवर्तते ॥",
     "end": "space"
    },
    {
     "n": 8,
     "text": "इति । शार्दूल० वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small letters and punctuation are indistinct."
  },
