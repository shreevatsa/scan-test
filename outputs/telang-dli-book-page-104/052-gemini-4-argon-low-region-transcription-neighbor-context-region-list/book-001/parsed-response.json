{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "मातर्लक्ष्मि भजस्व कञ्चिदपरं मत्काङ्क्षिणी मा स्म भू-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "र्भोगेभ्यः स्पृहयालवो न हि वयं का निस्पृहाणामसि ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "सद्यःस्यूतपलाशपत्रपुटिकापात्रे पवित्रीकृते",
     "end": "line"
    },
    {
     "n": 4,
     "text": "",
     "end": "line"
    },
    {
     "n": 5,
     "text": "भिक्षासक्तुभिरेव सम्प्रति वयं वृत्तिं समीहामहे ॥ ६४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यूयं वयं वयं यूयमित्यासीन्मतिरावयोः ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "किं जातमधुना येन यूयं यूयं वयं वयम् ॥ ६५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "बाले लीलामुकुलितममी मन्थरा दृष्टिपाताः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "किं क्षिप्यन्ते विरम विरम व्यर्थ एष श्रमस्ते ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "सम्प्रत्यन्ये वयमुपरतं बाल्यमास्था वनान्ते",
     "end": "line"
    },
    {
     "n": 4,
     "text": "क्षीणो मोहस्तृणमिव जगज्जालमालोकयामः ॥ ६६ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "इयं बाला मां प्रत्यनवरतमिन्दीवरदल-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "प्रभाचोरं चक्षुः क्षिपति किमभिप्रेतमनया ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "गतो मोहोस्माकं स्मरकुसुमबाणव्यतिकर-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "ज्वरज्वाला शान्ता तदपि न वराकी विरमति ॥ ६७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "रम्यं हर्म्यतलं न किं वसतये श्रव्यं न गेयादिकं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "किं वा प्राणसमासमागमसुखं नैवाधिकं प्रीतये ।",
     "end": "line"
    }
   ],
   "uncertain": false,
   "note": null
  },
