{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "एके सत्पुरुषाः परार्थघटकाः स्वार्थं परित्यज्य ये",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सामान्यास्तु परार्थमुद्यमभृतः स्वार्थाविरोधेन ये ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तेमी मानुषराक्षसाः परहितं स्वार्थाय निघ्नन्ति ये",
     "end": "line"
    },
    {
     "n": 4,
     "text": "ये निघ्नन्ति निरर्थकं परहितं ते के न जानीमहे ॥ ७४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "क्षीरेणात्मगतोदकाय हि गुणा दत्ताः पुरा तेखिलाः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "क्षीरे तापमवेक्ष्य तेन पयसा ह्यात्मा कृशानौ हुतः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "गन्तुं पावकमुन्मनस्तदभवद्दृष्ट्वा तु मित्रापदं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "युक्तं तेन जलेन शाम्यति सतां मैत्री पुनस्त्वीदृशी ॥ ७५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "इतः स्वपिति केशवः कुलमितस्तदीयद्विषा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "मितश्च शरणार्थिनः शिखरिणां गणाः शेरते ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इतोपि वडवानलः सह समस्तसंवर्तकै-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "रहो विततमूर्जितं भरसहं च सिन्धोर्वपुः ॥ ७६ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "तृष्णां छिन्धि भज क्षमां जहि मदं पापे रतिं मा कृथाः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सत्यं ब्रूह्यनुयाहि साधुपदवीं सेवस्व विद्वज्जनम् ।",
     "end": "line"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "LXXIV. (a) एके; ये के. S. X. एते Bo. Be. N. P. R. ते ते K. स्वार्थ-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "म्; स्वार्थान्. N. ये; ते. X. S. T. D. (b) मध्यस्थाः खलु ते परार्थघटकाः स्वार्थावि-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "रोधेन ये S. X. ये; तु Bo.n. (c) °नुष; °नव T.—°र्थाय°; °र्थे वि.° P. नि°;",
     "end": "space"
