{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अस्माकं तु मनोरथोपरचितप्रासादवापीतट-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "क्रीडाकाननकेलिकौतुकजुषामायुः परिक्षीयते ॥ १०३ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "",
     "end": "join"
    },
    {
     "n": 2,
     "text": "आघ्रातं मरणेन जन्म जरया विद्युच्चलं यौवनं",
     "end": "line"
    },
    {
     "n": 3,
     "text": "संतोषो धनलिप्सया शमसुखं प्रौढाङ्गनाविभ्रमैः ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "लोकैर्मत्सरिभिर्गुणा वनभुवो व्यालैर्नृपा दुर्जनै-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "",
     "end": "join"
    },
    {
     "n": 6,
     "text": "रस्थैर्येण विभूतिरप्यपहृता ग्रस्तं न किं केन वा ॥ १०४ ॥",
     "end": "join"
    },
    {
     "n": 7,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "आधिव्याधिशतैर्जनस्य विविधैरारोग्यमुन्मूल्यते",
     "end": "join"
    },
    {
     "n": 2,
     "text": "",
     "end": "line"
    },
    {
     "n": 3,
     "text": "लक्ष्मीर्यत्र पतन्ति तत्र विवृतद्वारा इव व्यापदः ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "जातं जातमवश्यमाशु विवशं मृत्युः करोत्यात्मसा-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "",
     "end": "join"
    },
    {
     "n": 6,
     "text": "त्तत्किं नाम निरङ्कुशेन विधिना यन्निर्मितं सुस्थितम् ॥ १०५॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "कृच्छ्रेणामेध्यमध्ये नियमिततनुभिः स्थीयते गर्भमध्ये",
     "end": "line"
    },
    {
     "n": 2,
     "text": "कान्ताविश्लेषदुःखव्यतिकरविषमे यौवने विप्रयोगः ।",
     "end": "line"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
