{
 "regions": {
  "r3": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "मानी पुरुषः परकृतं निकारं न सहतेति सदृष्टान्तमाह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यदचेतनोपि पादैः स्पृष्टः प्रज्वलति सवितुरिनकान्तः ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "तत्तेजस्वी पुरुषः परकृतनिकृतिं[१] कथं सहते ॥ ३७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "यद्यस्मात्कारणात् । अविद्यमाना चेतना यस्यासौ अचेतनः निर्जीवोपि । इन-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "कान्तः सूर्यकान्तः । सवितुः पादैः मयूखैः । चरणतलैश्च । स्पृष्टः आक्रान्तः ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "ताडितश्चेति ध्वन्यते । प्रज्वलति तेज उद्गिरति । कोपदीप्तश्च भवतीति गम्यते ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "तत्तस्मात्कारणात् । परेणान्येन शत्रुणा वा कृतां निकृतिं निकारम् । न कथंचि-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "दपि सहते इत्यर्थः ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small-type readings, especially कोपदीप्तश्च, are unclear."
  },
  "r6": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "वयस्तेजसो न हेतुरिति विनिगमयति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "सिंहः शिशुरपि निपतति मदमलिनकपोलभित्तिषु गजेषु ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "प्रकृतिरियं सत्त्ववतां न खलु वयस्तेजसो हेतुः ॥ ३८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "कपोलाः भित्तय इव कपोलभित्तयः । भित्तिशब्दः प्राशस्त्यार्थे । मदेन दानवा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "रिणा मलिनाः कपोलभित्तयो येषां तेषु । प्रकृतिः स्वभावः । सत्त्ववतां बलशा-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "लिनाम् । न खल्विति-कालीदासोप्याह-तेजसां हि न वयः समीक्ष्यते इति ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "अथार्थपद्धतिः ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r10": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "तत्रादावर्थसंग्रहैकपराणां मतमभिसंधायाह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r11": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "जातिर्यातु रसातलं गुणगणस्तस्याप्यधो गच्छतु[२]",
     "end": "line"
    },
    {
     "n": 2,
     "text": "शीलं शैलतटात्पतत्वभिजनः संदह्यतां वह्निना ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "शौर्ये वैरिणि वज्रमाशु निपतत्वर्थोऽस्तु नः केवलं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "येनैकेन विना गुणास्तृणलवप्रायाः समस्ता इमे[३] ॥ ३९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r12": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "जातिर्ब्राह्मणत्वादिः रसातलं पृथ्वीतलं यातु । नश्यतु इत्यर्थः । शीलं सद्वृत्तं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "पततु विशीर्णं भवतु । अभिजनः वंशः । कुलीनतेति यावत् । वैरिणि सत्यां",
     "end": "space"
    },
    {
     "n": 3,
     "text": "परभूतौ संक्षोभकारित्वाच्छत्रुभूते । वयं केवलमर्थमेव साधयाम इत्यर्थः ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "ननु उक्तगुणानां प्रध्वंसेनापि किमित्यर्थलाभ इष्यते इति चेत् येनेति । तृणल-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "वप्रायास्तृणलवतुल्याः । तदृच्छव इत्यर्थः । तदुक्तं रामायणे-धनमर्जय काकुत्स्थ",
     "end": "space"
    },
    {
     "n": 6,
     "text": "धनमूलमिदं जगत् । अन्तरं नाभिजानामि निर्धनस्य मृतस्य च ॥ इति ।",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several small-type words, particularly तदृच्छव and सत्यां परभूतौ, are difficult to read."
  },
