          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"34. There are even others\u2014B\u1e5bhaspati chief among them,\",\"end\":\"space\"},{\"n\":2,\"text\":\"five or six in number, that are honourable ( enough ); but\",\"end\":\"space\"},{\"n\":3,\"text\":\"R\u00e1hu, delighting in ( showing ) his peculiar prowess ( or,\",\"end\":\"space\"},{\"n\":4,\"text\":\"showing his prowess against a distinguished adversary), does\",\"end\":\"space\"},{\"n\":5,\"text\":\"not act inimically towards them. On the new and full moon\",\"end\":\"space\"},{\"n\":6,\"text\":\"days the demon-chief, whose head is the only remnant part\",\"end\":\"space\"},{\"n\":7,\"text\":\"of his body, mark, friend, eclipses only two, the luminous\",\"end\":\"space\"},{\"n\":8,\"text\":\"sun and the bright moon.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"35. S'esha supports the row of the worlds on his shelf-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"like hood; he is ever held on his back by the great Tortoise;\",\"end\":\"space\"},{\"n\":3,\"text\":\"even him, the ocean consigns with little concern to the abyss\",\"end\":\"space\"},{\"n\":4,\"text\":\"( of its water ); oh ! unbounded is the magnificence of the\",\"end\":\"space\"},{\"n\":5,\"text\":\"actions of the great !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"36. Better would it have been ( for Main\u00e1ka ) to have his\",\"end\":\"space\"},{\"n\":2,\"text\":\"wings lopped off with the strokes of the thunderbolt hurled\",\"end\":\"space\"},{\"n\":3,\"text\":\"by the proud Indra, strokes which were unbearable on\",\"end\":\"space\"},{\"n\":4,\"text\":\"account of the flames of fire proceeding thickly from the\",\"end\":\"space\"},{\"n\":5,\"text\":\"thunderbolt; but alas, for the son of the snowy mountain a\",\"end\":\"space\"},{\"n\":6,\"text\":\"plunge into the waters of the ocean was not proper, when\",\"end\":\"space\"},{\"n\":7,\"text\":\"his father ( Him\u00e1laya ) was beside himself with pain.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"37. Since even the insentient sun-jewel emits burning\",\"end\":\"space\"},{\"n\":2,\"text\":\"heat when touched by the p\u00e1da\u0441 ( feet\u2013the rays ) of the sun,\",\"end\":\"space\"},{\"n\":3,\"text\":\"how can a man of mettle then brook an insult offered by\",\"end\":\"space\"},{\"n\":4,\"text\":\"others ?\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The italic transliterated word appears to be 'p\u00e1das'.\"},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"38. A lion, though young, attacks elephants whose ram-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"part-like temples are soiled with rut; this is the nature of\",\"end\":\"space\"},{\"n\":3,\"text\":\"the valiant; age, indeed, is not the cause of valour.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"39. Let caste go to the nether world, and let the aggre-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"gate of virtues sink lower still; let goodness of character fall\",\"end\":\"space\"},{\"n\":3,\"text\":\"from a precipice, and nobility be burnt down with fire; let\",\"end\":\"space\"},{\"n\":4,\"text\":\"the thunderbolt strike at once bravery which is no friend ( to\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 7 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"34\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"35\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"36\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"37\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"38\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"39\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
