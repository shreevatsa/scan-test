    {
     "n": 1,
     "text": "४ दैवहतकः.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r19",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "५ तत्रापदां भाजनम्.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r20",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "६ भुजं-",
     "end": "hyphen"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r21",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "गविहंगमब० शशि० इति पादयोर्व्यत्यासेन पाठः ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
