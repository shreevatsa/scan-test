          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"earth is covered ( overpowered ) with his pa'das (feet i. e.\",\"end\":\"space\"},{\"n\":2,\"text\":\"power; rays-in the case of the sun).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"6. Spirited men, devoted to the performance of the vow\",\"end\":\"space\"},{\"n\":2,\"text\":\"of truthfulness, sacrifice their lives willingly but not their\",\"end\":\"space\"},{\"n\":3,\"text\":\"vow which is the source of modesty and numerous other\",\"end\":\"space\"},{\"n\":4,\"text\":\"good qualities, which keeps the heart exceedingly pure and\",\"end\":\"space\"},{\"n\":5,\"text\":\"is binding like a mother of exceedingly pure heart and\",\"end\":\"space\"},{\"n\":6,\"text\":\"attached to one.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"7. Like unto the face reflected in a mirror the heart of\",\"end\":\"space\"},{\"n\":2,\"text\":\"women cannot be caught ( comprehended ); their feeling,\",\"end\":\"space\"},{\"n\":3,\"text\":\"intricate like the faint mountain-track, cannot be gauged;\",\"end\":\"space\"},{\"n\":4,\"text\":\"their heart has been described by the wise as fickle like\",\"end\":\"space\"},{\"n\":5,\"text\":\"water on a lotus-leaf; a woman growing with faults is,\",\"end\":\"space\"},{\"n\":6,\"text\":\"evidently, like a creeper growing with its poisonous shoots.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"8. Leave aside the question whether a man, wounded\",\"end\":\"space\"},{\"n\":2,\"text\":\"while facing the enemy attain victory or heaven; the\",\"end\":\"space\"},{\"n\":3,\"text\":\"applause of both the armies is, indeed, intensely gratifying\",\"end\":\"space\"},{\"n\":4,\"text\":\"to the ear.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"9. In all this collection of exceedingly wonderful things,\",\"end\":\"space\"},{\"n\":2,\"text\":\"whether of this nature or of such extent, either Var\u00e0ha or\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"R\u00e0hu, preeminently stands out as an object of wonder: ( the\",\"end\":\"space\"},{\"n\":5,\"text\":\"former ) in that he alone bore up the earth when it was sunk\",\"end\":\"space\"},{\"n\":6,\"text\":\"in water; the latter, the head-remnant, in that he swallows\",\"end\":\"space\"},{\"n\":7,\"text\":\"his enemy ( the sun ), and afterwards throws him out.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"10. The earth is bounded by the ocean; that store of\",\"end\":\"space\"},{\"n\":2,\"text\":\"waters is a hundred yojanas in extent; the sun, ever travel-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"ling measures the expanse of the sky;\u2014thus in most cases,\",\"end\":\"space\"},{\"n\":4,\"text\":\"things are confined within well-defined bounds; but victori-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"ous is the intellectual brilliancy of the good ( wise ) that is\",\"end\":\"space\"},{\"n\":6,\"text\":\"unlimited !\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"11. ( Let me have ) one god\u2014Keshava or S'iva; one\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 21 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"5\",\"label\":null,\"