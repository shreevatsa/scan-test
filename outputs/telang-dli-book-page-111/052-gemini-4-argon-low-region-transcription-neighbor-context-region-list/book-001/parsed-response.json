{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "ज्ञानं सतां मानमदादिनाशनं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "केषाञ्चिदेतन्मदमानकारणम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "स्थानं विविक्तं यमिनां विमुक्तये",
     "end": "line"
    },
    {
     "n": 4,
     "text": "कामातुराणामतिकामकारणम् ॥ ९० ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "जीर्णा एव मनोरथाः स्वहृदये यातं जरां यौवनं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "हन्ताङ्गेषु गुणाश्च बन्ध्यफलतां याता गुणज्ञैर्विना ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "किं युक्तं सहसाभ्युपैति बलवान्कालः कृतान्तोक्षमी",
     "end": "line"
    },
    {
     "n": 4,
     "text": "ह्याज्ञातं स्मरशासनाङ्घ्रियुगलं मुक्त्वास्ति नान्या गतिः ॥ ९१ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "तृषा शुष्यत्यास्ये पिबति सलिलं स्वादु सुरभि",
     "end": "line"
    },
    {
     "n": 2,
     "text": "क्षुधार्तः सञ्शालीन्कवलयति शाकादिवलितान् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "प्रदीप्ते रागाग्नौ सुदृढतरमाश्लिष्यति वधूं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "प्रतीकारो व्याधेः सुखमिति विपर्यस्यति जनः ॥ ९२ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "स्नात्वा गाङ्गैः पयोभिः शुचिकुसुमफलैरर्चयित्वा विभो त्वां",
     "end": "line"
    },
    {
     "n": 2,
     "text": "ध्येये ध्यानं नियोज्य क्षितिधरकुहरग्रावपर्यङ्कमूले ।",
     "end": "line"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
