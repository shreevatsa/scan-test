          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"mind for a moment; there are many clouds in the sky, but\",\"end\":\"space\"},{\"n\":2,\"text\":\"they are not all of them such ( that a supplication should\",\"end\":\"space\"},{\"n\":3,\"text\":\"be addressed to them ); some of them moisten the earth\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"with showers, ( whereas ) others roar for nothing; do not\",\"end\":\"space\"},{\"n\":6,\"text\":\"utter a piteous cry before every one that you happen to see.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"52. Cruelty, unprovoked opposition, lust of another\u2019s\",\"end\":\"space\"},{\"n\":3,\"text\":\"wealth and wife, and envy of good men and relations: these\",\"end\":\"space\"},{\"n\":4,\"text\":\"are natural with the wicked.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"53. Though adorned with learning a wicked man should\",\"end\":\"space\"},{\"n\":2,\"text\":\"be avoided. Is not a serpent dangerous ( although it is ) be-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"decked with a jewel ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"54. Dulness is attributed to a modest man; hypocrisy to\",\"end\":\"space\"},{\"n\":2,\"text\":\"one who has a liking for religious observences; roguery to\",\"end\":\"space\"},{\"n\":3,\"text\":\"one who leads a life of sanctity; cruelty to a warrior; want\",\"end\":\"space\"},{\"n\":4,\"text\":\"of discrimination to one devoted to meditation; meanness to\",\"end\":\"space\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"one who speaks agreeably; arrogance to a spirited man; gar-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"rulity to an orator; and imbecility to a steady man. What\",\"end\":\"space\"},{\"n\":8,\"text\":\"virtue is there then that is not stigmatised by the wicked ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"55. If avarice forms part of a man\u2019s character, why\",\"end\":\"space\"},{\"n\":2,\"text\":\"should he need other bad qualities; if there be wickedness,\",\"end\":\"space\"},{\"n\":3,\"text\":\"why want sins; if truthfulness, religious austerietis; if there\",\"end\":\"space\"},{\"n\":4,\"text\":\"is purity of heart, why should he go on a pilgrimage ? If he\",\"end\":\"space\"},{\"n\":5,\"text\":\"has goodness of heart, why should he want relatives ? If he\",\"end\":\"space\"},{\"n\":6,\"text\":\"has reputation, ornaments are superfluous. If he possesses\",\"end\":\"space\"},{\"n\":7,\"text\":\"learning, what need he care for wealth ( v. l. the people )?\",\"end\":\"space\"},{\"n\":8,\"text\":\"If he has a bad name why should he need death ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"56. The moon, pale by day ( i. e. day-light ), a beautiful\",\"end\":\"space\"},{\"n\":2,\"text\":\"woman past youth, a lake without lotuses, the unlettered\",\"end\":\"space\"},{\"n\":3,\"text\":\"mouth of a man with a fair exterior, a king solely given to\",\"end\":\"space\"},{\"n\":4,\"text\":\"hoarding wealth, a virtuous man ever plunged in misery,\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 10 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"51\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"52\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"53\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"54\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"55\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"56\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
