{
 "regions": [
  {
   "id": "r1",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "॥ श्रीगणेशाय नमः ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r2",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "। अथ वैराग्यशतकम् ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "चूडोत्तंसितचारुचन्द्रकलिकाचञ्चच्छिखाभास्व[१]रो",
     "end": "line"
    },
    {
     "n": 2,
     "text": "लीलादग्धविलोलकामशलभः श्रेयोदशाग्रे स्फुरन् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "अन्तःस्फूर्जदपारमोहतिमिरप्राग्भारमुच्चाटयं-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "श्चेतःसद्मनि योगिनां विजयते ज्ञानप्रदीपो हरः ॥ १ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "चूडायां केशपाश उत्तंसिता भूषणीकृता चारुः सुन्दरा या चन्द्रकलिका",
     "end": "space"
    },
    {
     "n": 2,
     "text": "चन्द्रकला तस्याः चञ्चन्ती स्फुरन्ती या शिखा किरणदीप्तिस्तया भास्वरः ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "लीलया अनायासेन दग्धः विलोलः काम एव शलभः कीटविशेषः येन सः । श्रेयः",
     "end": "space"
    },
    {
     "n": 4,
     "text": "शिवं एव दशा वर्तिः । तस्याः अग्रे । अन्तःस्फूर्जन् अन्तःकरणे प्रसरन्यः",
     "end": "space"
    },
    {
     "n": 5,
     "text": "अपारः मोहः स एव तिमिरं तमः तस्य प्राग्भारं संहतिमुच्चाटयन् विनाशयन् ।",
     "end": "space"
    },
    {
     "n": 6,
     "text": "ज्ञानरूपप्रदीपो हरः योगिनां ध्यायिनां चेतःसद्मनि चेतोमन्दिरे विजयते सर्वो-",
     "end": "hyphen"
    },
    {
     "n": 7,
     "text": "त्कर्षेण वर्तते । तेन तं प्रणतोस्मीत्यर्थो लभ्यते । शार्दूलविक्रीडितं वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "आदौ सहृदयाभावात्सुभाषितस्यानवकाशतां निर्दिशति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "बोद्धारो मत्सरग्रस्ताः प्रभवः स्मयदूषिताः ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "अ[२]बोधोपहताश्चान्ये जीर्णम[३]ङ्गे सुभाषितम् ॥ २ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "बोद्धारः सदसद्व्यक्तिहेतवो ज्ञानिनः । मत्सरेण अन्यशुभद्वेषेण ग्रस्ता व्याप्ताः ।",
     "end": "space"
    },
    {
     "n": 2,
     "text": "प्रभवः राजानो धनाढ्या वा स्मयेन गर्वेण दूषिताः । अत एव श्रवणविमुखाः ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "अन्ये उक्तव्यतिरिक्ताः प्राकृता जना अज्ञानेनोपहताः सदसतोरन्तरं ज्ञातुम-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "समर्था इत्यर्थः । अतः सुभाषितमङ्गे जीर्णं गुणग्रहीत्रभावादित्यर्थः । पादत्रयस्य",
     "end": "space"
    },
    {
     "n": 5,
     "text": "चतुर्थपादं प्रति हेतुत्वात्काव्यलिङ्गमलंकारः । अनुष्टुप् छन्दः ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r8",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "अथ तृष्णादूषणम् ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r9",
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "विषयानुरागस्य तृष्णामूलत्वात्तस्याश्च वैराग्यप्रतिबन्धकत्वात्तामेवादौ दूषयति ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r10",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "उत्खातं निधिशङ्कया क्षितितलं ध्माता गिरेर्धातवो",
     "end": "line"
    },
    {
     "n": 2,
     "text": "निस्तीर्णः सरितां पतिर्नृपतयो यत्नेन संतोषिताः ।",
     "end": "line"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r11",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ भासुरः",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r12",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "२ अज्ञानो.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r13",
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "३ अङ्गेषु भाषितम्.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  }
 ],
