{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "विघ्नैः पुनःपुनरपि प्रतिहन्यमानाः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "प्रारभ्य चोत्तमजना न परित्यजन्ति ॥ २७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "प्रिया न्याय्या वृत्तिर्मलिनमसुभङ्गेप्यसुकरं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "त्वसन्तो नाभ्यर्थ्याः सुहृदपि न याच्यः कृशधनः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "विपद्युच्चैः स्थेयं पदमनुविधेयं च महतां",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सतां केनोद्दिष्टं विषममसिधाराव्रतमिदम् ॥ २८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "इति विद्वत्प्रशंसा ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "अथ मानशौर्यप्रशंसा ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "क्षुत्क्षामोपि जराकृशोपि शिथिलप्रायोपि कष्टां दशा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "मापन्नोपि विपन्नदीधितिरपि प्राणेषु नश्यत्स्वपि ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "मत्तेभेन्द्रविभिन्नकुम्भकवलग्रासैकबद्धस्पृहः",
     "end": "line"
    },
    {
     "n": 4,
     "text": "किं जीर्णं तृणमत्ति मानमहतामग्रेसरः केसरी ॥ २९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "(c) विघ्नैः सहस्रगुणितैरपि हन्यमानाः. in Bo.n. विघ्नैर्मुहुर्मुहुरपि प्रतिहन्यमानाः. in",
     "end": "space"
    },
    {
     "n": 2,
     "text": "N. (d) °भ्यचो°; °भ्य त°. X. S. T. G. °भ्यमु °. W. °ब्धत °. L. °ब्ध मु °.",
     "end": "space"
    },
    {
     "n": 3,
     "text": "Bo. Be. N. जना; गुणा. Bo.n. N.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r8",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "XXVIII. (b) त्व°; अ°. Bo. Be. S. K. M. X. P. R. The first six",
     "end": "space"
    },
    {
     "n": 2,
     "text": "of these have the second line of this stanza first and the first",
     "end": "space"
    },
    {
     "n": 3,
     "text": "second. P. R. have the third first, first second, and second third",
     "end": "space"
    },
    {
     "n": 4,
     "text": "(c) स्थेयम् ; स्थैर्यम् . N. (d) °रा°; °र°. D.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r9",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "XXIX. (a) शिथिलप्रायोपि; शिथिलप्राणोपि. D. Be. Bo. L. F. M. विगतप्रा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "योपि. Bo.n. शिथिलःप्राप्नो (प्तो?) ति. W. कष्टाम् ; दीनाम् . D. (b) °न्नोपि; °न्नोति.",
     "end": "space"
    },
