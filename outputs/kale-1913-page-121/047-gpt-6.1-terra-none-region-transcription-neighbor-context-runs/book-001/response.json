      "content": [
        {
          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"us ); wealth alone be ours, without which all these virtues\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"are like ( of as little worth as ) a piece of straw.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"40. There are the limbs, all the same; the action the\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"same; the same unimpaired intellect; and speech also the\",\"end\":\"space\"},{\"n\":4,\"text\":\"same; and yet the same man, destitute of the warmth of\",\"end\":\"space\"},{\"n\":5,\"text\":\"wealth, becomes instantaneously a changed being; this is\",\"end\":\"space\"},{\"n\":6,\"text\":\"strange.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"41. The man who possesses wealth is ( considered ) noble-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"born; he is learned, well-informed, and an appreciator of\",\"end\":\"space\"},{\"n\":3,\"text\":\"merits; he alone is an orator and a handsome man; (in short)\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"all qualifications cling to wealth.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"42. On account of evil counsel is ruined a king; an an-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"chorite by attachment to worldly pleasures; a son by indul-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"gence; a Br\u00e1hma\u1e47a by not studying the Vedas; a family by\",\"end\":\"space\"},{\"n\":4,\"text\":\"a misbehaved son; character by association with the\",\"end\":\"space\"},{\"n\":5,\"text\":\"wicked; modesty by wine; husbandry by want of attention;\",\"end\":\"space\"},{\"n\":6,\"text\":\"affection by resorting to travel; friendship by want of\",\"end\":\"space\"},{\"n\":7,\"text\":\"courtesy; prosperity by bad management; and wealth by\",\"end\":\"space\"},{\"n\":8,\"text\":\"misdirected charity ( or careless expenditure).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"43. Charity, enjoyment, and destruction are the three\",\"end\":\"space\"},{\"n\":2,\"text\":\"courses by which wealth passes away. He who neither gives\",\"end\":\"space\"},{\"n\":3,\"text\":\"nor enjoys has the third course ( left for his wealth ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"44. A jewel polished on the grindstone, a victorious\",\"end\":\"space\"},{\"n\":2,\"text\":\"warrior wounded with weapons, an elephant emaciated on\",\"end\":\"space\"},{\"n\":3,\"text\":\"account of rutting, a river with its waters ( lit. sandy bed )\",\"end\":\"space\"},{\"n\":4,\"text\":\"shrunken in winter, the moon with an only digit remaining,\",\"end\":\"space\"},{\"n\":5,\"text\":\"a young woman become languid though amorous sports, and\",\"end\":\"space\"},{\"n\":6,\"text\":\"persons whose wealth has been bestowed on supplicants\u2014\",\"end\":\"space\"},{\"n\":7,\"text\":\"all these look graceful by their slenderness.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"45. When poor, a man longs for a handful of rice; when\",\"end\":\"space\"},{\"n\":2,\"text\":\"afterwards he is full ( of wealth ) he regards the whole earth\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 8 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"39\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"40\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"41\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"42\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"43\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"44\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"45\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
