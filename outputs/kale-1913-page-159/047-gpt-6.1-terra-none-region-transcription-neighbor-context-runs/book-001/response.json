          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"farthest corner of a forest, the night, delightful on account\",\"end\":\"space\"},{\"n\":2,\"text\":\"of the expanse of the sky being brightened up by the winter\",\"end\":\"space\"},{\"n\":3,\"text\":\"moonshine, solely intent on storing up merit.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"7. Our view (at first) was that you were we and we\",\"end\":\"space\"},{\"n\":2,\"text\":\"were you (i. e. you and we were the same, had no diverging\",\"end\":\"space\"},{\"n\":3,\"text\":\"interests); what has happened now by which you are you\",\"end\":\"space\"},{\"n\":4,\"text\":\"and we are we (i. e. you and we have had diverging\",\"end\":\"space\"},{\"n\":5,\"text\":\"interests) ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"8. What if one has a threadbare wallet or a spotless\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"white silken cloth ? What if one has only one\u2019s wife, or is\",\"end\":\"space\"},{\"n\":4,\"text\":\"surrounded by a splendid army of horses and elephants?\",\"end\":\"space\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"What if delicious food is eaten, or coarse food towards the\",\"end\":\"space\"},{\"n\":7,\"text\":\"close of the day ? What if there is not the light (of the\",\"end\":\"space\"},{\"n\":8,\"text\":\"knowledge of Brahman) manifested inside (i. e. in the heart\",\"end\":\"space\"},{\"n\":9,\"text\":\"or what if there is the glorification in which the fear of\",\"end\":\"space\"},{\"n\":10,\"text\":\"\",\"end\":\"space\"},{\"n\":11,\"text\":\"worldly existence is destroyed ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"9. When there was ignorance (in us) produced by the\",\"end\":\"space\"},{\"n\":2,\"text\":\"influence of the darkness of passion, even the whole world\",\"end\":\"space\"},{\"n\":3,\"text\":\"was then looked upon (by us) as consisting of women only;\",\"end\":\"space\"},{\"n\":4,\"text\":\"now having applied the collyrium of better judgment, our\",\"end\":\"space\"},{\"n\":5,\"text\":\"sight has been restored to its normal state and regards the\",\"end\":\"space\"},{\"n\":6,\"text\":\"whole world as Brahman.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"10. Knowledge in the case of the good does away with\",\"end\":\"space\"},{\"n\":2,\"text\":\"conceit vanity and the like; in the case of others (lit. some)\",\"end\":\"space\"},{\"n\":3,\"text\":\"it is the cause of haughtiness and vanity. A secluded place\",\"end\":\"space\"},{\"n\":4,\"text\":\"in the case of self-restraining persons leads to salvation; in\",\"end\":\"space\"},{\"n\":5,\"text\":\"the case of love-sick persons it is a further incitement to love.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"11. I consider those men to be supremely rich, who have\",\"end\":\"space\"},{\"n\":2,\"text\":\"never joined their palms overhead in token of submission, to\",\"end\":\"space\"},{\"n\":3,\"text\":\"whom a slab on some mountain is as a couch and a cave in\",\"end\":\"space\"},{\"n\":4,\"text\":\"mountain as a home, to whom the barks of trees are as\",\"end\":\"space\"},{\"n\":5,\"text\":\"raiment and the deer as friends, whose subsistence is by the\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 46 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"6\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"7\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"8\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"9\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"10\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"11\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
