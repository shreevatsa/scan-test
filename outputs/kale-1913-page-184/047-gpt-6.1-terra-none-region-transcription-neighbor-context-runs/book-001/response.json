          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"2. 121. \u0935\u093f\u0915\u0943\u0924\u093f-insult. Cf. \u0928 \u0924\u0947\u091c\u0938\u094d\u0924\u0947\u091c\u0938\u094d\u0935\u0940 \u092a\u094d\u0930\u0938\u0943\u0924\u092e\u093f\u0924\u0930\u0947\u0937\u093e\u0902 \u092a\u094d\u0930\u0938\u0939\u0924\u0947 \u0938 \u0924\u0938\u094d\u092f\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0938\u094d\u0935\u094b \u092d\u093e\u0935\u0903 \u092a\u094d\u0930\u0915\u0943\u0924\u093f\u0928\u093f\u092f\u0924\u0924\u094d\u0935\u093e\u0926\u094d\u0927\u093f \u0915\u0943\u0924\u0915\u0903 \u0964 \u092e\u092f\u0942\u0916\u0948\u0930\u094d\u092f\u0938\u094d\u0924\u092a\u094d\u0924\u0902 \u0924\u092a\u0924\u093f \u092f\u0926\u093f \u0926\u0947\u0935\u094b \u0926\u093f\u0928\u0915\u0930\u0903\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0915\u093f\u092e\u0917\u094d\u0928\u0947\u092f\u0917\u094d\u0930\u093e\u0935\u093e \u0928\u093f\u0915\u0943\u0924 \u0907\u0935 \u0924\u0947\u091c\u093e\u0902\u0938\u093f \u0935\u092e\u0924\u093f \u0965 Utt. VI. 14; also \u092a\u0941\u0930\u0903\u0938\u0930\u093e\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0927\u093e\u092e\u0935\u0924\u093e\u0902 \u092f\u0936\u094b\u0927\u0928\u093e\u0903 \u0938\u0941\u0926\u0941\u0903\u0938\u0939\u0902 \u092a\u094d\u0930\u093e\u092a\u094d\u092f \u0928\u093f\u0915\u093e\u0930\u092e\u0940\u0926\u0943\u0936\u092e\u094d \u0964 \u092d\u0935\u0926\u094d\u0935\u093f\u0927\u093e\u0936\u094d\u091b\u0947\u0926\u0927\u0943\u0924\u093f\u0935\u094d\u0930\u0924\u0948 \u0930\u0924\u093f\u0902\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0928\u093f\u0930\u093e\u0936\u094d\u0930\u092f\u093e \u0939\u0928\u094d\u0924 \u0939\u0924\u093e \u092e\u0928\u0938\u094d\u0935\u093f\u0924\u093e \u0965 Kir. I. 43, where \u0928\u093f\u0915\u093e\u0930 is the same as\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u0928\u093f\u0915\u0943\u0924\u093f. Cf. also III. 44. \u0935\u093f\u0915\u0943\u0924\u093f V. l. which nearly means the\",\"end\":\"space\"},{\"n\":7,\"text\":\"same thing. It properly means \u2018change, agitation;\u2019 hence what\",\"end\":\"space\"},{\"n\":8,\"text\":\"causes such agitation, offence, injury. Fig. \u0926\u0943\u0937\u094d\u091f\u093e\u0928\u094d\u0924.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several words in the Sanskrit quotations are difficult to distinguish.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"Sl. 38. \u092e\u0926\u092e\u0932\u093f\u0928\u2014\u092e\u0926\u0947\u0928 \u092e\u0932\u093f\u0928\u0947 \u0915\u092a\u094b\u0932\u092d\u093f\u0924\u094d\u0924\u0940 \u092f\u0947\u0937\u093e\u0902 \u0924\u0947\u0937\u0941 \u0964 \u092a\u094d\u0930\u0936\u0938\u094d\u0924\u094c \u0915\u092a\u094b\u0932\u094c\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0915\u092a\u094b\u0932\u092d\u093f\u0924\u094d\u0924\u0940 ( wall-like ), excellent cheeks; the excellence consist-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"ing in their breadth or massiveness. \u2018 \u092e\u0924\u093e\u0919\u094d\u0917\u0915\u094b\u0924\u094d\u0924\u092e\u093e\u0919\u094d\u0917\u093e\u0903 \u0938\u094d\u092f\u0941\u0903 \u092a\u094d\u0930\u0915\u093e\u0923\u094d\u0921-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"\u0938\u094d\u0925\u0932\u092d\u093f\u0924\u094d\u0924\u092f\u0903 \u2019 Ganaratnamahodadhi quoted by Malli. in his com. on\",\"end\":\"space\"},{\"n\":6,\"text\":\"Rag. V. 43. Or this may mean \u2018 the temples and cheeks.\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u092d\u093f\u0924\u094d\u0924\u093f properly means a wall, fr. \u092d\u093f\u0926\u094d to separate; a wall separates\",\"end\":\"space\"},{\"n\":8,\"text\":\"two rooms; hence any thing that separates, distinguishes ( used\",\"end\":\"space\"},{\"n\":9,\"text\":\"at the end of a Karm. Comp. ). \u092a\u094d\u0930\u0915\u0943\u0924\u093f\u2014\u2018 nature,\u2019 a permanent\",\"end\":\"space\"},{\"n\":10,\"text\":\"trait in one\u2019s character; opp. to \u0935\u093f\u0915\u0943\u0924\u093f. Comp. sl. 52, last line.\",\"end\":\"space\"},{\"n\":11,\"text\":\"For the idea comp. K\u00e2lid\u00e2sa\u2014\u0924\u0947\u091c\u0938\u093e\u0902 \u0939\u093f \u0928 \u0935\u092f\u0903 \u0938\u092e\u0940\u0915\u094d\u0937\u094d\u092f\u0924\u0947 Rag. XI.\",\"end\":\"space\"},{\"n\":12,\"text\":\"1. and \u0924\u0947\u091c\u0938\u093e \u0938\u0939 \u091c\u093e\u0924\u093e\u0928\u093e\u0902 \u0935\u092f\u0903 \u0915\u0941\u0924\u094d\u0930\u094b\u092a\u092f\u0941\u091c\u094d\u092f\u0924\u0947 \u0964\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation on lines 4\u20135 is indistinct; line 1 contains only a stray mark from the following line.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 39. \u091c\u093e\u0924\u093f\u0930\u094d\u092f\u093e\u0924\u0941 &c.\u2014The idea of the sl. is that all these\",\"end\":\"space\"},{\"n\":2,\"text\":\"qualities sink into utter insignificance when compared to mo-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"ney. If one has money these are nothing to him. Comp. sl. 41.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0930\u0938\u093e\u0924\u0932\u0902\u2014one of the seven regions below the earth. These are\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0905\u0924\u0932, \u0935\u093f\u0924\u0932, \u0938\u0941\u0924\u0932, \u0930\u0938\u093e\u0924\u0932, \u0924\u0932\u093e\u0924\u0932, \u092e\u0939\u093e\u0924\u0932 and \u092a\u093e\u0924\u093e\u0932. \u0936\u0940\u0932\u2014Vir-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"tuous conduct, character. It is a word of constant occurrence\",\"end\":\"space\"},{\"n\":7,\"text\":\"in Bhar.; cf. Slokas 13, 42, 82, 109 &c. \u0905\u092d\u093f\u091c\u0928\u0903\u2014nobility of\",\"end\":\"space\"},{\"n\":8,\"text\":\"birth. Cf. M\u00e2l. M\u00e2d. II. 13. S\u2019ak IV. 18. \u0936\u094c\u0930\u094d\u092f\u0902 \u0935\u0948\u0930\u093f\u0923\u093f\u2014Bravery\",\"end\":\"space\"},{\"n\":9,\"text\":\"is said here to be an enemy as it often proves an obstacle to\",\"end\":\"space\"},{\"n\":10,\"text\":\"earning money. A brave man can never stoop to such mean\",\"end\":\"space\"},{\"n\":11,\"text\":\"acts as it sometimes becomes necessary for a seeker of wealth to\",\"end\":\"space\"},{\"n\":12,\"text\":\"perform. \u092f\u0947\u0928\u0948\u0915\u0947\u0928 &c.\u2014This explains why wealth is desired at\",\"end\":\"space\"},{\"n\":13,\"text\":\"the cost of \u091c\u093e\u0924\u093f &c., and so the fig. is Kavyalinga.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 40. \u0907\u0928\u094d\u0926\u094d\u0930\u093f\u092f\u093e\u0923\u093f\u2014\u0907\u0928\u094d\u0926\u094d\u0930\u093f\u092f is peculiarly derived by P\u00e2n. ( V. 2.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 19 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"38\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"39\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"40\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
