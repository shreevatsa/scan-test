{
 "regions": [
  {
   "id": "r2",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "MISCELLANEOUS.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अकिंचनस्य दान्तस्य शान्तस्य समचेतसः ॥",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सदा संतुष्टमनसः सर्वाः सुखमया दिशः ॥ १ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अनावर्ती कालो व्रजति स वृथा तन्न गणितं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "दशास्तास्ताः सोढा व्यसनशतसंपातविधुराः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "कियद्वा वक्ष्यामः किमिव बत नात्मन्यपकृतं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "त्वया यावत्तावत्पुनरपि तदेव व्यवसितम् ॥ २ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अभिमतमहामानग्रन्थिप्रभेदपटीयसी",
     "end": "line"
    },
    {
     "n": 2,
     "text": "गुरुतरगुणग्रामाम्भोजस्फुटोज्ज्वलचन्द्रिका ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "विपुलविलसल्लज्जावल्लीविदारकुठारिका",
     "end": "line"
    },
    {
     "n": 4,
     "text": "जठरपिठरी दुःपूरेयं करोति विडम्बनम् ॥ ३ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अश्नीमहि वयं भिक्षामाशावासो वसीमहि ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "शयीमहि महीपृष्ठे कुर्वीमहि किमीश्वरैः ॥ ४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "उत्तिष्ठ क्षणमेकमुद्वह गुरुं दारिद्र्यभारं सखे",
     "end": "line"
    },
    {
     "n": 2,
     "text": "श्रान्तस्तावदहं चिरं मरणजं सेवे त्वदीयं सुखम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इत्युक्तो धनवर्जितेन सहसा गत्वा श्मशाने शवो",
     "end": "line"
    },
    {
     "n": 4,
     "text": "दारिद्र्यान्मरणं वरं वरमिति ज्ञात्वैव तूष्णीं स्थितः ॥ ५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
