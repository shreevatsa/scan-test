        {
          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u0909\u0926\u094d\u092f\u092e\u0902 \u092c\u093f\u092d\u094d\u0930\u0924\u0940\u0924\u093f; \u0938\u094b\u092a\u092e\u093e \u0907\u0924\u094d\u092f\u0930\u094d\u0925\u0903 \u0964 \u0938\u094d\u0935\u093e\u0930\u094d\u0925\u093e\u0935\u093f\u0930\u094b\u0927\u0947\u0928\u2014\u0935\u093f\u0930\u094b\u0927\u0938\u094d\u092f\u093e\u092d\u093e\u0935\u0903 \u0905\u0935\u093f\u0930\u094b\u0927\u0903;\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0938\u094d\u0935\u093e\u0930\u094d\u0925\u0947\u0928 \u0905\u0935\u093f\u0930\u094b\u0927\u0903, \u0924\u0947\u0928 i. e. without sacrificing their own good.\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0938\u094d\u0935\u093e\u0930\u094d\u0925\u093e\u092f\u2014i. e. \u0938\u094d\u0935\u093e\u0930\u094d\u0925\u0902 \u0938\u093e\u0927\u092f\u093f\u0924\u0941\u092e\u094d. See note on \u0939\u093f\u0924\u093e\u092f sl. 72.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit characters are unclear.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 75. \u092a\u0941\u0930\u093e\u2014at first, i. e. before it was placed on fire. \u0924\u093e\u092a\u2014\",\"end\":\"space\"},{\"n\":2,\"text\":\"(1) heat; (2) trouble. \u0939\u093f\u2014\u0905\u0935\u0927\u093e\u0930\u0923\u0947 Mark!; or, surely, verily.\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0909\u0928\u094d\u092e\u0928\u0938\u094d\u2014eager. \u0924\u0947\u0928 \u091c\u0932\u0947\u0928 \u092f\u0941\u0915\u094d\u0924\u092e\u094d\u2014reunited with the same water.\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0936\u093e\u092e\u094d\u092f\u0924\u093f\u2014becomes calm, settles down. The stanza draws a very\",\"end\":\"space\"},{\"n\":5,\"text\":\"nice moral lesson from a common occurrence in the kitchen. The\",\"end\":\"space\"},{\"n\":6,\"text\":\"milk on being well heated begins to boil over; but if water is added\",\"end\":\"space\"},{\"n\":7,\"text\":\"to it, it settles down. The fig.s are \u0915\u094d\u0930\u093f\u092f\u093e\u0938\u094d\u0935\u0930\u0942\u092a\u094b\u0924\u094d\u092a\u094d\u0930\u0947\u0915\u094d\u0937\u093e supported by\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0905\u0930\u094d\u0925\u093e\u0928\u094d\u0924\u0930\u0928\u094d\u092f\u093e\u0938.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit figure name and some inflections are difficult to read.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 76. \u0907\u0924\u0903\u2014when repeated this has the sense of here-there,\",\"end\":\"space\"},{\"n\":2,\"text\":\"in one place, in another \u0915\u0947\u0936\u0935 or \u0935\u093f\u0937\u094d\u0923\u0941 is called \u091c\u0932\u0936\u093e\u092f\u0940 ( Amara )\",\"end\":\"space\"},{\"n\":3,\"text\":\"and \u0915\u094d\u0937\u0940\u0930\u093e\u092c\u094d\u0927\u093f\u0928\u093f\u0935\u093e\u0938\u0940. \u0915\u0941\u0932\u0902-family, a host of ( \u0938\u091c\u093e\u0924\u0940\u092f\u0948\u0903 \u0915\u0941\u0932\u092e\u094d ). \u0924\u0926\u0940\u092f-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"\u0926\u094d\u0935\u093f\u0937\u093e\u092e\u094d\u2014Of Kes'ava\u2019s enemies, the demons. For the account of\",\"end\":\"space\"},{\"n\":5,\"text\":\"the K\u00e2lakeyas hiding themselves in the sea, see Mah. Bhar. Van.\",\"end\":\"space\"},{\"n\":6,\"text\":\"P. 101, 105. \u0936\u0930\u0923\u093e\u0930\u094d\u0925\u093f\u0928\u0903 &c.\u2014chains of mountains seeking shelter\",\"end\":\"space\"},{\"n\":7,\"text\":\"( scil. from the wrath of Indra ). See notes on sl. 36. Comp.\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u092a\u0915\u094d\u0937\u091a\u094d\u091b\u093f\u0926\u093e \u0917\u094b\u0924\u094d\u0930\u092d\u093f\u0926\u093e\u0924\u094d\u0924\u0917\u0928\u094d\u0927\u093e\u0903 \u0936\u0930\u0923\u094d\u092f\u092e\u0947\u0928\u0902 \u0936\u0924\u0936\u094b \u092e\u0939\u0940\u0927\u094d\u0930\u093e\u0903 \u0964 \u0928\u0943\u092a\u093e \u0907\u0935\u094b\u092a\u092a\u094d\u0932\u0935\u093f\u0928\u0903 \u092a\u0930\u0947\u092d\u094d\u092f\u094b\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u0927\u0930\u094d\u092e\u094b\u0924\u094d\u0924\u0930\u0902 \u092e\u0927\u094d\u092f\u092e\u092e\u093e\u0936\u094d\u0930\u092f\u0928\u094d\u0924\u0947 \u0965 According to the Hariv. Main\u00e2ka appears\",\"end\":\"space\"},{\"n\":10,\"text\":\"to be the only mountain that took refuge in the sea. The poets\",\"end\":\"space\"},{\"n\":11,\"text\":\"speak of more mountains as having taken refuge probably only\",\"end\":\"space\"},{\"n\":12,\"text\":\"to magnify the greatness of the sea. \u0938\u0902\u0935\u0930\u094d\u0924\u0915\u0948\u0903\u2014with the fires that\",\"end\":\"space\"},{\"n\":13,\"text\":\"destroy the world at the end of the creation. The commentator\",\"end\":\"space\"},{\"n\":14,\"text\":\"R\u00e2marshi gives to this word the sense \u0938\u0915\u0932\u091c\u0932\u091a\u0930\u091c\u0940\u0935\u0935\u093f\u0936\u0947\u0937, in\",\"end\":\"space\"},{\"n\":15,\"text\":\"addition, but this is quite obscure. \u0938\u0902\u0935\u0930\u094d\u0924 is also a particular\",\"end\":\"space\"},{\"n\":16,\"text\":\"cloud though it is not intended here. For \u0935\u0921\u0935\u093e\u0928\u0932 see Matsya\",\"end\":\"space\"},{\"n\":17,\"text\":\"Pur\u00e2\u1e47a CLXXIV. 49. et. seq. and Mis. sl. 9. \u092d\u0930\u0966\u2014\u0938\u0939\u0924\u0947 \u0907\u0924\u093f \u0938\u0939\u0902\",\"end\":\"space\"},{\"n\":18,\"text\":\"\u092d\u0930\u0938\u094d\u092f \u0938\u0939\u0902 \u092d\u0930\u0966 able to bear a great load, mighty. This may be\",\"end\":\"space\"},{\"n\":19,\"text\":\"looked upon as an instance of \u0905\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924\u092a\u094d\u0930\u0936\u0902\u0938\u093e the \u0905\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 not being\",\"end\":\"space\"},{\"n\":20,\"text\":\"directly mentioned.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words, especially in the quoted verse and grammatical explanation, are unclear.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 77. In line 3 the Nirnayas\u00e2gar Edition reads \u092a\u094d\u0930\u0939\u094d\u0935\u093e\u092f\u092f\",\"end\":\"space\"},{\"n\":2,\"text\":\"for \u092a\u094d\u0930\u091a\u094d\u091b\u093e\u0926\u092f which will suit only with the reading \u092a\u094d\u0930\u0936\u094d\u0930\u092f\u092e\u094d for\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit variant readings are difficult to discern.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 30 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"75\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"76\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"77\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
        }
      ],
