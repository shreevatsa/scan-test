{
 "regions": {
  "r3": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "धीराणां न कदाचिदपि संतापो जायते इत्याह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "छिन्नोऽपि रोहति तरुः क्षीणोऽप्युपचीयते पुनश्चन्द्रः ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "इति विमृशन्तः सन्तः संतप्यन्ते न विप्लुता लोके ॥ ८९ ॥[*]",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Small superscript variant markers are not reliably legible."
  },
  "r5": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "क्षीणः कृष्णपक्षे क्रमशः कलाहीनोऽपि उपचीयते वर्धते । लोके इति विमृ-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "शन्तो विचारयन्तः सन्तः विप्लुता आपदभिभूता अपि । आर्या छन्दः ।",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r6": {
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "अथ दैवपद्धतिः—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "नेता यस्य बृहस्पतिः प्रहरणं वज्रं सुराः सैनिकाः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "",
     "end": "line"
    },
    {
     "n": 3,
     "text": "स्वर्गो दुर्गमनुग्रहः खलु हरेरैरावतो वारणः ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "इत्यैश्वर्यबलान्वितोऽपि बलभिद्भग्नः परैः संगरे",
     "end": "line"
    },
    {
     "n": 5,
     "text": "तद्व्यक्तं ननु दैवमेव शरणं धिग्धिग्वृथा पौरुषम् ॥ ९० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Small superscript variant markers are not reliably legible."
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "बृहतां वाचां पतिः बृहस्पतिः । ( श्लो. ३४ द्रष्टव्यः । ) । हरेः सर्वदेवाधी-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "शस्य । न तु कस्यचित्क्षुद्रदेवस्य । बलभिदिन्द्रः । भग्नः पराजितः । ततस्तस्मात् ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "पौरुषं पुरुषस्य कर्म । हायनान्तयुवादिभ्योऽण् इत्यण् । पुरुषकारं धिग्धिक् ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "नित्यवीप्सयोरित्याभीक्ष्ण्ये द्विरुक्तिः । यतः वृथा व्यर्थं तत् । शार्दूलवि० वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small commentary characters are difficult to distinguish."
  },
  "r9": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अधुना नराणां वृद्धिक्षययोर्दैवमेव कारणमित्याह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r10": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "भग्नाशस्य करण्डपीडिततनोर्म्लानेन्द्रियस्य क्षुधा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "कृत्वाखुर्विवरं स्वयं निपतितो नक्तं मुखे भोगिनः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तृप्तस्तत्पिशितेन सत्वरमसौ तेनैव यातः पथा",
     "end": "line"
    },
    {
     "n": 4,
     "text": "लोकाः पश्यत दैवमेव हि नृणां वृद्धौ क्षये कारणम् ॥९१॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Small superscript variant markers are not reliably legible."
  },
  "r11": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "नक्तं रात्रौ आखुर्मूषकः विवरं बिलं । करण्डे इत्यर्थः । कृत्वा । भग्ना मुक्तिं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "प्रति आशा यस्य तस्य । करण्डे पीडिता प्रसरणाभावात्तनुर्यस्य । क्षुधा बुभु-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "क्षया म्लानानि इन्द्रियाणि यस्य । तस्य भोगिनः सर्पस्य मुखे पतितः । असौ",
     "end": "space"
    },
    {
     "n": 4,
     "text": "सर्पस्तस्याखोः पिशितेन मांसेन तृप्तस्तेनैव पथा बिलद्वारेण । पश्यतेति—अतो",
     "end": "space"
    },
    {
     "n": 5,
     "text": "हानौ वृद्धौ वा शोक आनन्दो वा न कार्य इत्यर्थः । शार्दूल० वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small commentary characters are difficult to distinguish."
  },
  "r12": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "एवं सत्यपि धीमतोद्योगः कर्तव्य एवे camerasत्याह—",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The compound around धीमतोद्योगः is closely printed."
  },
  "r13": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "कर्मायत्तं फलं पुंसां बुद्धिः कर्मानुसारिणी ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "तथापि सुधिया भाव्यं सुविचार्यैव कुर्वता ॥ ९२ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r14": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ चन्द्रः क्षीणोऽपि वर्धते पुनः.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r15": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "२ ते विपदा.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
