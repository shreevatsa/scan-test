  "r22": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "* अस्मात्परमयं श्लोकः पुस्तकान्तरे—",
     "end": "space"
    },
    {
     "n": 2,
     "text": "नापेक्षन्ते न पात्राणि न स्नेहं न दशान्तरम् । सदालोकहिता एका रत्नदीपा इवोत्तमाः ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The first word of the verse is crowded and partly obscured."
  },
