{
 "regions": [
  {
   "id": "r3",
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "नितरामत्यन्तं कुपितो विधाता हंसस्य । अम्भोजिनीनां वनमम्भोजिनीवनं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "तत्र निवास एव विलासस्तमपहन्ति । न त्वसौ अस्य हंसस्य दुग्धं च जलं च",
     "end": "space"
    },
    {
     "n": 3,
     "text": "दुग्धजले तयोर्भेदविधौ भेदविषये प्रसिद्धां । वैदग्ध्येन जनिता कीर्तिः वैदग्ध्यकी-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "र्तिस्तामपहर्तुं समर्थः । एवं कुपितो राजा विदुषः स्वविषयाद्विवासयेत्केवलं",
     "end": "space"
    },
    {
     "n": 5,
     "text": "न तु तेषामनेकविद्यापरिशीलनोत्पन्नचातुरीकीर्तिहरणे प्रभवेदिति भावः ।",
     "end": "space"
    },
    {
     "n": 6,
     "text": "वसन्ततिलका छन्दः ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "केयूरा न[१] विभूषयन्ति पुरुषं हारा न चन्द्रोज्ज्वला",
     "end": "line"
    },
    {
     "n": 2,
     "text": "न स्नानं न विलेपनं न कुसुमं नालंकृता मूर्धजाः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "वाण्येका समलंकरोति पुरुषं या संस्कृता धार्यते",
     "end": "line"
    },
    {
     "n": 4,
     "text": "क्षीयन्ते खलु[२] भूषणानि सततं वाग्भूषणं भूषणम् ॥ १९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "के बाहुशिखरे यौतीति केयूरः । केयूरा अङ्गदाः पुरुषं न विभूषयन्ति ।",
     "end": "space"
    },
    {
     "n": 2,
     "text": "चन्द्रवदुज्ज्वला हाराः मुक्ताहारा अपि न । संस्कृता व्याकरणशुद्ध्याद्यलंकृता ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "क्षीयन्ते कालगत्या नश्यन्ति । सततं नित्यमनपायि इत्यर्थः । शार्दूलविक्रीडितं",
     "end": "space"
    },
    {
     "n": 4,
     "text": "वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "विद्या नाम नरस्य रूपमधिकं प्रच्छन्नगुप्तं धनं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "विद्या भोगकरी यशःसुखकरी विद्या गुरूणां गुरुः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "विद्या बन्धुजनो विदेशगमने विद्या परा[३] देवता",
     "end": "line"
    },
    {
     "n": 4,
     "text": "विद्या राजसु पूजिता[४] न तु धनं विद्याविहीनः पशुः ॥२०॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "रूपं स्वाभाविकमाकारसौष्ठवम् । तदुक्तं भावप्रकाशे-अवेध्यारोप्यविक्षेप्यबन्ध-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "नयैरभूषितम् । यद्भूषितमिवाभाति तद्रूपमिति कथ्यते ॥ इति । विद्या नाम ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "नाम प्राकाश्ये अभ्युपगमे वा । अधिकं श्रेष्ठम् । उक्तलक्षणादधिकं लोक-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "रञ्जकत्वात् । प्रच्छन्नं यथा तथा गुप्तं रक्षितं धनम् । भोगान्करोतीति",
     "end": "space"
    },
    {
     "n": 5,
     "text": "भोगकरी । यशश्च सुखश्च यशःसुखे ते करोतीति । उभयत्र कृञो हेतुताच्छील्या-",
     "end": "hyphen"
    },
    {
     "n": 6,
     "text": "नुलोम्येषु ( ३. २. २० ) इति टः टित्वान्ङीप् च । गुरूणामुपदेष्टॄणामपि",
     "end": "space"
    },
    {
     "n": 7,
     "text": "उपदेष्टृत्वाद्गुरुः । यद्वा श्रेष्ठानामपि श्रेष्ठा । यद्वा गृणाति हितमुपदिशतीति व्युत्पत्त्या",
     "end": "space"
    },
    {
     "n": 8,
     "text": "गुरुर्हिततमा । अत्र विद्याया रूपधनाद्याकारेण बहुधा निरूपणान्मालारूपकमलं-",
     "end": "hyphen"
    },
    {
     "n": 9,
     "text": "कारः । वृत्तं पूर्वोक्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
