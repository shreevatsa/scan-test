          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"in its natural case. \u0938\u0941\u0927\u093e\u0938\u094d\u092f\u0928\u094d\u0926\u093f\u092d\u093f\u0903\u2014shedding nectar, mellifluous.\",\"end\":\"space\"},{\"n\":2,\"text\":\"The root is sometimes used transitively. Cf. \u0939\u093e\u0932\u093e\u0939\u0932\u0902 \u0916\u0932\u0941 \u092a\u093f\u092a\u093e\u0938\u0924\u093f\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0915\u094c\u0924\u0941\u0915\u093e\u0924\u094d\u0915\u093e\u0932\u093e\u0928\u0932\u0902 \u092a\u0930\u093f\u091a\u0941\u091a\u0941\u092e\u094d\u092c\u093f\u0937\u0924\u093f \u092a\u094d\u0930\u0915\u093e\u092e\u092e\u094d \u0964 \u0935\u094d\u092f\u093e\u0932\u093e\u0927\u093f\u092a\u0902 \u091a \u092f\u0924\u0924\u0947 \u092a\u0930\u093f\u0930\u092c\u094d\u0927\u0941\u092e\u0938\u094c\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u092f\u094b \u0926\u0941\u0930\u094d\u091c\u0928\u0902 \u0935\u0936\u092f\u093f\u0924\u0941\u0902 \u0915\u0941\u0930\u0941\u0924\u0947 \u092e\u0928\u0940\u0937\u093e\u092e\u094d \u0964 Bh\u00e2. Vil. I 93; also 96. where the\",\"end\":\"space\"},{\"n\":5,\"text\":\"idea is somewhat differently expressed.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words are indistinct.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"The rhetorical fig. here is Nidars'an\u00e0 ( \u092e\u093e\u0932\u093e\u0928\u093f\u0926\u0966 ) which is\",\"end\":\"space\"},{\"n\":2,\"text\":\"defined as- \u0928\u093f\u0926\u0930\u094d\u0936\u0928\u093e \u0964 \u2018\u0905\u0938\u092e\u094d\u092c\u0928\u094d\u0927\u0938\u094d\u0924\u0941 \u0938\u092e\u094d\u092c\u0928\u094d\u0927 \u0909\u092a\u092e\u093e\u092a\u0930\u093f\u0915\u0932\u094d\u092a\u0915\u0903 \u0965 when an\",\"end\":\"space\"},{\"n\":3,\"text\":\"impossible connection of things implies a comparison it is\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0928\u093f\u0926\u0930\u094d\u0936\u0928\u0902 \u0926\u0943\u0937\u094d\u091f\u093e\u0928\u094d\u0924\u0915\u0930\u0923\u092e\u094d ( citing of an instance ). We have here a\",\"end\":\"space\"},{\"n\":5,\"text\":\"M'ala'nidars'ana' ( a string of illustrations ) as the upama'nas or\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u2018things compared to\u2019 are many.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit definition and transliteration diacritics are indistinct.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 7. \u0938\u094d\u0935\u093e\u092f\u0924\u094d\u0924\u092e\u094d\u2013at one's command, within one's control.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u090f\u0915\u093e\u0928\u094d\u0924\u0917\u0941\u0923\u0902\u2013\u090f\u0915\u093e\u0928\u094d\u0924\u0903 always leading to one result; hence, never\",\"end\":\"space\"},{\"n\":3,\"text\":\"failing in its effect. With this sense cf. \u2018\u090f\u0915\u093e\u0928\u094d\u0924\u0935\u093f\u0927\u094d\u0935\u0902\u0938\u093f\u0937\u0941 \u092e\u0926\u094d\u0935\u093f\u0927\u093e\u0928\u093e\u0902\u2019\",\"end\":\"space\"},{\"n\":4,\"text\":\"Rag. II. 57. \u0917\u0941\u0923\u2014efficacy, advantage. \u0905\u092a\u0923\u094d\u0921\u093f\u0924\u093e\u0903\u2014\u092a\u0923\u094d\u0921\u093e acute\",\"end\":\"space\"},{\"n\":5,\"text\":\"intellect, learning; see com.; Nan. Tat.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words are unclear.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 8. \u0915\u093f\u0902\u091a\u093f\u091c\u094d\u091c\u094d\u091e\u0903\u2014Knowing a little. cf. \u091c\u094d\u091e\u093e\u0928\u0932\u0935\u0966 sl. 3. supra; Mr.\",\"end\":\"space\"},{\"n\":2,\"text\":\"Telang separates \u092f\u0926\u093e \u0905\u0915\u093f\u0902\u091a\u093f\u091c\u094d\u091c\u094d\u091e\u0903 to mark distinctly, as he says,\",\"end\":\"space\"},{\"n\":3,\"text\":\"the contrast with the third line. But this hardly improves the\",\"end\":\"space\"},{\"n\":4,\"text\":\"sense. A man is likely to be puffed up with little knowledge,\",\"end\":\"space\"},{\"n\":5,\"text\":\"not with great knowledge. \u0926\u094d\u0935\u093f\u092a\u2013\u0926\u094d\u0935\u093e\u092d\u094d\u092f\u093e\u0902 with two ( i. e. the mouth\",\"end\":\"space\"},{\"n\":6,\"text\":\"and the trunk ). \u092a\u093f\u092c\u0924\u0940\u0924\u093f\u2014an elephant. \u0915\u093f\u0902\u091a\u093f\u0924\u094d\u0915\u093f\u0902\u091a\u093f\u0924\u094d\u2014When I\",\"end\":\"space\"},{\"n\":7,\"text\":\"knew something ( of reality ) every day. The repetition of\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0915\u093f\u0902\u091a\u093f\u0924\u094d shows continuous increase of knowledge, the continuity\",\"end\":\"space\"},{\"n\":9,\"text\":\"of action being one of the senses of \u0935\u0940\u092a\u094d\u0938\u093e or repetition. \u092e\u0926 \u2014\",\"end\":\"space\"},{\"n\":10,\"text\":\"mark the double meaning of this word here; ( 1 ) rut, ( 2 )\",\"end\":\"space\"},{\"n\":11,\"text\":\"vanity, arrogance.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit forms are indistinct.\"},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 9. \u0915\u0943\u092e\u093f\u0966\u2014Covered with, or full of a swarm of insects.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0935\u093f\u0917\u0928\u094d\u0927\u093f\u2014giving out a bad stench. This is grammatically\",\"end\":\"space\"},{\"n\":3,\"text\":\"inaccurate. \u0935\u093f\u0930\u0941\u0926\u094d\u0927\u0903 \u0917\u0928\u094d\u0927\u0903 \u0905\u0938\u094d\u092f gives \u0935\u093f\u0917\u0928\u094d\u0927\u092e\u094d. So to explain the\",\"end\":\"space\"},{\"n\":4,\"text\":\"form we must add \u0907\u0928\u094d \u092e\u0924\u094d\u0935\u0930\u094d\u0925\u0947; \u0935\u093f\u0930\u0941\u0926\u094d\u0927\u0903 \u0917\u0928\u094d\u0927\u0903 \u0935\u093f\u0917\u0928\u094d\u0927\u0903 Karm. \u0938\u094b\u093d\u0938\u094d\u092f\u093e\u0938\u094d\u0924\u093f.\",\"end\":\"space\"},{\"n\":5,\"text\":\"But this is against the rule \u0928 \u0915\u0930\u094d\u092e\u0927\u093e\u0930\u092f\u093e\u0928\u094d\u092e\u0924\u094d\u0935\u0930\u094d\u0925\u0940\u092f\u094b \u092c\u0939\u0941\u0935\u094d\u0930\u0940\u0939\u093f\u0936\u094d\u091a\u0947\u0924\u094d\u0924\u0926\u0930\u094d\u0925\u0902\",\"end\":\"space\"},{\"n\":6,\"text\":\"\u092a\u094d\u0930\u0924\u093f\u092a\u0924\u094d\u0924\u093f\u0915\u0930\u0903 \u0964 No affix showing possession should be added to a\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit grammatical rule is difficult to read.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 6 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"6\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\",\"r3\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"7\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"8\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"9\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
