          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"sweet fruits of trees, who find an agreeable beverage in\",\"end\":\"space\"},{\"n\":2,\"text\":\"spring water, and to whom learning is as a pleasure-giving\",\"end\":\"space\"},{\"n\":3,\"text\":\"consort.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"12. When there is the river of the three worlds, the lustre\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"of whose waist garment touches the head of S'iva, and which\",\"end\":\"space\"},{\"n\":5,\"text\":\"with good fruits and with the barks of the trees lining\",\"end\":\"space\"},{\"n\":6,\"text\":\"its bank furnishes a splendid living, what wise man is there,\",\"end\":\"space\"},{\"n\":7,\"text\":\"who, with the intense pain from the fever of poverty, would\",\"end\":\"space\"},{\"n\":8,\"text\":\"face harrowing miseries, if he had no commiseration for his\",\"end\":\"space\"},{\"n\":9,\"text\":\"ill-placed family ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"13. Alas ! why do wise men live elsewhere, rejecting\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"K\u00e2s'i where the most rigorous penance (a life of entire absti-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"nence ) is (like) varied dinners given in gardens, where a\",\"end\":\"space\"},{\"n\":5,\"text\":\"strip of cloth to cover (the body ) is decent raiment, where\",\"end\":\"space\"},{\"n\":6,\"text\":\"the glory is an unlimited wandering for alms, and where\",\"end\":\"space\"},{\"n\":7,\"text\":\"approaching death is like a blessing.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"14. Oh heart, leave those at whose gate (are heard) such\",\"end\":\"space\"},{\"n\":2,\"text\":\"replies as \u201cthis is not the time for you ( to see the master ),\u201d\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u201c( he is ) now in private,\u201d \u201c the master is asleep and \u201c if\",\"end\":\"space\"},{\"n\":4,\"text\":\"you were to see him after waiting he would get angry\u201d; and\",\"end\":\"space\"},{\"n\":5,\"text\":\"do you go to the temple of the Lord, the ruler of the world,\",\"end\":\"space\"},{\"n\":6,\"text\":\"which gives unbounded happiness, which is free from harsh-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"ness, and where the cruel words of gatekeepers are not heard.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"15. May my days pass in some sacred forest, while mut-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"tering the words \u201cS'iva, S'iva, S'iva\u201d with an eye regarding\",\"end\":\"space\"},{\"n\":3,\"text\":\"equally a serpent or a wreath, a powerful enemy or a friend,\",\"end\":\"space\"},{\"n\":4,\"text\":\"a gem or a clod of earth, a bed of flowers or a stone, a blade\",\"end\":\"space\"},{\"n\":5,\"text\":\"of grass or a group of damsels.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"16 Every thing gives happiness ( lit. all directions are\",\"end\":\"space\"},{\"n\":2,\"text\":\"full of happiness ) to a man who is poor, self-restrained,\",\"end\":\"space\"},{\"n\":3,\"text\":\"peaceful, of an equilibrating mind, and ever content at heart.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"17. Time never returns; it passes uselessly, a fact which was\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 47 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"12\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"13\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"14\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"15\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"16\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"17\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
