          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u0932\u091c\u094d\u091c\u093e\u092f\u093e \u092f\u0947 \u0917\u0941\u0923\u093e\u0903 &c. For taking \u0906\u0926\u093f understood in ( 2 ) there\",\"end\":\"space\"},{\"n\":2,\"text\":\"is no authority. ( 3 ), though not quite unacceptable, does not\",\"end\":\"space\"},{\"n\":3,\"text\":\"seem to be intended. In ( 1 ) the word \u0913\u0918 has hardly any pro-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"priety. It is, therefore, better to take it as \u0932\u091c\u094d\u091c\u093e \u091a \u0917\u0941\u0923\u094c\u0918\u0936\u094d\u091a mod-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"esty and many other qualities ( as Mr. Telang does ). \u0905\u0924\u094d\u092f\u0928\u094d\u0924\u0936\u0941\u0926\u094d\u0927-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\u0939\u0943\u0926\u092f\u093e and \u0905\u0928\u0941\u0935\u0930\u094d\u0924\u092e\u093e\u0928\u093e may also be taken with both, \u092a\u094d\u0930\u0924\u093f\u091c\u094d\u091e\u093e and\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u091c\u0928\u0928\u0940 and interpreted as ( 1 ) \u0905\u0924\u094d\u092f\u0928\u094d\u0924\u0902 \u0936\u0941\u0926\u094d\u0927\u0902 \u0939\u0943\u0926\u092f\u0902 \u092f\u0938\u094d\u092f\u093e\u0902 in which the\",\"end\":\"space\"},{\"n\":8,\"text\":\"heart, i. e. motive, is pure; (3 )...\u0939\u0943\u0926\u092f\u0902 \u092f\u0938\u094d\u092f\u093e\u0903 whose heart is pure;\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u0905\u0928\u0941\u0966\u2014( 1 ) always going with one, binding; ( 2 ) devoted or\",\"end\":\"space\"},{\"n\":10,\"text\":\"attached to, lit. always following one. \u0938\u0941\u0916\u092e\u0938\u0942\u0928\u092a\u093f-\u0938\u0941\u0916\u0902 may here\",\"end\":\"space\"},{\"n\":11,\"text\":\"be taken as a noun in the acc. ( comforts and even life ), or as an\",\"end\":\"space\"},{\"n\":12,\"text\":\"adverb, meaning \u2018 easily, willingly \u2019 ( and this is preferable\",\"end\":\"space\"},{\"n\":13,\"text\":\"being more forcible ); cf. \u0924\u094d\u092f\u091c\u0928\u094d\u0924\u094d\u092f\u0938\u0942\u0928\u0930\u094d\u0925\u0902 \u091a \u092e\u093e\u0928\u093f\u0928\u094b \u0935\u0930\u0902 \u0924\u094d\u092f\u091c\u0928\u094d\u0924\u093f \u0928\",\"end\":\"space\"},{\"n\":14,\"text\":\"\u0938\u094d\u0935\u0940\u0915\u0943\u0924\u092e\u0930\u094d\u0925\u093f\u0924\u0935\u094d\u0930\u0924\u092e\u094d \u0965 Nai. I. 56; for the former sense comp. \u0938\u094d\u0928\u0947\u0939\u0902 \u0926\u092f\u093e\u0902\",\"end\":\"space\"},{\"n\":15,\"text\":\"\u091a \u0938\u094c\u0916\u094d\u092f\u0902 \u091a \u092f\u0926\u093f \u0935\u093e \u091c\u093e\u0928\u0915\u0940\u092e\u092a\u093f \u0964 \u0906\u0930\u093e\u0927\u0928\u093e\u092f \u0932\u094b\u0915\u093e\u0928\u093e\u0902 \u092e\u0941\u091e\u094d\u091a\u0924\u094b \u0928\u093e\u0938\u094d\u0924\u093f\",\"end\":\"space\"},{\"n\":16,\"text\":\"\u092e\u0947 \u0935\u094d\u092f\u0925\u093e \u0965 Uttara. I.; for \u0938\u0924\u094d\u092f\u0935\u094d\u0930\u0924\u0935\u094d\u092f\u0938\u0928 see slokas 62, 103. The aff.\",\"end\":\"space\"},{\"n\":17,\"text\":\"\u0907\u0928\u094d is added for the metre, as a Bah. would have expressed the\",\"end\":\"space\"},{\"n\":18,\"text\":\"same sense. See. note on \u0935\u093f\u0917\u0923\u092f\u094d\u092f Sl 9. supra. Fig Upam\u0101.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit words and the quotation are difficult to read in the scan.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 7. The word \u0938\u094d\u0924\u094d\u0930\u0940\u0923\u093e\u0902, in the second line, is to be construed\",\"end\":\"space\"},{\"n\":2,\"text\":\"with each of the first three lines. \u0938\u094d\u0924\u094d\u0930\u0940\u0923\u093e\u0902 \u0939\u0943\u0926\u092f\u092e\u0917\u094d\u0930\u093e\u0939\u094d\u092f\u092e\u094d\u2014the heart of\",\"end\":\"space\"},{\"n\":3,\"text\":\"women cannot be comprehended ( lit. seized ); \u0905\u0917\u094d\u0930\u093e\u0939\u094d\u092f has a two-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"fold sense ( 1 ) not to be fathomed &c.; ( 2 ) not to be felt or\",\"end\":\"space\"},{\"n\":5,\"text\":\"touched by the hand. \u092d\u093e\u0935\u2014Real feeling, inward motive. \u2018\u092d\u093e\u0935\u094b-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0906\u0936\u092f\u0903\u2019 Y\u0101dava-kosha; see Malli. in his com. on Rag. II.\",\"end\":\"space\"},{\"n\":7,\"text\":\"26. \u0935\u093f\u0937\u092e\u0903\u2014crooked or difficult to be perceived like the narrow\",\"end\":\"space\"},{\"n\":8,\"text\":\"mountain-path. \u092a\u0941\u0937\u094d\u0915\u0930\u092a\u0932\u093e\u0936\u0924\u094b\u092f\u0924\u0930\u0932\u0902\u2014a common expression to denote\",\"end\":\"space\"},{\"n\":9,\"text\":\"unsteadiness. \u092d\u093e\u0937\u093f\u0924 is used here for \u092d\u0923\u093f\u0924 told, described.\",\"end\":\"space\"},{\"n\":10,\"text\":\"\",\"end\":\"space\"},{\"n\":11,\"text\":\"\u0928\u093e\u092e\u2014Mr. Telang takes this in the sense of\u2013verily,; it may\",\"end\":\"space\"},{\"n\":12,\"text\":\"perhaps be taken in the sense of \u092a\u094d\u0930\u093e\u0915\u093e\u0936\u094d\u092f\u2014as is well-known.\",\"end\":\"space\"},{\"n\":13,\"text\":\"Cf. \u0928\u0932\u093f\u0928\u0940\u0926\u0932\u0917\u0924\u0938\u0932\u093f\u0932\u0902 \u0924\u0930\u0932\u0902 \u0964 \u0924\u0926\u094d\u0935\u091c\u094d\u091c\u0940\u0935\u093f\u0924\u092e\u0924\u093f\u0936\u092f\u091a\u092a\u0932\u092e\u094d\u2014Mohamudgara.\",\"end\":\"space\"},{\"n\":14,\"text\":\"\u0926\u094b\u0937\u0948\u0903 \u0938\u092e\u0902 \u0935\u0930\u094d\u0927\u093f\u0924\u093e\u0903\u2014growing with the faults; i. e. as the woman\",\"end\":\"space\"},{\"n\":15,\"text\":\"grows the faults develop in her. The fig. is upam\u0101.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words are blurred, especially in lines 6, 8, 9 and 13.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 8. \u0905\u092d\u093f\u092e\u0941\u0916 &c.\u2014killed with his face towards ( not turned\",\"end\":\"space\"},{\"n\":2,\"text\":\"away from ) the enemy, or in the front line. \u2018For the idea of\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 44 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"6\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"7\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"8\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
