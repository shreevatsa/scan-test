{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "प्रायः कन्दुकपातेनोत्पतत्यार्यः पतन्नपि ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "तथा त्वनार्यः पतति मृत्पिण्डपतनं यथा ॥ १३ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "First word 'प्रायः' in line 1 is mostly cut off on the left; reconstructed from apparatus."
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यदि नाम दैवगत्या जगदसरोजं कदाचिदपि जातम् ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "अवकरनिकरं विकिरति तत्किं कृकवाकुरिव हंसः ॥ १४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यन्नागा मदभिन्नगण्डकरटास्तिष्ठन्ति निद्रालसा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "द्वारे हेमविभूषणाश्च तुरगा वल्गन्ति यद्दर्पिताः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "वीणावेणुमृदङ्गशङ्खपटहैः सुप्तस्तु यद्बोध्यते",
     "end": "line"
    },
    {
     "n": 4,
     "text": "तत्सर्वं सुरलोकदेवसदृशं धर्मस्य विस्फूर्जितम् ॥ १५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "ये संतोषसुखप्रमोदमुदितास्तेषां न भिन्ना मुदो",
     "end": "line"
    },
    {
     "n": 2,
     "text": "ये त्वन्ये धनलोभसंकुलधियस्तेषां न तृष्णा हता ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इत्थं कस्य कृते कृतः स विधिना तादृक्पदं संपदां",
     "end": "line"
    },
    {
     "n": 4,
     "text": "स्वात्मन्येव समाप्तहेममहिमा मेरुर्न मे रोचते ॥ १६ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "रक्तत्वं कमलानां सत्पुरुषाणां परोपकारित्वम् ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "असतां च निर्दयत्वं स्वभावसिद्धं त्रिषु त्रितयम् ॥ १७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "वचो हि सत्यं परमं विभूषणं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "गजाङ्गनाया कृशता तच्च ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "द्विजस्य विद्यैव पुनस्तथा क्षमा",
     "end": "line"
    },
    {
     "n": 4,
     "text": "शीलं हि सर्वस्य नरस्य भूषणम् ॥ १८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
