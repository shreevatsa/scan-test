          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"the instr. or the nom. \u0936\u093f\u0936\u0941\u0915\u0948\u0903\u2014\u0936\u093f\u0936\u0935 \u090f\u0935 \u0936\u093f\u0936\u0941\u0915\u093e\u0903 \u0964 \u0915 expresses\",\"end\":\"space\"},{\"n\":2,\"text\":\"pity. \u0935\u093f\u0927\u0941\u0930\u093e\u2014miserable ( \u0926\u0940\u0928\u093e ). derived as \u0935\u093f\u0917\u0924\u093e \u0927\u0942\u0903 \u0915\u093e\u0930\u094d\u092f\u092d\u093e\u0930\u094b \u092f\u0938\u094d\u092f\u093e\u0903\",\"end\":\"space\"},{\"n\":3,\"text\":\"Lit. having nothing to do: hence perplexed, at a loss to know\",\"end\":\"space\"},{\"n\":4,\"text\":\"what to do \u0917\u0926\u094d\u0917\u0926 &c.\u2014Avy comp. \u0926\u0917\u094d\u0927\u091c\u0920\u0930\u0938\u094d\u092f\u093e\u0930\u094d\u0925\u0947\u2014for the sake of\",\"end\":\"space\"},{\"n\":5,\"text\":\"the accursed stomach The word \u0926\u0917\u094d\u0927 is often used in the sense\",\"end\":\"space\"},{\"n\":6,\"text\":\"it has here Cf. \u0905\u0938\u094d\u092f \u0926\u0917\u094d\u0927\u094b\u0926\u0930\u0938\u094d\u092f\u093e\u0930\u094d\u0925\u0947 \u0915\u0903 \u0915\u0941\u0930\u094d\u092f\u093e\u0924\u094d\u092a\u093e\u0924\u0915\u0902 \u092e\u0939\u0924\u094d \u0964 H. 1. See\",\"end\":\"space\"},{\"n\":7,\"text\":\"notes on Nit. S'a. Sl. 99. \u092e\u0928\u0938\u094d\u0935\u0940 a high-souled person; see\",\"end\":\"space\"},{\"n\":8,\"text\":\"Nit. sl. 33.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit compounds and punctuation are difficult to distinguish.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 23. \u0905\u092d\u093f\u092e\u0924\u0966\u2014highly valued. The demands of the\",\"end\":\"space\"},{\"n\":2,\"text\":\"stomach make one completely forego all self-respect. \u0917\u0941\u0930\u0941\u0924\u0930\u2014\",\"end\":\"space\"},{\"n\":3,\"text\":\"nobler; higher \u0917\u094d\u0930\u093e\u092e\u2014a collection. \u0905\u092e\u094d\u092d\u094b\u091c\u2014the water lily that\",\"end\":\"space\"},{\"n\":4,\"text\":\"blooms at sunrise, but fades when the mooon rises Cf. \u0915\u0941\u092e\u0941\u0926\u0935\u0928-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"\u092e\u092a\u093e\u0936\u094d\u0930\u093f \u0936\u094d\u0930\u0940\u092e\u0926\u092e\u094d\u092d\u094b\u091c\u0916\u0923\u094d\u0921\u0902 S'is. XI. 64. where the sun-rise is described.\",\"end\":\"space\"},{\"n\":6,\"text\":\"The moon-light-like \u091c\u0920\u0930\u092a\u093f\u0920\u0930\u0940 makes the lotuses of virtues fade\",\"end\":\"space\"},{\"n\":7,\"text\":\"away. \u0935\u093f\u092a\u0941\u0932\u0966\u2014\u0935\u093f\u092a\u0941\u0932\u093e ( \u0935\u093f\u092a\u0941\u0932\u0902 \u092f\u0925\u093e \u0924\u0925\u093e \u0935\u093e ) \u0935\u093f\u0932\u0938\u0928\u094d\u0924\u0940 \u092f\u093e &c. \u0915\u0941\u0920\u093e\u0930\u093f\u0915\u093e\",\"end\":\"space\"},{\"n\":8,\"text\":\"a small hatchet. \u092a\u093f\u0920\u0930\u0940\u2014a pan or boiler.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation is difficult to read.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 24. \u092a\u093e\u0932\u0940\u2014the edge. \u0938\u093f\u0924 &c -The edge of which is cover-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"ed with a piece of white cloth. \u0915\u092a\u093e\u0932\u0940\u2014a broken pot. \u0928\u094d\u092f\u093e\u092f &c.\u2014\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0928\u092f\u0928\u094d\u0924\u093f \u092a\u0930\u0902 \u092a\u0926\u0902 \u092a\u094d\u0930\u093e\u092a\u092f\u0928\u094d\u0924\u093f \u0935\u093f\u0935\u0947\u0915\u093f\u0928\u094b\u093d\u092e\u0940 \u0928\u094d\u092f\u093e\u092f\u093e\u0903 \u0936\u094d\u0930\u0941\u0924\u093f\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0938\u092e\u094d\u0928\u094d\u092f\u093e\u092f\u093e\u0903 says\",\"end\":\"space\"},{\"n\":4,\"text\":\"R\u00e2marshi. The meaning here is \u2018the formul\u00e6 or systems\",\"end\":\"space\"},{\"n\":5,\"text\":\"manifested in the three Vedas\u2019; the proper method of perform-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"ing sacrifices ). So this means \u090b\u0924\u0941\u092e\u0928\u094d\u0924\u094d\u0930\u0935\u093f\u0928\u093f\u092f\u094b\u0917\u0935\u093f\u0927\u093f\u091c\u094d\u091e\u093e\u0903 Malli.\",\"end\":\"space\"},{\"n\":7,\"text\":\"commenting on Kum. II 12 says \u0928\u0940\u092f\u0928\u094d\u0924 \u090f\u092d\u093f\u0930\u0930\u094d\u0925\u0935\u093f\u0936\u0947\u0937\u093e \u0907\u0924\u093f \u0928\u094d\u092f\u093e\u092f\u093e\u0903\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0938\u094d\u0935\u0930\u093e\u0938\u094d\u0924\u0948\u0930\u0941\u0926\u093e\u0924\u094d\u0924\u093e\u0928\u0941\u0926\u093e\u0924\u094d\u0924\u0938\u094d\u0935\u0930\u093f\u0924\u0948\u0903 \u0964 This meaning will also do here\u2014the\",\"end\":\"space\"},{\"n\":9,\"text\":\"Vedas pronounced correctly with proper intonation and accent).\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u0927\u0942\u092e\u094d\u0930\u2014of a smoky colour, blackened \u0909\u092a\u0915\u0923\u094d\u0920\u092e\u094d\u2014the adjacent part.\",\"end\":\"space\"},{\"n\":11,\"text\":\"\u0926\u094d\u0935\u093e\u0930\u0902 \u0926\u094d\u0935\u093e\u0930\u0902 \u092a\u094d\u0930\u0935\u0943\u0924\u094d\u0924\u0903\u2014going to every door. \u0935\u0930\u092e\u094d\u2014an indecl. expressing\",\"end\":\"space\"},{\"n\":12,\"text\":\"preference, and used with the clause containing the thing pre-\",\"end\":\"hyphen\"},{\"n\":13,\"text\":\"ferred (which is put in the nom. case). See Apte\u2019s Guide \u00a7 301.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit readings in the quotations are uncertain.\"},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"\u0924\u0941\u0932\u094d\u092f\u0915\u0941\u0932\u094d\u092f\u0947\u0937\u0941-\u0915\u0941\u0932\u0947 \u092d\u0935\u093e\u0903 \u0915\u0941\u0932\u094d\u092f\u093e\u0903 fr \u0915\u0941\u0932 + \u092f\u0924\u094d (\u092f) by \u2018\u0926\u093f\u0917\u093e\u0926\u093f\u092d\u094d\u092f\u094b\u2019 \u092f\u0924\u094d\",\"end\":\"space\"},{\"n\":2,\"text\":\"P\u00e2n IV. 3. 54, \u0915\u0941\u0932 being a synonym of \u0935\u0902\u0936. \u0915\u0941\u0932\u094d\u092f\u0903 \u0915\u0941\u0932\u094b\u0926\u094d\u092d\u0935\u0947 \u092e\u093e\u0928\u094d\u092f\u0947\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u0915\u0941\u0932\u0938\u0928\u094d\u0924\u0924\u093f\u0939\u093f\u0924\u0947\u093d\u092a\u093f \u091a \u0964 Vis'va. The sense intended by the poet,\",\"end\":\"space\"},{\"n\":4,\"text\":\"however, is \u0924\u0941\u0932\u094d\u092f\u0902 \u091a \u0924\u0924\u094d \u0915\u0941\u0932\u0902 \u0924\u0941\u0932\u094d\u092f\u0915\u0941\u0932\u0902 \u0924\u0924\u094d\u0930 \u092d\u0935\u093e\u0903 \u0964 But this is inadmis-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"sible from a grammatical point of view. \u092d\u0935\u093e\u0930\u094d\u0925\u0947 \u092f\u0924\u094d is to be added\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit text is indistinct.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 57 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":\"22\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"23\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"24\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r4\",\"r5\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
