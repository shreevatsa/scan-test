{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "उदन्वच्छन्ना भूः स च निधिरपां योजनशतं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सदा पान्थः पूषा गमनपरिमाणं कलयति ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इति प्रायो भावाः स्फुरदवधिमुद्रामुकुलिताः",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सतां प्रज्ञोन्मेषः पुनरयमसीमा विजयते ॥ ६ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "एको देवः केशवो वा शिवो वा",
     "end": "line"
    },
    {
     "n": 2,
     "text": "एकं मित्रं भूपतिर्वा यतिर्वा ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "एको वासः पत्तने वा वने वा",
     "end": "line"
    },
    {
     "n": 4,
     "text": "एका भार्या सुन्दरी वा दरी वा ॥ ७ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "एको रागिषु राजते प्रियतमादेहार्धहारी हरो",
     "end": "line"
    },
    {
     "n": 2,
     "text": "नीरागेषु जनो विमुक्तललनासङ्गो न यस्मात्परः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "दुर्वारस्मरबाणपन्नगविषव्याविद्धमुग्धो जनः",
     "end": "line"
    },
    {
     "n": 4,
     "text": "शेषः कामविडम्बितान्न विषयान्भोक्तुं न मोक्तुं क्षमः ॥ ८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "एता हसन्ति च रुदन्ति च कार्यहेतो-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "र्विश्वासयन्ति च परं न च विश्वसन्ति ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तस्मान्नरेण सुशीलसमन्वितेन",
     "end": "line"
    },
    {
     "n": 4,
     "text": "नार्यः श्मशानघटिका इव वर्जनीयाः ॥ ९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "कदा वाराणस्याममरतटिनीरोधसि वस-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "न्वसानः कौपीनं शिरसि निदधानोञ्जलिपुटम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "अये गौरीनाथ त्रिपुरहर शम्भो त्रिनयन",
     "end": "line"
    },
    {
     "n": 4,
     "text": "प्रसीदेत्याक्रोशन्निमिषमिव नेष्यामि दिवसान् ॥ १० ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "कार्कश्यं स्तनयोर्दृशोस्तरलतालीकं मुखे श्लाघ्यते",
     "end": "line"
    },
    {
     "n": 2,
     "text": "कौटिल्यं कचसंचये च वदने मान्द्यं त्रिके स्थूलता ।",
     "end": "line"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r8",
   "type": "apparatus_entry",
