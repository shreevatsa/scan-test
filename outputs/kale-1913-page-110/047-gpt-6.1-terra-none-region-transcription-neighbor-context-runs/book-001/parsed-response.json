{
 "regions": {
  "r3": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "समारम्भा भग्नाः कति न कतिवारांस्तव परे",
     "end": "line"
    },
    {
     "n": 2,
     "text": "पिपासोस्तुच्छेस्मिन्द्रविणमृगतृष्णार्णवजले ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तथापि प्रत्याशा विरमति न तेऽद्यापि शतधा",
     "end": "line"
    },
    {
     "n": 4,
     "text": "न दीर्णं यच्चेतो नियतमशनिग्रावघटितम् ॥ ३३ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several characters in the first two lines are difficult to distinguish."
  },
  "r4": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "हे पुच्छविषाणरहित पशो अस्मिन् तुच्छे द्रवणमेव मृगतृष्णासमुद्रः तस्य",
     "end": "space"
    },
    {
     "n": 2,
     "text": "जले पिपासोस्तव कतिवारान् कति कियन्तः समारम्भाः कर्मप्रारम्भाः न भग्नाः ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "अपि तु अनेकशः अनेकप्रारम्भा भग्ना इत्यर्थः । तथापि प्रत्याशा तव उत्कट-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "तृष्णा नाद्यापि विरमति शाम्यति । एवमपि यतः चेतः न शतधा दीर्णं",
     "end": "space"
    },
    {
     "n": 5,
     "text": "अनेकशः विदीर्णमतः तन्नियतं निश्चयेन अशनिरिव प्रावा तेन घटितं कृतम् ।",
     "end": "space"
    },
    {
     "n": 6,
     "text": "अतो नमस्तुभ्यमेवंविधनिर्लज्जमनुष्याय । शिखरिणी ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small-type readings, particularly in lines 1 and 5, are uncertain."
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "संमोहयन्ति मदयन्ति विडम्बयन्ति ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "निर्भर्त्सयन्ति रमयन्ति विषादयन्ति ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "एताः प्रविश्य सदयं हृदयं नराणां",
     "end": "line"
    },
    {
     "n": 4,
     "text": "किं नाम वामनयना न समाचरन्ति ॥ ३४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "संमोहयन्ति विवेकरहितं कुर्वन्ति मदयन्ति उन्मादयन्ति विडम्बयन्ति उप-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "हास्यतां नयन्ति । नितरां भर्त्सयन्ति । विषादयन्ति विषादं प्रापयन्ति । एवं",
     "end": "space"
    },
    {
     "n": 3,
     "text": "एता वामनयनाः स्त्रियः नराणां पुरुषाणां सदयं हृदयं प्रविश्य किं नाम न",
     "end": "space"
    },
    {
     "n": 4,
     "text": "समाचरन्ति सर्वमपि समाचरन्तीत्यर्थः । वसन्ततिलका ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The small type is indistinct in places."
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "सिंहो बली द्विरदशूकरमांसभोजी",
     "end": "line"
    },
    {
     "n": 2,
     "text": "संवत्सरेण रतिमेति किलैकवारम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "पारावतः खरशिलाकणमात्रभोजी",
     "end": "line"
    },
    {
     "n": 4,
     "text": "कामी भवत्यनुदिनं वद कोऽत्र हेतुः ॥ ३५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "द्विरदः करी शूकरो वराहः तयोः मांसभोजनशीलो बली सिंहः किल संव-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "त्सरेण एकवारमेव रतिमेति । रतिसुखाभिलाषी भवतीत्यर्थः । कामी खराः",
     "end": "space"
    },
    {
     "n": 3,
     "text": "",
     "end": "space"
    },
    {
     "n": 4,
     "text": "कठिणाः ये शिलाकणाः तन्मात्रभोजी पारावतः कपोतोऽनुदिनं प्रत्यहं भवति ।",
     "end": "space"
    },
    {
     "n": 5,
     "text": "कोऽत्र हेतुः कारणं वद कथय । क्षुद्रमहत्त्वे एव अत्र कारणमित्यर्थः ।",
     "end": "space"
    },
    {
     "n": 6,
     "text": "वसन्ततिलका ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The reading in line 5 is uncertain; line 3 contains only a stray mark from line 2."
  },
  "r9": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "स्थितिः पुण्यारण्ये सह परिचयो हन्त हरिणैः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "फलैर्मेध्या वृत्तिः प्रतिनदि च तल्यानि दृषदः ।",
     "end": "line"
    }
   ],
   "uncertain": true,
   "note": "The word before दृषदः is indistinct."
  },
  "r1": {
   "type": "running_header",
   "lines": [
