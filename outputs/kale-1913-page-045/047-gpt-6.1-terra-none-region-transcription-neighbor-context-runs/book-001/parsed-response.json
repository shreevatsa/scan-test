{
 "regions": {
  "r3": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "लज्जागुणौघजननीं जननीमिव स्वा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "मत्यन्तशुद्धहृदयामनुवर्तमानाम्[१] ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तेजस्विनः सुखमसूनपि संत्यजन्ति",
     "end": "line"
    },
    {
     "n": 4,
     "text": "सत्यव्रतव्यसनिनो न पुनः प्रतिज्ञाम् ॥ ६ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "लज्जा एव गुणस्तस्यौघः सततप्रवाहः । अथवा लज्जादयो ये गुणास्तेषा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "मौघः । यद्वा लज्जाया ये गुणाः । तस्य जननीम् । अत्यन्तं शुद्धं हृदयं यस्यां",
     "end": "space"
    },
    {
     "n": 3,
     "text": "यस्याश्च । अनुवर्तमानां पाल्यतयानुबन्धिनीं पुत्रहितपरायणां च । सत्यमेव",
     "end": "space"
    },
    {
     "n": 4,
     "text": "व्रतं तदेव तस्मिन्वा व्यसनं येषां ते । सुखं सुखेन । वसन्ततिलका वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अग्राह्यं हृदयं यथैव वदनं यद्दर्पणान्तर्गतं[२]",
     "end": "line"
    },
    {
     "n": 2,
     "text": "भावः पर्वतसूक्ष्ममार्गविषमः स्त्रीणां न विज्ञायते ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "चित्तं पुष्करपत्रतोयतरलं विद्वद्भिराशंसितं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "नारी नाम विषाङ्कुरैरिव लता दोषैः समं वर्धिता ॥ ७ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The reading and placement of the small marker on line 1 are uncertain."
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "दर्पणान्तर्गतमादर्शे प्रतिफलितं वदनं यथा अग्राह्यं तथा स्त्रीणां हृदयम-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "ग्राह्यं ज्ञातुमशक्यम् । तासां भावः हृद्गत आशयः । पर्वते यः सूक्ष्मः मार्गः तद्वत्",
     "end": "space"
    },
    {
     "n": 3,
     "text": "विषमः कठिनो दुर्ग्रहो वा । पुष्करपत्रे यत्तोयं तद्वत्तरलं चञ्चलम् । नामेति",
     "end": "space"
    },
    {
     "n": 4,
     "text": "प्राकाश्ये । नारीणां दोषाः सहजा एवेति भावः ॥ शार्दूलवि० वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अभिमुखनिहतस्य सतस्तिष्ठतु तावज्जयोऽथवा स्वर्गः ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "उभयबलसाधुवादः श्रवणसुखोऽसौ बतात्यर्थम् ॥ ८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "युद्धे शत्रोः अभिमुखे निहतस्य हतस्य । सतो वीरस्य । स्वर्गः–अत्र मनुः—",
     "end": "space"
    },
    {
     "n": 2,
     "text": "आहवेषु मिथोऽन्योन्यं जिघांसन्तो महीक्षितः । युध्यमानाः परं शक्त्या स्वर्गं",
     "end": "space"
    },
    {
     "n": 3,
     "text": "यान्त्यपराङ्मुखाः ॥ इति । उभयपक्षे यद्बलं तस्य साधु साधु इति वादः ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "इयत्यस्मिन्वा निरवधिचमत्कृत्यतिशये",
     "end": "line"
    },
    {
     "n": 2,
     "text": "वराहो वा राहुः प्रभवति चमत्कारविषयः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "महीमेको मग्नां यदयमवहद्दन्तसलिले",
     "end": "line"
    },
    {
     "n": 4,
     "text": "शिरःशेषः शत्रुं निगिलति परः संत्यजति च ॥ ९ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several readings in the verse, especially line 3, are uncertain."
  },
  "r10": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ जननीमिव वर्तमानाम्, अनुवर्तमानाः.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
