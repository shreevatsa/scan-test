{
 "regions": [
  {
   "id": "r2",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "लोला यौवनलालना तनुभृतामित्याकलय्य द्रुतं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "योगे धैर्यसमाधिसिद्धिसुलभे बुद्धिं विधध्वं बुधाः ॥ ५४ ॥",
     "end": "space"
    },
    {
     "n": 3,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "पुण्ये ग्रामे वने वा महति सितपटच्छन्नपालीं कपाली-",
     "end": "line"
    },
    {
     "n": 2,
     "text": "मादाय न्यायगर्भद्विजहुतहुतभुग्धूमधूम्रोपकण्ठम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "line"
    },
    {
     "n": 4,
     "text": "द्वारं द्वारं प्रवृत्तो वरमुदरदरीपूरणाय क्षुधार्तो",
     "end": "line"
    },
    {
     "n": 5,
     "text": "",
     "end": "line"
    },
    {
     "n": 6,
     "text": "मानी प्राणी स धन्यो न पुनरनुदिनं तुल्यकुल्येषु दीनः ॥५५॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "चाण्डालः किमयं द्विजातिरथवा शूद्रोथ किं तापसः",
     "end": "line"
    },
    {
     "n": 2,
     "text": "किंवा तत्त्वनिवेशपेशलमतिर्योगीश्वरः कोपि किम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "",
     "end": "line"
    },
    {
     "n": 4,
     "text": "इत्युत्पन्नविकल्पजल्पमुखरैः संभाष्यमाणा जनै-",
     "end": "line"
    },
    {
     "n": 5,
     "text": "र्न क्रुद्धाः पथि नैव तुष्टमनसो यान्ति स्वयं योगिनः ॥ ५६ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
