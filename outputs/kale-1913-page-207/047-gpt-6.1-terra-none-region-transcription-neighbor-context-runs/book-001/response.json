          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"him if it is fated not to come ( \u092f\u0924\u094d\u0915\u0930\u094d\u092e\u0935\u0936\u0924\u094b\u093d\u092d\u093e\u0935\u094d\u092f\u0902 \u0924\u0928\u094d\u0928 \u092d\u0935\u0924\u0940\u0939 ); for\",\"end\":\"space\"},{\"n\":2,\"text\":\"how can that be counteracted which is destined to happen ?\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u092e\u091c\u094d\u091c\u0924\u0941 &c.\u2014i. e. for pearls &c. \u0906\u0939\u0935 \u0906\u0939\u0942\u092f\u0928\u094d\u0924\u0947 \u0905\u0930\u092f\u094b\u0924\u094d\u0930 \u0964\u0938\u0915\u0932\u093e\u0903 \u0935\u093f\u0926\u094d\u092f\u093e\u0903\u2014\",\"end\":\"space\"},{\"n\":4,\"text\":\"According to some the vidyas are three, viz. \u0906\u0928\u094d\u0935\u0940\u0915\u094d\u0937\u093f\u0915\u0940 or me-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"taphysics ( \u0905\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u0935\u093f\u0926\u094d\u092f\u093e ), \u0924\u094d\u0930\u092f\u0940 the three Vedas, and \u0928\u0940\u0924\u093f or \u0926\u0923\u094d\u0921-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\u0928\u0940\u0924\u093f administration of justice. According to some they are four\",\"end\":\"space\"},{\"n\":7,\"text\":\"viz. \u0906\u0928\u094d\u0935\u0940\u0915\u094d\u0937\u093f\u0915\u0940 \u0924\u094d\u0930\u092f\u0940 \u0935\u093e\u0930\u094d\u0924\u093e \u0926\u0923\u094d\u0921\u0928\u0940\u0924\u093f\u0936\u094d\u091a \u0936\u093e\u0936\u094d\u0935\u0924\u0940 \u0964 K\u00e1mandaka. The\",\"end\":\"space\"},{\"n\":8,\"text\":\"usual number of Vidyas, however, is fourteen\u2014\u0905\u0919\u094d\u0917\u093e\u0928\u093f \u0935\u0947\u0926\u093e\u0936\u094d\u091a\u0924\u094d\u0935\u093e\u0930\u094b\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u092e\u0940\u092e\u093e\u0902\u0938\u093e \u0928\u094d\u092f\u093e\u092f\u0935\u093f\u0938\u094d\u0924\u0930\u0903 \u0964 \u092a\u0941\u0930\u093e\u0923\u0902 \u0927\u0930\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0902 \u091a \u0935\u093f\u0926\u094d\u092f\u093e \u0939\u094d\u092f\u0947\u0924\u093e\u0936\u094d\u091a\u0924\u0941\u0930\u094d\u0926\u0936 \u0964 See Rag. V.\",\"end\":\"space\"},{\"n\":10,\"text\":\"21. \u0915\u0932\u093e\u0903\u2014These are said to be 64.[*] \u092d\u093e\u0917\u094d\u092f\u0935\u0936\u0924\u0903\u2014in obedience to\",\"end\":\"space\"},{\"n\":11,\"text\":\"the power of fate.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit readings, especially in lines 1 and 3, are indistinct.\"},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 108. \u0924\u0938\u094d\u092f &c.\u2014is friendly disposed towards him. \u0938\u0928\u094d\u0928\u093f\u0927\u093f\u0966-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"\u0938\u0924\u094d may qualify \u0928\u093f\u0927\u093f as well as \u0930\u0924\u094d\u0928; \u0938\u0928\u094d\u0924\u093f \u091a \u0924\u093e\u0928\u093f ( \u0928\u093f\u0927\u092f\u094b \u0930\u0924\u094d\u0928\u093e\u0928\u093f\",\"end\":\"space\"},{\"n\":3,\"text\":\"\u091a ) \u0928\u093f\u0927\u093f\u0930\u0924\u094d\u0928\u093e\u0928\u093f \u091a; or \u0938\u0928\u094d\u0928\u093f\u0927\u093f\u2014collections of choice things, and\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"jewels. R\u00e1marshi takes it as \u0938\u0928\u094d\u0928\u093f\u0927\u094c \u0938\u092e\u0940\u092a\u0947 \u0930\u0924\u094d\u0928\u0948\u0930\u0941\u0924\u094d\u0915\u0943\u0937\u094d\u091f\u0935\u0938\u094d\u0924\u0941\u092d\u093f\u0930\u094d\u0917\u0935\u093e\u0936\u094d\u0935-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\u0935\u0938\u094d\u0924\u094d\u0930\u093e\u0926\u093f\u092d\u093f\u0930\u094d\u092e\u0923\u093f\u092d\u093f\u0930\u094d\u0935\u093e \u092a\u0942\u0930\u094d\u0923\u093e \u0964 For the alleged fatalistic tendency of the\",\"end\":\"space\"},{\"n\":7,\"text\":\"Hindus in general, see Introduction.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit compounds in lines 1 and 5\u20136 are difficult to read.\"},\"r4\":{\"type\":\"footnote\",\"lines\":[{\"n\":1,\"text\":\"* The following are the names of these :\u2014\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0917\u0940\u0924\u0902, \u0935\u093e\u0926\u094d\u092f\u0902, \u0928\u0943\u0924\u094d\u092f\u0902, \u0906\u0932\u0947\u0916\u094d\u092f\u0902, \u0935\u093f\u0936\u0947\u0937\u0915\u091a\u094d\u091b\u0947\u0926\u094d\u092f\u0902, \u0924\u0923\u094d\u0921\u0941\u0932\u0915\u0941\u0938\u0941\u092e\u092c\u0932\u093f\u0935\u093f\u0915\u093e\u0930\u093e\u0903, \u092a\u0941\u0937\u094d\u092a\u093e\u0938\u094d\u0924\u0930\u0923\u0902, \u0926\u0936\u0928-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\u0935\u0938\u0928\u093e\u0919\u094d\u0917\u0930\u093e\u0917\u0903, \u092e\u0923\u093f\u092d\u0942\u092e\u093f\u0915\u093e\u0915\u0930\u094d\u092e, \u0936\u092f\u0928\u0930\u091a\u0928\u0902, \u0909\u0926\u0915\u0935\u093e\u0926\u094d\u092f\u0902, \u0909\u0926\u0915\u093e\u0918\u093e\u0924\u0903, \u091a\u093f\u0924\u094d\u0930\u093e\u0936\u094d\u091a \u092f\u094b\u0917\u093e\u0903, \u092e\u093e\u0932\u094d\u092f-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"\u0917\u094d\u0930\u0925\u0928\u0935\u093f\u0915\u0932\u094d\u092a\u093e\u0903, \u0936\u0947\u0916\u0930\u0915\u093e\u092a\u0940\u0921\u092f\u094b\u091c\u0928\u0902, \u0928\u0947\u092a\u0925\u094d\u092f\u092a\u094d\u0930\u092f\u094b\u0917\u093e\u0903, \u0915\u0930\u094d\u0923\u092a\u0924\u094d\u0930\u092d\u0919\u094d\u0917\u093e\u0903, \u0917\u0928\u094d\u0927\u092f\u0941\u0915\u094d\u0924\u093f\u0903, \u092d\u0942\u0937\u0923\u092f\u094b\u091c\u0928\u0902,\",\"end\":\"space\"},{\"n\":5,\"text\":\"\u0910\u0928\u094d\u0926\u094d\u0930\u091c\u093e\u0932\u093e\u0903, \u0915\u094c\u091a\u0941\u092e\u093e\u0930\u093e\u0936\u094d\u091a \u092f\u094b\u0917\u093e\u0903, \u0939\u0938\u094d\u0924\u0932\u093e\u0918\u0935\u0902, \u0935\u093f\u091a\u093f\u0924\u094d\u0930\u0936\u093e\u0915\u092f\u0942\u0937\u092d\u0915\u094d\u0937\u094d\u092f\u0935\u093f\u0915\u093e\u0930\u0915\u094d\u0930\u093f\u092f\u093e, \u092a\u093e\u0928\u0915\u0930\u0938\u0930\u093e-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"\u0917\u093e\u0938\u0935\u092f\u094b\u091c\u0928\u0902, \u0938\u0942\u091a\u0940\u0935\u093e\u0928\u0915\u0930\u094d\u092e\u093e\u0923\u093f, \u0938\u0942\u0924\u094d\u0930\u0915\u094d\u0930\u0940\u0921\u093e, \u0935\u0940\u0923\u093e\u0921\u092e\u0930\u0941\u0915\u0935\u093e\u0926\u094d\u092f\u093e\u0928\u093f, \u092a\u094d\u0930\u0939\u0947\u0932\u093f\u0915\u093e, \u092a\u094d\u0930\u0924\u093f\u092e\u093e\u0932\u093e, \u0926\u0941\u0930\u094d\u0935\u093e-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u091a\u0915\u092f\u094b\u0917\u093e\u0903, \u092a\u0941\u0938\u094d\u0924\u0915\u0935\u093e\u091a\u0928\u0902, \u0928\u093e\u091f\u0915\u093e\u0916\u094d\u092f\u093e\u092f\u093f\u0915\u093e\u0926\u0930\u094d\u0936\u0928\u0902, \u0915\u093e\u0935\u094d\u092f\u0938\u092e\u0938\u094d\u092f\u093e\u092a\u0942\u0930\u0923\u0902, \u092a\u091f\u094d\u091f\u093f\u0915\u093e\u0935\u0947\u0924\u094d\u0930\u092c\u093e\u0923\u0935\u093f\u0915\u0932\u094d\u092a\u093e\u0903,\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u0924\u0915\u094d\u0937\u0915\u0930\u094d\u092e\u093e\u0923\u093f, \u0924\u0915\u094d\u0937\u0923\u0902, \u0935\u093e\u0938\u094d\u0924\u0941\u0935\u093f\u0926\u094d\u092f\u093e, \u0930\u0942\u092a\u094d\u092f\u0930\u0924\u094d\u0928\u092a\u0930\u0940\u0915\u094d\u0937\u093e, \u0927\u093e\u0924\u0941\u0935\u093e\u0926\u0903, \u092e\u0923\u093f\u0930\u093e\u0917\u093e\u0915\u0930\u091c\u094d\u091e\u093e\u0928\u0902, \u0935\u0943\u0915\u094d\u0937\u093e\u092f\u0941\u0930\u094d\u0935\u0947\u0926\u092f\u094b\u0917\u093e\u0903,\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u092e\u0947\u0937\u0915\u0941\u0915\u094d\u0915\u0941\u091f\u0932\u093e\u0935\u0915\u092f\u0941\u0926\u094d\u0927\u0935\u093f\u0927\u093f\u0903, \u0936\u0941\u0915\u0938\u093e\u0930\u093f\u0915\u093e\u092a\u094d\u0930\u0932\u093e\u092a\u0928\u0902, \u0909\u0924\u094d\u0938\u093e\u0926\u0928\u0947 \u0938\u0902\u0935\u093e\u0939\u0928\u0947 \u0915\u0947\u0936\u092e\u0930\u094d\u0926\u0928\u0947 \u091a \u0915\u094c\u0936\u0932\u0902, \u0905\u0915\u094d\u0937-\",\"end\":\"hyphen\"},{\"n\":11,\"text\":\"\u0930\u092e\u0941\u0937\u094d\u091f\u093f\u0915\u093e\u0915\u0925\u0928\u0902, \u092e\u094d\u0932\u0947\u091a\u094d\u091b\u093f\u0924\u0935\u093f\u0915\u0932\u094d\u092a\u093e\u0903, \u0926\u0947\u0936\u092d\u093e\u0937\u093e\u0935\u093f\u091c\u094d\u091e\u093e\u0928\u0902, \u092a\u0941\u0937\u094d\u092a\u0936\u0915\u091f\u093f\u0915\u093e, \u0928\u093f\u092e\u093f\u0924\u094d\u0924\u091c\u094d\u091e\u093e\u0928\u0902, \u092f\u0928\u094d\u0924\u094d\u0930\u092e\u093e\u0924\u0943\u0915\u093e,\",\"end\":\"space\"},{\"n\":12,\"text\":\"\u0927\u093e\u0930\u0923\u092e\u093e\u0924\u0943\u0915\u093e, \u0938\u0902\u092a\u093e\u0920\u094d\u092f\u0902, \u092e\u093e\u0928\u0938\u0940 \u0915\u093e\u0935\u094d\u092f\u0915\u094d\u0930\u093f\u092f\u093e, \u0905\u092d\u093f\u0927\u093e\u0928\u0915\u094b\u0937\u0903, \u091b\u0928\u094d\u0926\u094b\u091c\u094d\u091e\u093e\u0928\u0902, \u0915\u094d\u0930\u093f\u092f\u093e\u0915\u0932\u094d\u092a\u0903, \u091b\u0932\u093f\u0924-\",\"end\":\"hyphen\"},{\"n\":13,\"text\":\"\u0915\u092f\u094b\u0917\u093e\u0903, \u0935\u0938\u094d\u0924\u094d\u0930\u0917\u094b\u092a\u0928\u093e\u0928\u093f, \u0926\u094d\u092f\u0942\u0924\u0935\u093f\u0936\u0947\u0937\u0903, \u0906\u0915\u0930\u094d\u0937\u0915\u094d\u0930\u0940\u0921\u093e, \u092c\u093e\u0932\u0915\u094d\u0930\u0940\u0921\u0928\u0915\u093e\u0928\u093f, \u0935\u0948\u0928\u092f\u093f\u0915\u0940\u0928\u093e\u0902 \u0935\u0948\u091c\u092f\u093f-\",\"end\":\"hyphen\"},{\"n\":14,\"text\":\"\u0915\u0940\u0928\u093e\u0902 \u0935\u094d\u092f\u093e\u092f\u093e\u092e\u093f\u0915\u0940\u0928\u093e\u0902 \u091a \u0935\u093f\u0926\u094d\u092f\u093e\u0928\u093e\u0902 \u091c\u094d\u091e\u093e\u0928\u0902, \u0907\u0924\u093f \u091a\u0924\u0941\u0903\u0937\u0937\u094d\u091f\u093f\u0930\u0919\u094d\u0917\u0935\u093f\u0926\u094d\u092f\u093e\u0903 V\u00e1t. Ka\u2019m. Sut.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Several Sanskrit items in the list are difficult to distinguish in the scan.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 42 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"u2\",\"u3\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"108\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"footnote\",\"number\":null,\"label\":\"*\",\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]},{\"flow\":\"notes\",\"units\":[\"u4\"]}],\"relations\":[{\"type\":\"note\",\"region\":\"r2\",\"line\":10,\"marker\":\"*\",\"to\":\"u4\"}]}"
