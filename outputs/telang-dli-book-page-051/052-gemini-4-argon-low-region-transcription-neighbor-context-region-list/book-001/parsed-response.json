{
 "regions": [
  {
   "id": "r1",
   "type": "other",
   "lines": [
    {
     "n": 1,
     "text": "॥ श्रीगणेशाय नमः ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r2",
   "type": "heading",
   "lines": [
    {
     "n": 1,
     "text": "॥ अथ नीतिशतकम् ॥",
     "end": "space"
    },
    {
     "n": 2,
     "text": "",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r3",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "दिक्कालाद्यनवच्छिन्नानन्तचिन्मात्रमूर्तये ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "",
     "end": "space"
    },
    {
     "n": 3,
     "text": "स्वानुभूत्येकसाराय नमः शान्ताय तेजसे ॥ १ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r4",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "यां चिन्तयामि सततं मयि सा विरक्ता",
     "end": "line"
    },
    {
     "n": 2,
     "text": "साप्यन्यमिच्छति जनं स जनोन्यसक्तः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "अस्मत्कृते च परितुष्यति काचिदन्या",
     "end": "line"
    },
    {
     "n": 4,
     "text": "धिक्तां च तं च मदनं च इमां च मां च ॥ २ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r5",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अज्ञः सुखमाराध्यः सुखतरमाराध्यते विशेषज्ञः ।",
     "end": "line"
    },
    {
     "n": 2,
     "text": "ज्ञानलवदुर्विदग्धं ब्रह्मापि नरं न रञ्जयति ॥ ३ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r6",
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "प्रसह्य मणिमुद्धरेन्मकरवक्त्रदंष्ट्राङ्कुरा-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "त्समुद्रमपि संतरेत्प्रचलदूर्मिमालाकुलम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "भुजङ्गमपि कोपितं शिरसि पुष्पवद्धारये-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "न्न तु प्रतिनिविष्टमूर्खजनचित्तमाराधयेत् ॥ ४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r7",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "I. (a) दिक्कालानवच्छिन्नाय चिन्मात्रानन्तमूर्तये. Bo. (b) °भूत्ये°; °भूत्यै°.",
     "end": "space"
    },
    {
     "n": 2,
     "text": "Be. Bo. S. W. L. D. X. G. साराय; मानाय. D. Bo.n. N.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r8",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "II. (a) वि°; न P. R. (b) °प्य°; चा°. Bo. Be. P. R. सक्तः; रक्तः",
     "end": "space"
    },
    {
     "n": 2,
     "text": "Be.n. (c) च; °पि. P. R. Be.n. Bo.n. °तु°; °शु.° X. (d) धिक्तां च",
     "end": "space"
    },
    {
     "n": 3,
     "text": "तंच; धिक्तं च तांच. W.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r9",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "III. (b) विशे°; °ऽशे°. K. Be.n. (c) लवदुर्विद°; लवलेशद° D.",
     "end": "space"
    },
    {
     "n": 2,
     "text": "(d). °पि न°; °पि तं न° C. T. S. L. W. X. D. F. G.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  {
   "id": "r10",
   "type": "apparatus_entry",
   "lines": [
    {
     "n": 1,
     "text": "IV. (a) °ष्ट्राङ्कु°; °ष्ट्रान्त° F. N. (b) °रेत्प्रचलदू°; °रेच्चपलदू° Bo. Be.",
     "end": "space"
    },
    {
     "n": 2,
     "text": "°रेत्प्रचुरदू.° W. G. (where च for चु). °रेच्चपलमू°. K. °रेत्प्रसरदू°–",
     "end": "space"
    },
    {
     "n": 3,
     "text": "P. See further Be.n. (d) °र्ख; °र्ष R.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  }
