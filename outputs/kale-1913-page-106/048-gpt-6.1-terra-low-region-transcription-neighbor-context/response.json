bud7yASTIZcbzLA4O7oTSGpfTMVBqWkF4VEDe9PTb6UdNOMAW90u5v-T6RLWqtocMC6Co05j5w=="},{"type":"message","id":"msg_05eef1f44ed9dd98016aed4b8b082887d09148809698ad6911","role":"assistant","status":"completed","content":[{"type":"output_text","text":"{\"regions\":{\"r3\":{\"type\":\"commentary\",\"lines\":[{\"n\":1,\"text\":\"रोदनं कुर्वते च । परं पुरुषं च विश्वासयन्ति स्वस्मिन्विश्रम्भं कारयन्ति स्वतस्तु\",\"end\":\"space\"},{\"n\":2,\"text\":\"न कस्मिन्नपि विश्वसन्ति । तस्मात्कुलेन कुलं च शीलं च ताभ्यां समन्वितेन नार्यः\",\"end\":\"space\"},{\"n\":3,\"text\":\"स्त्रियः श्मशाने या घटिका मृत्पात्रविशेषास्ता इव वर्जनीयाः दूरतः परिव-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"र्जनीयाः । तासां अनर्थहेतुत्वात् । वसन्ततिलका ॥\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some readings in the continuation are unclear.\"},\"r4\":{\"type\":\"verse\",\"lines\":[{\"n\":1,\"text\":\"कार्कश्यं स्तनयोर्दृशोस्तरलतालिकं मुखे श्लाघ्यते\",\"end\":\"line\"},{\"n\":2,\"text\":\"कौटिल्यं कचसंचये च वदने मान्द्यं त्रिके स्थूलता ।\",\"end\":\"line\"},{\"n\":3,\"text\":\"भीरुत्वं हृदये सदैव कथितं मायाप्रयोगैः[२] प्रिये\",\"end\":\"line\"},{\"n\":4,\"text\":\"यासां दोषगणो गुणो मृगदृशां ताः स्युः पशूनां प्रियाः २०\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The small variant markers are difficult to distinguish.\"},\"r5\":{\"type\":\"commentary\",\"lines\":[{\"n\":1,\"text\":\"स्तनयोः कर्कशस्य भावः कार्कश्यं काठिन्यं दोषपक्षे निर्दयता । दृशोः\",\"end\":\"space\"},{\"n\":2,\"text\":\"नेत्रयोः तरलता चंचलता पक्षे अस्थिरता । मुखे अलिकं ललाटदेशः पक्षे\",\"end\":\"space\"},{\"n\":3,\"text\":\"अनृतभाषणं । श्लाघ्यते प्रशस्यते । कचसंचये केशपुञ्जे कुटिलस्य भावः कौटिल्यं\",\"end\":\"space\"},{\"n\":4,\"text\":\"वक्रता । वदने मान्द्यं गम्भीरता । त्रिके पृष्ठवंशाधारभागे । स्थूलता । मायाप्रयोगो\",\"end\":\"space\"},{\"n\":5,\"text\":\"वञ्चनाप्रचुरचेष्टा । यासां मृगनयनानां दोषाणां गणः समूहोऽपि गुणः ताः\",\"end\":\"space\"},{\"n\":6,\"text\":\"स्त्रियः पशूनां प्रियाः । न तु मनुष्याणां स्युरिति शेषः । अतः ये एवंविधासु स्त्रीषु\",\"end\":\"space\"},{\"n\":7,\"text\":\"गुणदृष्टिं कुर्वन्ति ते पशव इत्यर्थः । शार्दूल० ॥\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"A few small-type readings are uncertain.\"},\"r6\":{\"type\":\"verse\",\"lines\":[{\"n\":1,\"text\":\"क्वचिद्वीणावादः क्वचिदपि च हाहेति रुदितं\",\"end\":\"line\"},{\"n\":2,\"text\":\"क्वचिद्विद्वद्गोष्ठी क्वचिदपि सुरामत्तकलहः ।\",\"end\":\"line\"},{\"n\":3,\"text\":\"क्वचिद्रामा रम्याः क्वचिदपि गलितकुष्ठवपुषो\",\"end\":\"line\"},{\"n\":4,\"text\":\"न जाने संसारः किममृतमयः किं विषमयः ॥ २१ ॥\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"commentary\",\"lines\":[{\"n\":1,\"text\":\"वीणावादः वीणावादनम् । विदुषां गोष्ठी शास्त्रप्रचुरा कथा । सुरया मत्तानां\",\"end\":\"space\"},{\"n\":2,\"text\":\"कलहः । गलत् प्रस्रवत् कुष्ठं यत्र तादृक् वपुः येषां ते यासां ता वा तथा । संसारः\",\"end\":\"space\"},{\"n\":3,\"text\":\"अमृतमयः सुखप्रचुरः विषमयः दुःखप्रचुरो वा न जाने । प्राचुर्ये मयट् । परस्पर-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"विरुद्धावस्थावलोकनान्निश्चयाभाव इत्यर्थः । शिखरिणी ॥\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The compound in the last line is somewhat unclear.\"},\"r8\":{\"type\":\"verse\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"गात्रैर्गिरा च विकलश्चटुमीश्वराणां\",\"end\":\"line\"},{\"n\":3,\"text\":\"कुर्वन्नयं प्रहसनस्य नटः कृतोऽसि ।\",\"end\":\"line\"},{\"n\":4,\"text\":\"तं त्वां पुनः पलितकर्णकमञ्जमेनं\",\"end\":\"line\"},{\"n\":5,\"text\":\"नाट्येन केन नटयिष्यति दीर्घमायुः ॥ २२ ॥\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The compound in line 4 is unclear.\"},\"r9\":{\"type\":\"commentary\",\"lines\":[{\"n\":1,\"text\":\"गात्रैः गिरा च विकलः । चटु चाटुभाषितम् । प्रहसनस्य हास्यरसप्रधान-\",\"end\":\"hyphen\"}],\"uncertain\":false,\"note\":null},\"r10\":{\"type\":\"footnote\",\"lines\":[{\"n\":1,\"text\":\"१ प्रवचने.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r11\":{\"type\":\"footnote\",\"lines\":[{\"n\":1,\"text\":\"२ प्रयोगप्रिये.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r12\":{\"type\":\"footnote\",\"lines\":[{\"n\":1,\"text\":\"३ किं नराणां\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r13\":{\"type\":\"footnote\",\"lines\":[{\"n\":1,\"text\":\"४ वाचं.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"running_header\",\"lines\":[{\"n\":1,\"text\":\"वैराग्यशतकम् ।\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r2\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"५७\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"section\",\"number\":null,\"label\":\"वैराग्यशतकम्\",\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u4\",\"u7\",\"u10\"]},{\"id\":\"u2\",\"type\":\"group\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"u3\"]},{\"id\":\"u3\",\"type\":\"commentary\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"group\",\"number\":\"20\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"u5\",\"u6\"]},{\"id\":\"u5\",\"type\":\"verse\",\"number\":\"20\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u6\",\"type\":\"commentary\",\"number\":null,\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u7\",\"type\":\"group\",\"number\":\"21\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"u8\",\"u9\"]},{\"id\":\"u8\",\"type\":\"verse\",\"number\":\"21\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u9\",\"type\":\"commentary\",\"number\":null,\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u10\",\"type\":\"group\",\"number\":\"22\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"u11\",\"u12\"]},{\"id\":\"u1