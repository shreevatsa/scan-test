          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"24. If you desire to see the courage of magnanimous\",\"end\":\"space\"},{\"n\":2,\"text\":\"persons give way in times of difficulty, desist from this\",\"end\":\"space\"},{\"n\":3,\"text\":\"wicked pursuit, all trouble in which must be fruitless\u2014\",\"end\":\"space\"},{\"n\":4,\"text\":\"O you block-head these are not the Kula-mountains nor the\",\"end\":\"space\"},{\"n\":5,\"text\":\"oceans either which transgress their usual bounds at the\",\"end\":\"space\"},{\"n\":6,\"text\":\"time of the universal destruction\u2014but insignificant on\",\"end\":\"space\"},{\"n\":7,\"text\":\"that account.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"25. The goddess of victory likes the chest of warriors\",\"end\":\"space\"},{\"n\":2,\"text\":\"lacerated with the nail-like-long sword, just as an ac-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"complished and grown up handsome woman longs for the\",\"end\":\"space\"},{\"n\":4,\"text\":\"chest of brave men scratched by her nails long and piercing\",\"end\":\"space\"},{\"n\":5,\"text\":\"like a sword.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 24 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"u2\",\"u3\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"24\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"25\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
