          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r1\":{\"type\":\"heading\",\"lines\":[{\"n\":1,\"text\":\"TRANSLATION\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r2\":{\"type\":\"heading\",\"lines\":[{\"n\":1,\"text\":\"\",\"end\":\"space\"},{\"n\":2,\"text\":\"N\u00ceTIS'ATAK.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"I. Salutation to that peaceful Majesty whose form is pure\",\"end\":\"space\"},{\"n\":2,\"text\":\"knowledge, infinite and unconditioned by space, time &c., and\",\"end\":\"space\"},{\"n\":3,\"text\":\"the principal means of knowing which is self-perception.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"2 She of whom I think ceaselessly is indifferent to me:\",\"end\":\"space\"},{\"n\":2,\"text\":\"she yearns after another man, and he is attached to a third\",\"end\":\"space\"},{\"n\":3,\"text\":\"person; while some other woman pines away for me: fie on\",\"end\":\"space\"},{\"n\":4,\"text\":\"that woman, on him, and on the God of Love, as well as on\",\"end\":\"space\"},{\"n\":5,\"text\":\"this woman and on me.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"3. An ignorant man can be pleased easily; a wise man\",\"end\":\"space\"},{\"n\":2,\"text\":\"can be pursuaded the more easily; but, the God Brahm\u00e2\",\"end\":\"space\"},{\"n\":3,\"text\":\"himself will not be able to win over a man puffed up with a\",\"end\":\"space\"},{\"n\":4,\"text\":\"grain of knowledge.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"4. One might forcibly take out a jewel from the midst of\",\"end\":\"space\"},{\"n\":2,\"text\":\"the jaws of a shark; one might cross even the sea, agitated\",\"end\":\"space\"},{\"n\":3,\"text\":\"on account of a succession of waves rising high; one might\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"place on one\u2019s head even an infuriated serpent as if it were\",\"end\":\"space\"},{\"n\":6,\"text\":\"a flower; but one cannot please the heart of a perverse fool\",\"end\":\"space\"},{\"n\":7,\"text\":\"( or the perverse mind of a fool ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"5. Sedulously pressing sand, one may get oil even from\",\"end\":\"space\"},{\"n\":2,\"text\":\"it; a person parched with thirst may drink water even in a\",\"end\":\"space\"},{\"n\":3,\"text\":\"mirage; roaming ( here and there ) a person may, perchance,\",\"end\":\"space\"},{\"n\":4,\"text\":\"find the horn of a hare; but no one will be able to propitiate\",\"end\":\"space\"},{\"n\":5,\"text\":\"a confirmed blockhead.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"6. He who wishes to lead wicked men to the path of the\",\"end\":\"space\"},{\"n\":2,\"text\":\"good, with wise words that sprinkle nectar (as it were), tries\",\"end\":\"space\"},{\"n\":3,\"text\":\"to bind an elephant with a tender lotus-stalk, or attempts\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":\"Translation\",\"open_start\":false,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\",\"u9\"]},{\"id\":\"u2\",\"type\":\"heading\",\"number\":null,\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r1\"]},{\"id\":\"u3\",\"type\":\"heading\",\"number\":null,\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"1\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"2\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"3\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"4\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"5\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u9\",\"type\":\"translated_stanza\",\"number\":\"6\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]},{\"flow\":\"notes\",\"units\":[]}],\"relations\":[]}"
