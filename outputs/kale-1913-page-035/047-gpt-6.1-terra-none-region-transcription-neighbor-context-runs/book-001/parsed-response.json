{
 "regions": {
  "r3": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "अक्रोधः समाहितचित्तत्वम् । प्रसज्यप्रतिषेधेऽपि नञ्समासः क्वचिदिष्टः । निर्व्या-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "जता निष्कापट्यम् । शार्दूल० वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small-type readings are uncertain."
  },
  "r4": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "धीरा न्यायमार्गात्कदापि न चलन्तीत्याह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "निन्दन्तु नीतिनिपुणा यदि वा स्तुवन्तु",
     "end": "line"
    },
    {
     "n": 2,
     "text": "लक्ष्मीः समाविशतु गच्छतु वा यथेष्टम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "अद्यैव वा मरणमस्तु युगान्तरे वा",
     "end": "line"
    },
    {
     "n": 4,
     "text": "न्याय्यात्पथः प्रविचलन्ति पदं न धीराः ॥ ८३ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "नीतौ नये निपुणाः । न्याय्यादनपेतात् । धीराः धैर्यशालिनो",
     "end": "space"
    },
    {
     "n": 2,
     "text": "मनस्विनः । वसन्ततिलका वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The reading around न्याय्यात् is uncertain."
  },
  "r7": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अधुना धीरस्य धैर्यगुणो न कदाचिदपाक्रियते इति सदृष्टान्तमाह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "कदर्थितस्यापि हि धैर्यवृत्ते-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "र्न शक्यते धैर्यगुणः प्रमार्ष्टुम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "अधोमुखस्यापि कृतस्य वह्ने-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "र्नाधः शिखा याति कदाचिदेव ॥ ८४ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r9": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "कुत्सितोऽर्थः कदर्थः । कोः कत्तत्पुरुषेऽचि । इति कुशब्दस्य कदादेशः ।",
     "end": "space"
    },
    {
     "n": 2,
     "text": "कदर्थीकृतः कदर्थितो न्यक्कृतस्तस्य । धैर्येण वृत्तिर्यस्य तस्य । धैर्यमेव गुणः धैर्य-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "गुणः प्रमार्ष्टुं निराकर्तुं न शक्यते । तत्र दृष्टान्तः अधोमुखस्येति । वृत्त-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "मुपजातिः ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The grammatical citation on the first line is uncertain."
  },
  "r10": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "संप्रति को धीर इत्याकांक्षायामाह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r11": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "कान्ताकटाक्षविशिखा न लुनन्ति[३] यस्य",
     "end": "line"
    },
    {
     "n": 2,
     "text": "चित्तं न निर्दहति कोपकृशानुतापः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "कर्षन्ति[४] भूरिविषयाश्च न लोभपाशै-",
     "end": "hyphen"
    },
    {
     "n": 4,
     "text": "र्लोकत्रयं जयति कृत्स्नमिदं स धीरः ॥ ८५ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r12": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "यस्य चित्तं कान्तायाः कटाक्षा अपाङ्गवीक्षितानि एव विशिखा बाणा न",
     "end": "space"
    },
    {
     "n": 2,
     "text": "लुनन्ति । भिन्दन्तीत्यर्थः । कोप एव कृशानुरग्निस्तस्य तापः न निर्दहति ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "भूरयो विषया लोभा एव पाशास्तैः न कर्षन्ति स्वायत्तं कुर्वन्तीत्यर्थः । जयति",
     "end": "space"
    },
    {
     "n": 4,
     "text": "स्वाधीनतां नयति । वसन्ततिलका वृत्तम् ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r13": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "१ बुद्धिविनाशो न हि शङ्कनीयः.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r14": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "२ तनुनपातः.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r15": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "३ खनन्ति.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r16": {
   "type": "footnote",
   "lines": [
    {
     "n": 1,
     "text": "४ तर्षन्ति.",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
