          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"you play, such as you are, with your ears bordered with\",\"end\":\"space\"},{\"n\":2,\"text\":\"grey hair.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"23. Wealth is evanescent, life is unsteady, and youth in\",\"end\":\"space\"},{\"n\":2,\"text\":\"life is fickle; in worldly existence, which is fleeting, merit\",\"end\":\"space\"},{\"n\":3,\"text\":\"alone is unchangeable.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"24. That Tortoise alone was born who offered to bear on\",\"end\":\"space\"},{\"n\":2,\"text\":\"his back ( lit. offered his back for ) the heavy burden of the\",\"end\":\"space\"},{\"n\":3,\"text\":\"world; the birth of Dhruva ( alone ) is to be praised, regu-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"lated by whom, the planetary system revolves; other crea-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"tures in the world are, like the insects in an udumbara\",\"end\":\"space\"},{\"n\":6,\"text\":\"\",\"end\":\"space\"},{\"n\":7,\"text\":\"fruit, which possess wings to no purpose, as it were born and\",\"end\":\"space\"},{\"n\":8,\"text\":\"dead (simultaneously), since they are not able in any way\",\"end\":\"space\"},{\"n\":9,\"text\":\"to do good to others ( and since ) (both) the present world\",\"end\":\"space\"},{\"n\":10,\"text\":\"and the next have become unavailable to them.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"25. Possessed of abuses as you are, you may pour abuses;\",\"end\":\"space\"},{\"n\":2,\"text\":\"ay, you may; for want of them, we are unable to give you\",\"end\":\"space\"},{\"n\":3,\"text\":\"abuses; it is known all the world over, that what there is can\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"be given; no one ever gives to another the horn of a hare.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"26. Alms are not unattainable to me in my path lined\",\"end\":\"space\"},{\"n\":2,\"text\":\"by rich gardens; the earth is full of fruits, and the skins of\",\"end\":\"space\"},{\"n\":3,\"text\":\"deer and the barks of trees ( serve as ) raiment; with joys\",\"end\":\"space\"},{\"n\":4,\"text\":\"or with sorrows, there is in fact the same result. Who will\",\"end\":\"space\"},{\"n\":5,\"text\":\"\",\"end\":\"space\"},{\"n\":6,\"text\":\"then give up the Three-eyed God, and bow to the man\",\"end\":\"space\"},{\"n\":7,\"text\":\"blinded by pride for a particle of wealth ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"27. With a sword we did not cut asunder elephants; we\",\"end\":\"space\"},{\"n\":2,\"text\":\"did not harass our enemies; * * * *\",\"end\":\"space\"},{\"n\":3,\"text\":\"\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"we did not sip the noisy water of the streamlets of the Him\u00e2-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"layas: we passed our time like crows desirous of obtaining a\",\"end\":\"space\"},{\"n\":7,\"text\":\"morsel from others.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"By you Bali was not liberated from the nether world; death\",\"end\":\"space\"},{\"n\":2,\"text\":\"was not done away with; the dark spot on the moon was\",\"end\":\"space\"},{\"n\":3,\"text\":\"not wiped away, nor were diseases rooted out; nor was Sesha\u2019s\",\"end\":\"space\"},{\"n\":4,\"text\":\"burden lightened (by you) for a moment by supporting the\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 49 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r9\":{\"type\":\"other\",\"lines\":[{\"n\":1,\"text\":\"4\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"23\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"24\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"25\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"26\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"27\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":null,\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
