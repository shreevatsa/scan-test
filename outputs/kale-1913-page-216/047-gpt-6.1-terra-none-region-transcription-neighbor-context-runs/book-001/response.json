          "text": "{\"regions\":{\"r2\":{\"type\":\"heading\",\"lines\":[{\"n\":1,\"text\":\"VAIRA'GYAS'ATAKA.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 1. \u091a\u0942\u0921\u094b\u0924\u094d\u0924\u0902\u0938\u093f\u0924 &c.\u2014In this Sl. Hara is described as a\",\"end\":\"space\"},{\"n\":2,\"text\":\"lamp having for its flame the crescent moon, burning the moth\",\"end\":\"space\"},{\"n\":3,\"text\":\"of K\u00e2ma, and dispelling the darkness in the form of \u092e\u094b\u0939. \u0909\u0924\u094d\u0924\u0902\u0938\u093f\u0924\",\"end\":\"space\"},{\"n\":4,\"text\":\"worn as a head-ornament. \u091a\u091e\u094d\u091a\u0924\u094d\u2013moving, quivering. \u0932\u0940\u0932\u093e\u0926\u0917\u094d\u0927\u0966\u2013\",\"end\":\"space\"},{\"n\":5,\"text\":\"see Kum. III. 72. \u0926\u0936\u093e\u2013(1) a wick; (2) the condition of. \u092a\u094d\u0930\u093e\u0917\u094d\u092d\u093e\u0930\u2013\",\"end\":\"space\"},{\"n\":6,\"text\":\"a mass or heap of; ( an uncommon word; see M\u00e1l. M\u00e1d. V. 29.)\",\"end\":\"space\"},{\"n\":7,\"text\":\"\u0909\u091a\u094d\u091a\u093e\u091f\u092f\u0928\u094d\u2014removing, entirely dispelling. Cf. Nai. III. 7. \u0935\u093f\u091c\u092f\u0924\u0947\u2014\",\"end\":\"space\"},{\"n\":8,\"text\":\"\u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0915\u0930\u094d\u0937\u0947\u0923 \u0935\u0930\u094d\u0924\u0924\u0947\u2013shines pre-eminently. Fig. R\u00fbpaka.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit words are blurred, especially in lines 1 and 4.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 2. The poet herein gives three causes of the decadence\",\"end\":\"space\"},{\"n\":2,\"text\":\"of learning\u2014first, learned men themselves do not encourage it,\",\"end\":\"space\"},{\"n\":3,\"text\":\"being jealous of new aspirants for literary honours; secondly,\",\"end\":\"space\"},{\"n\":4,\"text\":\"wealthy men in their own self-sufficiency despise knowledge;\",\"end\":\"space\"},{\"n\":5,\"text\":\"and lastly, ignorant men do not encourage it because they cannot\",\"end\":\"space\"},{\"n\":6,\"text\":\"appreciate it. \u092a\u094d\u0930\u092d\u0935\u0903\u2014th\u0435 great, the rich. \u0905\u092c\u094b\u0927\u094b\u092a\u0939\u0924\u093e\u0903\u2014Lit. smit-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"ten by ignorance or want of understanding; incapable of appre-\",\"end\":\"hyphen\"},{\"n\":8,\"text\":\"ciating merits. \u091c\u0940\u0930\u094d\u0923\u0947\u2014p. p. of \u091c\u0944, absorbed; see infra. sl. 84\",\"end\":\"space\"},{\"n\":9,\"text\":\"and cf. Mis. sl. 3.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl, 3. \u0928\u093f\u0927\u093f\u0936\u0919\u094d\u0915\u092f\u093e\u2014in the expectation of (finding) a treasure.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0927\u094d\u092e\u093e\u0924\u093e\u0903\u2014fused, smelted. There may also be a reference to alchemy\",\"end\":\"space\"},{\"n\":3,\"text\":\"here. \u0927\u093e\u0924\u0935\u0903\u2014Metallic ores, minerals. \u092e\u0928\u094d\u0924\u094d\u0930\u093e\u0930\u093e\u0927\u0928\u2014here means\",\"end\":\"space\"},{\"n\":4,\"text\":\"securing the magical power with which some incantations are\",\"end\":\"space\"},{\"n\":5,\"text\":\"supposed to endow a man who repeats them according to the\",\"end\":\"space\"},{\"n\":6,\"text\":\"rules or manner prescribed in the Tantras. \u0936\u094d\u092e\u0936\u093e\u0928\u0947\u2014the cemetery\",\"end\":\"space\"},{\"n\":7,\"text\":\"being the usual place for such practices. \u0915\u093e\u0923\u0966 &c.\u2014a broken\",\"end\":\"space\"},{\"n\":8,\"text\":\"cowrie shell. \u0936\u094d\u092e\u0936\u093e\u0928\u2014derived as \u0936\u0935\u093e\u0903 \u0936\u0947\u0930\u0924\u0947 \u0905\u0924\u094d\u0930; a comp. of the\",\"end\":\"space\"},{\"n\":9,\"text\":\"\u092a\u0943\u0937\u094b\u0926\u0930\u093e\u0926\u093f class.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 4. \u0926\u0947\u0936\u0902 \u092d\u094d\u0930\u093e\u0928\u094d\u0924\u092e\u094d\u2014traversed (by me). The construction is\",\"end\":\"space\"},{\"n\":2,\"text\":\"peculiar. The subj. \u092e\u092f\u093e is understood. By the s\u00fbtra \u2018\u0917\u0924\u094d\u092f\u0930\u094d\u0925\u093e\u0915\u0930\u094d\u092e\u0915\u2019\u2014\",\"end\":\"space\"},{\"n\":3,\"text\":\"P\u00e1n. III. 4. 12, \u0915\u094d\u0924 is added \u092d\u093e\u0935\u0947 to verbs implying motion\",\"end\":\"space\"},{\"n\":4,\"text\":\"or used intransitively. \u0926\u0947\u0936\u0902 is an acc. of place. Mr. Telang cites\",\"end\":\"space\"},{\"n\":5,\"text\":\"as a parallel instance \u2018\u0928\u093f\u091c\u093e\u0936\u094d\u0930\u092e\u092a\u0926\u0902 \u092a\u094d\u0930\u0924\u093f \u0917\u0924\u0902 \u091a \u092e\u0941\u0928\u093f\u0928\u093e\u2019 Pra. II; Cf.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The Sanskrit quotation and s\u016btra are somewhat blurred.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"(51)\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"heading\",\"number\":null,\"label\":\"VAIRA'GYAS'ATAKA\",\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"1\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"2\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"stanza_note\",\"number\":\"3\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"stanza_note\",\"number\":\"4\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]},{\"flow\":\"notes\",\"units\":[]}],\"relations\":[]}"
