{
 "regions": {
  "r3": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "उक्तमेव स्पष्टार्थमाह—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "एतस्माद्विरमेन्द्रियार्थगहनादायासकादाश्रय",
     "end": "line"
    },
    {
     "n": 2,
     "text": "श्रेयोमार्गमशेषदुःखशमनव्यापारदक्षं क्षणात् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "शान्तं भावमुपैहि संत्यज निजां कल्लोललोलां गतिं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "मा भूयो भज भङ्गुरां भवरतिं चेतः प्रसीदाधुना ॥ ६४ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The superscript footnote markers in the verse are not all clearly legible."
  },
  "r5": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "हे चेतः एतस्मात् सर्वानुभवसिद्धात् । आयासं त्रासं करोतीति आयासकं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "तस्मात् । इन्द्रियाणां ज्ञानकर्मेन्द्रियाणामर्थाः विषयाः शब्दस्पर्शादयः आदान-",
     "end": "hyphen"
    },
    {
     "n": 3,
     "text": "ग्रहणादयश्च त एव गहनं वनं तस्मात् विरम निवर्तस्व । विषयेषु अनर्थकारिषु",
     "end": "space"
    },
    {
     "n": 4,
     "text": "मा प्रवृत्तं भूः इति भावः । क्षणात् सपदि अशेषाणि च तानि दुःखानि आध्या-",
     "end": "hyphen"
    },
    {
     "n": 5,
     "text": "त्मिकादीनि तेषां शमनव्यापारे दक्षं चतुरं श्रेयोमार्गं मोक्षमार्गं आश्रय । तदे-",
     "end": "hyphen"
    },
    {
     "n": 6,
     "text": "वाह— शान्तं शमप्रधानं भावं वृत्तिविशेषमुपैहि प्राप्नुहि । समाहितं भवेत्यर्थः ।",
     "end": "space"
    },
    {
     "n": 7,
     "text": "कल्लोलवत् महातरंगवत् लोलां चञ्चलां गतिम् । भङ्गुरां विनाशशीलाम् । भवे",
     "end": "space"
    },
    {
     "n": 8,
     "text": "संसारे रतिः आसक्तिस्तां मा भज सेवस्व । प्रसीद प्रसन्नं भव । प्रसादमन्तरेण",
     "end": "space"
    },
    {
     "n": 9,
     "text": "श्रेयःप्राप्त्यसंभवादिति भावः । शार्दूल० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small-type readings are indistinct."
  },
  "r6": {
   "type": "lead_in",
   "lines": [
    {
     "n": 1,
     "text": "अधुना कर्तव्यं निर्दिशति—",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "मोहं मार्जय तामुपार्जय रतिं चन्द्रार्धचूडामणौ",
     "end": "line"
    },
    {
     "n": 2,
     "text": "",
     "end": "space"
    },
    {
     "n": 3,
     "text": "चेतः स्वर्गतटिनीतटभुवामासङ्गमङ्गीकुरु ।",
     "end": "line"
    },
    {
     "n": 4,
     "text": "को वा वीचिषु बुद्बुदेषु च तडिल्लेखासु च स्त्रीषु च",
     "end": "line"
    },
    {
     "n": 5,
     "text": "ज्वालाग्रेषु च पन्नगेषु च सरिद्वेगेषु च प्रत्ययः ॥ ६५ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some superscript variant markers are indistinct."
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "हे चेतः मोहं धनपुत्रादिष्वासक्तिरूपं दोषं मार्जय क्षालय । तां प्रसिद्धां",
     "end": "space"
    },
    {
     "n": 2,
     "text": "परमसुखानन्ददायिनीमिति रामर्षिः । चन्द्रार्धः चन्द्रकला चूडामणिः शिरोभूषणं",
     "end": "space"
    },
    {
     "n": 3,
     "text": "यस्य तस्मिन् शिवे रतिं प्रीतिमुपार्जय संपादय । स्वर्गतटिन्याः गंगायाः",
     "end": "space"
    },
    {
     "n": 4,
     "text": "तटसंबन्धिन्यो या भुवस्तासामासङ्गं समागमम् । वीचिषु जलतरङ्गेषु बुद्बुदेषु",
     "end": "space"
    },
    {
     "n": 5,
     "text": "जलविकारेषु तडिल्लेखासु विद्युल्लतासु स्त्रीषु ज्वालाग्रेषु अग्निशिखाग्रेषु सर्पेषु",
     "end": "space"
    },
    {
     "n": 6,
     "text": "नदीवेगेषु च को वा प्रत्ययः विश्वासः । न कोऽपीत्यर्थः । वृत्तं शार्दूलं० ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small-type readings are indistinct."
  },
