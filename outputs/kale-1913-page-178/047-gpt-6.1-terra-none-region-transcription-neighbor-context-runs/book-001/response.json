          "text": "{\"regions\":{\"r2\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"is connected with a plurality of verbs we have the ( second ) of\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0926\u0940\u092a\u0915\u093e\u0932\u0902\u0915\u093e\u0930.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 24. \u091c\u092f\u0928\u094d\u0924\u093f Glory to; veneration to ( implied ). \u0938\u0941\u0915\u0943\u0924\u093f\u0928\u2014\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u2018\u0907\u0928\u093f:\u2019 \u0964 Pan. V. 2, 115; ( 1 ) meritorious, whose works are\",\"end\":\"space\"},{\"n\":3,\"text\":\"good. ( 2 ) adepts in the preparation of medicines. \u0930\u0938\u0938\u093f\u0926\u094d\u0927\u093e\u0903\u2014\",\"end\":\"space\"},{\"n\":4,\"text\":\"see com.; perfect or accomplished in the Rasas or sentiments\",\"end\":\"space\"},{\"n\":5,\"text\":\"i. e. capable of depicting the various sentiments, and, thereby\",\"end\":\"space\"},{\"n\":6,\"text\":\"touching the passions and feelings of men ( what constitutes\",\"end\":\"space\"},{\"n\":7,\"text\":\"the soul of poetry ); masters of the poetic art. The Rasas are\",\"end\":\"space\"},{\"n\":8,\"text\":\"\",\"end\":\"space\"},{\"n\":9,\"text\":\"eight in number; viz. \u0936\u0943\u0919\u094d\u0917\u093e\u0930\u0935\u0940\u0930\u0915\u0930\u0941\u0923\u093e\u0926\u094d\u092d\u0941\u0924\u0939\u093e\u0938\u094d\u092f\u092d\u092f\u093e\u0928\u0915\u093e\u0903 \u0964 \u092c\u0940\u092d\u0924\u094d\u0938\u0930\u094c\u0926\u094d\u0930\u094c \u091a\",\"end\":\"space\"},{\"n\":10,\"text\":\"\u0930\u0938\u093e\u0903 ( \u0936\u093e\u0928\u094d\u0924\u0938\u094d\u0924\u0941 \u0928\u0935\u092e\u0903 \u0938\u094d\u092e\u0943\u0924\u0903 \u0965 \u0936\u093e\u0928\u094d\u0924 is also added ). Some also add a\",\"end\":\"space\"},{\"n\":11,\"text\":\"tenth-\u0935\u0924\u094d\u0938\u0932\u0930\u0938. The Rasas are more or less a necessary factor\",\"end\":\"space\"},{\"n\":12,\"text\":\"of every poetic composition. But according to Vis'van\u00e1tha they\",\"end\":\"space\"},{\"n\":13,\"text\":\"constitute the very essence of poetry (since he defines \u0915\u093e\u0935\u094d\u092f as\",\"end\":\"space\"},{\"n\":14,\"text\":\"\u0935\u093e\u0915\u094d\u092f\u0902 \u0930\u0938\u093e\u0924\u094d\u092e\u0915\u0902 \u0915\u093e\u0935\u094d\u092f\u092e\u094d ). \u0930\u0938\u0938\u093f\u0926\u094d\u0927 is also a S'lishta word. The side\",\"end\":\"space\"},{\"n\":15,\"text\":\"meaning is \u2018who are skilled in managing mercury ( \u0930\u0938 ), which,\",\"end\":\"space\"},{\"n\":16,\"text\":\"when prepared in a particular way, is supposed to grant exemp-\",\"end\":\"hyphen\"},{\"n\":17,\"text\":\"tion from old age.\u2019 \u092f\u0936\u0903\u0915\u093e\u092f\u0947\u2013\u092f\u0936\u094b\u0930\u0942\u092a\u0903 \u0915\u093e\u092f\u0903 \u0964 \u0915\u093e\u092f is irregularly\",\"end\":\"space\"},{\"n\":18,\"text\":\"derived form \u091a\u093f; \u091a\u0940\u092f\u0924\u0947\u093d\u0938\u094d\u092e\u093f\u0928\u094d\u0928\u0938\u094d\u0925\u094d\u092f\u093e\u0926\u093f\u0915\u092e\u093f\u0924\u093f, \u091a\u0940\u092f\u0924\u0947 \u0905\u0928\u094d\u0928\u093e\u0926\u093f\u0928\u0947\u0924\u093f \u0935\u093e \u0915\u093e\u092f\u0903 \u0964\",\"end\":\"space\"},{\"n\":19,\"text\":\"\u091a\u093f+\u0918\u091e\u094d, \u091a\u0938\u094d\u092f \u0915\u0903 \u0964 P\u00e1n. III. 3. 41. \u091c\u0930\u093e fr. \u091c\u0944+\u0905\u0919\u094d. Cf \u0915\u093e\u0924\u093f\u092a\u092f\u093e\u0928\u093f\u092e\u0947-\",\"end\":\"hyphen\"},{\"n\":20,\"text\":\"\u0937\u0935\u0930\u094d\u0924\u0940\u0928\u093f \u091c\u0928\u094d\u092e\u091c\u0930\u093e\u092e\u0930\u0923\u0935\u093f\u0939\u094d\u0935\u0932\u0947 \u091c\u0917\u0924\u093f \u0964 \u0915\u0932\u094d\u092a\u093e\u0928\u094d\u0924\u0915\u094b\u091f\u093f\u092c\u0928\u094d\u0927\u0941\u0903 \u0938\u094d\u092b\u0941\u0930\u0924\u093f \u0915\u0935\u0940\u0928\u093e\u0902\",\"end\":\"space\"},{\"n\":21,\"text\":\"\u092f\u0936\u0903\u092a\u094d\u0930\u0938\u0930\u0903 \u0965 Subh\u00e1. The fig. in this sl. is S'lesha.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit readings, particularly the derivations and quotation near the end, are difficult to distinguish.\"},\"r4\":{\"type\":\"stanza_note\",\"lines\":[{\"n\":1,\"text\":\"Sl. 25. \u0938\u0942\u0928\u0941\u0903\u2014a son; \u0938\u0942\u092f\u0924\u0947 \u0907\u0924\u093f \u0964 \u0938\u0941\u091e\u0903 \u0915\u093f\u0924\u094d \u0907\u0924\u093f \u0928\u0941\u0903 \u0964 Un. III. 35.\",\"end\":\"space\"},{\"n\":2,\"text\":\"\u0938\u091a\u094d\u091a\u0930\u093f\u0924\u0903\u2014well-behaved. \u0938\u0924\u0940\u2014\u0938\u0924\u0940 \u0938\u093e\u0927\u094d\u0935\u0940 \u092a\u0924\u093f\u0935\u094d\u0930\u0924\u093e Amara. \u092a\u094d\u0930\u0938\u093e\u0926\u094b-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"\u0928\u094d\u092e\u0941\u0916\u0903\u2014ready to favour, favourably disposed. \u0905\u0935\u0926\u093e\u0924 \u0905\u0935\u0926\u093e\u092f\u0924\u0947 \u0938\u094d\u092e\",\"end\":\"space\"},{\"n\":4,\"text\":\"\u0907\u0924\u093f \u0964 from \u0926\u0948 to purify &c.+\u0915\u094d\u0924\u0903 \u0915\u0930\u094d\u092e\u0923\u093f \u0964 refined, polished: hence\",\"end\":\"space\"},{\"n\":5,\"text\":\"elegant or beautiful with. \u0935\u093f\u0936\u094d\u0935\u0939\u093e\u0930\u093f\u0928\u094d\u2014\u0924\u093e\u091a\u094d\u091b\u0940\u0932\u094d\u092f\u0947 \u0923\u093f\u0928\u093f\u0903 \u0964 habitually\",\"end\":\"space\"},{\"n\":6,\"text\":\"pleasing the world, joy of the world ( Vishnu being the most\",\"end\":\"space\"},{\"n\":7,\"text\":\"popular deity ). The fig. here is \u0924\u0941\u0932\u094d\u092f\u092f\u094b\u0917\u093f\u0924\u093e ( and not \u0926\u0940\u092a\u0915 )\",\"end\":\"space\"},{\"n\":8,\"text\":\"\",\"end\":\"space\"},{\"n\":9,\"text\":\"which is defined as \u0928\u093f\u092f\u0924\u093e\u0928\u093e\u0902 \u0938\u0915\u0943\u0927\u094d\u0926\u0930\u094d\u092e\u0903 \u0938\u093e \u092a\u0941\u0928\u0938\u094d\u0924\u0941\u0932\u094d\u092f\u092f\u094b\u0917\u093f\u0924\u093e \u0964 K. P.\u2014a\",\"end\":\"space\"},{\"n\":10,\"text\":\"combination of several objects having the same attribute ( here,\",\"end\":\"space\"},{\"n\":11,\"text\":\"acquisition of the various things mentioned ) the objects being\",\"end\":\"space\"},{\"n\":12,\"text\":\"either all relevant or all irrelevant.\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"Some Sanskrit grammatical explanations and the definition of \u0924\u0941\u0932\u094d\u092f\u092f\u094b\u0917\u093f\u0924\u093e are difficult to read.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"( 13 )\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"notes\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\"]},{\"id\":\"u2\",\"type\":\"stanza_note\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"stanza_note\",\"number\":\"24\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"stanza_note\",\"number\":\"25\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
