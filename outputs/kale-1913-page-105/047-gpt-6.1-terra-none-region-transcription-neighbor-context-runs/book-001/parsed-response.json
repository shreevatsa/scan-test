{
 "regions": {
  "r3": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अकिंचनस्य दान्तस्य शान्तस्य समचेतसः ॥",
     "end": "line"
    },
    {
     "n": 2,
     "text": "सदा संतुष्टमनसः सर्वाः सुखमया दिशः ॥ १६ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r4": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "नास्ति किंचन यस्य तस्य । दान्तस्य उपरतबाह्येन्द्रियस्य । शान्तस्य",
     "end": "space"
    },
    {
     "n": 2,
     "text": "निगृहीतान्तःकरणस्य । समं चेतः यस्य तस्य संतुष्टमनसः प्रमुदितान्तःकरणस्य",
     "end": "space"
    },
    {
     "n": 3,
     "text": "पुरुषस्य । सुखमयाः सुखप्रचुराः । सर्वदुःखकारणे मनसि परितुष्टे सति सर्वत्र",
     "end": "space"
    },
    {
     "n": 4,
     "text": "सुखप्राचुर्यमनुभूयत इत्यर्थः ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small characters are indistinct."
  },
  "r5": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "अनावर्ती कालो व्रजति स वृथा तत्र गणितं",
     "end": "line"
    },
    {
     "n": 2,
     "text": "दशास्तास्ताः सोढा व्यसनशतसंपातविधुराः ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "कियद्वा वक्ष्यामः किमिव बत नात्मन्यपकृतं",
     "end": "line"
    },
    {
     "n": 4,
     "text": "वयो यावत्तावत्पुनरपि तदेव व्यवसितम् ॥ १७ ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "The first word of line 4 is not fully clear."
  },
  "r6": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "न आवर्तत इति तच्छीलः । वृथा व्यर्थं व्रजति गच्छतीति न गणितं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "मनसि कृतम् । तास्ताः परस्परविलक्षणाः दशा अवस्थाः । व्यसनानां शतं",
     "end": "space"
    },
    {
     "n": 3,
     "text": "तस्य संपातः पतनं तेन विधुरा विकलाः । बतेति खेदे । आत्मनि स्वस्मिन् ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "किमिव नापकृतं कोपकारो न कृतः । सर्वमपि अपकृतमित्यर्थः । व्यवसितं",
     "end": "space"
    },
    {
     "n": 5,
     "text": "चेष्टितम् । यावदेतत्सर्वं कृतं तावत्पुनरपि तदेव कर्तुमारब्धम् । शिखरिणी ॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Several small letters are indistinct."
  },
  "r7": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "उत्तिष्ठ क्षणमेकमुद्वह गुरुं दारिद्र्यभारं सखे",
     "end": "line"
    },
    {
     "n": 2,
     "text": "श्रान्तस्तावदहं चिरं मरणजं सेवे त्वदीयं सुखम् ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "इत्युक्तो धनवर्जितेन सहसा गत्वा श्मशाने शवो",
     "end": "line"
    },
    {
     "n": 4,
     "text": "दारिद्र्यान्मरणं वरं वरमिति ज्ञात्वैव तूष्णीं स्थितः ॥ १८ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r8": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "हे सखे शव । गुरुं दुर्वहम् । अहं श्रान्तः संसारभारवहनेन त्वदीयं मरणजं",
     "end": "space"
    },
    {
     "n": 2,
     "text": "सुखं सेवे । तदेव मे अतीव राचते । इति धनेन वर्जितः तेन दरिद्रेण गत्वा ।",
     "end": "space"
    },
    {
     "n": 3,
     "text": "सहसा संभ्रमेणोक्तः । दारिद्र्यान्मरणं वरं वरमिति ज्ञात्वा । वीप्सा आदरार्था ।",
     "end": "space"
    },
    {
     "n": 4,
     "text": "तूष्णीं मूकभावेन । ‘दारिद्र्यदोषो गुणराशिनाशी’ इति तु सुप्रसिद्धमेव । शार्दूल०॥",
     "end": "space"
    }
   ],
   "uncertain": true,
   "note": "Some small characters are indistinct."
  },
  "r9": {
   "type": "verse",
   "lines": [
    {
     "n": 1,
     "text": "एता हसन्ति च रुदन्ति च कार्यहेतो-",
     "end": "hyphen"
    },
    {
     "n": 2,
     "text": "र्विश्वासयन्ति च परं न च विश्वसन्ति ।",
     "end": "line"
    },
    {
     "n": 3,
     "text": "तस्मान्नरेण कुलशीलसमन्वितेन",
     "end": "line"
    },
    {
     "n": 4,
     "text": "नार्यः श्मशानघटिका इव वर्जनीयाः ॥ १९ ॥",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
  "r10": {
   "type": "commentary",
   "lines": [
    {
     "n": 1,
     "text": "एताः स्त्रियः कार्यहेतोः स्वहेतुसिद्ध्यै हसन्ति आनन्दप्रदर्शनं कुर्वन्ति रुदन्ति",
     "end": "space"
    }
   ],
   "uncertain": false,
   "note": null
  },
