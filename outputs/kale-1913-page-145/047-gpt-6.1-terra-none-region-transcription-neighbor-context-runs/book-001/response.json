          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"misfortunes come thronging as if through gates thrown open\",\"end\":\"space\"},{\"n\":2,\"text\":\"to them; Death hastily asserts his supremacy over every\",\"end\":\"space\"},{\"n\":3,\"text\":\"helpless creature that is born; what thing is there then, that\",\"end\":\"space\"},{\"n\":4,\"text\":\"despotic Fate has made immune from danger ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"35. Enjoyments are transient like high surging waves; life\",\"end\":\"space\"},{\"n\":2,\"text\":\"is liable to pass away in a moment; youthful happiness lasts\",\"end\":\"space\"},{\"n\":3,\"text\":\"for a few days only; love for the cherished is fickle; knowing,\",\"end\":\"space\"},{\"n\":4,\"text\":\"therefore, that the entire worldly existence is destitute of any\",\"end\":\"space\"},{\"n\":5,\"text\":\"good, ye wise men, givers of advice, make the attempt with\",\"end\":\"space\"},{\"n\":6,\"text\":\"a mind skilful in ( or, intent on) doing good to the people.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"36. Sensual objects are as ephemeral as the lightning\",\"end\":\"space\"},{\"n\":2,\"text\":\"shining in the midst of the cloudy canopy; life is frail like\",\"end\":\"space\"},{\"n\":3,\"text\":\"the water collected in the row of clouds scattered by the wind;\",\"end\":\"space\"},{\"n\":4,\"text\":\"momentary is the youthful happiness of mortals; taking this\",\"end\":\"space\"},{\"n\":5,\"text\":\"into consideration, O wise men, fix your mind at once on\",\"end\":\"space\"},{\"n\":6,\"text\":\"contemplation of the Supreme Spirit, which it is easy to do\",\"end\":\"space\"},{\"n\":7,\"text\":\"when one is a perfect master of ( lit. by being perfect in )\",\"end\":\"space\"},{\"n\":8,\"text\":\"patience and concentration.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"37. Life is fickle like a swelling wave; the splendour\",\"end\":\"space\"},{\"n\":2,\"text\":\"of youth remains only for a certain number of days; wealth\",\"end\":\"space\"},{\"n\":3,\"text\":\"is, like thought, momentary; pleasures are like the flashes\",\"end\":\"space\"},{\"n\":4,\"text\":\"of lightning in autumn; even the embrace of the beloved,\",\"end\":\"space\"},{\"n\":5,\"text\":\"encircling the neck, lasts not for a long time; so have your\",\"end\":\"space\"},{\"n\":6,\"text\":\"attention concentrated upon Brahman, that you should cross\",\"end\":\"space\"},{\"n\":7,\"text\":\"the ocean of worldly dangers.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"38. With their bodies cramped, men have to remain with\",\"end\":\"space\"},{\"n\":2,\"text\":\"difficulty in the womb in the midst of impurities; in youth\",\"end\":\"space\"},{\"n\":3,\"text\":\"the enjoyment of pleasures is difficult on account of the\",\"end\":\"space\"},{\"n\":4,\"text\":\"distraction arising from the pain of separation from one\u2019s\",\"end\":\"space\"},{\"n\":5,\"text\":\"beloved; surely old age too is unwelcome, ( for at that\",\"end\":\"space\"},{\"n\":6,\"text\":\"period ) the refractoriness of women is conspicuous; say\",\"end\":\"space\"},{\"n\":7,\"text\":\"oh men, if there is even the least happiness in worldly life ?\",\"end\":\"space\"}],\"uncertain\":true,\"note\":\"The words \u2018oh men\u2019 are obscured by ink.\"},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 32 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"34\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"35\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"36\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"37\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"38\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
