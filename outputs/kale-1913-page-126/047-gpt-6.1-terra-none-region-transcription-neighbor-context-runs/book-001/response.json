          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"68. He is a son who pleases his father with good actions;\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"that is a wife who desires the good alone of her husband;\",\"end\":\"space\"},{\"n\":4,\"text\":\"that is a friend who acts the same way in adversity as in\",\"end\":\"space\"},{\"n\":5,\"text\":\"happy times. The meritorious ( alone ) secure these three\",\"end\":\"space\"},{\"n\":6,\"text\":\"things in this world.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"69. Rising by bending low ( i. e. by their humility ), evi-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"dencing their own merits by extolling those of others,\",\"end\":\"space\"},{\"n\":3,\"text\":\"gaining their ends by projecting extensive schemes for ( the\",\"end\":\"space\"},{\"n\":4,\"text\":\"good of ) others, and censuring calumniators, whose tongues\",\"end\":\"space\"},{\"n\":5,\"text\":\"( lit. mouths ) are noisy with harsh syllables of accusation,\",\"end\":\"space\"},{\"n\":6,\"text\":\"with their patience alone\u2014virtuous men of such extraor-\",\"end\":\"hyphen\"},{\"n\":7,\"text\":\"dinary behaviour and highly esteemed in the world\u2014who\",\"end\":\"space\"},{\"n\":8,\"text\":\"will not adore them ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"70. Trees become bent ( i. e. humble ) with the harvest\",\"end\":\"space\"},{\"n\":2,\"text\":\"of fruits; with newly-formed waters the clouds hang very\",\"end\":\"space\"},{\"n\":3,\"text\":\"low; good men with ( the acquisition of ) wealth become\",\"end\":\"space\"},{\"n\":4,\"text\":\"meek; this is the nature of benevolent persons.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"71. The ear is graced by Vedic knowledge alone, and\",\"end\":\"space\"},{\"n\":2,\"text\":\"not by an ear-ring; the hand by charity, not by a bracelet;\",\"end\":\"space\"},{\"n\":3,\"text\":\"the body of beneficent people by kindness towards others,\",\"end\":\"space\"},{\"n\":4,\"text\":\"and not by sandal-paint.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"72. Wise people thus describe the characteristics of a\",\"end\":\"space\"},{\"n\":2,\"text\":\"true friend;\u2014he ( i. e. a good friend ) dissuades (you) from\",\"end\":\"space\"},{\"n\":3,\"text\":\"sin, urges (you) to good action, keeps (your) secrets, publi-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"shes (your) merits, does not forsake you (when you are) in\",\"end\":\"space\"},{\"n\":5,\"text\":\"distress, and helps (you, lit. gives you ) in time of need.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"73. The sun causes the group of son-lotuses to expand\",\"end\":\"space\"},{\"n\":2,\"text\":\"without a solicitation; the moon, though unasked, causes the\",\"end\":\"space\"},{\"n\":3,\"text\":\"moon-lotuses to bloom; and the cloud yields water without\",\"end\":\"space\"},{\"n\":4,\"text\":\"being solicited; good people direct their efforts towards the\",\"end\":\"space\"},{\"n\":5,\"text\":\"good of others of their own accord.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 13 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":\"N\u012bti\u015bataka translation\",\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"68\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"69\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"70\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"71\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"72\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"73\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
