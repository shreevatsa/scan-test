          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"as straw. Hence we must say that for want of fixity as\",\"end\":\"space\"},{\"n\":2,\"text\":\"regards the smallness or largeness of the objects of desire\",\"end\":\"space\"},{\"n\":3,\"text\":\"the position of the wealthy magnifies or lessens things ( i. e.\",\"end\":\"space\"},{\"n\":4,\"text\":\"their value ).\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"46. O king, if you wish to milk this cow-like earth, then\",\"end\":\"space\"},{\"n\":2,\"text\":\"first nourish ( enrich ) the nation as they do the calf; when\",\"end\":\"space\"},{\"n\":3,\"text\":\"the nation ( the people ) is being constantly enriched, the\",\"end\":\"space\"},{\"n\":4,\"text\":\"earth, like the desire-granting creeper, yields a variety of\",\"end\":\"space\"},{\"n\":5,\"text\":\"fruits.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"47. Now truthful, now false; at one time harsh, at another\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"speaking sweetly; now cruel and merciful afterwards; now\",\"end\":\"space\"},{\"n\":4,\"text\":\"parsimonious, but anon liberal; ever spending wealth and\",\"end\":\"space\"},{\"n\":5,\"text\":\"ever gaining large sums of money\u2014thus the policy of kings,\",\"end\":\"space\"},{\"n\":6,\"text\":\"like a harlot, assumes a diversity of forms.\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"48. What is the use of those men becoming the king\u2019s,\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"servants ( lit. resorting to the king ) who do not possess the\",\"end\":\"space\"},{\"n\":4,\"text\":\"six qualities, viz. the power to command, fame, the protection\",\"end\":\"space\"},{\"n\":5,\"text\":\"of Br\u00e2hma\u1e47as, charity, the enjoyment of pleasures and the\",\"end\":\"space\"},{\"n\":6,\"text\":\"protection of friends.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"49. Whatever amount of wealth, large or small, might\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"},{\"n\":3,\"text\":\"have been allotted to ( lit. written on the forehead of ) a man,\",\"end\":\"space\"},{\"n\":4,\"text\":\"\",\"end\":\"space\"},{\"n\":5,\"text\":\"he certainly obtains even in the country called Maru; on the\",\"end\":\"space\"},{\"n\":6,\"text\":\"mountain Meru he will not be able to get more. Have\",\"end\":\"space\"},{\"n\":7,\"text\":\"patience then, and do not adopt a servile course of conduct\",\"end\":\"space\"},{\"n\":8,\"text\":\"\",\"end\":\"space\"},{\"n\":9,\"text\":\"towards the wealthy for nothing. See that a jar draws ( lit.\",\"end\":\"space\"},{\"n\":10,\"text\":\"takes up ) the same quantity of water from a well as well as\",\"end\":\"space\"},{\"n\":11,\"text\":\"from the sea.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"50. Oh magnanimous cloud, who does not know that you\",\"end\":\"space\"},{\"n\":2,\"text\":\"alone are the supporter of the Ch\u00e2takas ? Why do you then\",\"end\":\"space\"},{\"n\":3,\"text\":\"wait for our plaintive appeal ?\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"51. Oh friend Ch\u00e2taka, listen ( to me ) with an attentive\",\"end\":\"space\"},{\"n\":2,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 9 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":null,\"label\":null,\"open_start\":true,\"open_end\":true,\"children\":[\"u2\",\"u3\",\"u4\",\"u5\",\"u6\",\"u7\",\"u8\"]},{\"id\":\"u2\",\"type\":\"translated_stanza\",\"number\":\"45\",\"label\":null,\"open_start\":true,\"open_end\":false,\"children\":[\"r2\"]},{\"id\":\"u3\",\"type\":\"translated_stanza\",\"number\":\"46\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r3\"]},{\"id\":\"u4\",\"type\":\"translated_stanza\",\"number\":\"47\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r4\"]},{\"id\":\"u5\",\"type\":\"translated_stanza\",\"number\":\"48\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r5\"]},{\"id\":\"u6\",\"type\":\"translated_stanza\",\"number\":\"49\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r6\"]},{\"id\":\"u7\",\"type\":\"translated_stanza\",\"number\":\"50\",\"label\":null,\"open_start\":false,\"open_end\":false,\"children\":[\"r7\"]},{\"id\":\"u8\",\"type\":\"translated_stanza\",\"number\":\"51\",\"label\":null,\"open_start\":false,\"open_end\":true,\"children\":[\"r8\"]}],\"flows\":[{\"flow\":\"main\",\"units\":[\"u1\"]}],\"relations\":[]}"
