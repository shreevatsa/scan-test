          "annotations": [],
          "logprobs": [],
          "text": "{\"regions\":{\"r2\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"heart must certainly be formed of adamantine stone since it\",\"end\":\"space\"},{\"n\":2,\"text\":\"has not yet been broken into a hundred pieces.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r3\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"34. What is it that lovely-eyed (women) do not do ?\",\"end\":\"space\"},{\"n\":2,\"text\":\"Having entered the affectionate heart of men they fas-\",\"end\":\"hyphen\"},{\"n\":3,\"text\":\"cinate them, madden them, mock them, despise them, gladden\",\"end\":\"space\"},{\"n\":4,\"text\":\"them and grieve them.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"35. A lion, strong and living on the flesh of elephants\",\"end\":\"space\"},{\"n\":2,\"text\":\"and hogs, ruts, it is said, once in a year. The dove eating\",\"end\":\"space\"},{\"n\":3,\"text\":\"only hard pebbles ruts daily. Say what the cause here is.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"36 Residence in a sacred forest, and oh joy, association\",\"end\":\"space\"},{\"n\":2,\"text\":\"with the deer, sacred maintenance on fruits, stones for couches\",\"end\":\"space\"},{\"n\":3,\"text\":\"on the bank of every river\u2014such are the materials for those\",\"end\":\"space\"},{\"n\":4,\"text\":\"that like devotion to God. To those whose minds are fixed\",\"end\":\"space\"},{\"n\":5,\"text\":\"on renunciation alone, whether ( they live in ) a house or a\",\"end\":\"space\"},{\"n\":6,\"text\":\"forest, it is all the same.\",\"end\":\"space\"},{\"n\":7,\"text\":\"\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"37. We are quite content with those delicious syllables\",\"end\":\"space\"},{\"n\":2,\"text\":\"( utterances ) sweeter than honey or clarified butter which the\",\"end\":\"space\"},{\"n\":3,\"text\":\"Divine speech ( the Upanishads ) sends forth from its ambro-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"cial and immortal body; as long as there is, under our arm, a\",\"end\":\"space\"},{\"n\":5,\"text\":\"quantity of barley-meal procured by begging for our maint-\",\"end\":\"hyphen\"},{\"n\":6,\"text\":\"enance so long do we not wish to live on wealth acquired by\",\"end\":\"space\"},{\"n\":7,\"text\":\"servitude.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"38. A dog, lean, blind of an eye, lame, crop-eared and\",\"end\":\"space\"},{\"n\":2,\"text\":\"tail-less (through disease), suffering from abscesses, clammed\",\"end\":\"space\"},{\"n\":3,\"text\":\"with pus, and with his body covered with hundreds of worms,\",\"end\":\"space\"},{\"n\":4,\"text\":\"exhausted through starvation, decayed with age, and having\",\"end\":\"space\"},{\"n\":5,\"text\":\"the brim of an earthen jar placed round its neck, follows a\",\"end\":\"space\"},{\"n\":6,\"text\":\"bitch. Madana scruples not to smite even one that has\",\"end\":\"space\"},{\"n\":7,\"text\":\"already been smitten.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"translated_stanza\",\"lines\":[{\"n\":1,\"text\":\"39. Desist, O wise men, from associating with women\u2014\",\"end\":\"space\"},{\"n\":2,\"text\":\"from the momentary happiness. Be attached to Mercy,\",\"end\":\"space\"},{\"n\":3,\"text\":\"Friendship and Reason. Neither the fully developed orbs\",\"end\":\"space\"},{\"n\":4,\"text\":\"of breasts covered with a wreath, nor the round hips having\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"[ 51 ]\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null}},\"units\":[{\"id\":\"u1\",\"type\":\"translation\",\"number\":nu