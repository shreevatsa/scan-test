{"id":"resp_069b81ecdad4acb6016aecbd47bb9487d198ff80aba9ddd611","object":"response","created_at":1793899848,"completed_at":1793899873,"status":"completed","background":false,"billing":{"payer":"developer"},"frequency_penalty":0.0,"presence_penalty":0.0,"moderation":null,"model":"gpt-6.1-terra","access_programs":{"cyber":"standard"},"previous_response_id":null,"instructions":null,"output":[{"type":"message","id":"msg_069b81ecdad4acb6016aecbd506cfc87d190d8d085320f28f6","role":"assistant","status":"completed","content":[{"type":"output_text","text":"{\"regions\":{\"r3\":{\"type\":\"heading\",\"lines\":[{\"n\":1,\"text\":\"॥ कथा २१ ॥\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r4\":{\"type\":\"paragraph\",\"lines\":[{\"n\":1,\"text\":\"अस्ति कस्मिंश्चिद् वनोद्देशे क्रव्यमुखचतुरकशङ्कुकर्णाख्यैर् वृकज-\",\"end\":\"hyphen\"},{\"n\":2,\"text\":\"म्बुकरभैर् मन्त्रिभिः सहितो वज्रदंष्ट्रो नाम सिंहः । स कदाचिन्\",\"end\":\"space\"},{\"n\":3,\"text\":\"मत्तगजेन सह युध्यमानस् तदीयदन्तकोटिपाटितवपुर् एकान्तम्\",\"end\":\"space\"},{\"n\":4,\"text\":\"आस्थितः । ततः सप्तदिनोपवासपीडितः क्षुत्क्षामतनुस् तान् क्षुधा\",\"end\":\"space\"},{\"n\":5,\"text\":\"बाध्यमानान् सचिवान् आह । किंचिद् अन्विष्यतां वने सत्त्वम् '\",\"end\":\"space\"},{\"n\":6,\"text\":\"येना‸हम् एतदवस्थो ऽपि भवतां तृप्तिम् उत्पादयामि ' इति ।\",\"end\":\"space\"},{\"n\":7,\"text\":\"अथ तदाज्ञासमकालम् एव ते वने पर्यटिताः ' परं न किंचिद्\",\"end\":\"space\"},{\"n\":8,\"text\":\"आसादितम् । अथ चतुरकश् चिन्तयाम् आस । यदि शङ्कुकर्णो\",\"end\":\"space\"},{\"n\":9,\"text\":\"ऽयं व्यापाद्यते ' तदा सर्वेषां कतिचिद् दिनानि तृप्तिर् भवति ।\",\"end\":\"space\"},{\"n\":10,\"text\":\"परं नै‸नं स्वामी मित्रत्वाद् व्यापादयिष्यति । अथवा बुद्धिप्रभावेण\",\"end\":\"space\"},{\"n\":11,\"text\":\"स्वस्वामिनं तथा प्रबोधयिष्यामि ' यथा व्यापादयति । तथा च ।\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r5\":{\"type\":\"verse\",\"lines\":[{\"n\":1,\"text\":\"अवध्यं वा‸थवा‸गम्यम् ' अकृत्यं[*] ना‸स्ति किंचन ।\",\"end\":\"line\"},{\"n\":2,\"text\":\"लोके बुद्धिमताम् अत्र ' तस्मात् तां योजयाम्य् अहम् ॥३५४॥\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r6\":{\"type\":\"paragraph\",\"lines\":[{\"n\":1,\"text\":\"एवं संचिन्त्य शङ्कुकर्णम् इदम् आह । भोः शङ्कुकर्ण ' स्वामी पथ्यं\",\"end\":\"space\"},{\"n\":2,\"text\":\"विना क्षुधया परिपीड्यते । स्वाम्यभावाद् अस्माकं चै‸व ध्रुवं\",\"end\":\"space\"},{\"n\":3,\"text\":\"मृत्युः । तद् त्वदर्थं स्वाम्यर्थं च किंचिद् वदिष्यामि । तच् छ्रूय-\",\"end\":\"hyphen\"},{\"n\":4,\"text\":\"ताम् । शङ्कुकर्ण आह । भो भद्र ' शीघ्रतरं निवेदय ' येन त्वद्व-\",\"end\":\"hyphen\"},{\"n\":5,\"text\":\"चनम् अविकल्पः करोमि । अपरं स्वामिनो हिते कृते सुकृतशतं\",\"end\":\"space\"},{\"n\":6,\"text\":\"कृतम् । चतुरक आह । भो भद्र ' आत्मशरीरं द्विगुणलाभेन\",\"end\":\"space\"},{\"n\":7,\"text\":\"प्रयच्छ ' येन ते द्विगुणं शरीरं भवति ' स्वामिनः प्राणयात्रा\",\"end\":\"space\"},{\"n\":8,\"text\":\"भवति । तच् छ्रुत्वा शङ्कुकर्ण आह । भद्र ' यद्य् एवम् ' तन्\",\"end\":\"space\"},{\"n\":9,\"text\":\"मदीयम् एवे‸दं प्रयोजनम् । तद् उच्यतां स्वामी । एतद् एव\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r1\":{\"type\":\"running_header\",\"lines\":[{\"n\":1,\"text\":\"OR, THE LION AND THE BULL. Book I. Tale xxi: Jackal outwits camel and lion.\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r2\":{\"type\":\"page_number\",\"lines\":[{\"n\":1,\"text\":\"97\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r7\":{\"type\":\"line_number\",\"lines\":[{\"n\":1,\"text\":\"3\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r8\":{\"type\":\"line_number\",\"lines\":[{\"n\":1,\"text\":\"6\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r9\":{\"type\":\"line_number\",\"lines\":[{\"n\":1,\"text\":\"9\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r10\":{\"type\":\"line_number\",\"lines\":[{\"n\":1,\"text\":\"12\",\"end\":\"space\"}],\"uncertain\":false,\"note\":null},\"r11\":{\"type\":\"line_number\",\"lines\":[{\"n\":1,